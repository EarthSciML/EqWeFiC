          "units": "g/mol",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "Section dry mass per mol of air, mass_dry_a/cair_mol_cc: move_sections' drymass, here at the state rather than before a step's growth."
        },
        "drydens": {
          "type": "unknown",
          "units": "g/cm^3",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "Section dry density mass_dry_a/vol_dry_a (dens_dry_a): move_sections' drydens."
        },
        "dvdt": {
          "type": "unknown",
          "units": "cm^3/(mol*s)",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "Rate of change of each section's dry volume per mol of air by ASTEM's condensation, d(vol_dry_a)/dt/cair along ASTEM's rates: each condensing gas's daer times the dry volume one mole of it adds -- mw_aer/dens_aer of the species it becomes plus its charge-balance H+ (aer_H, at the 1 g/mol and 1 g/cm3 the Fortran implies) -- with the same 1.e-15 (ng/m3 to g/cm3, binary32) aerosol_phase_state forms vol_dry_a with. The instantaneous form of the step's growth (drymass_aftgrow/drydens_aftgrow - drymass_pregrow/drydens_pregrow)/dtchem that move_sections receives."
        },
        "q_ms": {
          "type": "unknown",
          "units": "mol/mol",
          "shape": [
            "lev",
            "bin",
            "cq"
          ],
          "description": "The quantities section moving carries with the particle volume, in move_sections' order: the ten components, the hysteresis water, the water."
        },
        "dn_dt": {
          "type": "unknown",
          "units": "1/(mol*s)",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "Tendency of each section's number mixing ratio from every MOSAIC process that is a rate: the aerosol-chemistry column's (coagulation, nucleation, dry deposition) plus section moving's."
        },
        "dhysw_dt": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "Tendency of the hysteresis water from every MOSAIC rate: the aerosol-chemistry column's plus section moving's (ASTEM's water is a re-equilibration, not a rate, and is not here)."
        },
