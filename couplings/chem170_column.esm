        },
        "x_n2o5": {
          "type": "parameter",
          "units": "molec/cm^3",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "CBMZColumn.N2O5."
        },
        "x_no3": {
          "type": "parameter",
          "units": "molec/cm^3",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "CBMZColumn.NO3."
        },
        "x_pan": {
          "type": "parameter",
          "units": "molec/cm^3",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "CBMZColumn.PAN."
        },
        "x_hono": {
          "type": "parameter",
          "units": "molec/cm^3",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "CBMZColumn.HONO."
        },
        "x_oh": {
          "type": "parameter",
          "units": "molec/cm^3",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "CBMZColumn.OH (chem ho)."
        },
        "x_ho2": {
          "type": "parameter",
          "units": "molec/cm^3",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "CBMZColumn.HO2."
        },
        "x_hcl": {
          "type": "parameter",
          "units": "molec/cm^3",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "CBMZColumn.HCl."
        },
        "conv": {
          "type": "parameter",
          "units": "molec/(cm^3*ppmv)",
          "shape": [
            "lev"
          ],
          "default": 1.0,
          "description": "CBMZColumn.conv: the number density of one ppmv, var = conv chem."
        },
        "gas_mm": {
          "type": "parameter",
          "units": "mol/mol",
          "shape": [
            "lev",
            "hgas"
          ],
          "default": 0.0,
          "description": "Host.gas: the mole fractions rsub of the sixteen mapped gases, in mapaer_tofrom_host's order so2, h2so4, no2, no, o3, hno3, h2o2, hcho, nh3, n2o5, no3, pan, hono, oh, ho2, hcl."
        },
        "cair": {
          "type": "parameter",
          "units": "mol/cm^3",
          "shape": [
            "lev"
          ],
          "default": 1.0,
          "description": "Host.cair: cairclm = rho_phy/factdens."
        },
        "dgas": {
          "type": "parameter",
          "units": "nmol/(m^3*s)",
          "shape": [
            "lev",
            "gas"
          ],
          "default": 0.0,
          "description": "GasParticle's Rates.dgas: ASTEM's tendency of each condensing gas."
        },
        "daer": {
          "type": "parameter",
          "units": "nmol/(m^3*s)",
          "shape": [
            "lev",
            "bin",
            "gas"
          ],
          "default": 0.0,
          "description": "GasParticle's Rates.daer: ASTEM's condensation into each section, per gas."
        },
        "nuc_h2so4": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "AerChem.dh2so4_dt: nucleation's H2SO4 mole-fraction tendency."
        },
        "nuc_nh3": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "AerChem.dnh3_dt: nucleation's NH3 mole-fraction tendency."
        },
        "dr_chem": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "lev",
            "bin",
            "comp"
          ],
          "default": 0.0,
          "description": "AerChem.dr_dt: the component tendencies of coagulation, nucleation and aerosol dry deposition."
        },
        "chem_gas": {
          "type": "unknown",
          "units": "ppmv",
          "shape": [
            "lev",
            "hgas"
          ],
          "description": "The sixteen mapped gases in WRF's chem units, X/conv, in mapaer_tofrom_host's order."
        },
        "conv1a": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "lev"
          ],
          "description": "map_mosaic_species' conv1a = cair_mol_m3 * 1e9 with cair_mol_m3 = cairclm * 1e6: mole fraction (mol/mol(air)) -> nmol/m^3."
        },
        "gas_nmol": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "lev",
            "gas"
          ],
          "description": "ASTEM's gas(1:5): H2SO4, HNO3, HCl, NH3 = rsub * conv1a, and MSA = 0 (CBM-Z carries none)."
        },
        "q_h2so4": {
          "type": "unknown",
          "units": "mol/mol",
          "shape": [
            "lev"
          ],
          "description": "rsub(kh2so4), the H2SO4 nucleation reads."
        },
        "q_nh3": {
          "type": "unknown",
          "units": "mol/mol",
          "shape": [
            "lev"
          ],
          "description": "rsub(knh3), the NH3 nucleation reads."
        },
        "aerosol_H2SO4": {
          "type": "unknown",
          "units": "molec/(cm^3*s)",
          "shape": [
            "lev"
          ],
          "description": "H2SO4's exchange with the aerosol: (ASTEM's dgas/conv1a + nucleation's) * factgas * conv."
        },
        "aerosol_HNO3": {
          "type": "unknown",
          "units": "molec/(cm^3*s)",
          "shape": [
            "lev"
          ],
          "description": "HNO3's exchange with the aerosol: ASTEM's dgas/conv1a * factgas * conv."
        },
        "aerosol_HCl": {
          "type": "unknown",
          "units": "molec/(cm^3*s)",
          "shape": [
            "lev"
          ],
          "description": "HCl's exchange with the aerosol: ASTEM's dgas/conv1a * factgas * conv."
        },
        "aerosol_NH3": {
          "type": "unknown",
          "units": "molec/(cm^3*s)",
          "shape": [
            "lev"
          ],
          "description": "NH3's exchange with the aerosol: (ASTEM's dgas/conv1a + nucleation's) * factgas * conv."
        },
        "dr_dt": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "lev",
            "bin",
            "comp"
          ],
          "description": "Tendency of each section's component mole fractions from every MOSAIC process: the aerosol-chemistry column's dr_dt, ASTEM's daer/conv1a into SO4 (comp 1), NO3 (2), Cl (3) and NH4 (5), and section moving's transfer between sections (SecMove.dq_dt)."
        },
        "r_aer": {
          "type": "parameter",
          "units": "mol/mol",
          "shape": [
            "lev",
            "bin",
            "comp"
          ],
          "description": "AerChem.r: the component mole fractions of each section (rsub at massptr_aer)."
        },
        "hysw_aer": {
          "type": "parameter",
          "units": "mol/mol",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "AerChem.hysw: the hysteresis water (rsub at hyswptr_aer)."
        },
        "water_aer": {
          "type": "parameter",
          "units": "mol/mol",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "AerChem.water: the aerosol water (rsub at waterptr_aer)."
        },
        "mass_dry_ps": {
          "type": "parameter",
          "units": "g/cm^3",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "Ps.mass_dry: MOSAIC's dry mass of each section, g per cm3 of air (mass_dry_a)."
        },
        "vol_dry_ps": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "Ps.vol_dry: MOSAIC's dry volume of each section, cm3 of particle per cm3 of air (vol_dry_a)."
        },
        "dn_chem": {
          "type": "parameter",
          "units": "1/(mol*s)",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "AerChem.dn_dt: the number tendency of coagulation, nucleation and aerosol dry deposition."
        },
        "dhysw_chem": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "lev",
            "bin"
