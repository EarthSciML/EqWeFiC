  "reaction_systems": {
    "CBMZ": {
      "ref": "../components/gaschem/cbmz/cbmz.esm",
      "reaction_system": "CBMZ"
    }
  },
  "coupling": [
    {
      "type": "coupling_import",
      "ref": "../components/gaschem/cbmz/cbmz_peroxy_pool.esm",
      "bind": {
        "Mech": "CBMZ",
        "Rates": "CBMZRateConstants"
      },
      "description": "CBM-Z's ten state-dependent peroxy rate coefficients read the mechanism's own peroxy radicals, level by level once lifted."
    },
    {
      "type": "coupling_import",
      "ref": "lib/wrf_chem_emissions_driver_gas.esm",
      "bind": {
        "Col": "EmissionsColumn",
        "Bio": "Bio",
        "BioCbmz": "BioCbmz",
        "Anthro": "Anthro"
      },
      "description": "emissions_driver's gas half, exactly as couplings/emissions_column.esm wires it."
    },
    {
      "type": "coupling_import",
      "ref": "lib/wrf_chem_emissions_driver_aerosol.esm",
      "bind": {
        "Col": "EmissionsColumn",
        "Aer": "Aer"
      },
      "description": "emissions_driver's MOSAIC half. The gas column does not read it; it is wired so EmissionsColumn is whole."
    },
    {
      "type": "coupling_import",
      "ref": "lib/cbmz_column_processes.esm",
      "bind": {
        "CBMZColumn": "CBMZColumn",
        "CBMZRateConstants": "CBMZRateConstants",
        "CBMZ": "CBMZ",
        "EmissionsColumn": "EmissionsColumn",
        "WeselyRc": "WeselyRc",
        "WeselyVd": "WeselyVd",
        "DryDep": "DryDep",
        "WetDep": "WetDep"
      },
      "description": "The CBM-Z column's process edges, as couplings/cbmz_column.esm wires them."
    },
    {
      "type": "coupling_import",
      "ref": "lib/mosaic_gas_particle_processes.esm",
      "bind": {
        "Column": "GasParticle",
        "Lg": "Lg",
        "Const": "Const",
        "Act": "Act",
        "Ps": "Ps",
        "Zsr": "Zsr",
        "Eq": "Eq",
        "I2E": "I2E",
        "Rates": "Rates",
        "Mtc": "Mtc",
        "Liq": "Liq",
        "Sol": "Sol",
        "Mix": "Mix",
        "Conform": "Conform"
      },
      "description": "The 163 process edges of the MOSAIC column it names, as that column document wires them."
    },
    {
      "type": "coupling_import",
      "ref": "lib/mosaic_aerchemistry_processes.esm",
      "bind": {
        "Column": "AerChem",
        "CoagEntry": "CoagEntry",
        "CoagKernel": "CoagKernel",
        "CoagAssembly": "CoagAssembly",
        "Nucleation": "Nucleation",
        "DryDeposition": "DryDeposition"
      },
      "description": "The 58 process edges of the MOSAIC column it names, as that column document wires them."
    },
    {
      "type": "operator_compose",
      "systems": [
        "CBMZColumn",
        "CBMZ"
      ],
      "translate": {
        "CBMZColumn.H2SO4": "CBMZ.H2SO4",
        "CBMZColumn.HNO3": "CBMZ.HNO3",
        "CBMZColumn.NO": "CBMZ.NO",
        "CBMZColumn.NO2": "CBMZ.NO2",
        "CBMZColumn.NO3": "CBMZ.NO3",
        "CBMZColumn.N2O5": "CBMZ.N2O5",
        "CBMZColumn.HONO": "CBMZ.HONO",
        "CBMZColumn.HNO4": "CBMZ.HNO4",
        "CBMZColumn.O3": "CBMZ.O3",
        "CBMZColumn.OH": "CBMZ.OH",
        "CBMZColumn.HO2": "CBMZ.HO2",
        "CBMZColumn.H2O2": "CBMZ.H2O2",
        "CBMZColumn.CH4": "CBMZ.CH4",
        "CBMZColumn.CO": "CBMZ.CO",
        "CBMZColumn.SO2": "CBMZ.SO2",
        "CBMZColumn.C2H6": "CBMZ.C2H6",
        "CBMZColumn.CH3O2": "CBMZ.CH3O2",
        "CBMZColumn.ETHP": "CBMZ.ETHP",
        "CBMZColumn.HCHO": "CBMZ.HCHO",
        "CBMZColumn.CH3OH": "CBMZ.CH3OH",
        "CBMZColumn.ANOL": "CBMZ.ANOL",
        "CBMZColumn.CH3OOH": "CBMZ.CH3OOH",
        "CBMZColumn.ETHOOH": "CBMZ.ETHOOH",
        "CBMZColumn.ALD2": "CBMZ.ALD2",
        "CBMZColumn.HCOOH": "CBMZ.HCOOH",
        "CBMZColumn.RCOOH": "CBMZ.RCOOH",
        "CBMZColumn.C2O3": "CBMZ.C2O3",
        "CBMZColumn.PAN": "CBMZ.PAN",
        "CBMZColumn.PAR": "CBMZ.PAR",
        "CBMZColumn.AONE": "CBMZ.AONE",
        "CBMZColumn.MGLY": "CBMZ.MGLY",
        "CBMZColumn.C2H4": "CBMZ.C2H4",
        "CBMZColumn.OLET": "CBMZ.OLET",
        "CBMZColumn.OLEI": "CBMZ.OLEI",
        "CBMZColumn.TOL": "CBMZ.TOL",
        "CBMZColumn.XYL": "CBMZ.XYL",
        "CBMZColumn.CRES": "CBMZ.CRES",
        "CBMZColumn.TO2": "CBMZ.TO2",
        "CBMZColumn.CRO": "CBMZ.CRO",
        "CBMZColumn.OPEN": "CBMZ.OPEN",
        "CBMZColumn.ONIT": "CBMZ.ONIT",
        "CBMZColumn.ROOH": "CBMZ.ROOH",
        "CBMZColumn.RO2": "CBMZ.RO2",
        "CBMZColumn.ANO2": "CBMZ.ANO2",
        "CBMZColumn.NAP": "CBMZ.NAP",
        "CBMZColumn.XO2": "CBMZ.XO2",
        "CBMZColumn.XPAR": "CBMZ.XPAR",
        "CBMZColumn.ISOP": "CBMZ.ISOP",
        "CBMZColumn.ISOPRD": "CBMZ.ISOPRD",
        "CBMZColumn.ISOPP": "CBMZ.ISOPP",
        "CBMZColumn.ISOPN": "CBMZ.ISOPN",
        "CBMZColumn.ISOPO2": "CBMZ.ISOPO2",
        "CBMZColumn.ARO1": "CBMZ.ARO1",
        "CBMZColumn.ARO2": "CBMZ.ARO2",
        "CBMZColumn.ALK1": "CBMZ.ALK1",
        "CBMZColumn.OLE1": "CBMZ.OLE1",
        "CBMZColumn.API1": "CBMZ.API1",
        "CBMZColumn.API2": "CBMZ.API2",
        "CBMZColumn.LIM1": "CBMZ.LIM1",
        "CBMZColumn.LIM2": "CBMZ.LIM2",
        "CBMZColumn.API": "CBMZ.API",
        "CBMZColumn.LIM": "CBMZ.LIM",
        "CBMZColumn.O1D": "CBMZ.O1D",
        "CBMZColumn.O3P": "CBMZ.O3P"
      },
      "description": "The column's species ARE the mechanism's: composing the 0-D reaction system with the column's [lev] tendencies lifts CBM-Z pointwise over the column (esm-spec 10.5, 10.7), and each species' D(.) is chemistry plus its column processes. CBMZColumn is systems[0], so its [lev] spelling survives the merge."
    },
    {
      "type": "coupling_import",
      "ref": "lib/chem170_join.esm",
      "bind": {
        "AerChem": "AerChem",
        "CBMZColumn": "CBMZColumn",
        "GasParticle": "GasParticle",
        "Host": "Host",
        "Join": "Join",
        "Nucleation": "Nucleation",
        "Ps": "Ps",
        "Rates": "Rates",
        "SecMove": "SecMove"
      },
      "description": "The join of the joint column: the sixteen mapped gases down in WRF's units, the density mapaer_tofrom_host forms cairclm from, ASTEM's and nucleation's gas exchange back up into the four exchanging gases' column tendencies, and every MOSAIC process's component tendency into Join.dr_dt. One copy, shared with couplings/eqatmchem_scm.esm."
    }
  ]
}
