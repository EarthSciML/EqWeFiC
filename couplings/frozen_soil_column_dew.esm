     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives NoahSoilMoisture.dsh2o_dt through the coupling."
    },
    "dsh2o_dt_phase_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives NoahFrozenSoil.dsh2o_dt_phase through the coupling."
    },
    "dsmc_dt_transport_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives NoahSoilMoisture.dsmc_dt through the coupling."
    },
    "phase_active_in": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives NoahFrozenSoil.phase_active through the coupling."
    },
    "supersaturation_active_in": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Receives NoahSoilMoisture.supersaturation_active through the coupling."
    },
    "dsh2o_dt_transport": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Liquid-water tendency from vertical transport alone: Richards' equation with the Clapp-Hornberger closures, the infiltration limiter and the evaporation sinks, evaluated at the assembly's column state."
    },
    "dsh2o_dt_phase": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Liquid-water tendency from the freeze/thaw phase change, qtot/(rho_w hlice dz) where the sink runs and zero where WRF's interval clamp holds the layer. Evaluated at the SAME column state as the transport, which is the whole point of this document."
    },
    "dsh2o_dt_total": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "THE COUPLING CLAIM: the sum, which is what a consumer integrating the soil column adds to its liquid water. WRF never forms it -- SMFLX advances the water and only then does HRT's sink act on what SMFLX has already moved -- so reproducing the total step is a claim about the two components TOGETHER that neither can make alone."
    },
    "dsmc_dt_total": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Total-water tendency. The phase change moves water between the liquid and the ice within a layer and does not change the total, so this is the transport tendency alone; asserting it against WRF's own smc step is an independent check that the split was made in the right place, because an error leaking transport into the phase term would pass the liquid claim and fail this one."
    },
    "dsice_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Soil-ice tendency, dsmc_dt_total - dsh2o_dt_total, which reduces identically to minus the phase rate. It is the quantity a heat-equation consumer needs, because the latent sink is proportional to it."
    },
    "phase_active": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Which layers the phase change actually runs in, decided at the ASSEMBLY's shared column state. Asserted at zero tolerance against the decision WRF made at its POST-SMFLX state: that the two agree is what licenses evaluating both processes at one instantaneous state, because the phase rate depends on the liquid water only through this discrete switch."
    },
    "supersaturation_active": {
     "type": "unknown",
     "units": "1",
     "description": "SSTEP's supersaturation redistribution indicator. It must be zero for WRF's total step to be the sum of two rates at all -- it is a post-step projection that no tendency can carry -- so this is a precondition of the claim rather than a result."
    }
   },
