    { "type": "variable_map", "from": "Sat.xl", "to": "SatAdj.xl_in", "transform": "param_to_var", "description": "start-of-sub-step xl into the saturation adjustment" },
    { "type": "variable_map", "from": "Sat.cpm", "to": "SatAdj.cpm_in", "transform": "param_to_var", "description": "start-of-sub-step cpm into the saturation adjustment" },

    { "type": "variable_map", "from": "Sat.xl", "to": "MicrophysicsColumn.xl_in", "transform": "param_to_var", "description": "expose Sat.xl" },
