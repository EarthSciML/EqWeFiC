    { "type": "variable_map", "from": "Sat.xl", "to": "Rescale.xl_in", "transform": "param_to_var", "description": "start-of-sub-step xl into the latent heating of the update" },
    { "type": "variable_map", "from": "Sat.cpm", "to": "Rescale.cpm_in", "transform": "param_to_var", "description": "start-of-sub-step cpm into the latent heating of the update" },
    { "type": "variable_map", "from": "Warm.praut_lim", "to": "Rescale.praut_in", "transform": "param_to_var", "description": "praut into the budget check" },
