    { "type": "variable_map", "from": "Cold.psaci_lim", "to": "MicrophysicsColumn.psaci_in", "transform": "param_to_var", "description": "expose Cold.psaci_lim" },
    { "type": "variable_map", "from": "Cold.pgaci_lim", "to": "MicrophysicsColumn.pgaci_in", "transform": "param_to_var", "description": "expose Cold.pgaci_lim" },
    { "type": "variable_map", "from": "Cold.psacr_lim", "to": "MicrophysicsColumn.psacr_in", "transform": "param_to_var", "description": "expose Cold.psacr_lim" },
    { "type": "variable_map", "from": "Cold.pgacr_lim", "to": "MicrophysicsColumn.pgacr_in", "transform": "param_to_var", "description": "expose Cold.pgacr_lim" },
    { "type": "variable_map", "from": "Cold.paacw", "to": "MicrophysicsColumn.paacw_in", "transform": "param_to_var", "description": "expose Cold.paacw" },
    { "type": "variable_map", "from": "IceDep.pidep_lim", "to": "MicrophysicsColumn.pidep_in", "transform": "param_to_var", "description": "expose IceDep.pidep_lim" },
    { "type": "variable_map", "from": "IceDep.psdep_lim", "to": "MicrophysicsColumn.psdep_in", "transform": "param_to_var", "description": "expose IceDep.psdep_lim" },
    { "type": "variable_map", "from": "IceDep.pgdep_lim", "to": "MicrophysicsColumn.pgdep_in", "transform": "param_to_var", "description": "expose IceDep.pgdep_lim" },
    { "type": "variable_map", "from": "IceDep.pigen_lim", "to": "MicrophysicsColumn.pigen_in", "transform": "param_to_var", "description": "expose IceDep.pigen_lim" },
    { "type": "variable_map", "from": "IceDep.psaut", "to": "MicrophysicsColumn.psaut_in", "transform": "param_to_var", "description": "expose IceDep.psaut" },
    { "type": "variable_map", "from": "IceDep.pgaut_lim", "to": "MicrophysicsColumn.pgaut_in", "transform": "param_to_var", "description": "expose IceDep.pgaut_lim" },
    { "type": "variable_map", "from": "Rescale.prevp_final", "to": "MicrophysicsColumn.prevp_final_in", "transform": "param_to_var", "description": "expose Rescale.prevp_final" },
    { "type": "variable_map", "from": "Rescale.piacr_final", "to": "MicrophysicsColumn.piacr_final_in", "transform": "param_to_var", "description": "expose Rescale.piacr_final" },
    { "type": "variable_map", "from": "Rescale.psacr_final", "to": "MicrophysicsColumn.psacr_final_in", "transform": "param_to_var", "description": "expose Rescale.psacr_final" },
    { "type": "variable_map", "from": "Rescale.pgacr_final", "to": "MicrophysicsColumn.pgacr_final_in", "transform": "param_to_var", "description": "expose Rescale.pgacr_final" },
    { "type": "variable_map", "from": "Rescale.psaci_final", "to": "MicrophysicsColumn.psaci_final_in", "transform": "param_to_var", "description": "expose Rescale.psaci_final" },
    { "type": "variable_map", "from": "Rescale.pidep_final", "to": "MicrophysicsColumn.pidep_final_in", "transform": "param_to_var", "description": "expose Rescale.pidep_final" },
