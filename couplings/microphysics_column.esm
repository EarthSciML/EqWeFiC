    { "type": "variable_map", "from": "Cold.paacw", "to": "Rescale.paacw_in", "transform": "param_to_var", "description": "paacw into the budget check" },
    { "type": "variable_map", "from": "IceDep.psdep_lim", "to": "Rescale.psdep_in", "transform": "param_to_var", "description": "psdep into the budget check" },
    { "type": "variable_map", "from": "IceDep.pgdep_lim", "to": "Rescale.pgdep_in", "transform": "param_to_var", "description": "pgdep into the budget check" },
    { "type": "variable_map", "from": "IceDep.pidep_lim", "to": "Rescale.pidep_in", "transform": "param_to_var", "description": "pidep into the budget check" },
