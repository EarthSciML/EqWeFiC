    { "type": "variable_map", "from": "Melt.qs_out", "to": "IceDep.sd.qs_in", "transform": "param_to_var", "description": "post-melting/freezing snow into the deposition size distributions" },
    { "type": "variable_map", "from": "Melt.qg_out", "to": "IceDep.sd.qg_in", "transform": "param_to_var", "description": "post-melting/freezing graupel into the deposition size distributions" },
    { "type": "variable_map", "from": "Sat.qsat_w", "to": "IceDep.qsat_w_in", "transform": "param_to_var", "description": "start-of-sub-step qsat over water into the deposition chain" },
    { "type": "variable_map", "from": "Sat.rh_w", "to": "IceDep.rh_w_in", "transform": "param_to_var", "description": "start-of-sub-step rh over water into the deposition chain" },
    { "type": "variable_map", "from": "Sat.qsat_i", "to": "IceDep.qsat_i_in", "transform": "param_to_var", "description": "start-of-sub-step qsat over ice into the deposition chain" },
    { "type": "variable_map", "from": "Sat.rh_i", "to": "IceDep.rh_i_in", "transform": "param_to_var", "description": "start-of-sub-step rh over ice into the deposition chain" },
    { "type": "variable_map", "from": "Sat.xl", "to": "IceDep.xl_in", "transform": "param_to_var", "description": "start-of-sub-step xl into the deposition chain" },
    { "type": "variable_map", "from": "Warm.prevp_lim", "to": "IceDep.prevp_in", "transform": "param_to_var", "description": "rain evaporation opens WSM6's sequential vapor budget" },

    { "type": "variable_map", "from": "Melt.T_out", "to": "Rescale.T_in", "transform": "param_to_var", "description": "rate-evaluation temperature into the budget check" },
    { "type": "variable_map", "from": "Melt.qc_out", "to": "Rescale.qc_in", "transform": "param_to_var", "description": "rate-evaluation cloud water into the budget check" },
    { "type": "variable_map", "from": "Melt.qi_out", "to": "Rescale.qi_in", "transform": "param_to_var", "description": "rate-evaluation cloud ice into the budget check" },
    { "type": "variable_map", "from": "Melt.qr_out", "to": "Rescale.qr_in", "transform": "param_to_var", "description": "rate-evaluation rain into the budget check" },
