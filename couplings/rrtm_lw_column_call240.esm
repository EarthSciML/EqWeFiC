     ],
     "description": "Longwave potential-temperature tendency (the RTHRATENLW increment)."
    },
    "glw_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Heat.glw through the coupling."
    },
    "glw": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Downward longwave flux at the surface (WRF GLW)."
    },
    "olr_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
