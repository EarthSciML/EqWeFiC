     ],
     "description": "Upward longwave flux at the RRTM levels (TOTUFLUX, level 1 = surface)."
    },
    "F_dn_in": {
     "type": "parameter",
     "units": "W/m^2",
     "shape": [
      "rlev"
     ],
     "default": 0.0,
     "description": "Receives Rtrn.F_dn through the coupling."
    },
