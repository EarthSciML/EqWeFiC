    "htr_in": {
     "type": "parameter",
     "units": "K/day",
     "shape": [
      "rlay"
     ],
     "default": 0.0,
     "description": "Receives Rtrn.htr through the coupling."
    },
    "htr": {
     "type": "unknown",
     "units": "K/day",
     "shape": [
      "rlay"
     ],
     "description": "RTRN heating rate of each RRTM layer (HTR(L-1) is layer L)."
    },
    "rtrn_glw_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
