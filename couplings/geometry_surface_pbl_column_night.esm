     "units": "Pa",
     "description": "p_top, coupled into the column geometry."
    },
    "p1": {
     "type": "unknown",
     "units": "Pa",
     "description": "The layer pressure of the lowest model layer, taken from the column geometry (Geo.p at the lowest layer) instead of a prescribed dump value; coupled into the surface layer and, for p1 and t1, the slab."
    },
    "t1": {
     "type": "unknown",
     "units": "K",
     "description": "The temperature of the lowest model layer, taken from the column geometry (Geo.T at the lowest layer) instead of a prescribed dump value; coupled into the surface layer and, for p1 and t1, the slab."
    },
    "dz1": {
     "type": "unknown",
     "units": "m",
     "description": "The thickness of the lowest model layer, taken from the column geometry (Geo.dz8w at the lowest layer) instead of a prescribed dump value; coupled into the surface layer and, for p1 and t1, the slab."
    },
    "gsw0": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Prescribed downward shortwave flux at the ground (the WRF suite dump value; radiation is not mounted here)."
    },
    "gsw": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "The downward shortwave flux at the ground, coupled into the slab."
    },
    "glw0": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Prescribed downward longwave flux at the ground (the WRF suite dump value; radiation is not mounted here)."
    },
    "glw": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "The downward longwave flux at the ground, coupled into the slab."
    },
    "rthraten": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "K/s",
     "description": "Radiative potential-temperature tendency (WRF rthraten = LW + SW), prescribed from the WRF suite dump because radiation is not mounted here; coupled into YSU's rthraten_in."
    }
