{
 "esm": "1.1.0",
 "metadata": {
  "name": "GeometrySurfacePBLColumn",
  "description": "Surface layer (SfclayRev), slab land surface and YSU driven by the column geometry (stable night, step 900): a focused coupling demonstrating the geometry-input path of the surface and boundary-layer physics. WRFColumnGeometry feeds YSU's additive coupling-target parameters p_in, p_int_in (from the hydrostatic interface pressure p_hyd_w), exner_in and ze_in through the hand-authored mount-edge library couplings/tests/geophys_couple_ysu_inputs.esm, and feeds the surface layer's and slab's plain lowest-layer parameters (p1, t1, dz1, p_air, t_air) by indexing the geometry column in this document, so neither SfclayRev nor the slab needed new parameters. YSU's own state (theta, u, v, q) still comes from the dumped library, imported with `only` so its dumped geometry profiles are not used. Not the full EqWeather single-column model: how the physics and dynamics assemblies compose is under separate design review.",
  "license": "MIT",
  "tags": [
   "assembly",
   "coupling",
   "EqWeather",
   "single-column",
   "geometry"
  ]
 },
 "metaparameters": {
  "NLEV": {
   "type": "integer",
   "default": 59,
   "description": "Number of model layers (WRF kte), bound into every mount edge so all column schemes resolve their grid at the same size; 59 is the em_scm_xy reference column. The leaves' own index sets merge into this document's registry at the mount edge (esm-spec 4.7), so the document declares no index_sets of its own."
  },
  "NSOIL": {
   "type": "integer",
   "default": 4,
   "description": "Number of PROGNOSTIC soil layers of the mounted slab (WRF num_soil_layers - 1 = 4; the deepest WRF layer is the fixed reservoir T_deep). Bound into the Lsm mount edge, whose column axis is renamed soil/soil_nodes so it does not collide with the 59-layer atmospheric lev (esm-spec 4.7 mount-edge index_set_rename, EarthSciAST #213)."
  }
 },
 "models": {
  "Geo": {
   "ref": "../components/atmospheric_dynamics/wrf_arw/column_geometry.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "../components/atmospheric_dynamics/wrf_arw/tests/geometry_step900_inputs.esm"
    }
   ]
  },
  "Sfc": {
   "ref": "../components/atmospheric_dynamics/sfclayrev/sfclayrev.esm"
  },
  "Lsm": {
   "ref": "../components/land_surface/slab/slab.esm",
   "bindings": {
    "NLEV": "NSOIL"
   },
   "index_set_rename": {
    "lev": "soil",
    "lev_nodes": "soil_nodes"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/scm_step900_soil_inputs.esm"
    }
   ]
  },
  "Pbl": {
   "ref": "../components/atmospheric_dynamics/ysu/ysu.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/physics_step900_atmos_inputs.esm",
     "only": [
      "input_theta",
      "input_u",
      "input_v",
      "input_qv",
      "input_qc",
      "input_qi"
     ]
    },
    {
     "ref": "./tests/geophys_couple_ysu_inputs.esm"
    },
    {
     "ref": "./tests/physics_couple_pbl_inputs.esm"
    }
   ]
  },
  "GeometrySurfacePBLColumn": {
