     "type": "unknown",
     "units": "K/s",
     "description": "The coupled slab's instantaneous skin tendency, named for comparison with WRF's finite-step (tsk_out - tsk)/dt, which sub-steps the soil and re-evaluates the fluxes at the updated TSLB(1) (FORTRAN_BUGS N12: the two are 0.5-11 % apart)."
    },
    "mu_p0": {
     "type": "parameter",
     "units": "Pa",
     "default": 0.0,
     "description": "Prescribed mu_p of the column geometry (test override)."
    },
    "mu_p": {
     "type": "unknown",
     "units": "Pa",
     "description": "mu_p, coupled into the column geometry."
    },
    "mu_b0": {
     "type": "parameter",
     "units": "Pa",
     "default": 0.0,
     "description": "Prescribed mu_b of the column geometry (test override)."
    },
    "mu_b": {
