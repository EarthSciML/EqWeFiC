        "T": {
          "type": "parameter",
          "units": "K",
          "default": 298.0,
          "description": "Temperature of each layer (KPP TEMP = t_phy).",
          "shape": [
            "lev"
          ]
        },
        "M_air": {
          "type": "parameter",
          "units": "molec/cm^3",
          "default": 2.46e+19,
          "description": "Air number density KPP's rate laws read, C_M = dens2con_a rho formed in default real (chem_driver.F); kept beside conv because WRF rounds it to binary32 and the rate laws see that rounding.",
          "shape": [
            "lev"
          ]
        },
        "H2O": {
          "type": "parameter",
          "units": "molec/cm^3",
          "default": 0.0,
          "description": "Water vapour number density, KPP fixed species FIX(1).",
          "shape": [
            "lev"
          ]
        },
        "M_fix": {
          "type": "parameter",
          "units": "molec/cm^3",
          "default": 2.46e+19,
          "description": "Third body number density, KPP fixed species FIX(2).",
          "shape": [
            "lev"
          ]
        },
        "rho": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1.2,
          "description": "Moist air density rho_phy: the KPP interface's conv, the emissions and wet scavenging.",
          "shape": [
            "lev"
          ]
        },
        "p": {
          "type": "parameter",
          "units": "Pa",
          "default": 100000.0,
          "description": "Pressure p_phy (biogenic emissions).",
          "shape": [
            "lev"
          ]
        },
        "alt": {
          "type": "parameter",
          "units": "m^3/kg",
          "default": 0.83,
          "description": "Inverse density alt (MOSAIC aerosol emissions).",
          "shape": [
            "lev"
          ]
        },
        "ze": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "Layer-face heights z_at_w (the column's ground at 0): emissions_driver's and wetdep_ls's dz8w, dry_dep_driver's zzfull (vertmx's grid) and wesely_driver's z1 are all this one array (checked equal on every dumped step).",
          "shape": [
            "lev_nodes"
          ]
        },
        "qc": {
          "type": "parameter",
          "units": "kg/kg",
          "default": 0.0,
          "description": "Cloud water mixing ratio (wet scavenging).",
          "shape": [
            "lev"
          ]
        },
        "w": {
          "type": "parameter",
          "units": "m/s",
          "default": 0.0,
          "description": "Vertical velocity (wet scavenging).",
          "shape": [
            "lev"
          ]
        },
        "rain": {
          "type": "parameter",
          "units": "kg/m^2",
          "default": 0.0,
          "description": "Grid-scale rain over the step (wet scavenging)."
        },
        "dt": {
          "type": "parameter",
          "units": "s",
          "default": 60.0,
          "description": "Chemistry time step. A parameter of wetdep_ls's tendency (an in-place removal over dt, exposed as increment/dt), not an integrator step."
        },
        "gsw": {
          "type": "parameter",
          "units": "W/m^2",
          "default": 0.0,
          "description": "Net surface shortwave: Gunther's light and Wesely's rad = gsw."
        },
        "lu": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "description": "USGS land-use category of the column (ivgtyp)."
        },
        "julday": {
          "type": "parameter",
          "units": "1",
          "default": 170.0,
          "description": "Day of year."
        },
        "emiss_inpt_opt": {
          "type": "parameter",
          "units": "1",
          "default": 101.0,
          "description": "Anthropogenic input variety (1 RADM2-variety, 101 CBM-Z variety)."
        },
        "volumcen": {
          "type": "parameter",
          "units": "cm^3",
          "default": 1.0,
          "description": "MOSAIC section centre volumes (aerosol emissions).",
          "shape": [
            "bin"
          ]
        },
        "T_sfc": {
          "type": "parameter",
          "units": "K",
          "default": 298.0,
          "description": "Skin temperature tsk, Wesely's ta."
        },
        "rh": {
          "type": "parameter",
          "units": "%",
          "default": 50.0,
          "description": "Wesely's rhchem (wesely_driver forms it from layer-1 qv, T, p)."
        },
        "wetflag": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Dew flag of wesely_driver (rhchem >= 95)."
        },
        "rainflag": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Rain flag of wesely_driver (layer-1 qr > 1e-18 or convective rain)."
        },
        "iland": {
          "type": "parameter",
          "units": "1",
          "default": 2.0,
          "description": "Wesely land-use class (ivgtyp mapped by wesely_driver)."
        },
        "iseason": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
