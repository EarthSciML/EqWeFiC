        },
        "sulf_scavenged": {
          "type": "unknown",
          "units": "molec/cm^3/s",
          "shape": [
            "lev"
          ],
          "description": "wetdep_ls's removal of sulf (entry 1 of its species axis, bare ppmv per second) in the column's units."
        }
