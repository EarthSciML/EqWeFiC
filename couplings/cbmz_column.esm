            "lev"
          ],
          "description": "Number density of one ppmv of the layer, conv = 1e-6 dens2con_a rho, formed in double precision exactly as the generated KPP interface forms it (module_kpp_cbmz_mosaic_interface.F:241): var = conv chem. Every WRF process other than KPP works in ppmv; this is the single place the two units meet."
        },
        "n_air": {
          "type": "unknown",
          "units": "molec/cm^3",
          "shape": [
            "lev"
          ],
          "description": "Air number density dens2con_a rho in double precision, the number density a mole fraction of 1 is."
        },
        "dz1": {
          "type": "unknown",
          "units": "m",
          "description": "Thickness of the lowest layer, wesely_driver's z1."
        },
        "sfc": {
          "type": "unknown",
          "units": "1/m",
          "shape": [
            "lev"
          ],
          "description": "1/z1 in the lowest layer and zero above: the lower boundary of vertmx with the mixing switched off, through which a deposition velocity removes a gas from the layer that touches the ground."
        },
        "highnh3": {
          "type": "unknown",
          "units": "1",
          "description": "wesely_driver's high-ammonia flag, chem(nh3) > 2 chem(so2) in the lowest layer -- the one Wesely input that reads the chemical state, so it is formed here from the column's own NH3 and SO2 (the ratio is the same in molec/cm^3 as in ppmv)."
        },
        "gas_slot": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "slot"
          ],
          "description": "The gas slot numbers 1..65 placed on Wesely's (renamed) species axis, so that its Rc and velocity are evaluated for every slot of chem_opt 170 and the column can read any species' velocity by its slot."
        },
        "sulf_c": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "spc"
          ],
          "description": "The one gas wetdep_ls scavenges (sulf, H2SO4) on wetdep_ls's species axis of length 1, as the bare number of ppmv WRF hands it: wetdep_ls compares its concentrations with bare thresholds in that unit and so declares them dimensionless (wetdep_ls.esm), and the column divides by one_ppmv to meet that declaration."
        },
        "one_ppmv": {
          "type": "parameter",
          "units": "ppmv",
          "default": 1.0,
          "description": "One ppmv: the unit bridge to wetdep_ls, whose concentrations are bare numbers of ppmv (its gates compare them with bare thresholds), so sulf goes in as H2SO4/(conv one_ppmv) and its removal comes back as conv one_ppmv dc_dt. Physically 1; it only carries the unit."
        },
        "aerosol_H2SO4": {
          "type": "parameter",
          "units": "molec/(cm^3*s)",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "Exchange of H2SO4 (chem sulf) with the aerosol: MOSAIC's gas-particle transfer and, for H2SO4 and NH3, new-particle formation, as a tendency of the gas. Zero in this gas-only column; couplings/chem170_column.esm supplies it from MOSAIC (its gas-particle and aerosol-chemistry columns, mapped back through mapaer_tofrom_host's units)."
        },
        "aerosol_HNO3": {
          "type": "parameter",
          "units": "molec/(cm^3*s)",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "Exchange of HNO3 (chem hno3) with the aerosol: MOSAIC's gas-particle transfer and, for H2SO4 and NH3, new-particle formation, as a tendency of the gas. Zero in this gas-only column; couplings/chem170_column.esm supplies it from MOSAIC (its gas-particle and aerosol-chemistry columns, mapped back through mapaer_tofrom_host's units)."
        },
        "aerosol_HCl": {
          "type": "parameter",
          "units": "molec/(cm^3*s)",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "Exchange of HCl (chem hcl) with the aerosol: MOSAIC's gas-particle transfer and, for H2SO4 and NH3, new-particle formation, as a tendency of the gas. Zero in this gas-only column; couplings/chem170_column.esm supplies it from MOSAIC (its gas-particle and aerosol-chemistry columns, mapped back through mapaer_tofrom_host's units)."
        },
        "aerosol_NH3": {
          "type": "parameter",
          "units": "molec/(cm^3*s)",
          "shape": [
            "lev"
          ],
          "default": 0.0,
