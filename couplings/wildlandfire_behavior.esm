  },
  {
   "type": "variable_map",
   "from": "WildlandFireBehavior.j_coupled",
   "to": "LevelSet.j_coupled",
   "transform": "param_to_var",
   "description": "which cell of the level set the coupled ROS drives"
  },
  {
   "type": "variable_map",
   "from": "WildlandFireBehavior.ts",
   "to": "Ign.ts",
   "transform": "param_to_var",
   "description": "step start time"
  },
  {
   "type": "variable_map",
   "from": "WildlandFireBehavior.lfn_in",
   "to": "Ign.lfn_in",
   "transform": "param_to_var",
   "description": "level set before propagation"
  },
  {
   "type": "variable_map",
   "from": "WildlandFireBehavior.lfn_out",
   "to": "Ign.lfn_out",
   "transform": "param_to_var",
   "description": "level set after propagation"
  },
  {
   "type": "variable_map",
   "from": "WildlandFireBehavior.tign_before",
   "to": "Ign.tign_before",
   "transform": "param_to_var",
   "description": "ignition time held before this step"
  },
  {
   "type": "variable_map",
   "from": "Fuel.fuel_time",
   "to": "FuelFrac.fuel_time",
   "transform": "param_to_var",
   "description": "fuel table -> fuel fraction: burn e-folding time"
  },
  {
   "type": "variable_map",
   "from": "WildlandFireBehavior.time_now",
   "to": "FuelFrac.time_now",
   "transform": "param_to_var",
   "description": "evaluation time of the subcell exponentials"
