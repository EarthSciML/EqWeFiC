{
 "esm": "1.0.0",
 "metadata": {
  "name": "SurfaceSoilColumn",
  "description": "Surface layer + land surface subassembly of the EqWeather reference suite: the revised MM5 surface layer (components/atmospheric_dynamics/sfclayrev) and the slab land-surface scheme (components/land_surface/slab) mounted by reference as top-level systems and coupled in the WRF order with variable_map/param_to_var edges: the assembly's shared scalar state feeds both, the surface layer's exchange coefficients FLHC/FLQC drive the slab's energy balance, and every output is exposed back as a SurfaceSoilColumn variable. The soil column (interface depths, prognostic soil temperatures) enters the slab through its input_<x> rewrite targets via a library injected at the mount edge (esm-spec 9.7.10), so one document holds one regime. The companion surface_pbl_column.esm assembles the surface layer with the YSU boundary layer; the two cannot be one document because the slab and the atmosphere both use the column_nonuniform_1d axis 'lev' at different sizes and esm index sets are document-scoped (PLAN.md gap (n)). In the instantaneous form the slab's hfx equals the surface layer's (both are FLHC (theta_g - theta_1) at the same skin temperature); WRF's finite step differs because SLAB1D re-evaluates the fluxes at the updated TSLB(1) from its second sub-step (FORTRAN_BUGS N12). KNOWN BINDING LIMITATIONS (Rust CLI, 2026-09-06): the mounted components' own inline tests are re-run inside this document under the coupling and fail there; run this file with `esm test --model SurfaceSoilColumn`.",
  "license": "MIT",
  "tags": [
   "wrf",
   "eqweather",
   "assembly",
   "surface-layer",
   "land-surface",
   "column"
  ]
 },
 "metaparameters": {
  "NLEV": {
   "type": "integer",
   "default": 4,
   "description": "Number of prognostic soil layers of the mounted slab (WRF num_soil_layers - 1), bound at the Lsm mount edge."
  }
 },
 "index_sets": {
  "secant_steps": {
   "kind": "interval",
   "size": 33
  }
 },
 "models": {
  "Sfc": {
   "ref": "../components/atmospheric_dynamics/sfclayrev/sfclayrev.esm"
  },
  "Lsm": {
   "ref": "../components/land_surface/slab/slab.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/scm_step60_soil_inputs.esm"
    }
   ]
  },
  "SurfaceSoilColumn": {
