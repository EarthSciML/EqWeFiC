     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "Soil-layer temperature tendencies of the mounted slab."
    },
    "dTsk_dt_wrf_step": {
     "type": "unknown",
     "units": "K/s",
     "description": "The slab's instantaneous skin tendency, for comparison with WRF's finite-step (tsk_out - tsk)/dt which sub-steps the soil and re-evaluates the fluxes at the updated TSLB(1) (FORTRAN_BUGS N12: 0.5-11 % apart)."
    }
   },
