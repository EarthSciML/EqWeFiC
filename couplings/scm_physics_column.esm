   "from": "ScmPhysicsColumn.qv1",
   "to": "Lsm.qv_air",
   "transform": "param_to_var",
   "description": "lowest-layer water-vapour mixing ratio into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.p1",
   "to": "Lsm.p_air",
   "transform": "param_to_var",
   "description": "lowest-layer pressure into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.psfc",
   "to": "Lsm.psfc",
   "transform": "param_to_var",
   "description": "surface pressure into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.tsk",
   "to": "Lsm.tsk",
   "transform": "param_to_var",
   "description": "skin temperature entering the step into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.emiss",
   "to": "Lsm.emiss",
   "transform": "param_to_var",
   "description": "surface emissivity into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.mavail",
   "to": "Lsm.mavail",
   "transform": "param_to_var",
   "description": "surface moisture availability into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.xland",
   "to": "Lsm.xland",
   "transform": "param_to_var",
   "description": "land/water mask into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.tmn",
   "to": "Lsm.tmn",
   "transform": "param_to_var",
   "description": "prescribed tmn into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.thc",
   "to": "Lsm.thc",
   "transform": "param_to_var",
   "description": "prescribed thc into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.snowc",
   "to": "Lsm.snowc",
   "transform": "param_to_var",
   "description": "prescribed snowc into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.radiation",
   "to": "Lsm.radiation",
   "transform": "param_to_var",
   "description": "prescribed radiation into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.ifsnow",
   "to": "Lsm.ifsnow",
   "transform": "param_to_var",
   "description": "prescribed ifsnow into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.T_deep",
   "to": "Lsm.T_deep",
   "transform": "param_to_var",
   "description": "prescribed T_deep into the land surface"
  },
  {
   "type": "variable_map",
   "from": "ScmPhysicsColumn.z_deep",
   "to": "Lsm.z_deep",
   "transform": "param_to_var",
   "description": "prescribed z_deep into the land surface"
  },
  {
   "type": "coupling_import",
   "ref": "lib/dudhia_slab.esm",
   "bind": {
    "Sw": "Sw",
    "Lsm": "Lsm"
   },
   "description": "Dudhia -> slab: net surface shortwave gsw."
  },
  {
   "type": "coupling_import",
   "ref": "lib/rrtm_lw_slab.esm",
   "bind": {
    "Heat": "Heat",
    "Lsm": "Lsm"
   },
   "description": "RRTM -> slab: downward surface longwave glw."
  },
  {
   "type": "coupling_import",
   "ref": "lib/sfclayrev_slab.esm",
   "bind": {
    "Sfc": "Sfc",
    "Lsm": "Lsm"
   },
   "description": "sfclayrev -> slab: the flhc/flqc exchange coefficients."
  },
  {
   "type": "coupling_import",
   "ref": "lib/slab_ysu.esm",
   "bind": {
    "Lsm": "Lsm",
    "Pbl": "Pbl"
   },
   "description": "slab -> YSU: the land-surface hfx/qfx, which WRF's sfclayrev -> slab -> YSU order makes the values YSU sees."
  },
  {
   "type": "variable_map",
   "from": "Lsm.hfx",
   "to": "ScmPhysicsColumn.lsm_hfx_in",
   "transform": "param_to_var",
   "description": "expose Lsm.hfx"
  },
  {
   "type": "variable_map",
   "from": "Lsm.qfx",
   "to": "ScmPhysicsColumn.lsm_qfx_in",
   "transform": "param_to_var",
   "description": "expose Lsm.qfx"
  },
  {
   "type": "variable_map",
   "from": "Lsm.lh",
   "to": "ScmPhysicsColumn.lsm_lh_in",
   "transform": "param_to_var",
   "description": "expose Lsm.lh"
  },
  {
   "type": "variable_map",
   "from": "Lsm.qsfc",
   "to": "ScmPhysicsColumn.lsm_qsfc_in",
   "transform": "param_to_var",
   "description": "expose Lsm.qsfc"
  },
  {
   "type": "variable_map",
   "from": "Lsm.capg",
   "to": "ScmPhysicsColumn.lsm_capg_in",
   "transform": "param_to_var",
   "description": "expose Lsm.capg"
  },
  {
   "type": "variable_map",
   "from": "Lsm.rnet",
   "to": "ScmPhysicsColumn.lsm_rnet_in",
   "transform": "param_to_var",
   "description": "expose Lsm.rnet"
  },
  {
   "type": "variable_map",
   "from": "Lsm.upflux",
   "to": "ScmPhysicsColumn.lsm_upflux_in",
   "transform": "param_to_var",
   "description": "expose Lsm.upflux"
  },
  {
   "type": "variable_map",
   "from": "Lsm.xinet",
   "to": "ScmPhysicsColumn.lsm_xinet_in",
   "transform": "param_to_var",
   "description": "expose Lsm.xinet"
  },
  {
   "type": "variable_map",
   "from": "Lsm.hm",
   "to": "ScmPhysicsColumn.lsm_hm_in",
   "transform": "param_to_var",
   "description": "expose Lsm.hm"
  },
  {
   "type": "variable_map",
   "from": "Lsm.qs",
   "to": "ScmPhysicsColumn.lsm_qs_in",
   "transform": "param_to_var",
   "description": "expose Lsm.qs"
  },
  {
   "type": "variable_map",
   "from": "Lsm.G_sfc",
   "to": "ScmPhysicsColumn.lsm_G_sfc_in",
   "transform": "param_to_var",
   "description": "expose Lsm.G_sfc"
  },
  {
   "type": "variable_map",
   "from": "Lsm.theta_air",
   "to": "ScmPhysicsColumn.lsm_theta_air_in",
   "transform": "param_to_var",
   "description": "expose Lsm.theta_air"
  },
  {
   "type": "variable_map",
   "from": "Lsm.land",
   "to": "ScmPhysicsColumn.lsm_land_in",
   "transform": "param_to_var",
   "description": "expose Lsm.land"
  },
  {
   "type": "variable_map",
   "from": "Lsm.dTsk_dt",
   "to": "ScmPhysicsColumn.lsm_dTsk_dt_in",
   "transform": "param_to_var",
   "description": "expose Lsm.dTsk_dt"
  },
  {
   "type": "variable_map",
   "from": "Lsm.dTs_dt",
   "to": "ScmPhysicsColumn.lsm_dTs_dt_in",
   "transform": "param_to_var",
   "description": "expose Lsm.dTs_dt"
  }
 ]
}
