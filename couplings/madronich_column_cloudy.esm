{
  "esm": "1.1.0",
  "metadata": {
    "name": "MadronichColumnCloudy",
    "description": "The Madronich photolysis column on a CLOUDY grid, closed: the cloud-refined level insertion padded to a fixed size, the optical depths and spherical geometry, the delta-Eddington two-stream solve, and the wavelength integral that produces the 21 photolysis frequencies RADM2 reads.\n\nThis is the cloudy counterpart of couplings/madronich_column.esm and it exists because subgrid makes the radiative-transfer grid SIZE depend on the cloud field (70, 72, 77 and 78 at the four dumped daytime calls), which a fixed index set cannot express. The resolution -- chosen by the user after the trade-off was measured, see data/eqwefic/notes/cloudy_column_design.md -- is to run on a FIXED grid of NRT = 131 levels and pad the unused ones with zero-thickness duplicates of the top.\n\nTHE PADDING IS NOT AN APPROXIMATION, but it is also not bit-identical, and the precise statement lives in components/gaschem/madronich/cloud_grid.esm. In short: padded layers carry WRF's 1e-36 floor, not tau = 0, and sphers's slant ratio is 0/0 on a zero-thickness layer, which needs a guard with no Fortran counterpart; measured on all four dumped columns the padded solve equals the unpadded one to 1.8e-13 on fluxes of order one, and the guard's value is immaterial (0 and the true secant limit agree to 3e-15).\n\nEverything is computed from the 70-interface input column. That includes WRF's air-density interpolation onto inserted levels, which divides by a SUM of heights where a difference belongs and is therefore wrong by up to 8.9 percent at levels that coincide exactly with model interfaces (FORTRAN_BUGS B11). It is reproduced rather than corrected, because the purpose here is to match WRF; it biases the pressure-quenched channels and j_hcocho most of all.\n\nThe tolerance is 2e-3 and that is a measurement, not a preference: on a cloudy column this scheme's single-precision solve is only self-determined to about 5.7e-4 in the j-values, which is larger than the disagreement here. The clear column is held to 1e-3."
  },
  "metaparameters": {
    "NRT": {
      "type": "integer",
      "default": 131,
      "description": "Padded radiative-transfer grid size; the maximum this 60-model-level configuration can need."
    },
    "NLEV": {
      "type": "integer",
      "default": 130,
      "description": "Padded layer count, NRT - 1."
    },
    "NBIN": {
      "type": "integer",
      "default": 101,
      "description": "Active wavelength bins, 101."
    },
    "NJ": {
      "type": "integer",
      "default": 21,
      "description": "Photolysis channels RADM2 reads."
    }
  },
  "index_sets": {
    "lev": {
      "kind": "interval",
      "size": "NLEV"
    },
    "lev_nodes": {
      "kind": "interval",
      "size": {
        "op": "+",
        "args": [
          "NLEV",
          1
        ]
      }
    },
    "wlbin": {
      "kind": "interval",
      "size": "NBIN"
    },
    "jrate": {
      "kind": "interval",
      "size": "NJ"
    }
  },
  "models": {
    "Cg": {
      "ref": "../components/gaschem/madronich/cloud_grid.esm",
      "bindings": {
        "NRT": "NRT"
      }
    },
    "Od": {
      "ref": "../components/gaschem/madronich/optical_depth.esm",
      "bindings": {
        "NLEV": "NLEV",
        "NBIN": "NBIN"
      }
    },
    "Ts": {
      "ref": "../components/gaschem/madronich/two_stream.esm",
      "bindings": {
        "NLEV": "NLEV",
        "NBIN": "NBIN"
      }
    },
    "MadronichColumnCloudy": {
      "variables": {
        "fldir_in": {
          "type": "parameter",
          "shape": [
            "lev_nodes",
            "wlbin"
          ],
          "units": "1",
          "default": 0.0,
          "description": "Coupling target: direct beam from MadronichOpticalDepth, on the PADDED grid."
        },
        "fldn_in": {
          "type": "parameter",
          "shape": [
            "lev_nodes",
            "wlbin"
          ],
          "units": "1",
          "default": 0.0,
          "description": "Coupling target: down-welling diffuse from MadronichTwoStream."
        },
        "flup_in": {
          "type": "parameter",
          "shape": [
            "lev_nodes",
            "wlbin"
          ],
          "units": "1",
          "default": 0.0,
          "description": "Coupling target: up-welling diffuse from MadronichTwoStream."
        },
        "sigma_qy": {
          "type": "parameter",
          "shape": [
            "jrate",
            "wlbin"
          ],
          "units": "cm^2",
          "default": 0.0,
          "description": "Cross section times quantum yield for the 21 RADM2 channels at this level, evaluated at the RADIATIVE-TRANSFER grid's temperature and air density (zt_rt, zair_rt) -- NOT the model's. On a cloudy column those differ: zair is off by up to 8.9 percent through FORTRAN_BUGS B11, and using the model value instead is wrong by up to 8 percent in the pressure-quenched channels."
        },
        "jlev": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "Which RADIATIVE-TRANSFER level to evaluate at. On a cloudy column this is not the model level index: every model interface is still present in the RT grid, but with inserted levels between them."
        },
        "actinic": {
          "type": "unknown",
          "shape": [
            "wlbin"
          ],
          "units": "cm^-2 s^-1",
          "description": "Actinic flux per bin at that level."
        },
        "j": {
          "type": "unknown",
          "shape": [
            "jrate"
          ],
          "units": "1/s",
          "description": "The 21 photolysis frequencies RADM2 reads."
        }
      },
      "equations": [
