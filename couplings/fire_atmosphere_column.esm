{
 "esm": "1.0.0",
 "metadata": {
  "name": "FireAtmosphereColumn",
  "description": "Fire -> atmosphere coupling chain of NCAR fire_behavior within WRF for one atmosphere column: the heat and moisture fluxes of the strongest fire cell under the column are computed by FireHeatFlux (EarthSciModels wildland_fire/level_set/fire_heat_flux.esm, algebraically fire_behavior's Calc_flux) from its fuel consumption rate, load and moisture, fed by a document-level coupling into FireFluxToAtmosphereWRFFire, which averages them with the other fire cells' fluxes onto the atmosphere cell and distributes the result over the column as the theta and qv tendencies (Provide_atm_feedback -> Fire_tendency). Pattern: top-level ref mounts coupled by variable_map param_to_var; the other 15 fire cells' fluxes and the column state enter FireFluxToAtmosphereWRFFire through its component test library (frame5_cfbm regime). Regime: test7 step 10 (t = 5 s), atmosphere cell (6,16) of the 19 x 19 x 44 WRF column of test7/wrf.nc frame 5, fire cell (21,62) (block index 5). Reference: real32 fire_behavior (standalone dump + feedback-driver replay), rel 1e-5. Run with `./esm test --model FireAtmosphereColumn couplings/fire_atmosphere_column.esm` (mounted components' inline tests re-run under the coupling, EarthSciAST issue #198).",
  "license": "MIT",
  "tags": [
   "assembly",
   "coupling",
   "wildland_fire",
   "fire_behavior"
  ],
  "references": [
   {
    "citation": "NCAR fire_behavior fork ctessum-claude/fire_behavior@8d519c6 (coupling dumps); test7 standalone run (fire_flux dump, step 10) and the EarthSciML feedback driver on test7/wrf.nc frame 5."
   }
  ]
 },
 "metaparameters": {
  "NLEV": {
   "type": "integer",
   "default": 44,
   "description": "Atmosphere layers of the test7 column (WRF kte = 44); bound into the mount edge of FireFluxToAtmosphereWRFFire."
  },
  "NSUB": {
   "type": "integer",
   "default": 16,
   "description": "Fire cells per atmosphere cell (sr_x sr_y = 16)."
  }
 },
 "index_sets": {
  "lev": {
   "kind": "interval",
   "size": "NLEV"
  },
  "lev_nodes": {
   "kind": "interval",
   "size": {
    "op": "+",
    "args": [
     "NLEV",
     1
    ]
   }
  },
  "subcell": {
   "kind": "interval",
   "size": "NSUB"
  }
 },
 "models": {
  "HeatFlux": {
   "ref": "../components/wildland_fire/level_set/fire_heat_flux.esm"
  },
  "Flux": {
   "ref": "../components/wildland_fire/fire_behavior/fire_flux_to_atmosphere_wrffire.esm",
   "bindings": {
    "NLEV": "NLEV",
    "NSUB": "NSUB"
   },
   "expression_template_imports": [
    {
     "ref": "../components/wildland_fire/fire_behavior/tests/frame5_cfbm_fluxes_col_6_16_inputs.esm"
    }
   ]
  },
  "FireAtmosphereColumn": {
   "variables": {
    "fuel_burn_rate0": {
     "type": "parameter",
     "units": "1/s",
     "default": 0.09015941619873047,
     "description": "Prescribed: fuel consumption rate of the coupled fire cell, fuel_frac_burnt_dt/dt of the fire_flux dump"
    },
    "w_l0": {
     "type": "parameter",
     "units": "kg/m^2",
     "default": 0.16599999368190765,
     "description": "Prescribed: fuel load of the coupled fire cell (fuel_load_g)"
    },
    "M_f0": {
     "type": "parameter",
     "units": "1",
     "default": 0.07999999821186066,
     "description": "Prescribed: fuel moisture of the coupled fire cell (fmc_g)"
    },
    "h_fuel0": {
     "type": "parameter",
     "units": "J/kg",
     "default": 17433000.0,
     "description": "Prescribed: combustion heat (cmbcnst)"
    },
    "L_water0": {
     "type": "parameter",
     "units": "J/kg",
     "default": 2500000.0,
     "description": "Prescribed: latent heat of vaporisation (xlv)"
    },
    "water_ratio0": {
     "type": "parameter",
     "units": "1",
     "default": 0.5600000023841858,
     "description": "Prescribed: water mass fraction of cellulose combustion (0.56)"
    },
    "s_coupled0": {
     "type": "parameter",
     "units": "1",
     "default": 5.0,
     "description": "Prescribed: block index (Fortran order, 1-based) of the coupled fire cell"
    },
    "mu0": {
     "type": "parameter",
     "units": "Pa",
     "default": 79500.8203125,
     "description": "Prescribed: dry air mass of the column (WRF mut)"
    },
    "fuel_burn_rate": {
     "type": "unknown",
     "units": "1/s",
     "description": "Coupling source for HeatFlux.fuel_burn_rate."
    },
    "w_l": {
     "type": "unknown",
     "units": "kg/m^2",
     "description": "Coupling source for HeatFlux.w_l."
    },
    "M_f": {
     "type": "unknown",
     "units": "1",
     "description": "Coupling source for HeatFlux.M_f."
    },
    "h_fuel": {
     "type": "unknown",
     "units": "J/kg",
     "description": "Coupling source for HeatFlux.h_fuel."
    },
    "L_water": {
     "type": "unknown",
     "units": "J/kg",
     "description": "Coupling source for HeatFlux.L_water."
    },
    "water_ratio": {
     "type": "unknown",
     "units": "1",
     "description": "Coupling source for HeatFlux.water_combustion_ratio."
    },
    "s_coupled": {
     "type": "unknown",
     "units": "1",
     "description": "Coupling source for Flux.s_coupled."
    },
    "mu": {
     "type": "unknown",
     "units": "Pa",
     "description": "Coupling source for Flux.mu."
    },
    "phi_h_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives HeatFlux.phi_h through the coupling."
    },
    "phi_q_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives HeatFlux.phi_q through the coupling."
    },
    "grnhfx_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Flux.grnhfx."
    },
    "grnqfx_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Flux.grnqfx."
    },
    "rthfrten_in": {
     "type": "parameter",
     "units": "Pa*K/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Flux.rthfrten_wrf."
    },
    "rqvfrten_in": {
     "type": "parameter",
     "units": "Pa/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Flux.rqvfrten_wrf."
    },
    "phi_h": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Sensible heat flux of the coupled fire cell (FireHeatFlux phi_h = fire_behavior grnhft)."
    },
    "phi_q": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Latent heat flux of the coupled fire cell."
    },
    "grnhfx": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Atmosphere-cell sensible heat flux (mean of the 16 fire cells)."
    },
    "grnqfx": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Atmosphere-cell latent heat flux."
    },
    "rthfrten": {
     "type": "unknown",
     "units": "Pa*K/s",
     "shape": [
      "lev"
     ],
     "description": "Mass-weighted theta tendency column (WRF rthfrten)."
    },
    "rqvfrten": {
     "type": "unknown",
     "units": "Pa/s",
     "shape": [
      "lev"
     ],
     "description": "Mass-weighted qv tendency column (WRF rqvfrten)."
    }
   },
   "equations": [
    {
     "lhs": "fuel_burn_rate",
     "rhs": "fuel_burn_rate0"
    },
    {
     "lhs": "w_l",
     "rhs": "w_l0"
    },
    {
     "lhs": "M_f",
     "rhs": "M_f0"
    },
    {
     "lhs": "h_fuel",
     "rhs": "h_fuel0"
    },
    {
     "lhs": "L_water",
     "rhs": "L_water0"
    },
    {
     "lhs": "water_ratio",
     "rhs": "water_ratio0"
    },
    {
     "lhs": "s_coupled",
     "rhs": "s_coupled0"
    },
    {
     "lhs": "mu",
     "rhs": "mu0"
    },
    {
     "lhs": "phi_h",
     "rhs": "phi_h_in"
    },
    {
     "lhs": "phi_q",
     "rhs": "phi_q_in"
    },
    {
     "lhs": "grnhfx",
     "rhs": "grnhfx_in"
    },
    {
     "lhs": "grnqfx",
     "rhs": "grnqfx_in"
    },
    {
     "lhs": "rthfrten",
     "rhs": "rthfrten_in"
    },
    {
     "lhs": "rqvfrten",
     "rhs": "rqvfrten_in"
    }
   ],
   "tests": [
    {
     "id": "test7_step10_cell_6_16",
     "description": "Reference: fire_behavior test7 at step 10 (t = 5 s): the coupled fire cell's flux from the standalone fire_flux dump (grnhft, real32; FireHeatFlux reproduces Calc_flux, see fire_heat_flux.esm), the atmosphere-cell flux and tendency column from the EarthSciML feedback driver replaying Provide_atm_feedback on test7/wrf.nc frame 5 with fire_behavior's own fire-mesh fluxes (dumps/fire_wrf/driver/frame5_cfbm). Single precision: rel 1e-5; Linf 1e-5 of the column maximum. The other 15 fire cells' fluxes and the column geometry come from the mounted component's frame5_cfbm test library.",
     "parameter_overrides": {},
     "time_span": {
      "start": 0,
      "end": 1
     },
     "tolerance": {
      "rel": 1e-05
     },
     "assertions": [
      {
       "variable": "phi_h",
       "time": 0.0,
       "expected": 241583.65625,
       "tolerance": {
        "rel": 1e-05
       }
      },
      {
       "variable": "phi_q",
       "time": 0.0,
       "expected": 22172.537109375,
