 },
 "coupling": [
  {
   "type": "variable_map",
   "from": "FireAtmosphereColumn.fuel_burn_rate",
   "to": "HeatFlux.fuel_burn_rate",
   "transform": "param_to_var",
   "description": "fuel consumption rate of the coupled fire cell"
  },
  {
   "type": "variable_map",
   "from": "FireAtmosphereColumn.w_l",
   "to": "HeatFlux.w_l",
   "transform": "param_to_var",
   "description": "fuel load"
  },
  {
   "type": "variable_map",
   "from": "FireAtmosphereColumn.M_f",
   "to": "HeatFlux.M_f",
   "transform": "param_to_var",
   "description": "fuel moisture"
  },
  {
   "type": "variable_map",
   "from": "FireAtmosphereColumn.h_fuel",
   "to": "HeatFlux.h_fuel",
   "transform": "param_to_var",
   "description": "combustion heat"
  },
  {
   "type": "variable_map",
   "from": "FireAtmosphereColumn.L_water",
   "to": "HeatFlux.L_water",
   "transform": "param_to_var",
   "description": "latent heat"
  },
  {
   "type": "variable_map",
   "from": "FireAtmosphereColumn.water_ratio",
   "to": "HeatFlux.water_combustion_ratio",
   "transform": "param_to_var",
   "description": "combustion water ratio"
  },
  {
   "type": "variable_map",
   "from": "FireAtmosphereColumn.s_coupled",
   "to": "Flux.s_coupled",
   "transform": "param_to_var",
   "description": "which fire cell of the block is coupled"
  },
  {
   "type": "variable_map",
   "from": "FireAtmosphereColumn.mu",
   "to": "Flux.mu",
   "transform": "param_to_var",
   "description": "column dry air mass"
  },
  {
   "type": "variable_map",
   "from": "HeatFlux.phi_h",
   "to": "Flux.phi_h_in",
   "transform": "param_to_var",
   "description": "fire cell sensible heat flux -> block"
  },
  {
   "type": "variable_map",
   "from": "HeatFlux.phi_q",
   "to": "Flux.phi_q_in",
   "transform": "param_to_var",
   "description": "fire cell latent heat flux -> block"
  },
  {
   "type": "variable_map",
   "from": "HeatFlux.phi_h",
   "to": "FireAtmosphereColumn.phi_h_in",
   "transform": "param_to_var",
   "description": "diagnostic"
  },
  {
   "type": "variable_map",
   "from": "HeatFlux.phi_q",
   "to": "FireAtmosphereColumn.phi_q_in",
   "transform": "param_to_var",
   "description": "diagnostic"
  },
  {
   "type": "variable_map",
   "from": "Flux.grnhfx",
   "to": "FireAtmosphereColumn.grnhfx_in",
   "transform": "param_to_var",
   "description": "atmosphere-cell heat flux"
  },
  {
   "type": "variable_map",
   "from": "Flux.grnqfx",
   "to": "FireAtmosphereColumn.grnqfx_in",
   "transform": "param_to_var",
   "description": "atmosphere-cell moisture flux"
  },
  {
   "type": "variable_map",
   "from": "Flux.rthfrten_wrf",
   "to": "FireAtmosphereColumn.rthfrten_in",
   "transform": "param_to_var",
   "description": "theta tendency column"
  },
  {
   "type": "variable_map",
   "from": "Flux.rqvfrten_wrf",
   "to": "FireAtmosphereColumn.rqvfrten_in",
   "transform": "param_to_var",
   "description": "qv tendency column"
  }
 ]
}
