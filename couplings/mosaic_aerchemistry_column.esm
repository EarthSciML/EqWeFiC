        "dnum_coag": {
          "type": "parameter",
          "units": "cm^-3/s",
          "shape": [
            "lev",
            "bin"
          ],
          "default": 0.0,
          "description": "Coagulation tendency of the number concentration, from CoagAssembly."
        },
        "dq_coag": {
          "type": "parameter",
          "units": "1/s",
          "shape": [
            "lev",
            "bin",
            "cq"
          ],
          "default": 0.0,
          "description": "Coagulation tendency of each carried composition column, from CoagAssembly."
        },
