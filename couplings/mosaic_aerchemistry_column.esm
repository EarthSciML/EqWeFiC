          "units": "mol/mol",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "Nucleation increment per call of each level (Nucleation.dq_so4a, lifted)."
        },
        "nuc_nh4a": {
          "type": "parameter",
          "units": "mol/mol",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "Nucleation increment per call of each level (Nucleation.dq_nh4a, lifted)."
        },
        "nuc_num": {
          "type": "parameter",
          "units": "1/mol",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "Nucleation increment per call of each level (Nucleation.dq_num, lifted)."
        },
        "vdep": {
          "type": "parameter",
          "units": "m/s",
          "shape": [
            "bin"
          ],
          "default": 0.0,
          "description": "Dry-deposition velocity of each section in the lowest layer, lifted out of DryDeposition."
        },
        "patm": {
          "type": "unknown",
          "units": "atm",
          "shape": [
            "lev"
          ],
          "description": "Pressure in atmospheres, as mosaic_coag_1clm forms patm_box."
        },
        "tk_p": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "lev",
            "bin",
            "bin2"
          ],
          "description": "Temperature of each pair's cell. Every pair of sections of every cell is one point of the kernel's lifted grid."
        },
        "patm_p": {
          "type": "unknown",
          "units": "atm",
          "shape": [
            "lev",
            "bin",
            "bin2"
          ],
          "description": "Pressure of each pair's cell. Every pair of sections of every cell is one point of the kernel's lifted grid."
        },
        "dpi_p": {
          "type": "unknown",
          "units": "cm",
          "shape": [
            "lev",
            "bin",
            "bin2"
          ],
          "description": "Wet diameter of the first partner. Every pair of sections of every cell is one point of the kernel's lifted grid."
        },
        "densi_p": {
          "type": "unknown",
          "units": "g/cm^3",
          "shape": [
            "lev",
            "bin",
            "bin2"
          ],
          "description": "Wet density of the first partner. Every pair of sections of every cell is one point of the kernel's lifted grid."
        },
        "dpj_p": {
          "type": "unknown",
          "units": "cm",
          "shape": [
            "lev",
            "bin",
            "bin2"
          ],
          "description": "Wet diameter of the second partner. Every pair of sections of every cell is one point of the kernel's lifted grid."
        },
        "densj_p": {
          "type": "unknown",
          "units": "g/cm^3",
          "shape": [
            "lev",
            "bin",
            "bin2"
          ],
          "description": "Wet density of the second partner. Every pair of sections of every cell is one point of the kernel's lifted grid."
        },
        "cbr_c": {
          "type": "unknown",
          "units": "cm^3/s",
          "shape": [
            "lev",
            "bin",
            "bin"
          ],
          "description": "The pair kernel as the assembly indexes it (both partners on the section axis)."
        },
        "q_coag": {
          "type": "unknown",
          "units": "mol/mol",
          "shape": [
            "lev",
            "bin",
            "cq"
          ],
          "description": "coagsolv's composition columns: the ten components, then the hysteresis water and the water (its thirteenth, the dry volume, only refreshes the aqvoldry_sub diagnostic and is not carried)."
        },
        "vol_part_l": {
          "type": "unknown",
          "units": "cm^3",
          "shape": [
            "lev"
          ],
          "description": "The single-particle volume new particles get, volumlo_sect(1), at every level."
        },
        "temp_s": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "bin"
          ],
          "description": "Lowest-layer temperature, per section. Dry deposition is evaluated section by section in the lowest layer only."
        },
        "cair_s": {
          "type": "unknown",
          "units": "mol/cm^3",
          "shape": [
            "bin"
          ],
          "description": "Lowest-layer air density, per section. Dry deposition is evaluated section by section in the lowest layer only."
        },
        "ustar_s": {
          "type": "unknown",
          "units": "m/s",
          "shape": [
            "bin"
          ],
          "description": "Friction velocity, per section. Dry deposition is evaluated section by section in the lowest layer only."
        },
        "aer_res_s": {
          "type": "unknown",
          "units": "s/m",
          "shape": [
            "bin"
          ],
          "description": "Aerodynamic resistance, per section. Dry deposition is evaluated section by section in the lowest layer only."
        },
        "water_s": {
          "type": "unknown",
          "units": "mol/mol",
          "shape": [
            "bin"
          ],
          "description": "Lowest-layer aerosol water of each section. Dry deposition is evaluated section by section in the lowest layer only."
        },
        "n_s": {
          "type": "unknown",
          "units": "1/mol",
          "shape": [
            "bin"
          ],
          "description": "Lowest-layer number of each section. Dry deposition is evaluated section by section in the lowest layer only."
        },
        "mw_water_s": {
          "type": "unknown",
          "units": "g/mol",
          "shape": [
            "bin"
          ],
          "description": "mw_water_aer, per section. Dry deposition is evaluated section by section in the lowest layer only."
        },
        "drymass_s": {
          "type": "unknown",
          "units": "g/mol",
          "shape": [
            "bin"
          ],
          "description": "mosaic_drydep_1clm's drymass of each lowest-layer section: sum over components of r mw (no clip)."
        },
        "dryvol_s": {
          "type": "unknown",
          "units": "cm^3/mol",
          "shape": [
            "bin"
          ],
          "description": "mosaic_drydep_1clm's dryvol: sum over components of r mw / dens."
        },
        "sfc": {
          "type": "unknown",
          "units": "1/m",
          "shape": [
            "lev"
          ],
          "description": "1/dz1 in the lowest layer and zero above: the deposition flux v_d X leaves the column through its floor, vertmx's lower-boundary term with the mixing off."
        },
        "nucsec": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "bin"
          ],
          "description": "1 in the section new particles enter, 0 elsewhere."
        },
        "dn_dt": {
          "type": "unknown",
          "units": "1/(mol*s)",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "Summed tendency of each section's number mixing ratio: coagulation (number concentration over molar air density), nucleation into the first section, dry deposition out of the lowest layer."
        },
        "dr_dt": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "lev",
            "bin",
            "comp"
          ],
          "description": "Summed tendency of each component mixing ratio: coagulation, the sulfate and ammonium nucleation puts in the first section, dry deposition."
        },
        "dhysw_dt": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "Summed tendency of the hysteresis water: coagulation and dry deposition."
        },
        "dwater_dt": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "Summed tendency of the aerosol water: coagulation and dry deposition."
        },
        "dh2so4_dt": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "lev"
          ],
          "description": "Tendency of gas-phase H2SO4: the nucleation increment over its sub-step."
        },
        "dnh3_dt": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "lev"
          ],
          "description": "Tendency of gas-phase NH3: the nucleation increment over its sub-step."
        }
      },
      "equations": [
        {
          "lhs": "patm",
          "rhs": {
            "op": "/",
            "args": [
              "ptot",
              "Cp.dyn_per_atm"
            ]
          }
        },
        {
          "lhs": "tk_p",
          "rhs": {
            "op": "faq",
            "output_idx": [
              "l",
              "i",
              "j"
            ],
            "args": [],
            "ranges": {
              "l": {
                "from": "lev"
              },
              "i": {
                "from": "bin"
              },
              "j": {
                "from": "bin2"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "temp",
                "l"
              ]
            }
          }
        },
