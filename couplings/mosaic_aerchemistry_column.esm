          "type": "parameter",
          "units": "mol/mol",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "Nucleation increment per call of each level (Nucleation.dq_h2so4, lifted)."
        },
        "nuc_nh3": {
          "type": "parameter",
          "units": "mol/mol",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "Nucleation increment per call of each level (Nucleation.dq_nh3, lifted)."
        },
        "nuc_so4a": {
