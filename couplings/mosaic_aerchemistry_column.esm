  "coupling": [
    {
      "type": "coupling_import",
      "ref": "lib/mosaic_aerchemistry_processes.esm",
      "bind": {
        "Column": "Column",
        "CoagEntry": "CoagEntry",
        "CoagKernel": "CoagKernel",
        "CoagAssembly": "CoagAssembly",
        "Nucleation": "Nucleation",
        "DryDeposition": "DryDeposition"
      },
      "description": "The 58 process edges of this column, shared with couplings/chem170_column.esm."
    },
    {
      "type": "variable_map",
      "from": "Column.q_h2so4",
      "to": "Nucleation.q_h2so4",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "the 0-D nucleation scheme lifted over the levels"
    },
    {
      "type": "variable_map",
      "from": "Column.q_nh3",
      "to": "Nucleation.q_nh3",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "the 0-D nucleation scheme lifted over the levels"
    }
  ]
}
