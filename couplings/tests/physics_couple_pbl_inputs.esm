{
 "esm": "1.0.0",
 "metadata": {
  "name": "physics_couple_pbl_inputs",
  "description": "Mount-edge library of the physics-column assemblies (couplings/physics_column{,_night}.esm and couplings/scm_physics_column{,_night}.esm): lowers YSU's `input_rthraten` rewrite target to the coupling-target parameter `rthraten_in`, which the document's variable_map fills with the radiation subassembly's dthdt_lw + dthdt_sw (esm-spec 9.7.10 + 10.4). Hand-authored; no numbers. The rest of YSU's column state comes from the regime library physics_step<N>_atmos_inputs.esm.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_rthraten": {
   "params": [],
   "match": {
    "op": "input_rthraten",
    "args": []
   },
   "body": "rthraten_in"
  }
 }
}
