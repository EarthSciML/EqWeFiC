{
 "esm": "1.1.0",
 "metadata": {
  "name": "scmdyn_couple_cor_inputs",
  "description": "Mount-edge template library of couplings/scm_dynamics_column*.esm for the mounted WRFPerturbationCoriolis: lowers the component's geometry rewrite targets (input_ze, input_w_above, input_w_below) to its additive coupling-target parameters (ze_in, w_above_in, w_below_in), which the document's coupling fills from the mounted WRFColumnGeometry through variable_map param_to_var edges (esm-spec 9.7.10, 10.4). Hand-authored; not generated by tools/fill_tests.py and not rewritten by it."
 },
 "expression_templates": {
  "input_ze": {
   "params": [],
   "match": {
    "op": "input_ze",
    "args": []
   },
   "body": "ze_in"
  },
  "input_w_above": {
   "params": [],
   "match": {
    "op": "input_w_above",
    "args": []
   },
   "body": "w_above_in"
  },
  "input_w_below": {
   "params": [],
   "match": {
    "op": "input_w_below",
    "args": []
   },
   "body": "w_below_in"
  }
 }
}
