{
 "esm": "1.1.0",
 "metadata": {
  "name": "scmstate_couple_ysu_inputs",
  "description": "Mount-edge template library of the EqWeather-SCM state document (couplings/eqweather_scm_dynamics.esm): lowers YSU's PROGNOSTIC-STATE rewrite targets (input_theta, input_u, input_v, input_qv, input_qc, input_qi) to its additive coupling-target parameters (theta_in, u_in, v_in, qv_in, qc_in, qi_in), which the state document fills from its own ODE states through variable_map param_to_var edges (esm-spec 9.7.10, 10.4). The scheme is a pure tendency diagnostic -- it reports dthdt, dudt, dvdt, dqvdt, dqcdt, dqidt and the document integrates their sum with the dynamics' -- so these edges drive the diagnosis at every RHS evaluation, not merely an initial condition. Geometry edges (p, p_int, exner, ze) are NOT here: they come from WRFColumnGeometry through couplings/tests/geophys_couple_ysu_inputs.esm, and the longwave heating rate through the physics-suite edge on rthraten_in. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling",
   "eqweather-scm"
  ]
 },
 "expression_templates": {
  "input_theta": {
   "params": [],
   "match": {
    "op": "input_theta",
    "args": []
   },
   "body": "theta_in"
  },
  "input_u": {
   "params": [],
   "match": {
    "op": "input_u",
    "args": []
   },
   "body": "u_in"
  },
  "input_v": {
   "params": [],
   "match": {
    "op": "input_v",
    "args": []
   },
   "body": "v_in"
  },
  "input_qv": {
   "params": [],
   "match": {
    "op": "input_qv",
    "args": []
   },
   "body": "qv_in"
  },
  "input_qc": {
   "params": [],
   "match": {
    "op": "input_qc",
    "args": []
   },
   "body": "qc_in"
  },
  "input_qi": {
   "params": [],
   "match": {
    "op": "input_qi",
    "args": []
   },
   "body": "qi_in"
  }
 }
}
