{
 "esm": "1.0.0",
 "metadata": {
  "name": "rrtm_couple_setcoef_inputs",
  "description": "Mount-edge library of the RRTM longwave assembly (couplings/rrtm_lw_column.esm): lowers each `input_<x>` rewrite target of RRTMSetcoef to the coupling-target parameter `<x>_in`, which the document's variable_map fills from RRTMColumn (esm-spec 9.7.10 + 10.4). Hand-authored; no numbers.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_pavel": {
   "params": [],
   "match": {
    "op": "input_pavel",
    "args": []
   },
   "body": "pavel_in"
  },
  "input_tavel": {
   "params": [],
   "match": {
    "op": "input_tavel",
    "args": []
   },
   "body": "tavel_in"
  },
  "input_coldry": {
   "params": [],
   "match": {
    "op": "input_coldry",
    "args": []
   },
   "body": "coldry_in"
  },
  "input_colh2o": {
   "params": [],
   "match": {
    "op": "input_colh2o",
    "args": []
   },
   "body": "colh2o_in"
  },
  "input_colco2": {
   "params": [],
   "match": {
    "op": "input_colco2",
    "args": []
   },
   "body": "colco2_in"
  }
 }
}
