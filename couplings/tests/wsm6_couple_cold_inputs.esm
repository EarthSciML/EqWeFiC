{
 "esm": "1.0.0",
 "metadata": {
  "name": "wsm6_couple_cold_inputs",
  "description": "Mount-edge library of the WSM6 microphysics-step assembly (couplings/microphysics_column*.esm): lowers the `input_<x>` rewrite targets of WSM6ColdAccretion to the additive coupling-target parameters `<x>_in`, which the document's variable_map param_to_var edges fill from the upstream stage (esm-spec 9.7.10 + 10.4). Hand-authored; no numbers. input_qc lowers to the model's own qc_in; input_T/qi/qr/qs/qg are used only inside the mounted hydrometeor_slopes.esm subsystem `sd`, where they lower to that subsystem's T_in/qi_in/qr_in/qs_in/qg_in and the document couples them as Cold.sd.<x>_in. All six carry WSM6MeltingFreezing's output state.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_qc": {
   "params": [],
   "match": {
    "op": "input_qc",
    "args": []
   },
   "body": "qc_in"
  },
  "input_T": {
   "params": [],
   "match": {
    "op": "input_T",
    "args": []
   },
   "body": "T_in"
  },
  "input_qi": {
   "params": [],
   "match": {
    "op": "input_qi",
    "args": []
   },
   "body": "qi_in"
  },
  "input_qr": {
   "params": [],
   "match": {
    "op": "input_qr",
    "args": []
   },
   "body": "qr_in"
  },
  "input_qs": {
   "params": [],
   "match": {
    "op": "input_qs",
    "args": []
   },
   "body": "qs_in"
  },
  "input_qg": {
   "params": [],
   "match": {
    "op": "input_qg",
    "args": []
   },
   "body": "qg_in"
  }
 }
}
