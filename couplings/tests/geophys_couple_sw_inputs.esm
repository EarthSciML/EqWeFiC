{
 "esm": "1.1.0",
 "metadata": {
  "name": "geophys_couple_sw_inputs",
  "description": "Mount-edge template library for DudhiaSW in the geometry-driven physics couplings: lowers input_p, input_exner and input_ze to the coupling-target parameters p_in, exner_in and ze_in, filled from WRFColumnGeometry (p, exner, z_w_agl). The solar inputs csza and solcon are plain parameters and are mapped directly from WRFSolarGeometry. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_p": {
   "params": [],
   "match": {
    "op": "input_p",
    "args": []
   },
   "body": "p_in"
  },
  "input_exner": {
   "params": [],
   "match": {
    "op": "input_exner",
    "args": []
   },
   "body": "exner_in"
  },
  "input_ze": {
   "params": [],
   "match": {
    "op": "input_ze",
    "args": []
   },
   "body": "ze_in"
  }
 }
}
