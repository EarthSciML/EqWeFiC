{
 "esm": "1.1.0",
 "metadata": {
  "name": "scmstate_couple_slab_inputs",
  "description": "Mount-edge template library of the EqWeather-SCM state document (couplings/eqweather_scm_dynamics.esm): lowers the 5-layer slab land-surface scheme's PROGNOSTIC-STATE rewrite target input_T_s to its additive coupling-target parameter T_s_in, which the state document fills from its own soil-temperature ODE state through a variable_map param_to_var edge (esm-spec 9.7.10, 10.4). The scheme reports dTs_dt and the document integrates it, closing the soil column the same way the atmospheric column is closed. The soil geometry edge input_ze is NOT here: the layer depths come from SOILPARM and are time-invariant, so they stay on the dumped library. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling",
   "eqweather-scm"
  ]
 },
 "expression_templates": {
  "input_T_s": {
   "params": [],
   "match": {
    "op": "input_T_s",
    "args": []
   },
   "body": "T_s_in"
  }
 }
}
