{
 "esm": "1.1.0",
 "metadata": {
  "name": "geophys_couple_ysu_inputs",
  "description": "Mount-edge template library for YSU in the geometry-driven physics couplings (couplings/geometry_physics_column*.esm): lowers YSU's geometry rewrite targets input_p, input_p_int, input_exner and input_ze to its additive coupling-target parameters p_in, p_int_in, exner_in and ze_in, which the document fills from WRFColumnGeometry (p, p_hyd_w, exner, z_w_agl; WRF hands YSU the hydrostatic interface pressure, p_top at the top and the surface pressure at the ground, not the extrapolated p8w) through variable_map param_to_var edges (esm-spec 9.7.10, 10.4). Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_p": {
   "params": [],
   "match": {
    "op": "input_p",
    "args": []
   },
   "body": "p_in"
  },
  "input_p_int": {
   "params": [],
   "match": {
    "op": "input_p_int",
    "args": []
   },
   "body": "p_int_in"
  },
  "input_exner": {
   "params": [],
   "match": {
    "op": "input_exner",
    "args": []
   },
   "body": "exner_in"
  },
  "input_ze": {
   "params": [],
   "match": {
    "op": "input_ze",
    "args": []
   },
   "body": "ze_in"
  }
 }
}
