{
 "esm": "1.1.0",
 "metadata": {
  "name": "scmstate_couple_cor_inputs",
  "description": "Mount-edge template library of the EqWeather-SCM state document (couplings/eqweather_scm_dynamics.esm): lowers WRFPerturbationCoriolis's PROGNOSTIC-STATE rewrite targets (input_u, input_v, input_w) to its additive coupling-target parameters (u_in, v_in, w_in), which the state document fills from its own ODE states through variable_map param_to_var edges (esm-spec 9.7.10, 10.4). This is what turns the dumped, frozen column of couplings/scm_dynamics_column.esm into a column that evolves: the same component, with the same geometry edges, reading the integrator's state instead of a constant profile. Base-state fields (u_base, v_base, theta_base, z_base, eta_w, phb, alb, pb) are NOT here -- they are genuinely time-invariant in the em_scm_xy reference run and keep coming from the dumped library. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling",
   "eqweather-scm"
  ]
 },
 "expression_templates": {
  "input_u": {
   "params": [],
   "match": {
    "op": "input_u",
    "args": []
   },
   "body": "u_in"
  },
  "input_v": {
   "params": [],
   "match": {
    "op": "input_v",
    "args": []
   },
   "body": "v_in"
  },
  "input_w": {
   "params": [],
   "match": {
    "op": "input_w",
    "args": []
   },
   "body": "w_in"
  }
 }
}
