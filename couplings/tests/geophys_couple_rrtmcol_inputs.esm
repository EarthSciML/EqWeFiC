{
 "esm": "1.1.0",
 "metadata": {
  "name": "geophys_couple_rrtmcol_inputs",
  "description": "Mount-edge template library for RRTMColumn in the geometry-driven physics couplings: lowers input_p, input_p_e, input_T, input_T_e and input_dz_m to the coupling-target parameters p_in, p_e_in, T_in, T_e_in and dz_m_in, filled from WRFColumnGeometry (p, p_hyd_w, T, t8w, dz8w; the RRTM interface pressure is the hydrostatic one, p_top at the top and the surface pressure at the ground). Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_p": {
   "params": [],
   "match": {
    "op": "input_p",
    "args": []
   },
   "body": "p_in"
  },
  "input_p_e": {
   "params": [],
   "match": {
    "op": "input_p_e",
    "args": []
   },
   "body": "p_e_in"
  },
  "input_T": {
   "params": [],
   "match": {
    "op": "input_T",
    "args": []
   },
   "body": "T_in"
  },
  "input_T_e": {
   "params": [],
   "match": {
    "op": "input_T_e",
    "args": []
   },
   "body": "T_e_in"
  },
  "input_dz_m": {
   "params": [],
   "match": {
    "op": "input_dz_m",
    "args": []
   },
   "body": "dz_m_in"
  }
 }
}
