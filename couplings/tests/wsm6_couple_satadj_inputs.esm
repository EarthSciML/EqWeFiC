{
 "esm": "1.0.0",
 "metadata": {
  "name": "wsm6_couple_satadj_inputs",
  "description": "Mount-edge library of the WSM6 microphysics-step assembly (couplings/microphysics_column*.esm): lowers the `input_<x>` rewrite targets of WSM6SaturationAdjustment to the additive coupling-target parameters `<x>_in`, which the document's variable_map param_to_var edges fill from the upstream stage (esm-spec 9.7.10 + 10.4). Hand-authored; no numbers. input_T and input_qv are used only inside the mounted saturation.esm subsystem `sat`, which re-evaluates qsat at the state AFTER the rate update, so the document couples them as SatAdj.sat.T_in / SatAdj.sat.qv_in from WSM6MassConservation's T_upd and qv_upd; qc likewise comes from qc_upd, while xl and cpm keep the start-of-sub-step values of WSM6Saturation, as the kernel does (FORTRAN_BUGS.md note N4).",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_T": {
   "params": [],
   "match": {
    "op": "input_T",
    "args": []
   },
   "body": "T_in"
  },
  "input_qv": {
   "params": [],
   "match": {
    "op": "input_qv",
    "args": []
   },
   "body": "qv_in"
  },
  "input_qc": {
   "params": [],
   "match": {
    "op": "input_qc",
    "args": []
   },
   "body": "qc_in"
  },
  "input_xl": {
   "params": [],
   "match": {
    "op": "input_xl",
    "args": []
   },
   "body": "xl_in"
  },
  "input_cpm": {
   "params": [],
   "match": {
    "op": "input_cpm",
    "args": []
   },
   "body": "cpm_in"
  }
 }
}
