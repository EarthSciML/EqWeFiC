{
 "esm": "1.1.0",
 "metadata": {
  "name": "geophys_couple_rrtmheat_inputs",
  "description": "Mount-edge template library for RRTMLWHeating in the geometry-driven physics couplings: lowers input_p_e, input_exner and input_T to the coupling-target parameters p_e_in, exner_in and T_in, filled from WRFColumnGeometry (p_hyd_w, exner, T). Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_p_e": {
   "params": [],
   "match": {
    "op": "input_p_e",
    "args": []
   },
   "body": "p_e_in"
  },
  "input_exner": {
   "params": [],
   "match": {
    "op": "input_exner",
    "args": []
   },
   "body": "exner_in"
  },
  "input_T": {
   "params": [],
   "match": {
    "op": "input_T",
    "args": []
   },
   "body": "T_in"
  }
 }
}
