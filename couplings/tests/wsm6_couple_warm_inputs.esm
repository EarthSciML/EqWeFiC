{
 "esm": "1.0.0",
 "metadata": {
  "name": "wsm6_couple_warm_inputs",
  "description": "Mount-edge library of the WSM6 microphysics-step assembly (couplings/microphysics_column*.esm): lowers the `input_<x>` rewrite targets of WSM6WarmRain to the additive coupling-target parameters `<x>_in`, which the document's variable_map param_to_var edges fill from the upstream stage (esm-spec 9.7.10 + 10.4). Hand-authored; no numbers. T, qc and qr come from WSM6MeltingFreezing's post-melting/freezing state and qsat, rh, xl from WSM6Saturation at the START-of-sub-step state (FORTRAN_BUGS.md note N4); qv, p and rho stay dumped profiles from the regime library because the block does not change them.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_T": {
   "params": [],
   "match": {
    "op": "input_T",
    "args": []
   },
   "body": "T_in"
  },
  "input_qc": {
   "params": [],
   "match": {
    "op": "input_qc",
    "args": []
   },
   "body": "qc_in"
  },
  "input_qr": {
   "params": [],
   "match": {
    "op": "input_qr",
    "args": []
   },
   "body": "qr_in"
  },
  "input_qsat": {
   "params": [],
   "match": {
    "op": "input_qsat",
    "args": []
   },
   "body": "qsat_in"
  },
  "input_rh": {
   "params": [],
   "match": {
    "op": "input_rh",
    "args": []
   },
   "body": "rh_in"
  },
  "input_xl": {
   "params": [],
   "match": {
    "op": "input_xl",
    "args": []
   },
   "body": "xl_in"
  }
 }
}
