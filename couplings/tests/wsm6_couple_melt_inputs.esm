{
 "esm": "1.0.0",
 "metadata": {
  "name": "wsm6_couple_melt_inputs",
  "description": "Mount-edge library of the WSM6 microphysics-step assembly (couplings/microphysics_column*.esm): lowers the `input_<x>` rewrite targets of WSM6MeltingFreezing to the additive coupling-target parameters `<x>_in`, which the document's variable_map param_to_var edges fill from the upstream stage (esm-spec 9.7.10 + 10.4). Hand-authored; no numbers. Only the start-of-sub-step thermodynamics comes from upstream (WSM6Saturation); the post-sedimentation column state that the melting/freezing block acts on is a dumped profile, because WSM6's sedimentation is an in-place PLM semi-Lagrangian update and not a rate that sedimentation.esm could hand over.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_cpm": {
   "params": [],
   "match": {
    "op": "input_cpm",
    "args": []
   },
   "body": "cpm_in"
  },
  "input_xl": {
   "params": [],
   "match": {
    "op": "input_xl",
    "args": []
   },
   "body": "xl_in"
  }
 }
}
