{
 "esm": "1.1.0",
 "metadata": {
  "name": "scmstate_couple_geo_inputs",
  "description": "Mount-edge template library of the EqWeather-SCM state document (couplings/eqweather_scm_dynamics.esm): lowers WRFColumnGeometry's PROGNOSTIC-STATE rewrite targets (input_phi_p, input_theta_m, input_qv) to its additive coupling-target parameters (phi_p_in, theta_m_in, qv_in), which the state document fills from its own ODE states through variable_map param_to_var edges (esm-spec 9.7.10, 10.4). This is what turns the dumped, frozen column of couplings/scm_dynamics_column.esm into a column that evolves: the same component, with the same geometry edges, reading the integrator's state instead of a constant profile. Base-state fields (eta_w, phb, alb, pb) and the total-water mixing ratio q_t are NOT here: the first four are genuinely time-invariant and q_t - q_v is the condensate, which no component of the dynamics half evolves (it is 2.1e-9 kg/kg of cirrus at the reference step) -- they are genuinely time-invariant in the em_scm_xy reference run and keep coming from the dumped library. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling",
   "eqweather-scm"
  ]
 },
 "expression_templates": {
  "input_phi_p": {
   "params": [],
   "match": {
    "op": "input_phi_p",
    "args": []
   },
   "body": "phi_p_in"
  },
  "input_theta_m": {
   "params": [],
   "match": {
    "op": "input_theta_m",
    "args": []
   },
   "body": "theta_m_in"
  },
  "input_qv": {
   "params": [],
   "match": {
    "op": "input_qv",
    "args": []
   },
   "body": "qv_in"
  }
 }
}
