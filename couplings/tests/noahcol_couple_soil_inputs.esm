{
 "esm": "1.2.0",
 "metadata": {
  "name": "noahcol_couple_soil_inputs",
  "description": "Mount-edge template library of the Noah column state document (couplings/noah_column.esm): lowers the Noah leaves' column rewrite targets. input_ze is the soil geometry, the Noah default four layers of 0.1, 0.3, 0.6 and 1.0 m (WRF DZS / SLDPTH, time-invariant) AS WRF HOLDS THEM, real32 values widened (0.10000000149011612, ...), so the interface depths are their running sums; with the exact decimals the top-layer half-depth DSOIL moves every surface-flux quantity by 1.5e-8 relative against the reference, which is WRF's geometry. input_stc, input_smc and input_sh2o lower to each leaf's additive coupling-target parameter (stc_in, smc_in, sh2o_in), which the document fills from its own ODE states through variable_map param_to_var edges (esm-spec 9.7.10, 10.4); input_et lowers soil_moisture's per-layer transpiration to et_in, which the document fills from the evapotranspiration leaf. Each mount imports only the ops its leaf uses. Hand-authored; not generated by tools/fill_tests.py.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling",
   "noah-column"
  ]
 },
 "expression_templates": {
  "input_ze": {
   "params": [],
   "match": {
    "op": "input_ze",
    "args": []
   },
   "body": {
    "op": "faq",
    "output_idx": [
     "k"
    ],
    "args": [],
    "ranges": {
     "k": {
      "from": "lev_nodes"
     }
    },
    "expr": {
     "op": "index",
     "args": [
      {
       "op": "const",
       "args": [],
       "value": [
        0.0,
        0.10000000149011612,
        0.4000000134110451,
        1.000000037252903,
        2.000000037252903
       ]
      },
      "k"
     ]
    }
   }
  },
  "input_stc": {
   "params": [],
   "match": {
    "op": "input_stc",
    "args": []
   },
   "body": "stc_in"
  },
  "input_smc": {
   "params": [],
   "match": {
    "op": "input_smc",
    "args": []
   },
   "body": "smc_in"
  },
  "input_sh2o": {
   "params": [],
   "match": {
    "op": "input_sh2o",
    "args": []
   },
   "body": "sh2o_in"
  },
  "input_et": {
   "params": [],
   "match": {
    "op": "input_et",
    "args": []
   },
   "body": "et_in"
  }
 }
}
