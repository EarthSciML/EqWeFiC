{
 "esm": "1.0.0",
 "metadata": {
  "name": "rrtm_couple_rtrn_inputs",
  "description": "Mount-edge library of the RRTM longwave assembly: lowers each `input_<x>` rewrite target of RTRNSweep to the coupling-target parameter `<x>_in` (filled from RRTMColumn and RRTMGasOptics by the document's variable_map). Hand-authored; no numbers.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_tavel": {
   "params": [],
   "match": {
    "op": "input_tavel",
    "args": []
   },
   "body": "tavel_in"
  },
  "input_tz": {
   "params": [],
   "match": {
    "op": "input_tz",
    "args": []
   },
   "body": "tz_in"
  },
  "input_pz": {
   "params": [],
   "match": {
    "op": "input_pz",
    "args": []
   },
   "body": "pz_in"
  },
  "input_cldfrac": {
   "params": [],
   "match": {
    "op": "input_cldfrac",
    "args": []
   },
   "body": "cldfrac_in"
  },
  "input_taucloud": {
   "params": [],
   "match": {
    "op": "input_taucloud",
    "args": []
   },
   "body": "taucloud_in"
  },
  "input_semiss": {
   "params": [],
   "match": {
    "op": "input_semiss",
    "args": []
   },
   "body": "semiss_in"
  },
  "input_pfrac_flat": {
   "params": [],
   "match": {
    "op": "input_pfrac_flat",
    "args": []
   },
   "body": "pfrac_flat_in"
  },
  "input_itr_flat": {
   "params": [],
   "match": {
    "op": "input_itr_flat",
    "args": []
   },
   "body": "itr_flat_in"
  }
 }
}
