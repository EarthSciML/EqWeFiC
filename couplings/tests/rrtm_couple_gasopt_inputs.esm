{
 "esm": "1.0.0",
 "metadata": {
  "name": "rrtm_couple_gasopt_inputs",
  "description": "Mount-edge library of the RRTM longwave assembly: lowers each `input_<x>` rewrite target of RRTMGasOptics to the coupling-target parameter `<x>_in` (filled from RRTMSetcoef and RRTMColumn by the document's variable_map); the four cross-section species columns (CCl4, CFC-11/12/22), which WRF passes as zero (WX = 0 in RRTMLWRAD), are constant zero columns here. Hand-authored.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
