{
 "esm": "1.1.0",
 "metadata": {
  "name": "scmstate_couple_rrtmcol_inputs",
  "description": "Mount-edge template library of the EqWeather-SCM state document (couplings/eqweather_scm_dynamics.esm): lowers the RRTM longwave column-mapping stage's PROGNOSTIC-STATE rewrite targets (input_qv, input_qc, input_qr, input_qi, input_qs) and its input_cldfra to the additive coupling-target parameters qv_in, qc_in, qr_in, qi_in, qs_in and cldfra_in, which the state document fills through variable_map param_to_var edges (esm-spec 9.7.10, 10.4). The five species come from the document's own ODE states; cldfra_in comes from components/atmospheric_radiation/cloud_fraction/cal_cldfra.esm, the diagnostic that replaces the dumped cloud-fraction profile this stage used to read. Thermodynamic and geometry edges (p, p_e, T, T_e, dz_m) are NOT here: they come from WRFColumnGeometry through couplings/tests/geophys_couple_rrtmcol_inputs.esm. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling",
   "eqweather-scm"
  ]
 },
 "expression_templates": {
  "input_qv": {
   "params": [],
   "match": {
    "op": "input_qv",
    "args": []
   },
   "body": "qv_in"
  },
  "input_qc": {
   "params": [],
   "match": {
    "op": "input_qc",
    "args": []
   },
   "body": "qc_in"
  },
  "input_qr": {
   "params": [],
   "match": {
    "op": "input_qr",
    "args": []
   },
   "body": "qr_in"
  },
  "input_qi": {
   "params": [],
   "match": {
    "op": "input_qi",
    "args": []
   },
   "body": "qi_in"
  },
  "input_qs": {
   "params": [],
   "match": {
    "op": "input_qs",
    "args": []
   },
   "body": "qs_in"
  },
  "input_cldfra": {
   "params": [],
   "match": {
    "op": "input_cldfra",
    "args": []
   },
   "body": "cldfra_in"
  }
 }
}
