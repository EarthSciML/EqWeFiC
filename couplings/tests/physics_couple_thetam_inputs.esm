{
 "esm": "1.1.0",
 "metadata": {
  "name": "physics_couple_thetam_inputs",
  "description": "Mount-edge template library for WRFMoistThetaTendency in couplings/scm_physics_column*.esm: lowers the component's TENDENCY rewrite targets input_dtheta_dt_phys and input_dqv_dt_phys to its additive coupling-target parameters dtheta_dt_phys_in and dqv_dt_phys_in, which the assembly fills from the LIVE physics -- the summed radiative-plus-PBL potential-temperature tendency rth_phys_sum and YSU's rqvblten -- through variable_map param_to_var edges (esm-spec 9.7.10, 10.4). The component's other two rewrite targets, input_theta_m and input_qv, are NOT here: they are the dynamical state theta_m = t_1 + t0 and moist_old(P_qv) at the point in the RK step where conv_t_tendf_to_moist runs, which the physics assembly does not carry, so they keep coming from the conv_t_tendf_to_moist dump. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": ["assembly-inputs", "coupling", "eqweather-scm"]
 },
 "expression_templates": {
  "input_dtheta_dt_phys": {"params": [], "match": {"op": "input_dtheta_dt_phys", "args": []}, "body": "dtheta_dt_phys_in"},
  "input_dqv_dt_phys": {"params": [], "match": {"op": "input_dqv_dt_phys", "args": []}, "body": "dqv_dt_phys_in"}
 }
}
