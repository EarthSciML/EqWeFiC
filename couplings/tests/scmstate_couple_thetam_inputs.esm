{
 "esm": "1.1.0",
 "metadata": {
  "name": "scmstate_couple_thetam_inputs",
  "description": "Mount-edge template library for WRFMoistThetaTendency in the EqWeather-SCM state document (couplings/eqweather_scm.esm): lowers input_theta_m and input_qv to the coupling-target parameters theta_m_in and qv_in, filled from the document's ODE state. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_theta_m": {
   "params": [],
   "match": {
    "op": "input_theta_m",
    "args": []
   },
   "body": "theta_m_in"
  },
  "input_qv": {
   "params": [],
   "match": {
    "op": "input_qv",
    "args": []
   },
   "body": "qv_in"
  }
 }
}
