{
 "esm": "1.1.0",
 "metadata": {
  "name": "scmstate_couple_qt_inputs",
  "description": "Mount-edge template library of the EqWeather-SCM state document (couplings/eqweather_scm.esm): lowers the total-water rewrite target input_q_t of WRFColumnGeometry and WRFVerticalMomentum to their additive coupling-target parameter q_t_in, which the state document fills with the sum of its six moisture ODE states (q_v + q_c + q_r + q_i + q_s + q_g). It is separate from couplings/tests/scmstate_couple_{geo,vm}_inputs.esm because those libraries are shared with the dynamics-half document couplings/eqweather_scm_dynamics.esm, which carries no condensate states and keeps reading q_t from the dumped step-1410 profile. Adding WSM6 is what makes q_t diagnostic: before it, the condensate part of q_t was frozen because nothing in the document evolved it. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling",
   "eqweather-scm"
  ]
 },
 "expression_templates": {
  "input_q_t": {
   "params": [],
   "match": {
    "op": "input_q_t",
    "args": []
   },
   "body": "q_t_in"
  }
 }
}
