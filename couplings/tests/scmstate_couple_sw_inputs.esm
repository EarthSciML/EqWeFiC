{
 "esm": "1.1.0",
 "metadata": {
  "name": "scmstate_couple_sw_inputs",
  "description": "Mount-edge template library of the EqWeather-SCM state document (couplings/eqweather_scm_dynamics.esm): lowers the Dudhia shortwave scheme's PROGNOSTIC-STATE rewrite targets (input_T and the six hydrometeor species input_qv, input_qc, input_qr, input_qi, input_qs, input_qg) to its additive coupling-target parameters (T_in, qv_in, qc_in, qr_in, qi_in, qs_in, qg_in), which the state document fills from its own ODE states through variable_map param_to_var edges (esm-spec 9.7.10, 10.4). The scheme is a pure heating-rate diagnostic, so these edges drive the absorber and cloud-optics path at every RHS evaluation. Geometry edges (p, exner, ze) are NOT here: they come from WRFColumnGeometry through couplings/tests/geophys_couple_sw_inputs.esm. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling",
   "eqweather-scm"
  ]
 },
 "expression_templates": {
  "input_T": {
   "params": [],
   "match": {
    "op": "input_T",
    "args": []
   },
   "body": "T_in"
  },
  "input_qv": {
   "params": [],
   "match": {
    "op": "input_qv",
    "args": []
   },
   "body": "qv_in"
  },
  "input_qc": {
   "params": [],
   "match": {
    "op": "input_qc",
    "args": []
   },
   "body": "qc_in"
  },
  "input_qr": {
   "params": [],
   "match": {
    "op": "input_qr",
    "args": []
   },
   "body": "qr_in"
  },
  "input_qi": {
   "params": [],
   "match": {
    "op": "input_qi",
    "args": []
   },
   "body": "qi_in"
  },
  "input_qs": {
   "params": [],
   "match": {
    "op": "input_qs",
    "args": []
   },
   "body": "qs_in"
  },
  "input_qg": {
   "params": [],
   "match": {
    "op": "input_qg",
    "args": []
   },
   "body": "qg_in"
  }
 }
}
