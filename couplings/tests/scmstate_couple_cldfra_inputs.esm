{
 "esm": "1.1.0",
 "metadata": {
  "name": "scmstate_couple_cldfra_inputs",
  "description": "Mount-edge template library of the EqWeather-SCM state document (couplings/eqweather_scm_dynamics.esm): lowers CalCldfra's rewrite targets (input_T, input_p, input_qv, input_qc, input_qi, input_qs) to its additive coupling-target parameters (T_in, p_in, qv_in, qc_in, qi_in, qs_in). Four of the six -- the water-vapour, cloud-water, cloud-ice and snow mixing ratios -- come from the document's own ODE states; the temperature and the pressure come from WRFColumnGeometry, which recomputes them from the state at every RHS evaluation. All six are filled through variable_map param_to_var edges (esm-spec 9.7.10, 10.4). This library is what makes cloud fraction a diagnosis of the running column rather than a dumped profile: CalCldfra's `cldfra` then feeds the RRTM longwave column stage's `cldfra_in` through couplings/tests/scmstate_couple_rrtmcol_inputs.esm. Hand-authored; no numbers; not generated by tools/fill_tests.py and not rewritten by it.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling",
   "eqweather-scm"
  ]
 },
 "expression_templates": {
  "input_T": {
   "params": [],
   "match": {
    "op": "input_T",
    "args": []
   },
   "body": "T_in"
  },
  "input_p": {
   "params": [],
   "match": {
    "op": "input_p",
    "args": []
   },
   "body": "p_in"
  },
  "input_qv": {
   "params": [],
   "match": {
    "op": "input_qv",
    "args": []
   },
   "body": "qv_in"
  },
  "input_qc": {
   "params": [],
   "match": {
    "op": "input_qc",
    "args": []
   },
   "body": "qc_in"
  },
  "input_qi": {
   "params": [],
   "match": {
    "op": "input_qi",
    "args": []
   },
   "body": "qi_in"
  },
  "input_qs": {
   "params": [],
   "match": {
    "op": "input_qs",
    "args": []
   },
   "body": "qs_in"
  }
 }
}
