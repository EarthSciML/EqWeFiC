{
 "esm": "1.0.0",
 "metadata": {
  "name": "wsm6_couple_icedep_inputs",
  "description": "Mount-edge library of the WSM6 microphysics-step assembly (couplings/microphysics_column*.esm): lowers the `input_<x>` rewrite targets of WSM6IceDeposition to the additive coupling-target parameters `<x>_in`, which the document's variable_map param_to_var edges fill from the upstream stage (esm-spec 9.7.10 + 10.4). Hand-authored; no numbers. input_T/qi/qr/qs/qg reach the mounted `sd` subsystem and carry WSM6MeltingFreezing's output state; qsat_w, rh_w, qsat_i, rh_i and xl come from WSM6Saturation; prevp closes WSM6's sequential vapor budget and comes from WSM6WarmRain's limited rain evaporation.",
  "license": "MIT",
  "tags": [
   "assembly-inputs",
   "coupling"
  ]
 },
 "expression_templates": {
  "input_T": {
   "params": [],
   "match": {
    "op": "input_T",
    "args": []
   },
   "body": "T_in"
  },
  "input_qi": {
   "params": [],
   "match": {
    "op": "input_qi",
    "args": []
   },
   "body": "qi_in"
  },
  "input_qr": {
   "params": [],
   "match": {
    "op": "input_qr",
    "args": []
   },
   "body": "qr_in"
  },
  "input_qs": {
   "params": [],
   "match": {
    "op": "input_qs",
    "args": []
   },
   "body": "qs_in"
  },
  "input_qg": {
   "params": [],
   "match": {
    "op": "input_qg",
    "args": []
   },
   "body": "qg_in"
  },
  "input_qsat_w": {
   "params": [],
   "match": {
    "op": "input_qsat_w",
    "args": []
   },
   "body": "qsat_w_in"
  },
  "input_rh_w": {
   "params": [],
   "match": {
    "op": "input_rh_w",
    "args": []
   },
   "body": "rh_w_in"
  },
  "input_qsat_i": {
   "params": [],
   "match": {
    "op": "input_qsat_i",
    "args": []
   },
   "body": "qsat_i_in"
  },
  "input_rh_i": {
   "params": [],
   "match": {
    "op": "input_rh_i",
    "args": []
   },
   "body": "rh_i_in"
  },
  "input_xl": {
   "params": [],
   "match": {
    "op": "input_xl",
    "args": []
   },
   "body": "xl_in"
  },
  "input_prevp": {
   "params": [],
   "match": {
    "op": "input_prevp",
    "args": []
   },
   "body": "prevp_in"
  }
 }
}
