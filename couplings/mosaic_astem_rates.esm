  "coupling": [
    {
      "type": "variable_map",
      "from": "AstemRates.t_k",
      "to": "Const.t_k",
      "transform": "param_to_var",
      "description": "the cell temperature sets each cell's equilibrium constants",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "AstemRates.relhum",
      "to": "Const.a_w",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "Kp_nh4no3_0 / Kp_nh4cl_0 at the relative humidity update_thermodynamic_constants runs at (relhumclm, N118)"
    },
    {
      "type": "variable_map",
      "from": "AstemRates.t_bg",
      "to": "Mtc.t_k",
      "transform": "param_to_var",
