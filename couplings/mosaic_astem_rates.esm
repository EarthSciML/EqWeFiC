      "type": "integer",
      "default": 8,
      "description": "MOSAIC size sections (nbin_a; 8 in chem_opt = 170)."
    },
    "NEL": {
      "type": "integer",
      "default": 22,
      "description": "MOSAIC electrolytes."
    },
    "NSALT": {
      "type": "integer",
      "default": 15,
      "description": "Soluble salts, the first NSALT electrolytes."
    }
  },
