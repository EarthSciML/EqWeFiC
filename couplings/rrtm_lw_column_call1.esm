    "dthdt_lw_in": {
     "type": "parameter",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Heat.dthdt through the coupling."
    },
    "dthdt_lw": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
