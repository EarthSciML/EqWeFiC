     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Heat.dTdt through the coupling."
    },
    "dTdt": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "Longwave temperature tendency of each model layer, -(g/cp) dF_net/dp."
