     "units": "W/m^2",
     "shape": [
      "rlev"
     ],
     "default": 0.0,
     "description": "Receives Rtrn.F_up through the coupling."
    },
    "F_up": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
