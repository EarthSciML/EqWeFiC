     ],
     "description": "Longwave potential-temperature tendency (the RTHRATENLW increment)."
    },
    "glw_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Heat.glw through the coupling."
    },
    "glw": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Downward longwave flux at the surface (WRF GLW)."
    },
    "olr_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Heat.olr through the coupling."
    },
    "olr": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Upward longwave flux at the model top (WRF OLR, FORTRAN_BUGS.md N14)."
    }
