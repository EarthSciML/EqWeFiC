  "PhysicsColumn": {
   "variables": {
    "psfc0": {
     "type": "parameter",
     "units": "Pa",
     "default": 97126.0078125,
     "description": "Prescribed: Surface pressure (WRF psfc)."
    },
    "psfc": {
     "type": "unknown",
     "units": "Pa",
     "description": "Surface pressure (WRF psfc). Coupling source (variable_map param_to_var) for the mounted components."
    },
    "tsk0": {
     "type": "parameter",
     "units": "K",
     "default": 285.68798828125,
     "description": "Prescribed: Skin temperature entering the step (WRF tsk; the slab updates it after the fluxes are taken). Radiation and the surface layer both see this value (radiation_driver runs before surface_driver)."
    },
    "tsk": {
     "type": "unknown",
     "units": "K",
     "description": "Skin temperature entering the step (WRF tsk; the slab updates it after the fluxes are taken). Radiation and the surface layer both see this value (radiation_driver runs before surface_driver). Coupling source (variable_map param_to_var) for the mounted components."
    },
