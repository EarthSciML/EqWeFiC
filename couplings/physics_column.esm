     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Heat.glw through the coupling."
    },
    "glw": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Downward longwave flux at the surface (WRF GLW)."
    },
    "olr_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Heat.olr through the coupling."
    },
    "olr": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Upward longwave flux at the model top (WRF OLR, FORTRAN_BUGS.md N14)."
    },
    "dthdt_sw_in": {
     "type": "parameter",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Sw.dthdt through the coupling."
    },
    "dthdt_sw": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "Shortwave potential-temperature tendency (the RTHRATENSW increment)."
    },
    "gsw_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Sw.gsw through the coupling."
    },
    "gsw": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Net shortwave flux absorbed at the surface (WRF GSW)."
    },
    "rthraten": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "Total radiative potential-temperature tendency of the column, dthdt_lw + dthdt_sw (WRF RTHRATEN after radiation_driver). Coupling source for YSU's rthraten (used by its cloud-top radiative-entrainment branch)."
    },
    "rth_phys_sum": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "Sum of the physics potential-temperature tendencies of the step, rthraten + dtheta/dt|PBL (WRF's RTHRATEN + RTHBLTEN with cu = shcu = fdda = 0). The PBL part is the instantaneous derivative, WRF's is the implicit step's increment (see the test description)."
    }
   },
