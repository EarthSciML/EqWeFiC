{
 "esm": "1.1.0",
 "metadata": {
  "name": "GeometryRadiationColumn",
  "description": "Radiation driven by the column geometry and the solar geometry (daytime clear sky, step 1410 (radiation call 2820)): a focused coupling that demonstrates the geometry-input path of the physics components. WRFColumnGeometry feeds Dudhia SW (p, exner, z above ground), the RRTM column mapping (p, p8w, T, t8w, dz8w) and the RRTM LW heating (p8w, exner) through their additive coupling-target parameters, via the hand-authored mount-edge libraries couplings/tests/geophys_couple_*_inputs.esm; WRFSolarGeometry feeds Dudhia's plain csza and solcon parameters directly. Only humidity, cloud and (for the heating) the fluxes still come from dumped libraries, imported with `only` so the dumped geometry profiles are not used. Not the full EqWeather single-column model: how the physics and dynamics assemblies compose is under separate design review. The solar geometry is mounted under its own model name, WRFSolarGeometry, because under a different mount key the Rust loader leaves some of the component's model-qualified constant references unrewritten (reported in PLAN.md).",
  "license": "MIT",
  "tags": [
   "assembly",
   "coupling",
   "EqWeather",
   "single-column",
   "geometry"
  ]
 },
 "metaparameters": {
  "NLEV": {
   "type": "integer",
   "default": 59,
   "description": "Number of model layers (WRF kte); 59 is the em_scm_xy reference column."
  },
  "NBUF": {
   "type": "integer",
   "default": 44,
   "description": "Buffer layers MM5ATM adds above the model top (44 for the reference column)."
  }
 },
 "models": {
  "Geo": {
   "ref": "../components/atmospheric_dynamics/wrf_arw/column_geometry.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "../components/atmospheric_dynamics/wrf_arw/tests/geometry_step1410_inputs.esm"
    }
   ]
  },
  "WRFSolarGeometry": {
   "ref": "../components/atmospheric_radiation/wrf_solar/wrf_solar_geometry.esm"
  },
  "Sw": {
   "ref": "../components/atmospheric_radiation/dudhia_sw/dudhia_sw.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "../components/atmospheric_radiation/dudhia_sw/tests/scm_call2820_midday_clear_inputs.esm",
     "only": [
      "input_T",
      "input_qv",
      "input_qc",
      "input_qr",
      "input_qi",
      "input_qs",
      "input_qg"
     ]
    },
    {
     "ref": "./tests/geophys_couple_sw_inputs.esm"
    }
   ]
  },
  "Col": {
   "ref": "../components/atmospheric_radiation/rrtm_lw/rrtm_column.esm",
   "bindings": {
    "NLEV": "NLEV",
    "NBUF": "NBUF"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/rrtm_column_call2820_inputs.esm",
     "only": [
      "input_qv",
      "input_qc",
      "input_qr",
      "input_qi",
      "input_qs",
      "input_cldfra"
     ]
    },
    {
     "ref": "./tests/geophys_couple_rrtmcol_inputs.esm"
    }
   ]
  },
  "Heat": {
   "ref": "../components/atmospheric_radiation/rrtm_lw/rrtm_lw_heating.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/rrtm_couple_heating_call2820_inputs.esm",
     "only": [
      "input_F_up",
      "input_F_dn",
      "input_T"
     ]
    },
    {
     "ref": "./tests/geophys_couple_rrtmheat_inputs.esm"
    }
   ]
  },
