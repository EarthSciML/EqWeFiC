      "input_v_base",
      "input_theta_base",
      "input_z_base"
     ]
    },
    {
     "ref": "./tests/scmdyn_couple_ray_inputs.esm"
    },
    {
     "ref": "./tests/scmstate_couple_ray_inputs.esm"
    }
   ]
  },
  "EqWeatherScmDynamics": {
   "subsystems": {
    "wrf": {
     "ref": "../lib/wrf_constants.esm"
    }
   },
   "variables": {
    "mu_p0": {
     "type": "parameter",
