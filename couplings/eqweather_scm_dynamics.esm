     "description": "Prescribed: Perturbation dry column mass mu' (WRF mu). Constant for the whole em_scm_xy run: the column is horizontally uniform and periodic, so the mass-continuity equation has no flux divergence to drive it.",
     "default": -97.75
    },
    "mu_p": {
     "type": "unknown",
     "units": "Pa",
     "description": "Perturbation dry column mass mu' (WRF mu). Constant for the whole em_scm_xy run: the column is horizontally uniform and periodic, so the mass-continuity equation has no flux divergence to drive it. Coupling source (variable_map param_to_var) for the mounted components."
    },
    "mu_b0": {
