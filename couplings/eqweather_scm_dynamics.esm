    },
    "dampcoef0": {
     "type": "parameter",
     "units": "1/s",
     "description": "Prescribed: Rayleigh damping coefficient (namelist dampcoef).",
     "default": 0.003000000026077032
    },
    "dampcoef": {
     "type": "unknown",
     "units": "1/s",
     "description": "Rayleigh damping coefficient (namelist dampcoef). Coupling source (variable_map param_to_var) for the mounted components."
    },
    "zdamp0": {
     "type": "parameter",
     "units": "m",
     "description": "Prescribed: Rayleigh damping depth (namelist zdamp).",
     "default": 5000.0
    },
    "zdamp": {
     "type": "unknown",
     "units": "m",
     "description": "Rayleigh damping depth (namelist zdamp). Coupling source (variable_map param_to_var) for the mounted components."
    },
