       "cur_dv_in",
       "ray_dv_in"
      ]
     }
    },
    {
     "lhs": "dw_dt_nonpg",
     "rhs": {
      "op": "+",
      "args": [
       "cor_dw_in",
       "cur_dw_in",
       "ray_dw_in"
      ]
     }
    },
    {
     "lhs": "dw_dt",
     "rhs": {
      "op": "+",
      "args": [
       "vm_dw_in",
       "dw_dt_nonpg"
      ]
     }
    },
    {
     "lhs": "dtheta_m_dt",
     "rhs": "ray_dth_in"
    },
    {
     "lhs": "dphi_dt",
     "rhs": "vm_dphi_in"
    },
    {
     "lhs": "dqv_dt",
     "rhs": 0.0
    },
    {
     "lhs": "p_p",
     "rhs": "geo_p_p_in"
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "u"
      ],
      "wrt": "t"
     },
     "rhs": "du_dt"
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "v"
      ],
      "wrt": "t"
     },
     "rhs": "dv_dt"
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "w"
      ],
      "wrt": "t"
     },
     "rhs": "dw_dt"
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "phi_p"
      ],
      "wrt": "t"
     },
     "rhs": "dphi_dt"
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "theta_m"
      ],
      "wrt": "t"
     },
     "rhs": "dtheta_m_dt"
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "qv"
      ],
      "wrt": "t"
     },
     "rhs": "dqv_dt"
    },
    {
     "lhs": "w_absmax",
     "rhs": {
      "op": "faq",
      "output_idx": [],
      "args": [
       "w"
      ],
      "ranges": {
       "k": {
        "from": "lev_nodes"
       }
      },
      "reduce": "max",
      "expr": {
       "op": "abs",
       "args": [
        {
         "op": "index",
         "args": [
          "w",
          "k"
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "dw_absmax",
     "rhs": {
      "op": "faq",
      "output_idx": [],
      "args": [
       "dw_dt"
      ],
      "ranges": {
       "k": {
        "from": "lev_nodes"
       }
      },
      "reduce": "max",
      "expr": {
       "op": "abs",
       "args": [
        {
         "op": "index",
         "args": [
          "dw_dt",
          "k"
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "u"
      ]
     },
     "rhs": 0.0
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "v"
      ]
     },
     "rhs": 0.0
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "w"
      ]
     },
     "rhs": 0.0
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
