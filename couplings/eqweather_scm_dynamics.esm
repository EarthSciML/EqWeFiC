{
 "esm": "1.1.0",
 "metadata": {
  "name": "EqWeatherScmDynamics",
  "description": "EqWeather-SCM, dynamics half: the STATE document of PLAN.md 3.1 item (1) for the five WRF-ARW column-dynamics components. couplings/scm_dynamics_column.esm evaluates their tendencies on a frozen column read from a WRF dump; this document makes the column the solution of an ODE -- D(u), D(v), D(w), D(phi'), D(theta_m) and D(q_v) are the summed component tendencies, and the state goes back into WRFColumnGeometry, WRFVerticalMomentum, WRFPerturbationCoriolis, WRFCurvature and WRFRayleighDamping through variable_map param_to_var edges, so heights, eta weights, the equation of state and the sponge's reference profiles are all recomputed from the evolving state at every right-hand-side evaluation. The prognostic set is WRF's, less the column mass mu' (constant here: a horizontally uniform periodic column has no mass-flux divergence) and less the soil temperature and TSK, which belong to the physics half. Tendencies that the PHYSICS half supplies are absent by construction and are named in each D equation's variable description: D(q_v) is identically zero here and picks up YSU's RQVBLTEN and the microphysics sources when the physics components are mounted; D(theta_m) is the sponge alone and picks up conv_t_tendf_to_moist's conversion of the physics theta and q_v tendencies (components/atmospheric_dynamics/wrf_arw/moist_theta_tendency.esm); D(u) and D(v) pick up RUBLTEN/RVBLTEN. So a run of THIS document is not a run of EqWeather-SCM and is not expected to follow the em_scm_xy trajectory: what it pins is that the loop closes and that closing it changes no bit of the right-hand side, which the inline test measures against the same step-1410 references couplings/scm_dynamics_column.esm asserts. KNOWN LIMIT, measured: integrating this system is dominated by the vertical acoustic mode. WRF removes it with the forward-backward acoustic sub-step and the off-centring parameter epssm; nothing here does, so the initial state's departure from float64 hydrostatic balance (WRF's state is REAL*4) rings at the column's acoustic frequency. See PLAN.md 3.1 items (4) and (5).",
  "license": "MIT",
  "tags": [
   "assembly",
   "wrf",
   "dynamics",
   "column",
   "state",
   "eqweather-scm"
  ]
 },
 "metaparameters": {
  "NLEV": {
   "type": "integer",
   "default": 59,
   "description": "Number of model layers, bound into every mount edge; 59 is the em_scm_xy reference column."
  }
 },
 "models": {
  "Geo": {
   "ref": "../components/atmospheric_dynamics/wrf_arw/column_geometry.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/scmdyn_step1410_state_inputs.esm",
     "only": [
      "input_eta_w",
      "input_phi_b",
      "input_q_t",
      "input_alpha_b",
      "input_p_b"
     ]
    },
    {
     "ref": "./tests/scmstate_couple_geo_inputs.esm"
    }
   ]
  },
  "Vm": {
   "ref": "../components/atmospheric_dynamics/wrf_arw/vertical_momentum.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/scmdyn_step1410_state_inputs.esm",
     "only": [
      "input_eta_w",
      "input_q_t"
     ]
    },
    {
     "ref": "./tests/scmdyn_couple_vm_inputs.esm"
    },
    {
     "ref": "./tests/scmstate_couple_vm_inputs.esm"
    }
   ]
  },
  "Cor": {
   "ref": "../components/atmospheric_dynamics/wrf_arw/perturbation_coriolis.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/scmdyn_step1410_state_inputs.esm",
     "only": [
      "input_u_base",
      "input_v_base",
      "input_z_base"
     ]
    },
    {
     "ref": "./tests/scmdyn_couple_cor_inputs.esm"
    },
    {
     "ref": "./tests/scmstate_couple_cor_inputs.esm"
    }
   ]
  },
  "Cur": {
   "ref": "../components/atmospheric_dynamics/wrf_arw/earth_curvature.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/scmdyn_couple_cur_inputs.esm"
    },
    {
     "ref": "./tests/scmstate_couple_cur_inputs.esm"
    }
   ]
  },
  "Ray": {
   "ref": "../components/atmospheric_dynamics/wrf_arw/rayleigh_damping.esm",
   "bindings": {
    "NLEV": "NLEV"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/scmdyn_step1410_state_inputs.esm",
