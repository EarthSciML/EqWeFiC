     "shape": [
      "lev"
     ]
    },
    "p_p": {
     "type": "unknown",
     "units": "Pa",
     "description": "Perturbation pressure diagnosed by the coupled equation of state, exposed so that the state document's own thermodynamics can be asserted.",
     "shape": [
      "lev"
     ]
    },
    "w_absmax": {
     "type": "unknown",
