     "shape": [
      "rlev"
     ],
     "default": 0.0,
     "description": "Receives Rtrn.F_up through the coupling."
    },
    "F_up": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "rlev"
     ],
     "description": "Upward longwave flux at the RRTM levels (TOTUFLUX, level 1 = surface)."
    },
    "F_dn_in": {
     "type": "parameter",
     "units": "W/m^2",
     "shape": [
      "rlev"
     ],
     "default": 0.0,
     "description": "Receives Rtrn.F_dn through the coupling."
    },
    "F_dn": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "rlev"
     ],
     "description": "Downward longwave flux at the RRTM levels (TOTDFLUX)."
    },
    "htr_in": {
     "type": "parameter",
     "units": "K/day",
     "shape": [
      "rlay"
     ],
     "default": 0.0,
     "description": "Receives Rtrn.htr through the coupling."
    },
    "htr": {
     "type": "unknown",
     "units": "K/day",
     "shape": [
      "rlay"
     ],
     "description": "RTRN heating rate of each RRTM layer (HTR(L-1) is layer L)."
    },
    "rtrn_glw_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
