    },
    "rtrn_glw": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "RTRN downward surface flux TOTDFLUX(0)."
    },
    "rtrn_olr_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Rtrn.olr through the coupling."
    },
    "rtrn_olr": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "RTRN upward flux at the model top TOTUFLUX(kte)."
    },
    "F_up_model": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "lev_nodes"
     ],
     "description": "F_up restricted to the NLEV+1 model interfaces: RRTM levels 0..kte are the model interfaces bottom-up, with no reversal (rrtm_lw_heating.esm). Coupling source for RRTMLWHeating."
    },
    "F_dn_model": {
     "type": "unknown",
     "units": "W/m^2",
     "shape": [
      "lev_nodes"
     ],
     "description": "F_dn restricted to the NLEV+1 model interfaces: RRTM levels 0..kte are the model interfaces bottom-up, with no reversal (rrtm_lw_heating.esm). Coupling source for RRTMLWHeating."
    },
    "dTdt_in": {
     "type": "parameter",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Heat.dTdt through the coupling."
    },
    "dTdt": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "Longwave temperature tendency of each model layer, -(g/cp) dF_net/dp."
    },
    "dthdt_lw_in": {
     "type": "parameter",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Heat.dthdt through the coupling."
    },
    "dthdt_lw": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "Longwave potential-temperature tendency (the RTHRATENLW increment)."
    },
    "glw_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Heat.glw through the coupling."
    },
    "glw": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Downward longwave flux at the surface (WRF GLW)."
    },
    "olr_in": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Receives Heat.olr through the coupling."
    },
    "olr": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Upward longwave flux at the model top (WRF OLR, FORTRAN_BUGS.md N14)."
    }
   },
