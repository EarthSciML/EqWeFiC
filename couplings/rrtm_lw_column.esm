    },
    "col_tbound_in": {
     "type": "parameter",
     "units": "K",
     "default": 0.0,
     "description": "Receives Col.tbound through the coupling."
    },
    "col_tbound": {
     "type": "unknown",
     "units": "K",
     "description": "Surface temperature TBOUND produced by the column setup (= tsk)."
    },
