     "units": "W/m^2",
     "description": "Assembly value of ec, mapped into the mount(s)."
    },
    "etp0": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Potential evaporation; read by the transport only for its SIGN, to decide whether the surface is gaining frost. Under a pack that frost does not reach the soil -- see dew_to_soil. Test-settable; the document's single copy."
    },
