    },
    "dt_pack0": {
     "type": "parameter",
     "units": "s",
     "default": 0.01,
     "description": "Sub-step for the pack projections. A parameter of the projections, not the integrator's step; set to the reference step here. Test-settable; the document's single copy."
    },
    "dt_pack": {
     "type": "unknown",
     "units": "s",
     "description": "Assembly value of dt_pack, mapped into the mount(s)."
    },
    "etanrg0": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Total latent-heat flux the snow-surface balance must dispose of. Test-settable; the document's single copy."
    },
    "etanrg": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "Assembly value of etanrg, mapped into the mount(s)."
    },
    "esnow_rate0": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "Sublimation rate from the pack, read only by the pack-exhaustion projection. Test-settable; the document's single copy."
    },
    "esnow_rate": {
     "type": "unknown",
     "units": "m/s",
     "description": "Assembly value of esnow_rate, mapped into the mount(s)."
    },
    "dew_to_soil0": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "0 here, and that is the point: under a pack SNOPAC deposits frost on the SNOW and never routes it into the soil, unlike NOPAC. Leaving the transport's snow-free default of 1 would add that frost to the soil water that WRF gives to the pack."
    },
    "dew_to_soil": {
     "type": "unknown",
     "units": "1",
     "description": "Assembly value, mapped into the transport."
    },
    "dsh2o_dt_transport_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives the transport tendency through the coupling."
    },
    "dsh2o_dt_phase_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives the phase tendency through the coupling."
    },
    "dsmc_dt_transport_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives the total-water tendency through the coupling."
    },
    "phase_active_in": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives the clamp decision through the coupling."
    },
    "supersaturation_active_in": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Receives the SSTEP's projection indicator through the coupling."
    },
    "ex_in": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "Receives the melt rate through the coupling."
    },
    "melting_in": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Receives the SNOPAC branch indicator through the coupling."
    },
    "water_supply_in": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "Receives the total surface water supply through the coupling."
    },
    "dsh2o_dt_transport": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "CLAIM 1 term. Liquid-water tendency from vertical transport, evaluated at the assembly's column state and driven by a surface supply that now includes snowmelt."
    },
    "dsh2o_dt_phase": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "CLAIM 1 term. Liquid-water tendency from the freeze/thaw phase change, at the SAME column state."
    },
    "dsh2o_dt_total": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "CLAIM 1. The sum, which is what a consumer integrating the soil column adds to its liquid water, asserted against WRF's own (sh2o_out - sh2o_in)/dt."
    },
    "dsmc_dt_total": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "CLAIM 2. Total-water tendency: the transport alone, because the phase change conserves total water within a layer."
    },
    "dsice_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "CLAIM 2. Soil-ice tendency, which reduces identically to minus the phase rate -- claim 2 read the other way round, and the form a heat-equation consumer needs."
    },
    "phase_active": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "CLAIM 3. Which layers the phase change runs in, decided at the assembly's shared state and asserted at zero tolerance against WRF's decision at its post-SMFLX state."
    },
    "melting": {
     "type": "unknown",
     "units": "1",
     "description": "CLAIM 3. Which SNOPAC branch the snow-surface energy balance selected, asserted at zero tolerance against the reference's own record."
    },
    "melt": {
     "type": "unknown",
     "units": "m/s",
     "description": "CLAIM 1, new term. The melt rate the snow-energy component produces and the transport consumes. Referenced against SNOPAC's own EX; the pack-exhaustion limiter never fires in this reference set, so the pre-limiter rate the component computes and the post-limiter rate the water budget saw are the same number."
    },
    "water_supply": {
     "type": "unknown",
     "units": "m/s",
     "description": "CLAIM 1, new term. The total liquid water the transport actually sees, prcp1 + dew_to_soil*dew + melt, asserted against SNOPAC's own PRCP1. This is the assertion that would fail if the frost were routed into the soil, and it is the one that makes dew_to_soil = 0 a tested claim rather than a comment."
    },
    "supersaturation_active": {
     "type": "unknown",
     "units": "1",
     "description": "PRECONDITION. SSTEP's redistribution indicator, which must be zero for WRF's step to be the sum of two rates at all."
    }
   },
   "equations": [
    {
     "lhs": "smcmax",
     "rhs": "smcmax0"
    },
    {
     "lhs": "bexp",
     "rhs": "bexp0"
    },
    {
     "lhs": "edir",
     "rhs": "edir0"
    },
    {
     "lhs": "ec",
     "rhs": "ec0"
    },
    {
     "lhs": "etp",
     "rhs": "etp0"
    },
    {
     "lhs": "prcp",
     "rhs": "prcp0"
