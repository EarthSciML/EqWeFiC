    },
    "esd0": {
     "type": "parameter",
     "units": "m",
     "default": 0.06,
     "description": "Snow water equivalent entering the step; read only by the two pack projections. Test-settable; the document's single copy."
    },
    "esd": {
     "type": "unknown",
