   "description": "Noah transport <-> phase change: the shared soil parameters into both mounts from one assembly copy, and the two tendencies, the clamp decision and SSTEP's indicator back out."
  },
  {
   "type": "coupling_import",
   "ref": "lib/noah_snowmelt_soilwater.esm",
   "bind": {
    "Col": "NoahFrozenSoilColumnMelt",
    "Sno": "Sno",
    "Sm": "Sm"
   },
   "description": "Noah snow-surface energy balance -> soil water: the melt rate becomes the surface supply, and the transport is told it is under a pack so that frost goes to the snow and not the soil."
  }
