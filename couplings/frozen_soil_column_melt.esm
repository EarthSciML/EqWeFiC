    }
   ]
  },
  "NoahFrozenSoilColumnMelt": {
   "variables": {
    "smcmax0": {
     "type": "parameter",
     "units": "m^3/m^3",
     "default": 0.476,
     "description": "Soil porosity. SHARED by the transport and the phase change from one assembly copy. Test-settable; the document's single copy."
    },
    "smcmax": {
     "type": "unknown",
     "units": "m^3/m^3",
     "description": "Assembly value of smcmax, mapped into the mount(s)."
    },
    "bexp0": {
     "type": "parameter",
     "units": "1",
     "default": 5.33,
     "description": "Clapp-Hornberger b. SHARED by both soil mounts. Test-settable; the document's single copy."
    },
    "bexp": {
     "type": "unknown",
     "units": "1",
     "description": "Assembly value of bexp, mapped into the mount(s)."
    },
    "edir0": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Direct soil evaporation. Under a pack SNOPAC scales it by (1 - sncovr) before SMFLX sees it, and the dump records the scaled value. Test-settable; the document's single copy."
    },
    "edir": {
     "type": "unknown",
