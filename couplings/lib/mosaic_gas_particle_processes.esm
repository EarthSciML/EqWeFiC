{
  "esm": "1.1.0",
  "metadata": {
    "name": "MosaicGasParticleProcesses",
    "description": "Coupling library (esm-spec 10.9): the edges of MOSAIC's gas-particle partitioning over a column (phase state, liquid thermodynamics, MESA salt rates, ASTEM rates; see couplings/mosaic_column.esm) between the column model that holds the cell and bin state (role Column) and the components. Factored out of couplings/mosaic_column.esm on 2026-11-13 so the joint gas + aerosol column couplings/chem170_column.esm wires them identically. NOT here: the condensing gases ASTEM's rates read (Rates.gas), which each importer supplies -- the aerosol-only column from its own parameters, the joint column from the CBM-Z state.",
    "tags": [
      "coupling-library",
      "wrf-chem",
      "chem_opt-170"
    ]
  },
  "coupling_roles": {
    "Column": {
      "description": "The model mounted as Column in couplings/mosaic_column.esm."
    },
    "Lg": {
      "description": "The model mounted as Lg in couplings/mosaic_column.esm."
    },
    "Const": {
      "description": "The model mounted as Const in couplings/mosaic_column.esm."
    },
    "Act": {
      "description": "The model mounted as Act in couplings/mosaic_column.esm."
    },
    "Ps": {
      "description": "The model mounted as Ps in couplings/mosaic_column.esm."
    },
    "Zsr": {
      "description": "The model mounted as Zsr in couplings/mosaic_column.esm."
    },
    "Eq": {
      "description": "The model mounted as Eq in couplings/mosaic_column.esm."
    },
    "I2E": {
      "description": "The model mounted as I2E in couplings/mosaic_column.esm."
    },
    "Rates": {
      "description": "The model mounted as Rates in couplings/mosaic_column.esm."
    },
    "Mtc": {
      "description": "The model mounted as Mtc in couplings/mosaic_column.esm."
    },
    "Liq": {
      "description": "The model mounted as Liq in couplings/mosaic_column.esm."
    },
    "Sol": {
      "description": "The model mounted as Sol in couplings/mosaic_column.esm."
    },
    "Mix": {
      "description": "The model mounted as Mix in couplings/mosaic_column.esm."
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Column.relhum",
      "to": "Lg.a_w",
      "transform": "param_to_var",
      "description": "mtem_compute_log_gamz at relhumclm (N118)"
    },
    {
      "type": "variable_map",
      "from": "Column.t_k",
      "to": "Const.t_k",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "the cell temperature sets each cell's equilibrium constants"
    },
    {
      "type": "variable_map",
      "from": "Column.relhum",
      "to": "Const.a_w",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "Kp_nh4no3_0 / Kp_nh4cl_0 at the relative humidity update_thermodynamic_constants runs at (relhumclm, N118), the same value mtem_compute_log_gamz uses"
    },
    {
      "type": "variable_map",
      "from": "Const.k_w",
      "to": "Act.k_w",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "Keq_ll(3), each cell's"
    },
