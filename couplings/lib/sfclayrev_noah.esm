{
 "esm": "1.2.0",
 "metadata": {
  "name": "SfclayrevNoahCoupling",
  "description": "Coupling library (esm-spec 10.9) handing the revised MM5 surface layer's outputs to WRF's Noah land surface: the exchange coefficient chs, which Noah takes as CH in PENMAN, CANRES and the surface closure, and the saturation mixing ratio qgh, from which the Noah driver forms Q2SAT. The return path (Noah's skin temperature, surface mixing ratio and roughness into the NEXT step's surface layer) is not an edge here: WRF lags it by a step, and a consumer that integrates the column carries those fields itself (couplings/noah_column.esm). The slab takes flhc/flqc instead (couplings/lib/sfclayrev_slab.esm). Import with coupling_import + bind {Sfc, Pen, Can, Heat, Drv}.",
  "tags": [
   "coupling-library",
   "wrf",
   "surface-layer",
   "land-surface",
   "sfclayrev",
   "noah",
   "param_to_var"
  ]
 },
 "coupling_roles": {
  "Sfc": {
   "description": "WRF revised MM5 surface layer (sfclayrev); provides chs and qgh."
  },
  "Pen": {
   "description": "Noah PENMAN."
  },
  "Can": {
   "description": "Noah CANRES."
  },
  "Heat": {
   "description": "Noah soil heat and surface closure."
  },
  "Drv": {
   "description": "Noah driver forcing (surface_driver.esm)."
  }
 },
 "coupling": [
  {
   "type": "variable_map",
   "from": "Sfc.chs",
   "to": "Pen.ch",
   "transform": "param_to_var",
   "description": "the surface layer's heat/moisture exchange coefficient, Noah's CH (WRF passes CHS(I,J) as CHK)"
  },
  {
   "type": "variable_map",
   "from": "Sfc.chs",
   "to": "Can.ch",
   "transform": "param_to_var",
   "description": "the surface layer's heat/moisture exchange coefficient, Noah's CH (WRF passes CHS(I,J) as CHK)"
  },
  {
   "type": "variable_map",
   "from": "Sfc.chs",
   "to": "Heat.ch",
   "transform": "param_to_var",
   "description": "the surface layer's heat/moisture exchange coefficient, Noah's CH (WRF passes CHS(I,J) as CHK)"
  },
  {
   "type": "variable_map",
   "from": "Sfc.qgh",
   "to": "Drv.qgh",
   "transform": "param_to_var",
   "description": "the surface layer's saturation mixing ratio at the lowest level, from which the driver forms Q2SAT"
  }
 ]
}
