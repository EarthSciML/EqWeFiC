{
  "esm": "1.1.0",
  "metadata": {
    "name": "DudhiaSlabCoupling",
    "description": "Coupling library (esm-spec §10.9) feeding the Dudhia shortwave scheme's net surface shortwave into the slab land-surface energy balance. WRF calls radiation_driver before surface_driver, so the slab sees this step's GSW. One edge, but it is the shortwave half of the surface radiative forcing and is named separately from the longwave half so that swapping Dudhia for RRTMG changes exactly one import. Roles: Sw (Dudhia) and Lsm (slab). Extracted verbatim from couplings/scm_physics_column.esm. Import with coupling_import + bind {Sw, Lsm}.",
    "tags": ["coupling-library", "wrf", "shortwave", "land-surface", "dudhia", "slab", "param_to_var"]
  },
  "coupling_roles": {
    "Sw": {"description": "WRF Dudhia shortwave; provides gsw, the net downward shortwave at the surface."},
    "Lsm": {"description": "WRF slab land surface; its gsw parameter is driven by the shortwave scheme."}
  },
  "coupling": [
    {"type": "variable_map", "from": "Sw.gsw", "to": "Lsm.gsw", "transform": "param_to_var", "description": "Dudhia net surface shortwave into the land-surface energy balance (WRF order: radiation_driver -> surface_driver, so the slab sees this step's GSW)"}
  ]
}
