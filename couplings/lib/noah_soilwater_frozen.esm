{
 "esm": "1.1.0",
 "metadata": {
  "name": "NoahSoilWaterFrozenCoupling",
  "description": "Coupling library (esm-spec section 10.9) for Noah's two soil-water processes: SMFLX/SRT vertical transport (`soil_moisture.esm`) and the SNKSRC freeze/thaw phase change (`frozen_soil.esm`), driven from ONE assembly column state and reporting their two tendencies back for summation. Roles: Col (the assembly, which owns the column state and the shared soil parameters), Sm (the transport) and Frz (the phase change). THE LOAD-BEARING EDGES ARE THE SHARED ONES: smcmax and bexp are handed to both mounts from a single assembly copy, which is what makes the pair a coupling rather than two independent evaluations that happen to sit in one file -- in WRF they are necessarily the same numbers, and a document that let them drift would be reproducing something WRF cannot do. The column fields themselves (ze, sh2o, smc, stc, et, qtot, hcpct) are NOT edges here: both components take them through esm-spec section 4.2 rewrite-target `input_<name>` ops, which can only be lowered by a template library on the MOUNT edge, so the assembly supplies them there instead and identical expressions in the two libraries are what makes the state shared. Import with coupling_import + bind {Col, Sm, Frz}.",
  "tags": [
   "coupling-library",
   "wrf",
   "land-surface",
   "noah",
   "soil-moisture",
   "frozen-soil",
   "param_to_var"
  ]
 },
 "coupling_roles": {
  "Col": {
   "description": "The assembly. Owns the shared soil parameters and receives both tendencies, the clamp decision and SSTEP's projection indicator for summation and assertion."
  },
  "Sm": {
   "description": "Noah soil moisture (SMFLX/SRT/WDFCND as Richards' equation); provides dsh2o_dt, dsmc_dt and supersaturation_active."
  },
  "Frz": {
   "description": "Noah frozen-soil sink (TBND/TMPAVG/FRH2O/SNKSRC); provides dsh2o_dt_phase and phase_active."
  }
 },
 "coupling": [
  {
   "type": "variable_map",
   "from": "Col.smcmax",
   "to": "Sm.smcmax",
   "transform": "param_to_var",
   "description": "shared soil parameter smcmax into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.smcmax",
   "to": "Frz.smcmax",
   "transform": "param_to_var",
   "description": "the SAME smcmax into the phase change -- one copy driving both, which is what makes this a coupling and not two independent evaluations"
  },
  {
   "type": "variable_map",
   "from": "Col.bexp",
   "to": "Sm.bexp",
   "transform": "param_to_var",
   "description": "shared soil parameter bexp into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.bexp",
   "to": "Frz.bexp",
   "transform": "param_to_var",
   "description": "the SAME bexp into the phase change -- one copy driving both, which is what makes this a coupling and not two independent evaluations"
  },
  {
   "type": "variable_map",
   "from": "Col.edir",
   "to": "Sm.edir",
   "transform": "param_to_var",
   "description": "edir into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.ec",
   "to": "Sm.ec",
   "transform": "param_to_var",
   "description": "ec into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.etp",
   "to": "Sm.etp",
   "transform": "param_to_var",
   "description": "etp into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.prcp",
   "to": "Sm.prcp",
   "transform": "param_to_var",
   "description": "prcp into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.shdfac",
   "to": "Sm.shdfac",
   "transform": "param_to_var",
   "description": "shdfac into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.cmc",
   "to": "Sm.cmc",
   "transform": "param_to_var",
   "description": "cmc into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.smcwlt",
   "to": "Sm.smcwlt",
   "transform": "param_to_var",
   "description": "smcwlt into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.dksat",
   "to": "Sm.dksat",
   "transform": "param_to_var",
   "description": "dksat into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.dwsat",
   "to": "Sm.dwsat",
   "transform": "param_to_var",
   "description": "dwsat into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.kdt",
   "to": "Sm.kdt",
   "transform": "param_to_var",
   "description": "kdt into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.frzx",
   "to": "Sm.frzx",
   "transform": "param_to_var",
   "description": "frzx into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.slope",
   "to": "Sm.slope",
   "transform": "param_to_var",
   "description": "slope into the transport"
  },
  {
   "type": "variable_map",
   "from": "Col.tsurf",
   "to": "Frz.tsurf",
   "transform": "param_to_var",
   "description": "tsurf into the phase change"
  },
  {
   "type": "variable_map",
   "from": "Col.tbot",
   "to": "Frz.tbot",
   "transform": "param_to_var",
   "description": "tbot into the phase change"
  },
  {
   "type": "variable_map",
   "from": "Col.z_deep",
   "to": "Frz.z_deep",
   "transform": "param_to_var",
   "description": "z_deep into the phase change"
  },
  {
   "type": "variable_map",
   "from": "Col.psisat",
   "to": "Frz.psisat",
   "transform": "param_to_var",
   "description": "psisat into the phase change"
  },
  {
   "type": "variable_map",
   "from": "Sm.dsh2o_dt",
   "to": "Col.dsh2o_dt_transport_in",
   "transform": "param_to_var",
   "description": "expose the transport tendency to the assembly"
  },
  {
   "type": "variable_map",
   "from": "Sm.dsmc_dt",
   "to": "Col.dsmc_dt_transport_in",
   "transform": "param_to_var",
   "description": "expose the total-water tendency to the assembly"
  },
  {
   "type": "variable_map",
   "from": "Sm.supersaturation_active",
   "to": "Col.supersaturation_active_in",
   "transform": "param_to_var",
   "description": "expose SSTEP's projection indicator, which must be inactive for the sum to be meaningful"
  },
  {
   "type": "variable_map",
   "from": "Frz.dsh2o_dt_phase",
   "to": "Col.dsh2o_dt_phase_in",
   "transform": "param_to_var",
   "description": "expose the phase-change tendency to the assembly"
  },
  {
   "type": "variable_map",
   "from": "Frz.phase_active",
   "to": "Col.phase_active_in",
   "transform": "param_to_var",
   "description": "expose the clamp decision, so the assembly can assert it against WRF's own"
  }
 ]
}
