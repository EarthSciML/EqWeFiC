{
  "esm": "1.1.0",
  "metadata": {
    "name": "SlabYsuCoupling",
    "description": "Coupling library (esm-spec §10.9) carrying the slab land surface's recomputed surface fluxes into the YSU boundary layer. WRF's call order is sfclayrev -> slab -> YSU, so YSU sees the land-surface hfx/qfx rather than the surface layer's first guess; wiring this pair is what makes the fluxes computed rather than prescribed. Roles: Lsm (slab) and Pbl (YSU). Extracted verbatim from couplings/scm_physics_column.esm. Import with coupling_import + bind {Lsm, Pbl}.",
    "tags": ["coupling-library", "wrf", "land-surface", "pbl", "slab", "ysu", "param_to_var"]
  },
  "coupling_roles": {
    "Lsm": {"description": "WRF slab land surface; provides the sensible and moisture surface fluxes hfx, qfx after the land-surface energy balance."},
    "Pbl": {"description": "YSU boundary layer; its hfx and qfx parameters are driven by the land surface, not by the surface layer."}
  },
  "coupling": [
    {"type": "variable_map", "from": "Lsm.hfx", "to": "Pbl.hfx", "transform": "param_to_var", "description": "slab-recomputed sensible heat flux into the PBL scheme (WRF order: sfclayrev -> slab -> YSU); computed here, no longer prescribed"},
    {"type": "variable_map", "from": "Lsm.qfx", "to": "Pbl.qfx", "transform": "param_to_var", "description": "slab-recomputed moisture flux into the PBL scheme; computed here, no longer prescribed"}
  ]
}
