{
  "esm": "1.2.0",
  "metadata": {
    "name": "Chem170Join",
    "description": "Coupling library (esm-spec 10.9): the join of the chem_opt = 170 joint gas + aerosol column -- the edges couplings/chem170_column.esm writes between the CBM-Z column (role CBMZColumn), MOSAIC's host mapping (Host), the join model (Join, chem170_column.esm's own model), ASTEM's rates (Rates), the gas-particle column (GasParticle), nucleation (Nucleation) and the aerosol-chemistry column (AerChem): the sixteen mapped gases down in WRF's units, the density mapaer_tofrom_host forms cairclm from, ASTEM's and nucleation's gas exchange back up into the four exchanging gases' column tendencies, and every MOSAIC process's component tendency into Join.dr_dt. Copied verbatim from couplings/chem170_column.esm @ 4725833 (2026-11-14) so the Stage-3 column couplings/eqatmchem_scm.esm wires the chemistry exactly as the joint column does; chem170_column.esm itself still writes these edges inline and should import this library instead (one copy, not two).",
    "tags": [
      "coupling-library",
      "wrf-chem",
      "chem_opt-170",
      "mosaic"
    ]
  },
  "coupling_roles": {
    "AerChem": {
      "description": "The model mounted as AerChem in couplings/chem170_column.esm."
    },
    "CBMZColumn": {
      "description": "The model mounted as CBMZColumn in couplings/chem170_column.esm."
    },
    "GasParticle": {
      "description": "The model mounted as GasParticle in couplings/chem170_column.esm."
    },
    "Host": {
      "description": "The model mounted as Host in couplings/chem170_column.esm."
    },
    "Join": {
      "description": "The model mounted as Join in couplings/chem170_column.esm."
    },
    "Nucleation": {
      "description": "The model mounted as Nucleation in couplings/chem170_column.esm."
    },
    "Rates": {
      "description": "The model mounted as Rates in couplings/chem170_column.esm."
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "CBMZColumn.SO2",
      "to": "Join.x_so2",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.H2SO4",
      "to": "Join.x_h2so4",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.NO2",
      "to": "Join.x_no2",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.NO",
      "to": "Join.x_no",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.O3",
      "to": "Join.x_o3",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.HNO3",
      "to": "Join.x_hno3",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.H2O2",
      "to": "Join.x_h2o2",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.HCHO",
      "to": "Join.x_hcho",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.NH3",
      "to": "Join.x_nh3",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.N2O5",
      "to": "Join.x_n2o5",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.NO3",
      "to": "Join.x_no3",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.PAN",
      "to": "Join.x_pan",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.HONO",
      "to": "Join.x_hono",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.OH",
      "to": "Join.x_oh",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.HO2",
      "to": "Join.x_ho2",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.HCl",
      "to": "Join.x_hcl",
      "transform": "param_to_var",
      "description": "down: a CBM-Z gas MOSAIC maps"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.conv",
      "to": "Join.conv",
      "transform": "param_to_var",
      "description": "down: molec/cm3 -> ppmv"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.rho",
      "to": "Host.rho_phy",
      "transform": "param_to_var",
      "description": "down: the air density mapaer_tofrom_host forms cairclm from (the KPP interface's rho_phy; the same field at a step)"
    },
    {
      "type": "variable_map",
      "from": "Join.chem_gas",
      "to": "Host.chem_gas",
      "transform": "param_to_var",
      "description": "down: the gases on the host, ppmv"
    },
    {
      "type": "variable_map",
      "from": "Host.gas",
      "to": "Join.gas_mm",
      "transform": "param_to_var",
      "description": "down: rsub, the mole fractions MOSAIC computes with"
    },
    {
      "type": "variable_map",
      "from": "Host.cair",
      "to": "Join.cair",
      "transform": "param_to_var",
      "description": "down: cairclm"
    },
    {
      "type": "variable_map",
      "from": "Join.gas_nmol",
      "to": "Rates.gas",
      "transform": "param_to_var",
      "description": "down: ASTEM's five condensing gases, nmol/m3"
    },
    {
      "type": "variable_map",
      "from": "Join.gas_nmol",
      "to": "GasParticle.gas",
      "transform": "param_to_var",
      "description": "down: the same gases, the ones conform_electrolytes' first bin sees"
    },
    {
      "type": "variable_map",
      "from": "Join.q_h2so4",
      "to": "Nucleation.q_h2so4",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "down: the H2SO4 nucleation reads, lifted over the levels"
    },
    {
      "type": "variable_map",
      "from": "Join.q_nh3",
      "to": "Nucleation.q_nh3",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "down: the NH3 nucleation reads, lifted over the levels"
    },
    {
      "type": "variable_map",
      "from": "Rates.dgas",
      "to": "Join.dgas",
      "transform": "param_to_var",
      "description": "up: ASTEM's gas tendencies"
    },
    {
      "type": "variable_map",
      "from": "Rates.daer",
      "to": "Join.daer",
      "transform": "param_to_var",
      "description": "up: ASTEM's condensation per section"
    },
    {
      "type": "variable_map",
      "from": "AerChem.dh2so4_dt",
      "to": "Join.nuc_h2so4",
      "transform": "param_to_var",
      "description": "up: nucleation's H2SO4 uptake"
    },
    {
      "type": "variable_map",
      "from": "AerChem.dnh3_dt",
      "to": "Join.nuc_nh3",
      "transform": "param_to_var",
      "description": "up: nucleation's NH3 uptake"
    },
    {
      "type": "variable_map",
      "from": "AerChem.dr_dt",
      "to": "Join.dr_chem",
      "transform": "param_to_var",
      "description": "the aerosol-chemistry column's component tendencies"
    },
    {
      "type": "variable_map",
      "from": "Join.aerosol_H2SO4",
      "to": "CBMZColumn.aerosol_H2SO4",
      "transform": "param_to_var",
      "description": "up: H2SO4 exchanged with the aerosol, a term of its column tendency"
    },
    {
      "type": "variable_map",
      "from": "Join.aerosol_HNO3",
      "to": "CBMZColumn.aerosol_HNO3",
      "transform": "param_to_var",
      "description": "up: HNO3 exchanged with the aerosol, a term of its column tendency"
    },
    {
      "type": "variable_map",
      "from": "Join.aerosol_HCl",
      "to": "CBMZColumn.aerosol_HCl",
      "transform": "param_to_var",
      "description": "up: HCl exchanged with the aerosol, a term of its column tendency"
    },
    {
      "type": "variable_map",
      "from": "Join.aerosol_NH3",
      "to": "CBMZColumn.aerosol_NH3",
      "transform": "param_to_var",
      "description": "up: NH3 exchanged with the aerosol, a term of its column tendency"
    }
  ]
}
