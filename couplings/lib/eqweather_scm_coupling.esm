{
 "esm": "1.2.0",
 "metadata": {
  "name": "EqWeatherScmCoupling",
  "description": "Coupling library (esm-spec 10.9): the 336 variable_map edges of the EqWeather single-column model -- the ODE state (role EqWeatherScm) into the column geometry, every mounted scheme's inputs from that state and from each other, and every scheme's tendency back into the state. Moved out of couplings/eqweather_scm.esm on 2026-11-20 so that the instantaneous-tendency document and the trajectory document couplings/eqweather_scm_trajectory.esm wire the column from one copy. The six scheme-internal libraries (sfclayrev_ysu, rrtm_lw_chain, ...) stay imported by each document directly.",
  "tags": [
   "coupling-library",
   "wrf",
   "scm"
  ]
 },
 "coupling_roles": {
  "Cldfra": {
   "description": "The model mounted as Cldfra in couplings/eqweather_scm.esm."
  },
