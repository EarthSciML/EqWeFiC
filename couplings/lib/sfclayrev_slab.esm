{
  "esm": "1.1.0",
  "metadata": {
    "name": "SfclayrevSlabCoupling",
    "description": "Coupling library (esm-spec §10.9) handing the revised MM5 surface layer's exchange coefficients to the WRF slab land surface, which uses them to close the surface energy balance. Roles: Sfc (sfclayrev, exposing flhc and flqc) and Lsm (slab). This pair is scheme-specific: a Noah or Noah-MP land surface takes a different set, so it gets its own library rather than reusing this one. Extracted verbatim from couplings/scm_physics_column.esm. Import with coupling_import + bind {Sfc, Lsm}.",
    "tags": ["coupling-library", "wrf", "surface-layer", "land-surface", "sfclayrev", "slab", "param_to_var"]
  },
  "coupling_roles": {
    "Sfc": {"description": "WRF revised MM5 surface layer (sfclayrev); provides the heat and moisture exchange coefficients flhc, flqc."},
    "Lsm": {"description": "WRF slab land surface; its flhc and flqc parameters are driven by the surface layer."}
  },
  "coupling": [
    {"type": "variable_map", "from": "Sfc.flhc", "to": "Lsm.flhc", "transform": "param_to_var", "description": "surface-layer heat exchange coefficient into the land surface"},
    {"type": "variable_map", "from": "Sfc.flqc", "to": "Lsm.flqc", "transform": "param_to_var", "description": "surface-layer moisture exchange coefficient into the land surface"}
  ]
}
