{
  "esm": "1.1.0",
  "metadata": {
    "name": "SfclayrevYsuCoupling",
    "description": "Coupling library (esm-spec §10.9) wiring WRF's revised MM5 surface layer (sfclayrev) into the YSU boundary layer, the pair WRF runs as surface_driver -> pbl_driver. Roles: Sfc (a sfclayrev model exposing ust, br, wspd, u10, v10, znt, fm, fh) and Pbl (YSU, whose same-named parameters become time-varying). Note the two renames: YSU's psim/psih are the full profile functions ln(z1/z0) - psi_{m,h}, which is what sfclayrev calls fm/fh, and WRF passes FM as PSIM (bl_ysu.F90: 'psim psih are ln(z1/z0)-psim,h'). Extracted verbatim from couplings/scm_physics_column.esm, whose Fortran-dump tests exercise every edge. Import with coupling_import + bind {Sfc, Pbl}.",
    "tags": ["coupling-library", "wrf", "surface-layer", "pbl", "sfclayrev", "ysu", "param_to_var"]
  },
  "coupling_roles": {
    "Sfc": {"description": "WRF revised MM5 surface layer (sfclayrev); provides friction velocity, bulk Richardson number, wind speed, 10 m winds, roughness length and the momentum/heat profile functions fm/fh."},
    "Pbl": {"description": "YSU boundary layer; its ust, br, wspd, u10, v10, znt, psim and psih parameters are driven by the surface layer."}
  },
  "coupling": [
    {"type": "variable_map", "from": "Sfc.ust", "to": "Pbl.ust", "transform": "param_to_var", "description": "surface-layer ust drives the PBL scheme (the physical coupling)"},
    {"type": "variable_map", "from": "Sfc.br", "to": "Pbl.br", "transform": "param_to_var", "description": "surface-layer br drives the PBL scheme (the physical coupling)"},
    {"type": "variable_map", "from": "Sfc.wspd", "to": "Pbl.wspd", "transform": "param_to_var", "description": "surface-layer wspd drives the PBL scheme (the physical coupling)"},
    {"type": "variable_map", "from": "Sfc.u10", "to": "Pbl.u10", "transform": "param_to_var", "description": "surface-layer u10 drives the PBL scheme (the physical coupling)"},
    {"type": "variable_map", "from": "Sfc.v10", "to": "Pbl.v10", "transform": "param_to_var", "description": "surface-layer v10 drives the PBL scheme (the physical coupling)"},
    {"type": "variable_map", "from": "Sfc.znt", "to": "Pbl.znt", "transform": "param_to_var", "description": "surface-layer znt drives the PBL scheme (the physical coupling)"},
    {"type": "variable_map", "from": "Sfc.fm", "to": "Pbl.psim", "transform": "param_to_var", "description": "YSU's psim is the full momentum profile function ln(z1/z0) - psi_m = sfclayrev's fm (bl_ysu.F90: 'psim psih are ln(z1/z0)-psim,h'); WRF passes FM as PSIM"},
    {"type": "variable_map", "from": "Sfc.fh", "to": "Pbl.psih", "transform": "param_to_var", "description": "YSU's psih is the heat profile function ln(z1/z0) - psi_h = sfclayrev's fh"}
  ]
}
