{
  "esm": "1.2.0",
  "metadata": {
    "name": "WRFChemEmissionsDriverAerosol",
    "description": "Coupling library (esm-spec \u00a710.9): the MOSAIC half of WRF-Chem's emissions_driver for chem_opt = 170 with emiss_opt = 4 -- the column state handed to the anthropogenic part of mosaic_addemiss (Aer) and its per-section layer-1 increments handed back to the column. Extracted verbatim from couplings/emissions_column.esm on 2026-11-12, beside its gas half (wrf_chem_emissions_driver_gas.esm), so that a gas-only chemistry column can import the gas half without mounting MOSAIC. Roles: Col (EmissionsColumn), Aer (MosaicAnthroEmissions).",
    "tags": [
      "coupling-library",
      "wrf-chem",
      "emissions",
      "mosaic",
      "param_to_var"
    ]
  },
  "coupling_roles": {
    "Col": {
      "description": "EmissionsColumn."
    },
    "Aer": {
      "description": "MosaicAnthroEmissions (mosaic_addemiss, anthropogenic part)."
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Col.dz1",
      "to": "Aer.dz",
      "transform": "param_to_var",
      "description": "emission-layer depth dz8w(1)"
    },
    {
      "type": "variable_map",
      "from": "Col.alt1",
      "to": "Aer.alt",
      "transform": "param_to_var",
      "description": "emission-layer specific volume"
    },
    {
      "type": "variable_map",
      "from": "Col.emiss_inpt_opt",
      "to": "Aer.emiss_inpt_opt",
      "transform": "param_to_var",
      "description": "input variety"
    },
    {
      "type": "variable_map",
      "from": "Col.volumcen",
      "to": "Aer.volumcen",
      "transform": "param_to_var",
      "description": "MOSAIC section centre volumes"
    },
    {
      "type": "variable_map",
      "from": "Aer.d_so4",
      "to": "Col.sfc_so4",
      "transform": "param_to_var",
      "description": "MOSAIC so4 per section"
    },
    {
      "type": "variable_map",
      "from": "Aer.d_no3",
      "to": "Col.sfc_no3",
      "transform": "param_to_var",
      "description": "MOSAIC no3 per section"
    },
    {
      "type": "variable_map",
      "from": "Aer.d_oc",
      "to": "Col.sfc_oc",
      "transform": "param_to_var",
      "description": "MOSAIC oc per section"
    },
    {
      "type": "variable_map",
      "from": "Aer.d_bc",
      "to": "Col.sfc_bc",
      "transform": "param_to_var",
      "description": "MOSAIC bc per section"
    },
    {
      "type": "variable_map",
      "from": "Aer.d_oin",
      "to": "Col.sfc_oin",
      "transform": "param_to_var",
      "description": "MOSAIC oin per section"
    },
    {
      "type": "variable_map",
      "from": "Aer.d_num",
      "to": "Col.sfc_num",
      "transform": "param_to_var",
      "description": "MOSAIC num per section"
    }
  ]
}
