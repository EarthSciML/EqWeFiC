{
  "esm": "1.1.0",
  "metadata": {
    "name": "CBMZColumnProcesses",
    "description": "Coupling library (esm-spec 10.9): the variable_map edges of the CBM-Z chemistry column (see couplings/cbmz_column.esm) -- the column's temperature, air density and photolysis frequencies lifted pointwise into the rate constants, the fixed species into the mechanism, and the column and surface fields into the emissions_driver assembly, Wesely and wet scavenging. Factored out of couplings/cbmz_column.esm on 2026-11-13 so the joint gas + aerosol column couplings/chem170_column.esm wires them identically. NOT here: the operator_compose that lifts the mechanism and the peroxy-pool and emissions-driver library imports, which each importer states itself.",
    "tags": [
      "coupling-library",
      "wrf-chem",
      "chem_opt-170"
    ]
  },
  "coupling_roles": {
    "CBMZColumn": {
      "description": "The model mounted as CBMZColumn in couplings/cbmz_column.esm."
    },
    "CBMZRateConstants": {
      "description": "The model mounted as CBMZRateConstants in couplings/cbmz_column.esm."
    },
    "CBMZ": {
      "description": "The reaction system mounted as CBMZ in couplings/cbmz_column.esm."
    },
    "EmissionsColumn": {
      "description": "The model mounted as EmissionsColumn in couplings/cbmz_column.esm."
    },
    "WeselyRc": {
      "description": "The model mounted as WeselyRc in couplings/cbmz_column.esm."
    },
    "WeselyVd": {
      "description": "The model mounted as WeselyVd in couplings/cbmz_column.esm."
    },
    "DryDep": {
      "description": "The model mounted as DryDep in couplings/cbmz_column.esm."
    },
    "WetDep": {
      "description": "The model mounted as WetDep in couplings/cbmz_column.esm."
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "CBMZColumn.T",
      "to": "CBMZRateConstants.T",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.M_air",
      "to": "CBMZRateConstants.M_air",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.j_o31d",
      "to": "CBMZRateConstants.j_o31d",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.j_o33p",
      "to": "CBMZRateConstants.j_o33p",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.j_no2",
      "to": "CBMZRateConstants.j_no2",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.j_no3o",
      "to": "CBMZRateConstants.j_no3o",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.j_hno2",
      "to": "CBMZRateConstants.j_hno2",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.j_hno3",
      "to": "CBMZRateConstants.j_hno3",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.j_hno4",
      "to": "CBMZRateConstants.j_hno4",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.j_h2o2",
      "to": "CBMZRateConstants.j_h2o2",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.j_ch2or",
      "to": "CBMZRateConstants.j_ch2or",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.j_ch2om",
      "to": "CBMZRateConstants.j_ch2om",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.H2O",
      "to": "CBMZ.H2O",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.M_fix",
      "to": "CBMZ.M",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.HCl",
      "to": "CBMZ.HCl",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.NH3",
      "to": "CBMZ.NH3",
      "transform": "param_to_var",
      "lifting": "pointwise"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.T",
      "to": "EmissionsColumn.T",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.p",
      "to": "EmissionsColumn.p",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.rho",
      "to": "EmissionsColumn.rho",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.alt",
      "to": "EmissionsColumn.alt",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.ze",
      "to": "EmissionsColumn.ze",
