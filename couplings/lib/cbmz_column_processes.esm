    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.n_gas",
      "to": "WeselyRc.n_gas",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "WeselyRc.srfres",
      "to": "WeselyVd.srfres",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.ustar",
      "to": "WeselyVd.ustar",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.rmol",
      "to": "WeselyVd.rmol_in",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.z0",
      "to": "WeselyVd.z0",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.dz1",
      "to": "WeselyVd.dz1",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.gas_slot",
      "to": "WeselyVd.igas",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.wesely_mech",
      "to": "WeselyVd.mech",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "WeselyVd.vd",
