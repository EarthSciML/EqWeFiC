      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.emiss_inpt_opt",
      "to": "EmissionsColumn.emiss_inpt_opt",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.volumcen",
      "to": "EmissionsColumn.volumcen",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.T_sfc",
