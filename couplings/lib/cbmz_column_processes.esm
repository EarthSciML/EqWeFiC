      "to": "WeselyRc.rad",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.rh",
      "to": "WeselyRc.rh",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.wetflag",
      "to": "WeselyRc.wetflag",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.rainflag",
      "to": "WeselyRc.rainflag",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.highnh3",
      "to": "WeselyRc.highnh3",
      "transform": "param_to_var"
    },
    {
      "type": "variable_map",
      "from": "CBMZColumn.iland",
