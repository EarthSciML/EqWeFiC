{
  "esm": "1.2.0",
  "metadata": {
    "name": "WRFChemEmissionsDriverGas",
    "description": "Coupling library (esm-spec \u00a710.9): the gas half of WRF-Chem's emissions_driver for chem_opt = 170 with emiss_opt = 4 and bio_emiss_opt = 1 -- the column state handed to Gunther's biogenic scheme (Bio), the CBM-Z anthropogenic scheme (Anthro) and add_biogenics' GUNTHER1 mapping (BioCbmz), the e_bio edge Bio -> BioCbmz, and each CBM-Z species' layer-1 increment (anthropogenic plus biogenic where both emit it) handed back to the column's sfc_<species>. Extracted verbatim from couplings/emissions_column.esm on 2026-11-12 so that the chemistry column (couplings/cbmz_column.esm) wires the emissions exactly as the emissions test does. Roles: Col (EmissionsColumn of couplings/emissions_column.esm), Bio, BioCbmz, Anthro.",
    "tags": [
      "coupling-library",
      "wrf-chem",
      "emissions",
      "cbm-z",
      "gunther",
      "param_to_var"
    ]
  },
  "coupling_roles": {
    "Col": {
      "description": "EmissionsColumn: the emission layer's state and the per-species surface tendencies."
    },
    "Bio": {
      "description": "GuntherBiogenicEmissions (bio_emissions)."
    },
    "BioCbmz": {
      "description": "GuntherToCBMZ (add_biogenics, GUNTHER1)."
    },
    "Anthro": {
      "description": "CBMZAnthroEmissions (cbmz_addemiss_anthro)."
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Col.T1",
      "to": "Bio.T",
      "transform": "param_to_var",
      "description": "emission-layer T1 into the Gunther biogenic scheme"
    },
    {
      "type": "variable_map",
      "from": "Col.p1",
      "to": "Bio.p",
      "transform": "param_to_var",
      "description": "emission-layer p1 into the Gunther biogenic scheme"
    },
    {
      "type": "variable_map",
      "from": "Col.gsw",
      "to": "Bio.gsw",
      "transform": "param_to_var",
      "description": "emission-layer gsw into the Gunther biogenic scheme"
    },
    {
      "type": "variable_map",
      "from": "Col.lu",
      "to": "Bio.lu",
      "transform": "param_to_var",
      "description": "emission-layer lu into the Gunther biogenic scheme"
    },
    {
      "type": "variable_map",
      "from": "Col.julday",
      "to": "Bio.julday",
      "transform": "param_to_var",
      "description": "emission-layer julday into the Gunther biogenic scheme"
    },
    {
      "type": "variable_map",
      "from": "Bio.e_bio",
      "to": "BioCbmz.e_bio",
      "transform": "param_to_var",
      "description": "bio_emissions' e_bio into add_biogenics (the only edge between two schemes)"
    },
    {
      "type": "variable_map",
      "from": "Col.dz1",
      "to": "Anthro.dz",
      "transform": "param_to_var",
      "description": "emission-layer depth dz8w(1)"
    },
    {
      "type": "variable_map",
      "from": "Col.dz1",
      "to": "BioCbmz.dz",
      "transform": "param_to_var",
      "description": "emission-layer depth dz8w(1)"
    },
    {
      "type": "variable_map",
      "from": "Col.rho1",
      "to": "Anthro.rho",
      "transform": "param_to_var",
      "description": "emission-layer density"
    },
    {
      "type": "variable_map",
      "from": "Col.emiss_inpt_opt",
      "to": "Anthro.emiss_inpt_opt",
      "transform": "param_to_var",
      "description": "input variety"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_so2",
      "to": "Col.sfc_so2",
      "transform": "param_to_var",
      "description": "SO2 from Anthro alone"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_no",
      "to": "Col.sfc_no",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_no",
          "BioCbmz.d_no"
        ]
      },
      "description": "NO: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_no2",
      "to": "Col.sfc_no2",
      "transform": "param_to_var",
      "description": "NO2 from Anthro alone"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_co",
      "to": "Col.sfc_co",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_co",
          "BioCbmz.d_co"
        ]
      },
      "description": "CO: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_eth",
      "to": "Col.sfc_eth",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_eth",
          "BioCbmz.d_eth"
        ]
      },
      "description": "ETH: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_ol2",
      "to": "Col.sfc_ol2",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_ol2",
          "BioCbmz.d_ol2"
        ]
      },
      "description": "OL2: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_olt",
      "to": "Col.sfc_olt",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_olt",
          "BioCbmz.d_olt"
        ]
      },
      "description": "OLT: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_oli",
      "to": "Col.sfc_oli",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_oli",
          "BioCbmz.d_oli"
        ]
      },
      "description": "OLI: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_tol",
      "to": "Col.sfc_tol",
      "transform": "param_to_var",
      "description": "TOL from Anthro alone"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_xyl",
      "to": "Col.sfc_xyl",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_xyl",
          "BioCbmz.d_xyl"
        ]
      },
      "description": "XYL: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_csl",
      "to": "Col.sfc_csl",
      "transform": "param_to_var",
      "description": "CSL from Anthro alone"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_hcho",
      "to": "Col.sfc_hcho",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_hcho",
          "BioCbmz.d_hcho"
        ]
      },
      "description": "HCHO: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_ald",
      "to": "Col.sfc_ald",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_ald",
          "BioCbmz.d_ald"
        ]
      },
      "description": "ALD: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_ket",
      "to": "Col.sfc_ket",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_ket",
          "BioCbmz.d_ket"
        ]
      },
      "description": "KET: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_ora2",
      "to": "Col.sfc_ora2",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_ora2",
          "BioCbmz.d_ora2"
        ]
      },
      "description": "ORA2: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_par",
      "to": "Col.sfc_par",
      "transform": {
        "op": "+",
        "args": [
          "Anthro.d_par",
          "BioCbmz.d_par"
        ]
      },
      "description": "PAR: anthropogenic plus biogenic"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_nh3",
      "to": "Col.sfc_nh3",
      "transform": "param_to_var",
      "description": "NH3 from Anthro alone"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_ch3oh",
      "to": "Col.sfc_ch3oh",
      "transform": "param_to_var",
      "description": "CH3OH from Anthro alone"
    },
    {
      "type": "variable_map",
      "from": "Anthro.d_c2h5oh",
      "to": "Col.sfc_c2h5oh",
      "transform": "param_to_var",
      "description": "C2H5OH from Anthro alone"
    },
    {
      "type": "variable_map",
      "from": "BioCbmz.d_iso",
      "to": "Col.sfc_iso",
      "transform": "param_to_var",
      "description": "ISO from BioCbmz alone"
    }
  ]
}
