{
  "esm": "1.1.0",
  "metadata": {
    "name": "RrtmLwSlabCoupling",
    "description": "Coupling library (esm-spec §10.9) feeding RRTM's downward surface longwave into the slab land-surface energy balance — the longwave half of the surface radiative forcing, the counterpart of lib/dudhia_slab.esm. The role is bound to the RRTM heating-rate model, which is the stage that diagnoses glw from the flux profile. Roles: Heat (rrtm_lw_heating) and Lsm (slab). Extracted verbatim from couplings/scm_physics_column.esm. Import with coupling_import + bind {Heat, Lsm}.",
    "tags": ["coupling-library", "wrf", "longwave", "land-surface", "rrtm", "slab", "param_to_var"]
  },
  "coupling_roles": {
    "Heat": {"description": "WRF RRTM longwave heating-rate stage; provides glw, the downward longwave at the surface."},
    "Lsm": {"description": "WRF slab land surface; its glw parameter is driven by the longwave scheme."}
  },
  "coupling": [
    {"type": "variable_map", "from": "Heat.glw", "to": "Lsm.glw", "transform": "param_to_var", "description": "RRTM downward surface longwave into the land-surface energy balance"}
  ]
}
