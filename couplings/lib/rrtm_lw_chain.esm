{
  "esm": "1.1.0",
  "metadata": {
    "name": "RrtmLwChainCoupling",
    "description": "Coupling library (esm-spec \u00a710.9) wiring the four stages WRF's RRTM longwave runs in sequence inside a single call: the MM5ATM column mapping (Col) feeds SETCOEF (Setcoef) and, directly, the gas optics (GasOpt) and the radiative-transfer sweep (Rtrn); SETCOEF's interpolation indices and fractions feed the gas optics; and the gas optics' Planck fractions and optical depths feed the sweep. This is an internal chain, not a scheme-to-scheme interaction: its external surface (the column state in, glw/olr/heating out) is the same whichever way the stages are split, which is what makes it safe to bundle as one library. Roles: Col, Setcoef, GasOpt, Rtrn. Extracted verbatim from couplings/scm_physics_column.esm, whose Fortran-dump tests exercise every edge. Import with coupling_import + bind {Col, Setcoef, GasOpt, Rtrn}.",
    "tags": [
      "coupling-library",
      "wrf",
      "longwave",
      "rrtm",
      "radiative-transfer",
      "param_to_var"
    ]
  },
  "coupling_roles": {
    "Col": {
      "description": "RRTM MM5ATM column mapping; provides the layer pressures/temperatures (pavel, tavel, tz, pz), the column gas amounts (coldry, colh2o, colco2, colo3, coln2o, colch4), the cloud properties (cldfrac, taucloud) and the surface boundary (semiss, tbound)."
    },
    "Setcoef": {
      "description": "RRTM SETCOEF; provides the reference-atmosphere interpolation indices (jp, jt, jt1, indself), the interpolation fractions (fac00/10/01/11, forfac, selffac, selffrac), co2mult and the layer counts laytrop, layswtch, laylow."
    },
    "GasOpt": {
      "description": "RRTM per-band gas optics (TAUGBn); driven by Col's column amounts and Setcoef's indices and fractions, and provides the flattened Planck fractions pfrac_flat and optical depths itr_flat."
    },
    "Rtrn": {
      "description": "RRTM RTRN upward/downward radiative-transfer sweep; driven by Col's profile and cloud fields and by GasOpt's per-g-point optics."
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Col.pavel",
      "to": "Setcoef.pavel_in",
      "transform": "param_to_var",
      "description": "MM5ATM pavel into SETCOEF"
    },
    {
      "type": "variable_map",
      "from": "Col.tavel",
      "to": "Setcoef.tavel_in",
      "transform": "param_to_var",
      "description": "MM5ATM tavel into SETCOEF"
    },
    {
      "type": "variable_map",
      "from": "Col.coldry",
      "to": "Setcoef.coldry_in",
      "transform": "param_to_var",
      "description": "MM5ATM coldry into SETCOEF"
    },
    {
      "type": "variable_map",
      "from": "Col.colh2o",
      "to": "Setcoef.colh2o_in",
      "transform": "param_to_var",
      "description": "MM5ATM colh2o into SETCOEF"
    },
    {
      "type": "variable_map",
      "from": "Col.colco2",
      "to": "Setcoef.colco2_in",
      "transform": "param_to_var",
      "description": "MM5ATM colco2 into SETCOEF"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.jp",
      "to": "GasOpt.jp_in",
      "transform": "param_to_var",
      "description": "SETCOEF jp into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.jt",
      "to": "GasOpt.jt_in",
      "transform": "param_to_var",
      "description": "SETCOEF jt into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.jt1",
      "to": "GasOpt.jt1_in",
      "transform": "param_to_var",
      "description": "SETCOEF jt1 into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.indself",
      "to": "GasOpt.indself_in",
      "transform": "param_to_var",
      "description": "SETCOEF indself into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.fac00",
      "to": "GasOpt.fac00_in",
      "transform": "param_to_var",
      "description": "SETCOEF fac00 into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.fac10",
      "to": "GasOpt.fac10_in",
      "transform": "param_to_var",
      "description": "SETCOEF fac10 into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.fac01",
      "to": "GasOpt.fac01_in",
      "transform": "param_to_var",
      "description": "SETCOEF fac01 into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.fac11",
      "to": "GasOpt.fac11_in",
      "transform": "param_to_var",
      "description": "SETCOEF fac11 into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.forfac",
      "to": "GasOpt.forfac_in",
      "transform": "param_to_var",
      "description": "SETCOEF forfac into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.selffac",
      "to": "GasOpt.selffac_in",
      "transform": "param_to_var",
      "description": "SETCOEF selffac into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.selffrac",
      "to": "GasOpt.selffrac_in",
      "transform": "param_to_var",
      "description": "SETCOEF selffrac into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.co2mult",
      "to": "GasOpt.co2mult_in",
      "transform": "param_to_var",
      "description": "SETCOEF co2mult into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.laytrop",
      "to": "GasOpt.laytrop",
      "transform": "param_to_var",
      "description": "SETCOEF layer count laytrop into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.layswtch",
      "to": "GasOpt.layswtch",
      "transform": "param_to_var",
      "description": "SETCOEF layer count layswtch into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Setcoef.laylow",
      "to": "GasOpt.laylow",
      "transform": "param_to_var",
      "description": "SETCOEF layer count laylow into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Col.colh2o",
      "to": "GasOpt.colh2o_in",
      "transform": "param_to_var",
      "description": "MM5ATM column amount colh2o into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Col.colco2",
      "to": "GasOpt.colco2_in",
      "transform": "param_to_var",
      "description": "MM5ATM column amount colco2 into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Col.colo3",
      "to": "GasOpt.colo3_in",
      "transform": "param_to_var",
      "description": "MM5ATM column amount colo3 into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Col.coln2o",
      "to": "GasOpt.coln2o_in",
      "transform": "param_to_var",
      "description": "MM5ATM column amount coln2o into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Col.colch4",
      "to": "GasOpt.colch4_in",
      "transform": "param_to_var",
      "description": "MM5ATM column amount colch4 into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Col.coldry",
      "to": "GasOpt.coldry_in",
      "transform": "param_to_var",
      "description": "MM5ATM column amount coldry into the gas optics"
    },
    {
      "type": "variable_map",
      "from": "Col.tavel",
      "to": "Rtrn.tavel_in",
      "transform": "param_to_var",
      "description": "MM5ATM tavel into RTRN"
    },
    {
      "type": "variable_map",
      "from": "Col.tz",
      "to": "Rtrn.tz_in",
      "transform": "param_to_var",
      "description": "MM5ATM tz into RTRN"
    },
    {
      "type": "variable_map",
      "from": "Col.pz",
      "to": "Rtrn.pz_in",
      "transform": "param_to_var",
      "description": "MM5ATM pz into RTRN"
    },
    {
      "type": "variable_map",
      "from": "Col.cldfrac",
      "to": "Rtrn.cldfrac_in",
      "transform": "param_to_var",
      "description": "MM5ATM cldfrac into RTRN"
    },
    {
      "type": "variable_map",
      "from": "Col.taucloud",
      "to": "Rtrn.taucloud_in",
      "transform": "param_to_var",
      "description": "MM5ATM taucloud into RTRN"
    },
    {
      "type": "variable_map",
      "from": "Col.semiss",
      "to": "Rtrn.semiss_in",
      "transform": "param_to_var",
      "description": "MM5ATM semiss into RTRN"
    },
    {
      "type": "variable_map",
      "from": "Col.tbound",
      "to": "Rtrn.tbound",
      "transform": "param_to_var",
      "description": "MM5ATM surface temperature TBOUND into RTRN"
    },
    {
      "type": "variable_map",
      "from": "GasOpt.pfrac_flat",
      "to": "Rtrn.pfrac_flat_in",
      "transform": "param_to_var",
      "description": "gas optics pfrac_flat (g-point fastest) into RTRN"
    },
    {
      "type": "variable_map",
      "from": "GasOpt.itr_flat",
      "to": "Rtrn.itr_flat_in",
      "transform": "param_to_var",
      "description": "gas optics itr_flat (g-point fastest) into RTRN"
    }
  ]
}
