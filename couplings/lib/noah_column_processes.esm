{
 "esm": "1.2.0",
 "metadata": {
  "name": "NoahColumnProcessesCoupling",
  "description": "Coupling library (esm-spec 10.9) for the snow-free, unfrozen Noah column: WRF's SFLX call sequence REDPRM -> (driver forcing) -> PENMAN -> CANRES -> NOPAC (EVAPO, SMFLX, SHFLX) written as edges between the process components, all evaluated at ONE column state owned by the assembly. The sequence matters only through what it hands on: the incoming-skin-temperature ground flux into PENMAN (Heat.ssoil_pre -> Pen.ssoil), PENMAN's rch/rr/epsca and the evapotranspiration's beta into the surface closure, the potential evaporation into EVAPO and SMFLX, and the canopy and soil evaporation and per-layer transpiration into the water budget. The column fields themselves reach the leaves through their mount-edge library (couplings/tests/noahcol_couple_soil_inputs.esm) and the stc_in/smc_in/sh2o_in/et_in coupling targets fed here. NOT IN THIS LIBRARY: the surface layer (couplings/lib/sfclayrev_noah.esm), the frozen-soil phase change (couplings/lib/noah_soilwater_frozen.esm), and the snow pack. Import with coupling_import + bind {Col, Veg, Pen, Can, Et, Heat, Sm, Drv}.",
  "tags": [
   "coupling-library",
   "wrf",
   "land-surface",
   "noah",
   "param_to_var"
  ]
 },
 "coupling_roles": {
  "Col": {
   "description": "The assembly: owns the soil column state (stc, smc, sh2o, cmc), the surface categories and greenness, tbot/z_deep, the root depth, the incoming skin temperature tsk_in and the downward shortwave, and receives the four tendencies."
  },
  "Veg": {
   "description": "Noah REDPRM parameter tables (soil_veg_parameters.esm)."
  },
  "Pen": {
   "description": "PENMAN (potential_evaporation.esm)."
  },
  "Can": {
   "description": "CANRES (canopy_resistance.esm)."
  },
  "Et": {
   "description": "EVAPO/DEVAP/TRANSP (evapotranspiration.esm)."
  },
  "Heat": {
   "description": "TDFCND/HRT/SHFLX and the surface closure (soil_heat.esm)."
  },
  "Sm": {
   "description": "SMFLX/SRT/WDFCND (soil_moisture.esm)."
  },
  "Drv": {
   "description": "The Noah driver's forcing, the snow-free surface properties and q1/qsfc (surface_driver.esm)."
  }
 },
