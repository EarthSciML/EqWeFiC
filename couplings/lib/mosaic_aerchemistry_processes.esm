{
  "esm": "1.1.0",
  "metadata": {
    "name": "MosaicAerchemistryProcesses",
    "description": "Coupling library (esm-spec 10.9): the edges of MOSAIC's aerosol-chemistry column processes -- coagulation (entry state, the pair kernel lifted over every pair of sections, the assembly), nucleation lifted over the levels, and aerosol dry deposition lifted over the lowest layer's sections -- between the column model that holds the MOSAIC state (role Column) and the components. Factored out of couplings/mosaic_aerchemistry_column.esm on 2026-11-13 so the joint gas + aerosol column couplings/chem170_column.esm wires them identically. NOT here: the two gas-phase inputs of nucleation (H2SO4, NH3), which each importer supplies -- the aerosol-only column from its own parameters, the joint column from the CBM-Z state.",
    "tags": [
      "coupling-library",
      "wrf-chem",
      "chem_opt-170"
    ]
  },
  "coupling_roles": {
    "Column": {
      "description": "The model mounted as Column in couplings/mosaic_aerchemistry_column.esm."
    },
    "CoagEntry": {
      "description": "The model mounted as CoagEntry in couplings/mosaic_aerchemistry_column.esm."
    },
    "CoagKernel": {
      "description": "The model mounted as CoagKernel in couplings/mosaic_aerchemistry_column.esm."
    },
    "CoagAssembly": {
      "description": "The model mounted as CoagAssembly in couplings/mosaic_aerchemistry_column.esm."
    },
    "Nucleation": {
      "description": "The model mounted as Nucleation in couplings/mosaic_aerchemistry_column.esm."
    },
    "DryDeposition": {
      "description": "The model mounted as DryDeposition in couplings/mosaic_aerchemistry_column.esm."
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "Column.r",
      "to": "CoagEntry.r",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "Column.n",
      "to": "CoagEntry.n_in",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "Column.water",
      "to": "CoagEntry.water_in",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "Column.hysw",
      "to": "CoagEntry.hysw_in",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "Column.mass_in",
      "to": "CoagEntry.mass_in",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
