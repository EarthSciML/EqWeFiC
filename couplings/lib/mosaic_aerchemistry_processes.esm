      "type": "variable_map",
      "from": "Column.mw",
      "to": "CoagEntry.mw",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "Column.dens",
      "to": "CoagEntry.dens",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "CoagEntry.dp_wet",
      "to": "Column.dp_wet_e",
      "transform": "param_to_var",
      "description": "coagsolv's entry state"
    },
    {
      "type": "variable_map",
      "from": "CoagEntry.dens_wet",
      "to": "Column.dens_wet_e",
      "transform": "param_to_var",
      "description": "coagsolv's entry state"
    },
    {
