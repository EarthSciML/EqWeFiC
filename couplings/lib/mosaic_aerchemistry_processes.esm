      "type": "variable_map",
      "from": "Column.tk_p",
      "to": "CoagKernel.tk",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "the 0-D pair kernel lifted over every pair of sections of every cell"
    },
    {
      "type": "variable_map",
      "from": "Column.patm_p",
      "to": "CoagKernel.patm",
      "transform": "param_to_var",
      "lifting": "pointwise",
      "description": "the 0-D pair kernel lifted over every pair of sections of every cell"
    },
    {
