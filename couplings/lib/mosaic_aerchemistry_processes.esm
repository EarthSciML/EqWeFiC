      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "Column.d_hi",
      "to": "CoagEntry.d_hi",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "Column.d_cen",
      "to": "CoagEntry.d_cen",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
