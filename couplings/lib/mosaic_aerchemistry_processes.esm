      "to": "CoagEntry.rho_in",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "Column.cair",
      "to": "CoagEntry.cair",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "Column.v_lo",
      "to": "CoagEntry.v_lo",
      "transform": "param_to_var",
      "description": "the column state into mosaic_coag_1clm's per-bin preparation"
    },
    {
      "type": "variable_map",
      "from": "Column.v_hi",
