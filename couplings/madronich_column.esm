  "coupling": [
    {
      "type": "variable_map",
      "from": "Od.taun",
      "to": "Ts.taun_up",
      "transform": "param_to_var",
      "description": "delta-scaled layer optical depth"
    },
    {
      "type": "variable_map",
      "from": "Od.om_scaled",
      "to": "Ts.om_up",
      "transform": "param_to_var",
      "description": "delta-scaled single-scattering albedo"
    },
    {
      "type": "variable_map",
      "from": "Od.g_scaled",
      "to": "Ts.g_up",
      "transform": "param_to_var",
      "description": "delta-scaled asymmetry factor"
    },
    {
      "type": "variable_map",
      "from": "Od.tausla",
      "to": "Ts.tausla",
      "transform": "param_to_var",
      "description": "slant optical depth to each interface"
    },
    {
      "type": "variable_map",
      "from": "Od.mu2",
      "to": "Ts.mu2",
      "transform": "param_to_var",
      "description": "effective slant cosine per layer"
    },
    {
      "type": "variable_map",
      "from": "Od.albedoph",
      "to": "Ts.albedoph",
      "transform": "param_to_var",
      "description": "wavelength-dependent surface albedo"
    },
    {
      "type": "variable_map",
      "from": "Od.fldir",
      "to": "MadronichColumn.fldir_in",
      "transform": "param_to_var",
      "description": "direct beam into the wavelength integral"
    },
    {
      "type": "variable_map",
      "from": "Ts.fldn",
      "to": "MadronichColumn.fldn_in",
      "transform": "param_to_var",
      "description": "down-welling diffuse into the wavelength integral"
    },
    {
      "type": "variable_map",
      "from": "Ts.flup",
      "to": "MadronichColumn.flup_in",
      "transform": "param_to_var",
      "description": "up-welling diffuse into the wavelength integral"
    }
  ]
}
