{
 "esm": "1.2.0",
 "metadata": {
  "name": "NoahColumn",
  "description": "The Noah land-surface column of the chem_opt = 170 reference column (em_scm_xy, Kansas 1997-06-20, sf_sfclay_physics = 1, sf_surface_physics = 2): the revised MM5 surface layer (sfclayrev) and the snow-free, unfrozen Noah LSM (REDPRM, the driver's forcing, PENMAN, CANRES, EVAPO, SMFLX and SHFLX) mounted together over ONE soil column state that this document owns as ODE states -- soil temperature stc, total and unfrozen soil moisture smc and sh2o, and canopy water cmc -- so that the land surface is a memory here rather than a boundary condition read from a dump. WHAT IS COUPLED: the surface layer's exchange coefficient chs into PENMAN, CANRES and the surface closure as Noah's CH, and its saturation mixing ratio qgh into the driver's Q2SAT (couplings/lib/sfclayrev_noah.esm); Noah's processes to one another exactly in SFLX's order of hand-offs (couplings/lib/noah_column_processes.esm); the column state into every leaf through its mount-edge library (couplings/tests/noahcol_couple_soil_inputs.esm); and the four tendencies back into D(stc), D(smc), D(sh2o), D(cmc). The outputs a consumer reads are Heat.t1 (WRF's TSK), Heat.sheat (HFX), Et.eta_kinematic (QFX), Et.eta (LH), Heat.ssoil (GRDFLX), Drv.qsfc (QSFC), Drv.z0 (ZNT), Drv.albedo/Drv.emissi, and the surface layer's Sfc.ust and Sfc.rmol. WHAT IS LAGGED, as in WRF: the surface layer reads the skin temperature, surface mixing ratio, roughness and its own fluxes of the PREVIOUS step (tsk_in, qsfc_prev, znt_prev, hfx_prev, ...), and SFLX forms PENMAN's ground heat flux from the incoming skin temperature (Heat.ssoil_pre). In the dt -> 0 limit tsk_in = Heat.t1, which is an algebraic loop (t1 -> chs -> rch/epsca -> t1) that WRF breaks by lagging one step and that this document carries as a parameter; a consumer that integrates the column must lag it the same way or have the integrator solve it (no solver is written here). WHAT IS PRESCRIBED: the lowest atmospheric level (u1, v1, t_air, qv_air, p_air, p_sfc, p_w2, dz1), the surface radiation (glw, swdown, from radiation) and the step's rain (rainbl, from microphysics), the surface categories and greenness, and tbot. NOT MOUNTED: the frozen-soil phase change (couplings/lib/noah_soilwater_frozen.esm; the column stays above 293 K) and the snow pack (snow_branch_active asserted 0). Tests: four steps of the full column (362, 364 noon; 1024, 1026 night with rain and a full canopy), all at t = 0 with an EMPTY time_span; references and tolerance tiers in each test's description and tools/fill_noah_column_tests.py.",
  "license": "MIT",
  "tags": [
   "coupling",
   "wrf",
   "land-surface",
   "noah",
   "sfclayrev",
   "chem170",
   "stage-3"
  ]
 },
 "metaparameters": {
  "NSOIL": {
   "type": "integer",
   "default": 4,
   "description": "Number of Noah soil layers (WRF num_soil_layers = 4), bound into every soil mount edge, whose column axis is renamed soil/soil_nodes so the document can later sit beside an atmospheric lev (esm-spec 4.7 index_set_rename)."
  }
 },
 "models": {
  "Sfc": {
   "ref": "../components/atmospheric_dynamics/sfclayrev/sfclayrev.esm"
  },
  "Veg": {
   "ref": "../components/land_surface/noah/soil_veg_parameters.esm"
  },
  "Pen": {
   "ref": "../components/land_surface/noah/potential_evaporation.esm"
  },
  "Can": {
   "ref": "../components/land_surface/noah/canopy_resistance.esm",
   "bindings": {
    "NLEV": "NSOIL"
   },
   "index_set_rename": {
    "lev": "soil",
    "lev_nodes": "soil_nodes"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/noahcol_couple_soil_inputs.esm",
     "only": [
      "input_ze",
      "input_sh2o"
     ]
    }
   ]
  },
  "Et": {
   "ref": "../components/land_surface/noah/evapotranspiration.esm",
   "bindings": {
    "NLEV": "NSOIL"
   },
   "index_set_rename": {
    "lev": "soil",
    "lev_nodes": "soil_nodes"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/noahcol_couple_soil_inputs.esm",
     "only": [
      "input_ze",
      "input_sh2o",
      "input_smc"
     ]
    }
   ]
  },
  "Heat": {
   "ref": "../components/land_surface/noah/soil_heat.esm",
   "bindings": {
    "NLEV": "NSOIL"
   },
   "index_set_rename": {
    "lev": "soil",
    "lev_nodes": "soil_nodes"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/noahcol_couple_soil_inputs.esm",
     "only": [
      "input_ze",
      "input_stc",
      "input_smc",
      "input_sh2o"
     ]
    }
   ]
  },
  "Sm": {
   "ref": "../components/land_surface/noah/soil_moisture.esm",
   "bindings": {
    "NLEV": "NSOIL"
   },
   "index_set_rename": {
    "lev": "soil",
    "lev_nodes": "soil_nodes"
   },
   "expression_template_imports": [
    {
     "ref": "./tests/noahcol_couple_soil_inputs.esm",
     "only": [
      "input_ze",
      "input_sh2o",
      "input_smc",
      "input_et"
     ]
    }
   ]
  },
  "Drv": {
   "ref": "../components/land_surface/noah/surface_driver.esm"
  },
  "NoahColumn": {
   "variables": {
    "stc": {
     "type": "unknown",
     "units": "K",
     "description": "Soil temperature of each layer (WRF TSLB), an ODE state; D(stc) is the soil-heat component's dstc_dt. With smc, sh2o and cmc it is the land surface's memory in this document.",
     "shape": [
      "soil"
     ]
    },
    "smc": {
     "type": "unknown",
     "units": "m^3/m^3",
     "description": "Total volumetric soil moisture (WRF SMOIS), an ODE state; D(smc) is the soil-moisture component's dsmc_dt.",
     "shape": [
      "soil"
     ]
    },
    "sh2o": {
     "type": "unknown",
     "units": "m^3/m^3",
     "description": "Unfrozen volumetric soil water (WRF SH2O), an ODE state; D(sh2o) is the soil-moisture component's dsh2o_dt (no phase change is mounted: the column never reaches freezing).",
     "shape": [
      "soil"
     ]
    },
    "cmc": {
     "type": "unknown",
     "units": "m",
     "description": "Canopy-intercepted water (WRF CANWAT/1000), an ODE state; D(cmc) is the soil-moisture component's dcmc_dt."
    },
    "heat_dstc_dt_in": {
     "type": "parameter",
     "units": "K/s",
     "default": 0.0,
     "description": "Receives Heat.dstc_dt through the coupling.",
     "shape": [
      "soil"
     ]
    },
    "sm_dsh2o_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "default": 0.0,
     "description": "Receives Sm.dsh2o_dt through the coupling.",
     "shape": [
      "soil"
     ]
    },
    "sm_dsmc_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "default": 0.0,
     "description": "Receives Sm.dsmc_dt through the coupling.",
     "shape": [
      "soil"
     ]
    },
    "sm_dcmc_dt_in": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "Receives Sm.dcmc_dt through the coupling."
    },
    "dstc_dt": {
     "type": "unknown",
     "units": "K/s",
     "description": "Total tendency of the soil temperature: the soil heat flux divergence (no phase change, no snow).",
     "shape": [
      "soil"
     ]
    },
    "dsh2o_dt": {
     "type": "unknown",
     "units": "1/s",
     "description": "Total tendency of the unfrozen soil water: Richards' transport, transpiration and soil evaporation.",
     "shape": [
      "soil"
     ]
    },
    "dsmc_dt": {
     "type": "unknown",
     "units": "1/s",
     "description": "Total tendency of the total soil moisture (= dsh2o_dt on unfrozen soil).",
     "shape": [
      "soil"
     ]
    },
    "dcmc_dt": {
     "type": "unknown",
     "units": "m/s",
     "description": "Tendency of the canopy water: interception minus canopy evaporation and drip."
    },
    "shdfac": {
     "type": "parameter",
     "units": "1",
     "default": 0.5,
     "description": "Green vegetation fraction, WRF's VEGFRA/100."
    },
    "soiltyp": {
     "type": "parameter",
     "units": "1",
     "default": 4.0,
     "description": "Soil category (STAS; 4 = silt loam)."
    },
    "vegtyp": {
     "type": "parameter",
     "units": "1",
     "default": 2.0,
     "description": "Vegetation category (USGS; 2 = dryland cropland and pasture)."
    },
    "slopetyp": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "Slope category."
    },
    "shdmin": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Annual minimum green vegetation fraction, WRF's SHDMIN/100."
    },
    "shdmax": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Annual maximum green vegetation fraction, WRF's SHDMAX/100."
    },
    "tbot": {
     "type": "parameter",
     "units": "K",
     "default": 300.0,
     "description": "Deep-soil temperature, WRF's TMN."
    },
    "z_deep": {
     "type": "parameter",
     "units": "m",
     "default": 8.0,
     "description": "Depth of tbot, |ZBOT_DATA|."
    },
    "z_root": {
     "type": "parameter",
     "units": "m",
     "default": 1.0,
     "description": "Depth of the bottom of the root zone, |ZSOIL(NROOT)| = 1.0 m for NROOT = 3 (VEGPARM NROTBL of vegetation type 2) on the 0.1/0.3/0.6/1.0 m layers. Carried here rather than derived from Veg.nroot because a layer index read off a real-valued count is not an equation."
    },
    "dt_canopy": {
     "type": "parameter",
     "units": "s",
     "default": 60.0,
     "description": "Step over which the canopy reservoir may be drained (evapotranspiration's ec cap); set to the reference step."
    },
    "tsk_in": {
     "type": "parameter",
     "units": "K",
     "default": 300.0,
     "description": "Skin temperature ENTERING the step, WRF's TSK: the previous step's diagnosed skin temperature. The surface layer reads it as its tsk and SFLX forms PENMAN's ground heat flux from it. LAGGED: in the dt -> 0 limit it is Heat.t1 itself, an algebraic loop through the surface layer's exchange coefficient (chs depends on tsk, t1 on chs) that WRF breaks by lagging; carried as a parameter here, and the measured difference tsk_in - Heat.t1 is in the test descriptions."
    },
    "swdown": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Downward shortwave at the surface, WRF's SWDOWN (from radiation)."
    },
    "glw": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 400.0,
     "description": "Downward longwave at the surface, WRF's GLW (from radiation)."
    },
    "albedo_in": {
     "type": "parameter",
     "units": "1",
     "default": 0.17,
     "description": "Surface albedo entering the step (the previous step's SFLX albedo)."
    },
    "emiss_in": {
     "type": "parameter",
     "units": "1",
     "default": 0.985,
     "description": "Surface emissivity entering the step (the previous step's SFLX emissivity)."
    },
    "rainbl": {
     "type": "parameter",
     "units": "kg/m^2",
     "default": 0.0,
     "description": "Grid-scale rain reaching the ground over the step, WRF's RAINBL."
    },
    "dt_rain": {
     "type": "parameter",
     "units": "s",
     "default": 60.0,
     "description": "The step over which rainbl accumulated."
    },
    "sneqv": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "description": "Snow water equivalent (zero: snow-free column)."
    },
    "ffrozp": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Frozen fraction of the precipitation (WSM6's SR)."
    },
    "u1": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "Zonal wind of the lowest model layer."
    },
    "v1": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "Meridional wind of the lowest model layer."
    },
    "t_air": {
     "type": "parameter",
     "units": "K",
     "default": 300.0,
     "description": "Temperature of the lowest model layer, WRF's T3D(I,1,J)."
    },
    "qv_air": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 0.01,
     "description": "Water-vapour mixing ratio of the lowest model layer."
    },
    "p_air": {
     "type": "parameter",
     "units": "Pa",
     "default": 99500.0,
     "description": "Pressure at the lowest model MASS level, WRF's P3D(I,1,J) (the surface layer's p1); not Noah's sfcprs, which is the mean of the two lowest interface pressures."
    },
    "p_sfc": {
     "type": "parameter",
     "units": "Pa",
     "default": 100000.0,
     "description": "Pressure at the ground, WRF's P8W(I,1,J) = PSFC."
    },
    "p_w2": {
     "type": "parameter",
     "units": "Pa",
     "default": 99000.0,
     "description": "Pressure at the second model interface, WRF's P8W(I,2,J)."
    },
    "dz1": {
     "type": "parameter",
     "units": "m",
     "default": 60.0,
     "description": "Thickness of the lowest model layer, WRF's DZ8W(I,1,J)."
    },
    "mavail": {
     "type": "parameter",
     "units": "1",
     "default": 0.3,
     "description": "Surface moisture availability seen by the surface layer."
    },
    "xland": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "Land mask (1 land)."
    },
    "lakemask": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "Lake mask."
    },
    "water_depth": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "description": "Water depth (shallow-water roughness option only)."
    },
    "dx": {
     "type": "parameter",
     "units": "m",
     "default": 20000.0,
     "description": "Grid length."
    },
    "isfflx": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "sfclayrev isfflx."
    },
    "shalwater_z0": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "sfclayrev shalwater_z0."
    },
    "scm_force_flux": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "sfclayrev scm_force_flux."
    },
    "isftcflx": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "sfclayrev isftcflx."
    },
    "iz0tlnd": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "sfclayrev iz0tlnd."
    },
    "pblh_prev": {
     "type": "parameter",
     "units": "m",
     "default": 1000.0,
     "description": "PBL height of the previous step."
    },
    "znt_prev": {
     "type": "parameter",
     "units": "m",
     "default": 0.15,
     "description": "Roughness length entering the step (Noah's z0 of the previous step)."
    },
    "ust_prev": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.3,
     "description": "Friction velocity of the previous step."
    },
    "mol_prev": {
     "type": "parameter",
     "units": "K",
     "default": 0.0,
     "description": "Temperature scale of the previous step."
    },
    "qsfc_prev": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 0.02,
     "description": "Surface mixing ratio entering the step (Noah's qsfc of the previous step)."
    },
    "hfx_prev": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "Sensible heat flux of the previous step (Noah's sheat)."
    },
    "qfx_prev": {
     "type": "parameter",
     "units": "kg/(m^2*s)",
     "default": 0.0,
     "description": "Moisture flux of the previous step (Noah's eta_kinematic)."
    },
    "ustm_prev": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.3,
     "description": "ustm of the previous step."
    },
    "chs_prev": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.01,
     "description": "chs of the previous step."
    },
    "chs2_prev": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.01,
     "description": "chs2 of the previous step."
    },
    "cqs2_prev": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.01,
     "description": "cqs2 of the previous step."
    }
   },
   "equations": [
    {
     "lhs": "dstc_dt",
     "rhs": "heat_dstc_dt_in"
    },
    {
     "lhs": "dsh2o_dt",
     "rhs": "sm_dsh2o_dt_in"
    },
    {
     "lhs": "dsmc_dt",
     "rhs": "sm_dsmc_dt_in"
    },
    {
     "lhs": "dcmc_dt",
     "rhs": "sm_dcmc_dt_in"
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "stc"
      ],
      "wrt": "t"
     },
     "rhs": "dstc_dt"
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "stc"
      ]
     },
     "rhs": 0.0
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "smc"
      ],
      "wrt": "t"
     },
     "rhs": "dsmc_dt"
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "smc"
      ]
     },
     "rhs": 0.0
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "sh2o"
      ],
      "wrt": "t"
     },
     "rhs": "dsh2o_dt"
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "sh2o"
      ]
     },
     "rhs": 0.0
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "cmc"
      ],
      "wrt": "t"
     },
     "rhs": "dcmc_dt"
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "cmc"
      ]
     },
     "rhs": 0.0
    }
   ],
   "tests": [
    {
     "id": "chem170_full_step362",
     "description": "Step 362 of the FULL chem_opt = 170 column (em_scm_xy Kansas 1997-06-20, cu_physics = 0; data/eqwefic/chem170_scm/run_full_met_sfc.sh, the same run as dumps/chem170_full_met: every noah dump byte-identical), the step whose end state the chemistry sees. Inputs: the noah dump of step 362 and the sfclayrev dump of call 723 (row j = 1 of ktau 362; the surface layer is dumped per j-row call), real32 values widened; the soil column (stc, smc, sh2o, cmc) is the initial condition. References (tools/noah_column_replay.py): the surface layer is the real64 kernels/sfclayrev_driver with WRF's thirteen real32 constant arguments replaced by their exact decimal values (with WRF's real32 copies chs moves by 3.3e-08 relative here); Noah is the real64 kernels/noah_driver fed the SAME forcing this document forms -- the driver preamble rebuilt in real64 from the raw inputs and the exact-constant chs and qgh -- at ESM_DT = 1e-6 s for the fluxes and diagnostics (instantaneous: the soil state and the canopy are the initial ones) and at 0.01 s for the four tendencies (x_out - x)/dt (the minimum of the V: 1e-6 s loses the tendency to cancellation). The incoming skin temperature tsk_in is WRF's lagged TSK; it differs from the skin temperature this state diagnoses (Heat.t1) by -0.1685 K, which is the size of the algebraic loop WRF breaks by lagging. Snow-free and unfrozen: the snow branch and the supersaturation projection are asserted inactive at zero tolerance.",
     "parameter_overrides": {
      "shdfac": 0.5,
      "soiltyp": 4.0,
      "vegtyp": 2.0,
      "slopetyp": 1.0,
      "shdmin": 0.0,
      "shdmax": 0.0,
      "tbot": 300.0,
      "z_deep": 8.0,
      "z_root": 1.000000037252903,
      "dt_canopy": 60.0,
      "tsk_in": 308.0150146484375,
      "swdown": 461.3055725097656,
      "glw": 451.50079345703125,
      "albedo_in": 0.17000000178813934,
      "emiss_in": 0.9850000143051147,
      "rainbl": 0.0,
      "dt_rain": 60.0,
      "sneqv": 0.0,
      "ffrozp": 0.0,
      "u1": 0.9938827753067017,
      "v1": -0.14886654913425446,
      "t_air": 302.38128662109375,
      "qv_air": 0.014946965500712395,
      "p_air": 99656.0,
      "p_sfc": 100013.6328125,
      "p_w2": 99298.3671875,
      "dz1": 64.0624008178711,
      "mavail": 0.30000001192092896,
      "xland": 1.0,
      "lakemask": 0.0,
      "water_depth": 0.0,
      "dx": 20000.0,
      "isfflx": 1.0,
      "shalwater_z0": 0.0,
      "scm_force_flux": 0.0,
      "isftcflx": 0.0,
      "iz0tlnd": 0.0,
      "pblh_prev": 1494.0108642578125,
      "znt_prev": 0.15000000596046448,
      "ust_prev": 0.25043267011642456,
      "mol_prev": -0.9798890948295593,
      "qsfc_prev": 0.020968420431017876,
      "hfx_prev": 72.81501007080078,
      "qfx_prev": 7.902727520558983e-05,
      "ustm_prev": 0.1332964450120926,
      "chs_prev": 0.0,
      "chs2_prev": 0.0,
      "cqs2_prev": 1494.0108642578125
     },
     "initial_conditions": {
      "stc": [
       302.07501220703125,
       296.0892639160156,
       294.0550842285156,
       293.02203369140625
      ],
      "smc": [
       0.29564368724823,
       0.29851293563842773,
       0.2989203631877899,
       0.3000871241092682
      ],
