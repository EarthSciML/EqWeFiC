                   "value": [0.0, 0.00016651491297643215, 0.0002603977600949613, 0.00027282398333229764, 0.00016754702368032058, -2.8289666263903806e-05, -0.00016303094511154105, -0.00020109865929605788, -0.00021459939045131329, -0.00021529900539187414, -0.0002121857556022041, -0.0002054816568435058, -0.00019193122389940697, -0.00016761324911822062, -0.00012803831254618294, -7.255270060733275e-05, -2.1327637960488616e-05, 4.9192017651640624e-06, 1.248525238318795e-05, 1.3920847226008793e-05, 1.4114417706583663e-05, 1.4134702677774666e-05, 1.4136946537280668e-05, 1.4136110353711408e-05, 1.4134889164757738e-05, 1.4136020118074437e-05, 1.413849633434564e-05, 1.4139232506750592e-05, 1.4140766512579093e-05, 1.4140333381521633e-05, 1.4135307256542369e-05, 1.4123170751360727e-05, 1.4122845715076721e-05, 1.4132133969975568e-05, 1.4128073366311889e-05, 1.4129656625758903e-05, 1.4130287147272235e-05, 1.4120451462842434e-05, 1.411636679634223e-05, 1.4112504711079885e-05, 1.4108614051199168e-05, 1.410933443236765e-05, 1.4108690751490592e-05, 1.41072349498808e-05, 1.4107559798173894e-05, 1.4107177800644051e-05, 1.4095033587835085e-05, 1.4087207150255165e-05, 1.409107525122664e-05, 1.4098343731784626e-05, 1.4140480428599186e-05, 1.422899876566638e-05, 1.4334314070012333e-05, 1.4492389763563771e-05, 1.4724364742723124e-05, 1.5007802938558214e-05, 1.5339020293198803e-05, 1.565094928696078e-05, 1.588275382886103e-05, 1.8360265733418094e-06]
