  "EqWeatherScm": {
   "expression_template_imports": [],
   "subsystems": {
    "wrf": {
     "ref": "../lib/wrf_constants.esm"
    }
   },
   "variables": {
    "mu_p0": {
     "type": "parameter",
     "units": "Pa",
     "description": "Prescribed: Perturbation dry column mass mu' (WRF mu). Constant for the whole em_scm_xy run: the column is horizontally uniform and periodic, so the mass-continuity equation has no flux divergence to drive it.",
     "default": -97.75
    },
    "mu_p": {
     "type": "unknown",
     "units": "Pa",
     "description": "Perturbation dry column mass mu' (WRF mu). Constant for the whole em_scm_xy run: the column is horizontally uniform and periodic, so the mass-continuity equation has no flux divergence to drive it. Coupling source (variable_map param_to_var) for the mounted components."
    },
    "mu_b0": {
     "type": "parameter",
     "units": "Pa",
     "description": "Prescribed: Base-state dry column mass (WRF mub).",
     "default": 79363.078125
    },
    "mu_b": {
     "type": "unknown",
     "units": "Pa",
     "description": "Base-state dry column mass (WRF mub). Coupling source (variable_map param_to_var) for the mounted components."
    },
    "p_top0": {
     "type": "parameter",
     "units": "Pa",
     "description": "Prescribed: Lid pressure (WRF p_top).",
     "default": 17761.310546875
    },
    "p_top": {
     "type": "unknown",
     "units": "Pa",
     "description": "Lid pressure (WRF p_top). Coupling source (variable_map param_to_var) for the mounted components."
    },
    "f0": {
     "type": "parameter",
     "units": "1/s",
     "description": "Prescribed: Coriolis parameter (WRF f).",
     "default": 8.898477972252294e-05
    },
    "f": {
     "type": "unknown",
     "units": "1/s",
     "description": "Coriolis parameter (WRF f). Coupling source (variable_map param_to_var) for the mounted components."
    },
    "e0": {
     "type": "parameter",
     "units": "1/s",
     "description": "Prescribed: Horizontal Coriolis parameter (WRF e).",
     "default": 0.00011554911179700866
    },
    "e": {
     "type": "unknown",
     "units": "1/s",
     "description": "Horizontal Coriolis parameter (WRF e). Coupling source (variable_map param_to_var) for the mounted components."
    },
    "sina0": {
     "type": "parameter",
     "units": "1",
     "description": "Prescribed: Sine of the grid rotation.",
     "default": 0.0
    },
    "sina": {
     "type": "unknown",
     "units": "1",
     "description": "Sine of the grid rotation. Coupling source (variable_map param_to_var) for the mounted components."
    },
    "cosa0": {
     "type": "parameter",
     "units": "1",
     "description": "Prescribed: Cosine of the grid rotation.",
     "default": 1.0
    },
    "cosa": {
     "type": "unknown",
     "units": "1",
     "description": "Cosine of the grid rotation. Coupling source (variable_map param_to_var) for the mounted components."
    },
    "dampcoef0": {
     "type": "parameter",
     "units": "1/s",
     "description": "Prescribed: Rayleigh damping coefficient (namelist dampcoef).",
     "default": 0.003000000026077032
    },
    "dampcoef": {
     "type": "unknown",
     "units": "1/s",
     "description": "Rayleigh damping coefficient (namelist dampcoef). Coupling source (variable_map param_to_var) for the mounted components."
    },
    "zdamp0": {
     "type": "parameter",
     "units": "m",
     "description": "Prescribed: Rayleigh damping depth (namelist zdamp).",
     "default": 5000.0
    },
    "zdamp": {
     "type": "unknown",
     "units": "m",
     "description": "Rayleigh damping depth (namelist zdamp). Coupling source (variable_map param_to_var) for the mounted components."
    },
    "u": {
     "type": "unknown",
     "units": "m/s",
     "description": "Zonal wind on the layers (WRF u). ODE state of this document.",
     "shape": [
      "lev"
     ]
    },
    "v": {
     "type": "unknown",
     "units": "m/s",
     "description": "Meridional wind on the layers (WRF v). ODE state.",
     "shape": [
      "lev"
     ]
    },
    "w": {
     "type": "unknown",
     "units": "m/s",
     "description": "Vertical velocity on the interfaces (WRF w). ODE state.",
     "shape": [
      "lev_nodes"
     ]
    },
    "phi_p": {
     "type": "unknown",
     "units": "m^2/s^2",
     "description": "Perturbation geopotential on the interfaces (WRF ph). ODE state.",
     "shape": [
      "lev_nodes"
     ]
    },
    "theta_m": {
     "type": "unknown",
     "units": "K",
     "description": "Moist potential temperature theta (1 + (R_v/R_d) q_v) on the layers (WRF t + t0 with use_theta_m = 1). ODE state.",
     "shape": [
      "lev"
     ]
    },
    "qv": {
     "type": "unknown",
     "units": "kg/kg",
     "description": "Water-vapour mixing ratio on the layers (WRF qv). ODE state: D(q_v) is YSU's RQVBLTEN plus the WSM6 vapour budget (deposition, evaporation, sublimation and the saturation adjustment).",
     "shape": [
      "lev"
     ]
    },
    "cor_du_in": {
     "type": "parameter",
     "units": "m/s^2",
     "description": "Coupling target: Receives Cor.du_dt.",
     "default": 0.0,
     "shape": [
      "lev"
     ]
    },
    "cur_du_in": {
     "type": "parameter",
     "units": "m/s^2",
     "description": "Coupling target: Receives Cur.du_dt.",
     "default": 0.0,
