    },
    "cur_dw_in": {
     "type": "parameter",
     "units": "m/s^2",
     "description": "Coupling target: Receives Cur.dw_dt.",
     "default": 0.0,
     "shape": [
      "lev_nodes"
     ]
    },
    "ray_dw_in": {
     "type": "parameter",
     "units": "m/s^2",
     "description": "Coupling target: Receives Ray.dw_dt.",
     "default": 0.0,
     "shape": [
      "lev_nodes"
     ]
    },
    "ray_dth_in": {
     "type": "parameter",
     "units": "K/s",
     "description": "Coupling target: Receives Ray.dtheta_m_dt.",
     "default": 0.0,
     "shape": [
      "lev"
     ]
    },
    "vm_dphi_in": {
     "type": "parameter",
     "units": "m^2/s^3",
     "description": "Coupling target: Receives Vm.dphi_dt.",
     "default": 0.0,
     "shape": [
      "lev_nodes"
     ]
    },
    "geo_p_p_in": {
     "type": "parameter",
     "units": "Pa",
     "description": "Coupling target: Receives Geo.p_p.",
     "default": 0.0,
     "shape": [
      "lev"
     ]
    },
    "du_dt": {
     "type": "unknown",
     "units": "m/s^2",
     "description": "Total tendency of u: the dynamics part (du_dt_dyn) plus YSU's RUBLTEN.",
     "shape": [
      "lev"
     ]
    },
    "dv_dt": {
     "type": "unknown",
     "units": "m/s^2",
     "description": "Total tendency of v: the dynamics part (dv_dt_dyn) plus YSU's RVBLTEN.",
     "shape": [
      "lev"
     ]
    },
    "dw_dt_nonpg": {
     "type": "unknown",
     "units": "m/s^2",
     "description": "Non-pressure part of the w tendency: Coriolis + curvature + sponge.",
     "shape": [
      "lev_nodes"
     ]
    },
    "dw_dt": {
     "type": "unknown",
     "units": "m/s^2",
     "description": "Total tendency of w: vertical pressure gradient and buoyancy + dw_dt_nonpg.",
     "shape": [
      "lev_nodes"
     ]
    },
    "dtheta_m_dt": {
     "type": "unknown",
