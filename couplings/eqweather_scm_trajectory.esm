    "Sfc": "Sfc",
    "Sw": "Sw",
    "Thm": "Thm",
    "Vm": "Vm",
    "Warm": "Warm"
   },
   "description": "The column's own wiring: state -> schemes -> tendencies (336 edges). One copy, shared with the other EqWeather-SCM document."
  },
  {
   "type": "coupling_import",
   "ref": "lib/sfclayrev_ysu.esm",
   "bind": {
    "Sfc": "Sfc",
    "Pbl": "Pbl"
   },
   "description": "sfclayrev -> YSU: ust, br, wspd, u10, v10, znt and the fm/fh profile functions."
  },
  {
   "type": "coupling_import",
   "ref": "lib/rrtm_lw_chain.esm",
   "bind": {
    "Col": "Col",
    "Setcoef": "Setcoef",
    "GasOpt": "GasOpt",
    "Rtrn": "Rtrn"
   },
   "description": "the RRTM longwave internal chain: MM5ATM column -> SETCOEF -> gas optics -> RTRN."
  },
  {
   "type": "coupling_import",
   "ref": "lib/dudhia_slab.esm",
   "bind": {
    "Sw": "Sw",
    "Lsm": "Lsm"
   },
   "description": "Dudhia -> slab: net surface shortwave gsw."
  },
  {
   "type": "coupling_import",
   "ref": "lib/rrtm_lw_slab.esm",
   "bind": {
    "Heat": "Heat",
    "Lsm": "Lsm"
   },
   "description": "RRTM -> slab: downward surface longwave glw."
  },
  {
   "type": "coupling_import",
   "ref": "lib/sfclayrev_slab.esm",
   "bind": {
    "Sfc": "Sfc",
    "Lsm": "Lsm"
   },
   "description": "sfclayrev -> slab: the flhc/flqc exchange coefficients."
  },
  {
   "type": "coupling_import",
   "ref": "lib/slab_ysu.esm",
   "bind": {
    "Lsm": "Lsm",
    "Pbl": "Pbl"
   },
   "description": "slab -> YSU: the land-surface hfx/qfx, which WRF's sfclayrev -> slab -> YSU order makes the values YSU sees."
  }
 ]
