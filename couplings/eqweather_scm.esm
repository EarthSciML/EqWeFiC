    },
    "lsm_dTs_dt": {
     "type": "unknown",
     "units": "K/s",
     "description": "Land-surface output dTs_dt of the mounted slab at the assembly state: soil-layer temperature tendencies.",
     "shape": [
      "soil"
     ]
    },
    "lsm_dTs_dt_in": {
     "type": "parameter",
     "units": "K/s",
     "default": 0.0,
     "description": "Receives Lsm.dTs_dt through the coupling.",
     "shape": [
      "soil"
     ]
    },
    "dTsk_dt_wrf_step": {
     "type": "unknown",
     "units": "K/s",
     "description": "The coupled slab's instantaneous skin tendency, named for comparison with WRF's finite-step (tsk_out - tsk)/dt, which sub-steps the soil and re-evaluates the fluxes at the updated TSLB(1) (FORTRAN_BUGS N12: the two are 0.5-11 % apart)."
    },
    "dtheta_m_conv_delta": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "What conv_t_tendf_to_moist ADDS to the physics theta tendency: dtheta_m_dt_phys - rth_phys_sum = (R_v/R_d) q_v dtheta/dt + (R_v/R_d) theta dq_v/dt. Isolated as its own observed because it is the part of the conversion that this assembly can pin TIGHTLY: both terms of the difference carry the same PBL-tendency gap, and it cancels to first order."
    },
    "qc": {
     "type": "unknown",
     "units": "kg/kg",
     "shape": [
      "lev"
     ],
     "description": "Cloud-water mixing ratio (WRF qc), an ODE state. D(qc) is YSU's RQCBLTEN plus the WSM6 microphysics: condensation, autoconversion, accretion and freezing."
    },
    "qi": {
     "type": "unknown",
     "units": "kg/kg",
     "shape": [
      "lev"
     ],
     "description": "Cloud-ice mixing ratio (WRF qi), an ODE state. D(qi) is YSU's RQIBLTEN plus the WSM6 microphysics: deposition and sublimation, nucleation, aggregation to snow, collection, and ice fallout."
    },
    "T_s": {
     "type": "unknown",
     "units": "K",
     "shape": [
      "soil"
     ],
     "description": "Soil layer temperature (WRF tslb), an ODE state; D(T_s) is the slab's dTs_dt. It is what makes the land surface a memory in this document rather than a boundary condition read from a dump."
    },
    "T_sk": {
     "type": "unknown",
     "units": "K",
     "description": "Skin temperature (WRF tsk), an ODE state; D(T_sk) is the slab's dTsk_dt. Every scheme that sees a surface temperature reads this one value -- the surface layer's exchange, the RRTM column's surface emission and the slab's own energy balance -- so the skin the radiation emits from is the skin the surface layer exchanges with, which is not true of the frozen-column documents where tsk is a constant."
    },
    "qr": {
     "type": "unknown",
     "units": "kg/kg",
     "shape": [
      "lev"
     ],
     "description": "Rain mixing ratio, an ODE state since WSM6 was mounted. D(q_r) is microphysics alone -- accretion and autoconversion from cloud water, freezing to graupel, evaporation, and the fall-speed flux divergence -- because YSU does not diffuse the precipitating species. It is read by Dudhia SW, the RRTM column mapping and cal_cldfra, which now see a rain profile this document computes instead of the frozen step-1410 one."
    },
    "qs": {
     "type": "unknown",
     "units": "kg/kg",
     "shape": [
      "lev"
     ],
     "description": "Snow mixing ratio, an ODE state since WSM6 was mounted. D(q_s) is microphysics alone; see q_r. cal_cldfra reads it as part of the ice condensate, so it enters the cloud fraction the longwave sees."
    },
    "qg": {
     "type": "unknown",
     "units": "kg/kg",
     "shape": [
      "lev"
     ],
     "description": "Graupel mixing ratio, an ODE state since WSM6 was mounted. D(q_g) is microphysics alone; see q_r."
    },
    "cldfra_in": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Coupling target: receives cal_cldfra's grid-scale cloud fraction (Cldfra.cldfra)."
    },
    "cldfra": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Grid-scale cloud fraction, COMPUTED by cal_cldfra from this document's own state rather than read from a dump. This is the one input of the longwave chain that the frozen-column documents had to prescribe; asserting it against the dumped CLDFRA of the same WRF call is what closes that gap."
    },
    "cldfra_branch_in": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Coupling target: receives cal_cldfra's branch label (Cldfra.branch, WRF's cldfra1_flag)."
    },
    "cldfra_branch": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Which arm of cal_cldfra1 fired in each layer (1 = below the condensate threshold, 2 = saturated, 3 = the Randall fractional fit), so a test pins the branch and not only the number."
    },
    "du_dt_dyn": {
     "type": "unknown",
     "units": "m/s^2",
     "shape": [
      "lev"
     ],
     "description": "The dynamics part of D(u): perturbation Coriolis + Earth curvature + Rayleigh sponge. Kept separate from du_dt so the dynamics half's own step-1410 reference still pins it now that the PBL contributes as well."
    },
    "dv_dt_dyn": {
     "type": "unknown",
     "units": "m/s^2",
     "shape": [
      "lev"
     ],
     "description": "The dynamics part of D(v), separated from dv_dt for the same reason as du_dt_dyn."
    },
    "dtheta_m_dt_dyn": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "The dynamics part of D(theta_m): the Rayleigh sponge alone. The physics part is dtheta_m_dt_phys, WRFMoistThetaTendency's conversion of the radiative and PBL theta and q_v tendencies into a theta_m tendency."
    },
    "dqc_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Total tendency of q_c: YSU's RQCBLTEN plus the WSM6 cloud-water budget."
    },
    "dqi_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Total tendency of q_i: YSU's RQIBLTEN plus the WSM6 cloud-ice budget."
    },
    "dT_s_dt": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "soil"
     ],
     "description": "Total tendency of the soil column: the slab's dTs_dt."
    },
    "dT_sk_dt": {
     "type": "unknown",
     "units": "K/s",
     "description": "Total tendency of the skin temperature: the slab's dTsk_dt."
    },
    "u1": {
     "type": "unknown",
     "units": "m/s",
     "description": "Lowest-layer zonal wind, indexed out of the ODE state rather than prescribed."
    },
    "v1": {
     "type": "unknown",
     "units": "m/s",
     "description": "Lowest-layer meridional wind, indexed out of the ODE state."
    },
    "qv1": {
     "type": "unknown",
     "units": "kg/kg",
     "description": "Lowest-layer vapour mixing ratio, indexed out of the ODE state."
    },
    "t1": {
     "type": "unknown",
     "units": "K",
     "description": "Temperature of the lowest model layer, taken from the column geometry (Geo.T), which computes it from the state's theta_m, q_v and phi'."
    },
    "p1": {
     "type": "unknown",
     "units": "Pa",
     "description": "Pressure of the lowest model layer, from the column geometry's equation of state (Geo.p)."
    },
    "dz1": {
     "type": "unknown",
     "units": "m",
     "description": "Thickness of the lowest model layer, from the column geometry (Geo.dz8w)."
    },
    "melt_dqc_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Melt.dqc_dt, the qc tendency contribution of the melting/freezing block, through the coupling."
    },
    "melt_dqi_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Melt.dqi_dt, the qi tendency contribution of the melting/freezing block, through the coupling."
    },
    "melt_dqr_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Melt.dqr_dt, the qr tendency contribution of the melting/freezing block, through the coupling."
    },
    "melt_dqs_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Melt.dqs_dt, the qs tendency contribution of the melting/freezing block, through the coupling."
    },
    "melt_dqg_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Melt.dqg_dt, the qg tendency contribution of the melting/freezing block, through the coupling."
    },
    "melt_dT_dt_in": {
     "type": "parameter",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Melt.dT_dt, the latent-heatingtendency contribution of the melting/freezing block, through the coupling."
    },
    "rescale_dqv_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Rescale.dqv_dt, the qv tendency contribution of the budget-rescaled process-rate block, through the coupling."
    },
    "rescale_dqc_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Rescale.dqc_dt, the qc tendency contribution of the budget-rescaled process-rate block, through the coupling."
    },
    "rescale_dqi_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Rescale.dqi_dt, the qi tendency contribution of the budget-rescaled process-rate block, through the coupling."
    },
    "rescale_dqr_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Rescale.dqr_dt, the qr tendency contribution of the budget-rescaled process-rate block, through the coupling."
    },
    "rescale_dqs_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Rescale.dqs_dt, the qs tendency contribution of the budget-rescaled process-rate block, through the coupling."
    },
    "rescale_dqg_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Rescale.dqg_dt, the qg tendency contribution of the budget-rescaled process-rate block, through the coupling."
    },
    "rescale_dT_dt_in": {
     "type": "parameter",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Rescale.dT_dt, the latent-heatingtendency contribution of the budget-rescaled process-rate block, through the coupling."
    },
    "satadj_dqv_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives SatAdj.dqv_dt, the qv tendency contribution of the saturation adjustment, through the coupling."
    },
    "satadj_dqc_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives SatAdj.dqc_dt, the qc tendency contribution of the saturation adjustment, through the coupling."
    },
    "satadj_dT_dt_in": {
     "type": "parameter",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives SatAdj.dT_dt, the latent-heatingtendency contribution of the saturation adjustment, through the coupling."
    },
    "sed_dqi_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Sed.dqi_dt, the qi tendency contribution of sedimentation, through the coupling."
    },
    "sed_dqr_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Sed.dqr_dt, the qr tendency contribution of sedimentation, through the coupling."
    },
    "sed_dqs_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Sed.dqs_dt, the qs tendency contribution of sedimentation, through the coupling."
    },
    "sed_dqg_dt_in": {
     "type": "parameter",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "Receives Sed.dqg_dt, the qg tendency contribution of sedimentation, through the coupling."
    },
    "mp_dtcld0": {
     "type": "parameter",
     "units": "s",
     "default": 60.0,
     "description": "Prescribed: the WSM6 sub-step dtcld. WSM6 splits the model time step into ndt = max(nint(dt/dtcldcr), 1) sub-steps with dtcldcr = 120 s; the em_scm_xy reference run has dt = 60 s, so ndt = 1 and dtcld = 60 s. This is NOT the integrator's step: it is a parameter of the microphysics tendency itself, because WSM6's limiters, budget rescaling and saturation adjustment are all defined over a finite sub-step (see mp_dqv_dt)."
    },
    "mp_tau0": {
     "type": "parameter",
     "units": "s",
     "default": 60.0,
     "description": "Prescribed: the relaxation timescale of the saturation adjustment, set equal to mp_dtcld so the adjustment removes the supersaturation over exactly the sub-step WSM6 removes it over."
    },
    "mp_dtcld": {
     "type": "unknown",
     "units": "s",
     "description": "The WSM6 sub-step, coupled into all six stages that need it (a parent test cannot set a mounted component's parameter, so it is prescribed here and coupled in)."
    },
    "mp_tau": {
     "type": "unknown",
     "units": "s",
     "description": "The saturation-adjustment relaxation timescale, coupled into SatAdj."
    },
    "q_t": {
     "type": "unknown",
     "units": "kg/kg",
     "shape": [
      "lev"
     ],
     "description": "Total water mixing ratio, q_v + q_c + q_r + q_i + q_s + q_g, summed over the six moisture ODE states and coupled into the column geometry (the full column mass that sets p_hyd) and the vertical momentum equation (the moisture coefficient of the buoyancy term). Diagnostic since WSM6 was mounted: before that the condensate part of q_t was frozen, because nothing in the document evolved it."
    },
    "mp_dqv_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Microphysical tendency of q_v: the rescaled rate block's vapour budget plus the saturation adjustment. WSM6 is an operator-split adjustment, not a rate, so each stage's contribution is the increment it applies divided by the sub-step mp_dtcld it applies it over; the sum converges to the continuous process rates as mp_dtcld -> 0 and at 60 s carries WSM6's own limiters. The melting/freezing block contributes nothing here (it moves mass between condensate species only)."
    },
    "mp_dqc_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Microphysical tendency of q_c: melting/freezing (ice melt in, homogeneous and Bigg freezing out) plus the rescaled rate block (autoconversion, accretion) plus the saturation adjustment (condensation). See mp_dqv_dt."
    },
    "mp_dqi_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Microphysical tendency of q_i: melting/freezing, the rescaled rate block (deposition, nucleation, aggregation, collection) and sedimentation. See mp_dqv_dt."
    },
    "mp_dqr_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Microphysical tendency of q_r: melting/freezing, the rescaled rate block and sedimentation. See mp_dqv_dt."
    },
    "mp_dqs_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Microphysical tendency of q_s: melting/freezing, the rescaled rate block and sedimentation. See mp_dqv_dt."
    },
    "mp_dqg_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Microphysical tendency of q_g: melting/freezing, the rescaled rate block and sedimentation. See mp_dqv_dt."
    },
    "mp_dT_dt": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "Microphysical latent-heating tendency: fusion from the melting/freezing block, sublimation and vaporization from the rescaled rate block, and condensation from the saturation adjustment. Sedimentation carries no heat. See mp_dqv_dt."
    },
    "mp_dtheta_dt": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "The microphysical heating as a DRY potential-temperature tendency, mp_dT_dt/exner -- the form the moist-theta conversion takes, and WRF's own RTHMPTEN-equivalent (WRF applies microphysics directly to th rather than through a tendency array)."
    },
    "dtheta_dt_phys": {
     "type": "unknown",
     "units": "K/s",
     "shape": [
      "lev"
     ],
     "description": "Every physics potential-temperature tendency of the step, rth_phys_sum + mp_dtheta_dt: radiation, the PBL and now microphysics. This, not rth_phys_sum, is what the use_theta_m conversion is handed. rth_phys_sum is kept separate because it is what WRF's driver-level dump exposes and what the tests assert."
    },
    "dqr_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Total tendency of q_r: microphysics alone. YSU diffuses only q_v, q_c and q_i, so the precipitating species have no boundary-layer tendency, exactly as in WRF."
    },
    "dqs_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Total tendency of q_s: microphysics alone. See dqr_dt."
    },
    "dqg_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Total tendency of q_g: microphysics alone. See dqr_dt."
    },
    "mp_melt_dqi_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Diagnostic: the melting/freezing block's share of mp_dqi_dt, exposed separately so a test can say which stage a disagreement with WRF comes from. The three sum to mp_dqi_dt."
    },
    "mp_rate_dqi_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Diagnostic: the budget-rescaled process-rate block's share of mp_dqi_dt, exposed separately so a test can say which stage a disagreement with WRF comes from. The three sum to mp_dqi_dt."
    },
    "mp_sed_dqi_dt": {
     "type": "unknown",
     "units": "1/s",
     "shape": [
      "lev"
     ],
     "description": "Diagnostic: sedimentation's share of mp_dqi_dt, exposed separately so a test can say which stage a disagreement with WRF comes from. The three sum to mp_dqi_dt."
    }
   },
