      "bindings": {
        "NLEV": "NLEV"
      }
    },
    "WetDepColumn": {
      "variables": {
        "qc": {
          "type": "parameter",
          "units": "kg/kg",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "Cloud-water mixing ratio, moist(:,:,:,p_qc)."
        },
        "rho": {
          "type": "parameter",
          "units": "kg/m^3",
          "shape": [
            "lev"
          ],
          "default": 1.0,
          "description": "Air density as chem_driver passes it."
        },
        "w": {
          "type": "parameter",
          "units": "m/s",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "Vertical velocity on the BOTTOM face of each layer, WRF w_2 as chem_driver copies it into vvel."
        },
        "ze": {
          "type": "parameter",
          "units": "m",
          "shape": [
            "lev_nodes"
          ],
          "default": 0.0,
          "description": "Heights of the layer faces (cumulative dz8w from the ground)."
        },
        "rain": {
          "type": "parameter",
          "units": "kg/m^2",
          "default": 0.0,
          "description": "Grid-scale rain over the step, rainncv."
        },
        "dt": {
          "type": "parameter",
          "units": "s",
          "default": 60.0,
          "description": "The model step, grid%dt."
        }
      },
