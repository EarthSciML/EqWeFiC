{
  "esm": "1.2.0",
  "metadata": {
    "name": "MosaicMesaPass",
    "description": "ONE pass of MOSAIC's MESA solid-liquid solver (SUBROUTINE mesa_ptc, chem/module_mosaic_therm.F, WRF v4.8.0) assembled from its parts, for one size bin: the liquid the pass starts from goes through ions_to_electrolytes.esm (I2E: the liquid electrolytes, CaSO4 to the solid), aerosol_water_zsr.esm (Zsr: compute_activities' ZSR water at the bin's water activity), mtem_activities.esm (Act: the MTEM activities) and mesa_ptc_step.esm (Step: saturation, small-salt dissolution, fluxes, the convergence test and the pseudo-time step). This is exactly the chain mesa_flux_salt runs on every pass; each piece is tested on its own, and the tests here check that the pieces compose -- in particular that mtem_activities, tested against compute_activities' own calls, reproduces the activities mesa_ptc sees, including the zeroing of Na3H(SO4)2's activity, which the step component's own tests cannot see (their activity input is recorded after it).\n\nThe loop over passes is NOT assembled here: carrying (E_s, phi_old, alpha) from pass to pass is a three-variable recurrence (mesa_ptc_step.esm says why none of the three CLAUDE.md tests removes it), which needs EarthSciAST recurrence groups (#701 / PR #703) beyond the pinned be1fafe6d binary, and each pass evaluates the whole chain, i.e. the three models would have to be lifted over the pass axis. MesaPass only re-exposes ions_to_electrolytes' liquid species one by one because compute_activities takes them as scalars.\n\nTESTS: passes from the MESA tape (WRF fork module_esm_mesa_tape, kernels/mosaic_therm_driver; data/eqwefic/chem170_scm/mesa64), real64: inputs are the TOP record (the pass's starting state), the ENTRY record (totals, temperature, water activity) and the bin's MTEM inputs (GAMZ record, keq_ll); expected are the FLUX and STEP records. rel 1e-9, amounts with an absolute floor of 1e-12 of the bin's largest total amount, flags exactly.",
    "authors": [
      "EqWeFiC"
    ],
    "references": [
      {
        "citation": "Zaveri, R.A., Easter, R.C., Peters, L.K. (2005). A computationally efficient Multicomponent Equilibrium Solver for Aerosols (MESA). J. Geophys. Res. 110, D24203."
      },
      {
        "citation": "WRF v4.8.0 chem/module_mosaic_therm.F"
      }
    ]
  },
  "metaparameters": {
    "NEL": {
      "type": "integer",
      "default": 22,
      "description": "MOSAIC electrolytes."
    },
    "NAER": {
      "type": "integer",
      "default": 112,
      "description": "MOSAIC aerosol species per bin (chem_opt = 170)."
    }
  },
  "index_sets": {
    "el": {
      "kind": "interval",
      "size": "NEL"
    },
    "solv": {
      "kind": "interval",
      "size": "NEL"
    },
    "aer": {
      "kind": "interval",
      "size": "NAER"
    },
    "salt": {
      "kind": "interval",
      "size": 15
    },
    "sp": {
      "kind": "interval",
      "size": 7
    }
  },
  "models": {
    "I2E": {
      "ref": "../components/aerosol/mosaic/ions_to_electrolytes.esm"
    },
    "Zsr": {
      "ref": "../components/aerosol/mosaic/aerosol_water_zsr.esm"
    },
    "Act": {
      "ref": "../components/aerosol/mosaic/mtem_activities.esm"
    },
    "Step": {
      "ref": "../components/aerosol/mosaic/mesa_ptc_step.esm"
    },
    "MesaPass": {
      "variables": {
        "it": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "The pass number itdum."
        },
        "t_k": {
          "type": "parameter",
          "units": "K",
          "default": 298.0,
          "description": "Temperature."
        },
        "a_w": {
          "type": "parameter",
          "units": "1",
          "default": 0.8,
          "description": "The bin's water activity ah2o_a (the Kelvin-lowered value aerosol_phase_state passes in), at which compute_activities' ZSR water is taken."
        },
        "aer_t": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "aer"
          ],
          "default": 0.0,
          "description": "Total species aer(:, jtotal)."
        },
        "elec_t": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "el"
          ],
          "default": 0.0,
          "description": "Total electrolytes."
        },
        "elec_s_in": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "el"
          ],
          "default": 0.0,
          "description": "Solid electrolytes at the start of the pass."
        },
        "a_l_in": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "sp"
          ],
          "default": 0.0,
          "description": "Liquid species at the start of the pass (`sp` order so4, no3, cl, nh4, msa, na, ca)."
        },
        "phi_old_in": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "salt"
          ],
          "default": 0.0,
          "description": "phi_salt_old from the previous pass."
        },
        "alpha_in": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "salt"
          ],
          "default": 0.0,
          "description": "alpha_salt from the previous pass."
        },
        "phi_in": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "salt"
          ],
          "default": 0.0,
          "description": "phi_salt as the previous pass left it."
        },
        "log_gamz": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "el",
            "solv"
          ],
          "default": 0.0,
          "description": "MTEM binary log10 activity coefficients at the cell's relative humidity (mtem_binary_log_gamma.esm; mtem_compute_log_gamz runs once per MOSAIC call, at ah2o, not ah2o_a)."
        },
        "keq_hso4": {
          "type": "parameter",
          "units": "mol/kg",
          "default": 0.01,
          "description": "Keq_ll(1) at the cell temperature."
        },
        "k_w": {
          "type": "parameter",
          "units": "mol^2/kg^2",
          "default": 1e-14,
          "description": "Keq_ll(3), water's ion product."
        },
        "a_liq": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "sp"
          ],
          "default": 0.0,
          "description": "The liquid species as ions_to_electrolytes leaves them (coupled from I2E.a)."
        },
        "so4": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Liquid sulfate handed to compute_activities."
        },
        "no3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Liquid nitrate."
        },
        "cl": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Liquid chloride."
        },
        "nh4": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Liquid ammonium."
        },
        "msa": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Liquid MSA."
        },
        "na": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Liquid sodium."
        },
        "ca": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Liquid calcium."
        }
      },
      "equations": [
        {
          "lhs": "so4",
          "rhs": {
            "op": "index",
            "args": [
              "a_liq",
              1
            ]
          }
        },
        {
          "lhs": "no3",
          "rhs": {
            "op": "index",
            "args": [
              "a_liq",
              2
            ]
          }
        },
        {
          "lhs": "cl",
          "rhs": {
            "op": "index",
            "args": [
              "a_liq",
              3
            ]
          }
        },
        {
          "lhs": "nh4",
          "rhs": {
            "op": "index",
            "args": [
              "a_liq",
              4
            ]
          }
        },
        {
          "lhs": "msa",
          "rhs": {
            "op": "index",
            "args": [
              "a_liq",
              5
            ]
          }
        },
        {
          "lhs": "na",
          "rhs": {
            "op": "index",
            "args": [
              "a_liq",
              6
            ]
          }
        },
        {
          "lhs": "ca",
          "rhs": {
            "op": "index",
            "args": [
              "a_liq",
              7
            ]
          }
        }
      ],
      "tests": [
