  "coupling": [
    {
      "type": "variable_map",
      "from": "MesaPass.a_l_in",
      "to": "I2E.a_in",
      "transform": "param_to_var",
      "description": "the pass's starting liquid into ions_to_electrolytes"
    },
    {
      "type": "variable_map",
      "from": "I2E.a",
      "to": "MesaPass.a_liq",
      "transform": "param_to_var",
      "description": "ions_to_electrolytes' liquid (clipped, CaSO4 removed) back to the pass, to be handed on species by species"
    },
    {
      "type": "variable_map",
      "from": "I2E.elec",
      "to": "Zsr.elec",
      "transform": "param_to_var",
      "description": "the liquid electrolytes into the ZSR water (compute_activities' aerosol_water(jliquid))"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.a_w",
      "to": "Zsr.a_w",
      "transform": "param_to_var",
      "description": "the bin's water activity ah2o_a"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.aer_t",
      "to": "Zsr.aer_t",
      "transform": "param_to_var",
      "description": "the totals, for the kappa water of the non-electrolytes"
    },
    {
      "type": "variable_map",
      "from": "Zsr.water",
      "to": "Act.water",
      "transform": "param_to_var",
      "description": "the water the activities are molalities in"
    },
    {
      "type": "variable_map",
      "from": "I2E.elec",
      "to": "Act.elec",
      "transform": "param_to_var",
      "description": "the liquid electrolytes weight the MTEM mixing rule"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.so4",
      "to": "Act.so4",
      "transform": "param_to_var",
      "description": "liquid so4 into compute_activities"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.no3",
      "to": "Act.no3",
      "transform": "param_to_var",
      "description": "liquid no3 into compute_activities"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.cl",
      "to": "Act.cl",
      "transform": "param_to_var",
      "description": "liquid cl into compute_activities"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.nh4",
      "to": "Act.nh4",
      "transform": "param_to_var",
      "description": "liquid nh4 into compute_activities"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.msa",
      "to": "Act.msa",
      "transform": "param_to_var",
      "description": "liquid msa into compute_activities"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.na",
      "to": "Act.na",
      "transform": "param_to_var",
      "description": "liquid na into compute_activities"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.ca",
      "to": "Act.ca",
      "transform": "param_to_var",
      "description": "liquid ca into compute_activities"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.log_gamz",
      "to": "Act.log_gamz",
      "transform": "param_to_var",
      "description": "binary activity coefficients"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.keq_hso4",
      "to": "Act.keq_hso4",
      "transform": "param_to_var",
      "description": "bisulfate dissociation constant"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.k_w",
      "to": "Act.k_w",
      "transform": "param_to_var",
      "description": "water's ion product"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.it",
      "to": "Step.it",
      "transform": "param_to_var",
      "description": "the pass's it"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.t_k",
      "to": "Step.t_k",
      "transform": "param_to_var",
      "description": "the pass's t_k"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.aer_t",
      "to": "Step.aer_t",
      "transform": "param_to_var",
      "description": "the pass's aer_t"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.elec_t",
      "to": "Step.elec_t",
      "transform": "param_to_var",
      "description": "the pass's elec_t"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.elec_s_in",
      "to": "Step.elec_s_in",
      "transform": "param_to_var",
      "description": "the pass's elec_s_in"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.phi_old_in",
      "to": "Step.phi_old_in",
      "transform": "param_to_var",
      "description": "the pass's phi_old_in"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.alpha_in",
      "to": "Step.alpha_in",
      "transform": "param_to_var",
      "description": "the pass's alpha_in"
    },
    {
      "type": "variable_map",
      "from": "MesaPass.phi_in",
      "to": "Step.phi_in",
      "transform": "param_to_var",
      "description": "the pass's phi_in"
    },
    {
      "type": "variable_map",
      "from": "I2E.a",
      "to": "Step.a_l",
      "transform": "param_to_var",
      "description": "ions_to_electrolytes' liquid"
    },
    {
      "type": "variable_map",
      "from": "I2E.caso4",
      "to": "Step.caso4",
      "transform": "param_to_var",
      "description": "the CaSO4 ions_to_electrolytes moved to the solid"
    },
    {
      "type": "variable_map",
      "from": "I2E.elec",
      "to": "Step.elec_l",
      "transform": "param_to_var",
      "description": "the liquid electrolytes"
    },
    {
      "type": "variable_map",
      "from": "Zsr.water",
      "to": "Step.water",
      "transform": "param_to_var",
      "description": "the liquid water"
    },
    {
      "type": "variable_map",
      "from": "Act.activity",
      "to": "Step.activity",
      "transform": "param_to_var",
      "description": "the electrolyte activities"
    }
  ]
}
