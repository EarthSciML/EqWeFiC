Bootstrap: docker
From: ubuntu:24.04

# wrf-chem-build.sif — wrf-build.sif plus flex, bison and libfl for WRF-Chem KPP builds (WRF_CHEM=1 WRF_KPP=1). Toolchain for compiling the WRF 4.8 fork (../WRF, branch
# earthsciml-instrumented) and NCAR fire_behavior on the Illinois cluster.
# Build (setuid mode, no --fakeroot needed here):
#   apptainer build wrf-chem-build.sif tools/apptainer/wrf-chem-build.def
# Use with ../WRF bind-mounted, e.g.
#   apptainer exec --bind /projects:/projects wrf-build.sif bash -c 'cd ../WRF && ./configure && ./compile em_scm_xy'

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y -qq --no-install-recommends \
        build-essential gfortran gcc g++ m4 csh tcsh perl file \
        libnetcdf-dev libnetcdff-dev netcdf-bin \
        libhdf5-dev libopenmpi-dev openmpi-bin \
        python3 python3-numpy python3-netcdf4 \
        git curl ca-certificates cmake make flex bison libfl-dev > /dev/null
    rm -rf /var/lib/apt/lists/*
    # WRF's configure expects NETCDF to point at a prefix holding include/ and lib/.
    mkdir -p /opt/netcdf/include /opt/netcdf/lib /opt/netcdf/bin
    ln -sf /usr/include/netcdf.h /opt/netcdf/include/
    ln -sf /usr/include/netcdf.mod /opt/netcdf/include/
    ln -sf /usr/include/typesizes.mod /opt/netcdf/include/
    ln -sf /usr/include/netcdf.inc /opt/netcdf/include/
    ln -sf /usr/lib/x86_64-linux-gnu/libnetcdf.so /opt/netcdf/lib/
    ln -sf /usr/lib/x86_64-linux-gnu/libnetcdff.so /opt/netcdf/lib/
    ln -sf /usr/bin/nc-config /opt/netcdf/bin/
    ln -sf /usr/bin/nf-config /opt/netcdf/bin/
    gfortran --version | head -1
    nf-config --version

%environment
    export NETCDF=/opt/netcdf
    export NETCDF_classic=1
    export HDF5=/usr/lib/x86_64-linux-gnu/hdf5/serial
    export OMPI_ALLOW_RUN_AS_ROOT=1 OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
    export LC_ALL=C

%runscript
    exec "$@"
