{
 "dump_dir": "/projects/illinois/eng/cee/ctessum/ctessum/data/eqwefic/dumps/fire_wrf/driver/",
 "model": "FireFluxToAtmosphereWRFFire",
 "tests": [
  {
   "id": "frame5_wrfnc_fluxes_col_6_16",
   "description": "Reference: fire_behavior's Provide_atm_feedback/Fire_tendency (io/wrf_mod.F90) replayed by the EarthSciML feedback driver (data/eqwefic/fire_build/feedback_driver, instrumented firelib 8d519c6, default real32; alfg = alfc = 50 m, z1can = 15 m, fire_atm_feedback = 1, canopy fluxes 0) on the atmosphere column of test7/wrf.nc (WRF 4.x, 19 x 19 x 44 layers, dx = 100 m, sr = 4) with the strongest surface heat flux. The column geometry (z_at_w, dz8w, rho, mut, c1h, c2h) is the frame's end-of-step state. Single precision: rel 1e-5; Linf tolerances are 1e-5 of the column maximum. Regime: frame 5 (t = 5 s), atmosphere cell (i,j) = (6,16), fire-mesh fluxes as stored in wrf.nc (WRF-SFIRE's FGRNHFX; grnhfx 1.10e5 W/m^2).",
   "inputs": "frame5/esm_dump_fire_feedback_1.json",
   "reference": "frame5/esm_dump_fire_feedback_1.json",
   "column": 5,
   "fields_library": "tests/frame5_wrfnc_fluxes_col_6_16_inputs.esm",
   "fields": {
    "input_fgrnhfx_block": {
     "expr": "fgrnhfx[20:24, 60:64].ravel(order='F')",
     "axis": "subcell"
    },
    "input_fgrnqfx_block": {
     "expr": "fgrnqfx[20:24, 60:64].ravel(order='F')",
     "axis": "subcell"
    },
    "input_ze": {
     "expr": "concat(z_at_w[:, 15], [z_at_w[-1, 15] + dz8w[-1, 15]])",
     "axis": "lev_nodes"
    },
    "input_rho": {
     "expr": "rho[:, 15]",
     "axis": "lev"
    },
    "input_c1h": {
     "expr": "c1h",
     "axis": "lev"
    },
    "input_c2h": {
     "expr": "c2h",
     "axis": "lev"
    }
   },
   "parameter_overrides": {
    "mu": "mu[15]",
    "alfg": "alfg",
    "alfc": "alfc",
    "z1can": "z1can",
    "fire_atm_feedback": "fire_atm_feedback",
    "canhfx": "0.0",
    "canqfx": "0.0"
   },
   "time_span": {
    "start": 0,
    "end": 1
   },
   "tolerance": {
    "rel": 1e-05
   },
   "assertions": [
    {
     "variable": "grnhfx",
     "expr": "grnhfx[15]",
     "tolerance": {
      "rel": 1e-05
     }
    },
    {
     "variable": "grnqfx",
     "expr": "grnqfx[15]",
     "tolerance": {
      "rel": 1e-05
     }
    },
    {
     "variable": "rthfrten_wrf",
     "expr": "rthfrten[:, 15]",
     "axis": "lev",
     "reduce": "Linf_error",
     "tolerance": {
      "abs": 2.0
     }
    },
    {
     "variable": "rqvfrten_wrf",
     "expr": "rqvfrten[:, 15]",
     "axis": "lev",
     "reduce": "Linf_error",
     "tolerance": {
      "abs": 0.0001
     }
    },
    {
     "variable": "rthfrten",
     "expr": "rthfrten[:, 15]",
     "coords": {
      "lev": [
       1,
       2,
       3,
       5,
       8,
       12,
       20,
       30,
       43
      ]
     },
     "tolerance": {
      "rel": 1e-05,
      "abs": 1e-06
     }
    },
    {
     "variable": "rqvfrten",
     "expr": "rqvfrten[:, 15]",
     "coords": {
      "lev": [
       1,
       2,
       5,
       12,
       30
      ]
     },
     "tolerance": {
      "rel": 1e-05,
      "abs": 1e-09
     }
    }
   ]
  },
