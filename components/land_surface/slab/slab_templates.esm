{
 "esm": "1.0.0",
 "metadata": {
  "name": "slab_templates",
  "description": "Expression templates of the surface energy balance as WRF's slab land-surface scheme writes it (phys/module_sf_slab.F, SLAB1D): the Bolton (1980) / Tetens saturation vapor pressure, the Exner function from pressure, bulk surface fluxes from an exchange coefficient, black-body emission and net radiation. Kept next to the component because the Bolton formula with WRF's svp1..svp3 constants is shared by the surface-layer schemes too and should move to lib/wrf_thermo.esm once a second consumer exists.",
  "license": "MIT",
  "tags": ["wrf", "land-surface", "surface-energy-balance", "templates"],
  "references": [
   {"citation": "Bolton, D. (1980). The computation of equivalent potential temperature. Mon. Wea. Rev. 108, 1046-1053."},
   {"citation": "wrf-model/WRF v4.8.0 phys/module_sf_slab.F SLAB1D lines 441-453."}
  ]
 },
 "expression_templates": {
  "bolton_saturation_vapor_pressure": {
   "params": ["T", "svp1", "svp2", "svp3", "svpt0"],
   "description": "Saturation vapor pressure over water, e_s = svp1 exp(svp2 (T - svpt0) / (T - svp3)) (Bolton 1980 eq. 10 with WRF's constants svp1 = 0.6112 kPa, svp2 = 17.67, svp3 = 29.65 K, svpt0 = 273.15 K; SLAB1D: ESG = SVP1*EXP(SVP2*(TG0-SVPT0)/(TG0-SVP3))). The result carries the units of svp1.",
   "body": {"op": "*", "args": ["svp1", {"op": "exp", "args": [{"op": "/", "args": [{"op": "*", "args": ["svp2", {"op": "-", "args": ["T", "svpt0"]}]}, {"op": "-", "args": ["T", "svp3"]}]}]}]}
  },
  "exner_function": {
   "params": ["p", "p0", "kappa"],
   "description": "Exner function (p / p0)^kappa with kappa = r_d / cp, so that theta = T / exner (SLAB1D: THCON = (P1000mb*0.001/PL)**ROVCP is 1/exner of the lowest model layer).",
   "body": {"op": "^", "args": [{"op": "/", "args": ["p", "p0"]}, "kappa"]}
  },
  "bulk_surface_flux": {
   "params": ["coefficient", "surface_value", "air_value"],
   "description": "Bulk-aerodynamic surface flux, coefficient (surface_value - air_value), upward positive; WRF hands the slab scheme the exchange coefficients already multiplied by density and wind speed (FLHC in W m^-2 K^-1, FLQC in kg m^-2 s^-1), so HFX = FLHC (THG - THX) and QFX = FLQC (QSG - QX).",
   "body": {"op": "*", "args": ["coefficient", {"op": "-", "args": ["surface_value", "air_value"]}]}
  },
  "blackbody_emission": {
   "params": ["sigma", "T"],
   "description": "Black-body emission sigma T^4 (SLAB1D: UPFLUX = STBOLT*TG0**4; the emissivity multiplies the net longwave, not the emission, in this scheme).",
   "body": {"op": "*", "args": ["sigma", {"op": "^", "args": ["T", 4]}]}
  },
  "net_radiation": {
   "params": ["gsw", "glw", "emiss", "upflux"],
   "description": "Net radiation absorbed by the surface, gsw + emiss (glw - upflux): the downward shortwave already includes the albedo, and the emissivity scales the net longwave (SLAB1D: XINET = EMISS*(GLW-UPFLUX); RNET = GSW + XINET).",
   "body": {"op": "+", "args": ["gsw", {"op": "*", "args": ["emiss", {"op": "-", "args": ["glw", "upflux"]}]}]}
  }
 }
}
