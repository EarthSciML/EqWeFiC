{
 "esm": "1.1.0",
 "metadata": {
  "name": "NoahCanopyResistance",
  "description": "Canopy (bulk stomatal) resistance of WRF's unified Noah land-surface model, SUBROUTINE CANRES of phys/module_sf_noahlsm.F (WRF 4.8, sf_surface_physics = 2), and the plant coefficient pc it is converted into. Jarvis (1976) multiplicative stress form as implemented by Chen et al. (1996): rc = rsmin / (xlai rcs rct rcq rcsoil), with four independent stress factors, each floored -- rcs from incoming solar radiation, rct from air temperature about the optimum topt, rcq from the vapour-pressure deficit at the lowest model level, and rcsoil from root-zone soil moisture. The soil-moisture factor is written here as what the Fortran loop computes: rcsoil = (1/z_root) integral of the layer stress gx over the root zone, gx = clamp((sh2o - smcwlt)/(smcref - smcwlt), 0, 1), i.e. a THICKNESS-WEIGHTED MEAN of the layer stress over the root depth (the Fortran's PART(k) = (zsoil(k)-zsoil(k-1))/zsoil(nroot) gx(k) is dz[k]/z_root gx[k] because WRF's zsoil is negative downward). The integral runs over the whole soil column with the sub-root layers masked out by zc < z_root; a layer centre never coincides with z_root, which is by construction a layer interface, so the mask selects exactly the Fortran's layers 1..nroot. The plant coefficient pc converts rc into the factor that multiplies the LINEARISED Penman potential evaporation to give Penman-Monteith actual transpiration: pc = (rr + delta)/(rr (1 + rc ch) + delta), where rr is the radiative-plus-aerodynamic resistance ratio and delta = (slv/cp) dqsdt2 the saturation-humidity slope in the same units. Frozen-ground extension: WRF passes UNFROZEN soil water sh2o, not total smc, into this routine -- the `SMC` dummy argument of CANRES is bound to SH2O at the call site -- so the component's column input is named sh2o. The component covers the SHDFAC > 0 and XLAI > 0 branch; WRF sets rc = 0 and never calls CANRES otherwise, which a consumer must reproduce at the mount edge. The `rr` here is CANRES's own, built from cp = 1004.5 (module_model_constants) and Noah's rd = 287.04 and sigma = 5.67e-8; it is NOT the `rr` of SUBROUTINE PENMAN, which is a different expression built from PENMAN's own cp = 1004.6 (FORTRAN_BUGS N88). Consumer-supplied column fields (ze, sh2o) are rewrite-target ops `input_<name>` lowered by the consumer, in the inline tests through per-test expression_template_imports libraries generated by tools/fill_tests.py.",
  "license": "MIT",
  "tags": [
   "wrf",
   "land-surface",
   "noah",
   "canopy-resistance",
   "transpiration",
   "column"
  ],
  "references": [
   {
    "citation": "Jarvis, P. G. (1976). The interpretation of the variations in leaf water potential and stomatal conductance found in canopies in the field. Phil. Trans. R. Soc. Lond. B, 273, 593-610."
   },
   {
    "citation": "Noilhan, J., and S. Planton (1989). A simple parameterization of land surface processes for meteorological models. Mon. Wea. Rev., 117, 536-549."
   },
   {
    "citation": "Chen, F., et al. (1996). Modeling of land surface evaporation by four schemes and comparison with FIFE observations. J. Geophys. Res., 101(D3), 7251-7268, eqns 12-14 and Table 2."
   },
   {
    "citation": "wrf-model/WRF v4.8.0 phys/module_sf_noahlsm.F SUBROUTINE CANRES lines 1009-1145 (instrumented in ctessum-claude/WRF branch earthsciml-instrumented-chem170, commit ac6d4cc)."
   }
  ]
 },
 "metaparameters": {
  "NLEV": {
   "type": "integer",
   "default": 4,
   "description": "Number of soil layers, WRF num_soil_layers (4 for the Noah default). Bound into the column grid at the import edge."
  }
 },
 "models": {
  "NoahCanopyResistance": {
   "expression_template_imports": [
    {
     "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/grid.esm",
     "bindings": {
      "NLEV": "NLEV"
     }
    },
    {
     "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/rules/integral_lev_whole.esm",
     "bindings": {
      "NLEV": "NLEV"
     }
    }
   ],
   "subsystems": {
    "wrf": {
     "ref": "../../../lib/wrf_constants.esm"
    },
    "par": {
     "ref": "./noah_parameters.esm"
    }
   },
   "variables": {
    "ze": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev_nodes"
     ],
     "description": "Soil layer interface DEPTHS below the ground surface, positive downward, ze[1] = 0 and increasing with the lev index (the grid's required orientation). The cumulative sum of WRF's SLDPTH; the negative of WRF's ZSOIL, prefixed by zero."
    },
    "zc": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev"
     ],
     "description": "Soil layer centre depths, derived from ze by the grid's column_cell_center template."
    },
    "dz": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev"
     ],
     "description": "Soil layer thicknesses, derived from ze by the grid's column_cell_thickness template. Equals WRF's SLDPTH."
    },
    "sh2o": {
     "type": "unknown",
     "units": "m^3/m^3",
     "shape": [
      "lev"
     ],
     "description": "Volumetric UNFROZEN soil water content of each layer, WRF's SH2O. This is what the call site binds to CANRES's SMC argument (the frozen-ground extension), so the total soil moisture SMC is deliberately not used here."
    },
    "z_root": {
     "type": "parameter",
     "units": "m",
     "default": 1.0,
     "description": "Depth of the bottom of the root zone below the surface, |ZSOIL(NROOT)| in WRF: the cumulative thickness of the first NROOT layers, with NROOT the vegetation type's root-layer count from VEGPARM.TBL. A layer belongs to the root zone iff its centre lies above this depth."
    },
    "solar": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 500.0,
     "description": "Incoming (downward) shortwave radiation at the surface, WRF's SOLDN. Note the call site passes SOLDN, the DOWNWARD flux, not the net SOLNET that drives the energy balance."
    },
    "ch": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.01,
     "description": "Surface exchange coefficient for heat and moisture from the surface-layer scheme, WRF's CH (a velocity scale, not a dimensionless coefficient)."
    },
    "sfctmp": {
     "type": "parameter",
     "units": "K",
     "default": 300.0,
     "description": "Air temperature at the lowest model level, WRF's SFCTMP."
    },
    "sfcprs": {
     "type": "parameter",
     "units": "Pa",
     "default": 100000.0,
     "description": "Air pressure at the lowest model level, WRF's SFCPRS."
    },
    "q2": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 0.01,
     "description": "Specific humidity at the lowest model level, WRF's Q2."
    },
    "q2sat": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 0.02,
     "description": "Saturation specific humidity at the lowest model level, WRF's Q2SAT, supplied by the driver."
    },
    "dqsdt2": {
     "type": "parameter",
     "units": "kg/(kg*K)",
     "default": 0.001,
     "description": "Slope of the saturation specific humidity with temperature at the lowest model level, WRF's DQSDT2, supplied by the driver."
    },
    "emissi": {
     "type": "parameter",
     "units": "1",
     "default": 0.985,
     "description": "Surface emissivity, WRF's EMISSI, entering the radiative term of rr."
    },
    "rsmin": {
     "type": "parameter",
     "units": "s/m",
     "default": 40.0,
     "description": "Minimum (unstressed) stomatal resistance of the vegetation type, VEGPARM.TBL RSTBL."
    },
    "rgl": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 100.0,
     "description": "Solar radiation threshold of the vegetation type in the rcs stress function, VEGPARM.TBL RGLTBL."
    },
    "hs": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 36.25,
     "description": "Vapour-pressure-deficit coefficient of the vegetation type in the rcq stress function, VEGPARM.TBL HSTBL. It multiplies a specific-humidity difference, so it carries the reciprocal of that unit."
    },
    "xlai": {
     "type": "parameter",
     "units": "1",
     "default": 5.68,
     "description": "Leaf area index, WRF's XLAI, interpolated in REDPRM between the vegetation type's LAIMIN and LAIMAX by the greenness fraction."
    },
    "slv": {
     "type": "parameter",
     "units": "J/kg",
     "default": 2501000.0,
     "description": "Latent heat of vaporisation as CANRES defines it locally (its PARAMETER SLV = 2.501e6), used only in delta = (slv/cp) dqsdt2. Numerically equal to par.lvh2o but written separately because the Fortran declares it separately."
    },
    "rcs": {
     "type": "unknown",
     "units": "1",
     "description": "Solar-radiation stress factor, (ff + rsmin/rsmax)/(1 + ff) with ff = 1.1 solar/(rgl xlai), floored at 1e-4. Tends to rsmin/rsmax in the dark and to 1 in bright light."
    },
    "rct": {
     "type": "unknown",
     "units": "1",
     "description": "Air-temperature stress factor, 1 - 0.0016 (topt - sfctmp)^2, floored at 1e-4 (Noilhan and Planton 1989)."
    },
    "rcq": {
     "type": "unknown",
     "units": "1",
     "description": "Vapour-pressure-deficit stress factor, 1/(1 + hs (q2sat - q2)), floored at 0.01 (SSiB form)."
    },
    "rcsoil": {
     "type": "unknown",
     "units": "1",
     "description": "Root-zone soil-moisture stress factor: the thickness-weighted mean over the root zone of the layer stress gx, floored at 1e-4."
    },
    "gx": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Per-layer soil-moisture stress, (sh2o - smcwlt)/(smcref - smcwlt) clamped to [0, 1]: 0 at or below the wilting point, 1 at or above the field-capacity reference."
    },
    "gx_root": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "gx masked to the root zone (zero in layers whose centre lies below z_root), the integrand of rcsoil."
    },
    "smcwlt": {
     "type": "parameter",
     "units": "m^3/m^3",
     "default": 0.084,
     "description": "Soil wilting point of the soil type, SOILPARM.TBL WLTSMC."
    },
    "smcref": {
     "type": "parameter",
     "units": "m^3/m^3",
     "default": 0.36,
     "description": "Soil reference moisture (field capacity) of the soil type, SOILPARM.TBL REFSMC, at and above which transpiration is unstressed."
    },
    "rc": {
     "type": "unknown",
     "units": "s/m",
     "description": "Bulk canopy resistance, rsmin/(xlai rcs rct rcq rcsoil)."
    },
    "rr": {
     "type": "unknown",
     "units": "1",
     "description": "CANRES's radiative-to-aerodynamic resistance ratio, 4 emissi sigma rd sfctmp^4/(cp sfcprs ch) + 1. A different quantity from SUBROUTINE PENMAN's rr of the same name."
    },
    "delta": {
     "type": "unknown",
     "units": "1",
     "description": "Saturation-humidity slope expressed as the Penman psychrometric ratio, (slv/cp) dqsdt2."
    },
    "pc": {
     "type": "unknown",
     "units": "1",
     "description": "Plant coefficient: the factor by which the linearised Penman potential evaporation must be multiplied to give the Penman-Monteith transpiration that carries the canopy resistance rc."
    }
   },
   "equations": [
    {
     "lhs": "ze",
     "rhs": {
      "op": "input_ze",
      "args": []
     }
    },
    {
     "lhs": "zc",
     "rhs": {
      "op": "apply_expression_template",
      "name": "column_cell_center",
      "args": [],
      "bindings": {
       "ze": "ze"
      }
     }
    },
    {
     "lhs": "dz",
     "rhs": {
      "op": "apply_expression_template",
      "name": "column_cell_thickness",
      "args": [],
      "bindings": {
       "ze": "ze"
      }
     }
    },
    {
     "lhs": "sh2o",
     "rhs": {
      "op": "input_sh2o",
      "args": []
     }
    },
    {
     "lhs": "rcs",
     "rhs": {
      "op": "max",
      "args": [
       {
        "op": "/",
        "args": [
         {
          "op": "+",
          "args": [
           {
            "op": "/",
            "args": [
             {
              "op": "*",
              "args": [
               1.1,
               "solar"
              ]
             },
             {
              "op": "*",
              "args": [
               "rgl",
               "xlai"
              ]
             }
            ]
           },
           {
            "op": "/",
            "args": [
             "rsmin",
             "par.rsmax"
            ]
           }
          ]
         },
         {
          "op": "+",
          "args": [
           1.0,
           {
            "op": "/",
            "args": [
             {
              "op": "*",
              "args": [
               1.1,
               "solar"
              ]
             },
             {
              "op": "*",
              "args": [
               "rgl",
               "xlai"
              ]
             }
            ]
           }
          ]
         }
        ]
       },
       0.0001
      ]
     }
    },
    {
     "lhs": "rct",
     "rhs": {
      "op": "max",
      "args": [
       {
        "op": "-",
        "args": [
         1.0,
         {
          "op": "*",
          "args": [
           0.0016,
           {
            "op": "^",
            "args": [
             {
              "op": "-",
              "args": [
               "par.topt",
               "sfctmp"
              ]
             },
             2.0
            ]
           }
          ]
         }
        ]
       },
       0.0001
      ]
     }
    },
    {
     "lhs": "rcq",
     "rhs": {
      "op": "max",
      "args": [
       {
        "op": "/",
        "args": [
         1.0,
         {
          "op": "+",
          "args": [
           1.0,
           {
            "op": "*",
            "args": [
             "hs",
             {
              "op": "-",
              "args": [
               "q2sat",
               "q2"
              ]
             }
            ]
           }
          ]
         }
        ]
       },
       0.01
      ]
     }
    },
    {
     "lhs": "gx",
     "rhs": {
      "op": "max",
      "args": [
       {
        "op": "min",
        "args": [
         {
          "op": "/",
          "args": [
           {
            "op": "-",
            "args": [
             "sh2o",
             "smcwlt"
            ]
           },
           {
            "op": "-",
            "args": [
             "smcref",
             "smcwlt"
            ]
           }
          ]
         },
         1.0
        ]
       },
       0.0
      ]
     }
    },
    {
     "lhs": "gx_root",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": "<",
        "args": [
         "zc",
         "z_root"
        ]
       },
       "gx",
       0.0
      ]
     }
    },
    {
     "lhs": "rcsoil",
     "rhs": {
      "op": "max",
      "args": [
       {
        "op": "/",
        "args": [
         {
          "op": "integral",
          "args": [
           "gx_root"
          ],
          "var": "lev",
          "lower": {
           "op": "index",
           "args": [
            "ze",
            1
           ]
          },
          "upper": {
           "op": "index",
           "args": [
            "ze",
            {
             "op": "+",
             "args": [
              "NLEV",
              1
             ]
            }
           ]
          }
         },
         "z_root"
        ]
       },
       0.0001
      ]
     }
    },
    {
