   ],
   "tests": [
     {
       "id": "chem170_scm_step1",
       "description": "Reference: WRF 4.8 em_scm_xy single-column run at chem_opt = 170 with Noah (sf_surface_physics = 2, num_soil_layers = 4, USGS land use, silt loam, dryland cropland, shdfac = 0.5) -- data/eqwefic/chem170_scm, dumped by the instrumented ctessum-claude/WRF fork (branch earthsciml-instrumented-chem170, commit ac6d4cc, module_esm_dump hooks around SFLX in phys/module_sf_noahdrv.F) and replayed through the real64 (-fdefault-real-8) standalone kernels/noah_driver at ESM_DT = 0.01 s. Inputs are the dumped SFLX arguments (real32 values widened); every expected value is the real64 replay. CANRES is evaluated at the INPUT state (WRF calls it before NOPAC advances anything), so none of these six outputs depends on dt and the replay value equals the dumped WRF value to real32 round-off. step 1, 06 LST, pre-dawn: solar radiation essentially absent, so rcs sits at its dark floor rsmin/rsmax and rc is large.",
       "parameter_overrides": {
         "z_root": 1.000000037252903,
         "solar": 83.75596618652344,
         "ch": 2.107988257193938e-05,
         "sfctmp": 299.7296142578125,
         "sfcprs": 99642.484375,
         "q2": 0.013806705363094807,
         "q2sat": 0.021996596828103065,
         "dqsdt2": 0.0012975001009181142,
         "emissi": 0.9850000143051147,
         "rsmin": 40.0,
         "rgl": 100.0,
         "hs": 36.25,
         "xlai": 5.679999828338623,
         "smcwlt": 0.08399999886751175,
         "smcref": 0.36000001430511475
       },
       "expression_template_imports": [
         {
           "ref": "./tests/chem170_scm_step1_inputs.esm"
         }
       ],
       "time_span": {
         "start": 0.0,
         "end": 1.0
       },
       "assertions": [
         {
           "variable": "rcs",
           "time": 0.0,
           "expected": 0.14644893628626737,
           "tolerance": {
             "rel": 1e-09
           }
         },
         {
           "variable": "rct",
           "time": 0.0,
           "expected": 0.9952134952306747,
           "tolerance": {
             "rel": 1e-09
           }
         },
         {
           "variable": "rcq",
           "time": 0.0,
           "expected": 0.7710792445213094,
           "tolerance": {
             "rel": 1e-09
           }
         },
         {
           "variable": "rcsoil",
           "time": 0.0,
           "expected": 0.7826086991732422,
           "tolerance": {
             "rel": 1e-09
           }
         },
         {
           "variable": "rc",
           "time": 0.0,
           "expected": 80.06920315530635,
           "tolerance": {
             "rel": 1e-09
           }
         },
         {
           "variable": "pc",
           "time": 0.0,
           "expected": 0.9983367740100969,
           "tolerance": {
             "rel": 1e-09
           }
         }
       ]
     },
     {
       "id": "chem170_scm_step60",
       "description": "Reference: WRF 4.8 em_scm_xy single-column run at chem_opt = 170 with Noah (sf_surface_physics = 2, num_soil_layers = 4, USGS land use, silt loam, dryland cropland, shdfac = 0.5) -- data/eqwefic/chem170_scm, dumped by the instrumented ctessum-claude/WRF fork (branch earthsciml-instrumented-chem170, commit ac6d4cc, module_esm_dump hooks around SFLX in phys/module_sf_noahdrv.F) and replayed through the real64 (-fdefault-real-8) standalone kernels/noah_driver at ESM_DT = 0.01 s. Inputs are the dumped SFLX arguments (real32 values widened); every expected value is the real64 replay. CANRES is evaluated at the INPUT state (WRF calls it before NOPAC advances anything), so none of these six outputs depends on dt and the replay value equals the dumped WRF value to real32 round-off. step 60, 07 LST, just after sunrise: rcs is climbing out of the dark floor.",
       "parameter_overrides": {
         "z_root": 1.000000037252903,
         "solar": 64.72653198242188,
         "ch": 0.00029816199094057083,
         "sfctmp": 297.8211669921875,
         "sfcprs": 99616.421875,
         "q2": 0.014198871329426765,
         "q2sat": 0.019616004079580307,
         "dqsdt2": 0.0011736047454178333,
         "emissi": 0.9850000143051147,
         "rsmin": 40.0,
         "rgl": 100.0,
         "hs": 36.25,
         "xlai": 5.679999828338623,
         "smcwlt": 0.08399999886751175,
         "smcref": 0.36000001430511475
       },
       "expression_template_imports": [
         {
           "ref": "./tests/chem170_scm_step60_inputs.esm"
         }
       ],
       "time_span": {
         "start": 0.0,
         "end": 1.0
       },
       "assertions": [
         {
           "variable": "rcs",
           "time": 0.0,
           "expected": 0.11849700192603135,
