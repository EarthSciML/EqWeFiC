 "tests": [
  {
   "id": "chem170_scm_step1",
   "description": "Reference: WRF 4.8 em_scm_xy single-column run at chem_opt = 170 with Noah (sf_surface_physics = 2), data/eqwefic/chem170_scm, dumped by ctessum-claude/WRF branch earthsciml-instrumented-chem170 and replayed through the real64 (-fdefault-real-8) kernels/noah_driver at ESM_DT = 0.01 s; inputs are the dumped SFLX arguments (real32 values widened), expected values are the real64 replay. EVAPO runs on the INPUT state, so apart from the canopy-drain limiter -- inactive here -- nothing depends on dt. dt_canopy is set to the replay step so that the limiter is off, as it is in WRF at dt = 60 s for these states. pre-dawn, tiny positive etp, transpiration dominates.",
   "inputs": "in_1.json",
   "reference": "ref_1.json",
   "column": 0,
   "fields_library": "tests/evap_step1_inputs.esm",
   "fields": {
    "input_ze": {
     "expr": "cumsum0(sldpth)",
     "axis": "lev_nodes"
    },
    "input_smc": {
     "expr": "smc",
     "axis": "lev"
    },
    "input_sh2o": {
     "expr": "sh2o",
     "axis": "lev"
    }
   },
   "time_span": {
    "start": 0.0,
    "end": 1.0
   },
   "parameter_overrides": {
    "etp": "etp",
    "shdfac": "shdfac",
    "pc": "pc",
    "cmc": "cmc",
    "dt_canopy": "0.01",
    "z_root": "cumsum0(sldpth)[nroot]",
    "nroot": "nroot*1.0",
    "smcmax": "smcmax",
    "smcdry": "smcdry",
    "smcwlt": "smcwlt",
    "smcref": "smcref"
   },
   "assertions": [
    {
     "variable": "edir",
     "expr": "edir",
     "tolerance": {
      "rel": 1e-09,
      "abs": 1e-12
     }
    },
    {
     "variable": "ec",
     "expr": "ec",
     "tolerance": {
      "rel": 1e-09,
      "abs": 1e-12
     }
    },
    {
     "variable": "ett",
