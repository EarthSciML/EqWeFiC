  "models": {
    "GuntherBiogenicEmissions": {
      "subsystems": {
        "gp": {
          "ref": "./gunther_parameters.esm"
        },
        "wrf": {
          "ref": "../../../lib/wrf_constants.esm"
        }
      },
      "variables": {
        "lu": {
          "type": "parameter",
          "units": "1",
          "default": 2,
          "description": "USGS land-use category of the column, `ivgtyp`."
        },
        "T": {
          "type": "parameter",
          "units": "K",
          "default": 300.0,
          "description": "Temperature of the surface layer, `t_phy(i,kts,j)`."
        },
        "p": {
          "type": "parameter",
          "units": "Pa",
          "default": 100000.0,
          "description": "Pressure of the surface layer, `p_phy(i,kts,j)`."
        },
        "gsw": {
          "type": "parameter",
          "units": "W/m^2",
          "default": 0.0,
          "description": "Net shortwave at the ground as WRF passes it, `gsw`, which biogen treats as the global radiation."
        },
        "julday": {
          "type": "parameter",
          "units": "1",
          "default": 171,
          "description": "Day of the year, chem_driver's `ijulian`."
        },
        "winter": {
          "type": "unknown",
          "units": "1",
          "description": "1 outside day 90-270, when bioemiin uses its winter table."
        },
        "cls": {
          "type": "unknown",
          "units": "1",
          "description": "Simplified land-use class of the category, ixxxlu(lu)."
        },
        "forest": {
          "type": "unknown",
          "units": "1",
          "description": "1 for the deciduous and coniferous/mixed forest classes (4, 5)."
        },
        "crop": {
          "type": "unknown",
          "units": "1",
          "description": "1 for the agricultural class (2)."
        },
        "grass": {
          "type": "unknown",
          "units": "1",
          "description": "1 for the grassland and other-natural classes (3, 6)."
        },
        "barren": {
          "type": "unknown",
          "units": "1",
          "description": "1 for the urban/barren class (1), water and ice, which emit nothing."
        },
        "aefiso": {
          "type": "unknown",
          "units": "ug/(m^2*h)",
          "description": "Isoprene emission factor in force."
        },
        "aefmter": {
          "type": "unknown",
          "units": "ug/(m^2*h)",
          "description": "Monoterpene emission factor in force."
        },
        "aefovoc": {
          "type": "unknown",
          "units": "ug/(m^2*h)",
          "description": "Other-VOC emission factor in force."
        },
        "par": {
          "type": "unknown",
          "units": "umol/(m^2*s)",
          "description": "Photosynthetically active photon flux, `par = 2.0*rad`."
        },
        "c_l": {
          "type": "unknown",
          "units": "1",
          "description": "Isoprene light-correction factor `cl` (forest)."
        },
        "c_t": {
          "type": "unknown",
          "units": "1",
          "description": "Isoprene temperature-correction factor `ct` (forest)."
        },
        "ecf_crop": {
          "type": "unknown",
          "units": "1",
          "description": "Crop and grassland VOC correction factor, exp(0.1 (T - 30 degC))."
        },
        "ecf_iso": {
          "type": "unknown",
          "units": "1",
          "description": "Isoprene correction factor."
        },
        "ecf_mter": {
          "type": "unknown",
          "units": "1",
          "description": "Monoterpene (and other-VOC) correction factor."
        },
        "tsoil": {
          "type": "unknown",
          "units": "K",
          "description": "Soil temperature in degC the nitrogen emission is computed at (a temperature difference from 0 degC, hence K)."
        },
        "ecf_n": {
          "type": "unknown",
          "units": "1",
          "description": "Soil-nitrogen correction factor."
        },
        "rat": {
          "type": "unknown",
          "units": "K/hPa",
          "description": "T/p, `rat = ta/pa`, which carries the ideal-gas volume of the conversion."
        },
        "eiso": {
          "type": "unknown",
          "units": "ppmv*m/min",
          "description": "Isoprene emission."
        },
        "emter": {
          "type": "unknown",
          "units": "ppmv*m/min",
          "description": "Monoterpene emission."
        },
        "eovoc": {
          "type": "unknown",
          "units": "ppmv*m/min",
          "description": "Other-VOC emission."
        },
        "e_n": {
          "type": "unknown",
          "units": "ppmv*m/min",
          "description": "Soil nitrogen emission, as NO."
        },
        "row": {
          "type": "unknown",
          "units": "1",
          "description": "Row of the speciation tables, max(cls, 1) (water and ice, class 0, emit nothing to speciate)."
        },
        "e_bio": {
          "type": "unknown",
          "units": "ppmv*m/min",
          "shape": [
            "radm2"
          ],
          "description": "Emission of each RADM2 class (module_data_radm2 order), WRF's `e_bio(i,j,:)`."
        }
      },
