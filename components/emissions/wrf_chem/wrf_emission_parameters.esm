{
  "esm": "1.2.0",
  "metadata": {
    "name": "WRFEmissionParameters",
    "description": "The literal constants WRF-Chem uses to turn a surface emission into a tendency of the lowest model layer(s) (chem/module_cbmz_addemiss.F, chem/module_mosaic_addemiss.F, chem/module_emissions_anthropogenics.F, WRF v4.8.0), shared by the anthropogenic gas, anthropogenic aerosol and biogenic emission components of this directory. Each carries the units of the conversion it performs, so that the conversion is visible in the equation rather than hidden in a bare number.\n\n`mw_air_emis` is WRF's `4.828e-4`, the molar mass of air re-expressed so that a gas flux in mol km-2 hr-1 put into a layer of mass rho*dz (kg m-2) comes out as a mixing ratio in ppmv per MINUTE: 4.828e-4 kg hr mol-1 min-1 = 0.028968 kg mol-1. The `/60.` that follows it in every WRF conversion (`conv = 4.828e-4/rho*dt/(dz8w*60.)`) is `s_per_min`, so the tendency in ppmv per second is E*mw_air_emis/(rho*dz)/s_per_min, exactly WRF's arithmetic. The same `/60.` converts the Gunther biogenic emissions, which biogen writes in ppmv m per minute (`conv_rho = dtstep/(dz8w*60.)`). `g_per_ug` is mosaic_addemiss's `1.0e-6` (\"convert ug to g\") in its number-emission rate.",
    "authors": ["EqWeFiC"],
    "created": "2026-11-12T00:00:00Z",
    "tags": ["wrf-chem", "emissions", "parameters"]
  },
  "models": {
    "WRFEmissionParameters": {
      "variables": {
        "mw_air_emis": {"type": "parameter", "units": "kg*hr/(mol*min)", "default": 4.828e-4, "description": "WRF's `4.828e-4` in `conv = 4.828e-4/rho_phy*dtstep/(dz8w*60.)`: the molar mass of air, 0.028968 kg/mol, in the units that make a mol km-2 hr-1 flux into a kg m-2 layer a ppmv-per-minute tendency."},
        "s_per_min": {"type": "parameter", "units": "s/min", "default": 60.0, "description": "The `60.` WRF divides every per-minute emission conversion by."},
        "g_per_ug": {"type": "parameter", "units": "g/ug", "default": 1.0e-6, "description": "mosaic_addemiss's `1.0e-6` (ug to g) in the number-emission rate."}
      },
      "equations": []
    }
  }
}
