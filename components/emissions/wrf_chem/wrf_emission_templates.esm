{
  "esm": "1.2.0",
  "metadata": {
    "name": "WRFEmissionTemplates",
    "description": "The three ways WRF-Chem turns a surface emission into a tendency of the layer it is put in, factored out because every emitted species uses one of them. Each is a flux divided by the amount of air in the layer: a molar flux by the layer's molar column (gases, cbmz_addemiss_anthro), a mass or number flux by the layer's air mass per area (MOSAIC aerosol, mosaic_addemiss), and a mixing-ratio flux by the layer depth (the Gunther biogenic rates, add_biogenics). WRF applies each as an in-place increment `chem = chem + flux*conv` with `conv` proportional to dt, so the increment is exactly dt times the tendency these templates return: there is no operator-splitting error in an emission.",
    "authors": ["EqWeFiC"],
    "created": "2026-11-12T00:00:00Z",
    "tags": ["wrf-chem", "emissions", "templates"]
  },
  "expression_templates": {
    "gas_layer_tendency": {
      "params": ["E", "rho", "dz", "mw", "spm"],
      "description": "Mixing-ratio tendency (ppmv/s) of a layer of density rho and depth dz receiving a molar flux E (mol km-2 hr-1): E*mw/(rho*dz)/spm, WRF's `emis_ant*4.828e-4/rho_phy*dtstep/(dz8w*60.)` per unit dtstep, with mw = par.mw_air_emis and spm = par.s_per_min.",
      "body": {"op": "/", "args": [{"op": "/", "args": [{"op": "*", "args": ["E", "mw"]}, {"op": "*", "args": ["rho", "dz"]}]}, "spm"]}
    },
    "aerosol_layer_tendency": {
      "params": ["F", "alt", "dz"],
      "description": "Tendency of a per-kg-of-air aerosol quantity (ug/kg/s for a mass, 1/kg/s for a number) of a layer of specific volume alt and depth dz receiving the flux F (ug m-2 s-1, or m-2 s-1): F*alt/dz, mosaic_addemiss's `fact = (dtstep/dz8w)*alt` per unit dtstep.",
      "body": {"op": "/", "args": [{"op": "*", "args": ["F", "alt"]}, "dz"]}
    },
    "mixing_layer_tendency": {
      "params": ["e", "dz", "spm"],
      "description": "Mixing-ratio tendency (ppmv/s) of a layer of depth dz receiving a mixing-ratio flux e (ppmv m/min, the unit biogen writes): e/dz/spm, add_biogenics' `conv_rho = dtstep/(dz8w*60.)` per unit dtstep, with spm = par.s_per_min.",
      "body": {"op": "/", "args": [{"op": "/", "args": ["e", "dz"]}, "spm"]}
    }
  }
}
