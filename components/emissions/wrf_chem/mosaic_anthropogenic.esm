          "description": "E_NO3J."
        },
        "E_no3c": {
          "type": "parameter",
          "units": "ug/(m^2*s)",
          "default": 0.0,
          "description": "E_NO3C."
        },
        "E_orgi": {
          "type": "parameter",
          "units": "ug/(m^2*s)",
          "default": 0.0,
          "description": "E_ORGI, organic carbon."
        },
        "E_orgj": {
          "type": "parameter",
          "units": "ug/(m^2*s)",
          "default": 0.0,
