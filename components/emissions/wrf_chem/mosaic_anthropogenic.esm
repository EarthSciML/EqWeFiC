          "type": "parameter",
          "units": "ug/(m^2*s)",
          "default": 0.0,
          "description": "E_ORGC."
        },
        "E_eci": {
          "type": "parameter",
          "units": "ug/(m^2*s)",
          "default": 0.0,
          "description": "E_ECI, elemental (black) carbon."
        },
        "E_ecj": {
          "type": "parameter",
          "units": "ug/(m^2*s)",
          "default": 0.0,
          "description": "E_ECJ."
        },
        "E_ecc": {
          "type": "parameter",
          "units": "ug/(m^2*s)",
          "default": 0.0,
          "description": "E_ECC."
        },
        "E_pm25i": {
          "type": "parameter",
          "units": "ug/(m^2*s)",
          "default": 0.0,
          "description": "E_PM25I, unspeciated fine PM (into OIN)."
        },
