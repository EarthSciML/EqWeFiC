      "tests": [
        {
          "id": "chem170_emis_default_step1",
          "description": "Reference: the chem_opt = 170 emissions capture (data/eqwefic/chem170_scm/run_emis.sh, MODE=default: emiss_opt = 4, emiss_inpt_opt = 1, synthetic hourly wrfchemi files from make_wrfchemi.py; GNU gfortran real32 in model; fork ctessum-claude/WRF branch earthsciml-instrumented-chem170, the `emissions` hook around emissions_driver in chem/chem_driver.F) at model step 1 (dt = 60 s), surface layer of column (its, jts). Inputs are the dumped emission fields of layer 1 and the layer's density and depth; expected values are the real64 replay of cbmz_addemiss_anthro compiled unchanged (kernels/emissions_driver), its increment over the step divided by dt, at 1e-9 relative. The in-model real32 increments differ from the replay by at most 7.2e-07 relative. Isoprene carries no tendency although E_ISO is non-zero (FORTRAN_BUGS.md N116).",
          "parameter_overrides": {
            "emiss_inpt_opt": 1,
            "rho": 1.13362455368042,
            "dz": 63.34027862548828,
            "E_so2": 48.143394470214844,
            "E_no": 159.96031188964844,
            "E_no2": 17.083139419555664,
            "E_co": 1566.9898681640625,
            "E_eth": 8.23096752166748,
            "E_hc3": 45.03736877441406,
            "E_hc5": 24.071697235107422,
            "E_hc8": 7.609762191772461,
            "E_xyl": 9.473377227783203,
            "E_ol2": 15.064223289489746,
            "E_olt": 7.143858432769775,
            "E_oli": 4.503736972808838,
            "E_tol": 12.890005111694336,
