{
  "esm": "1.2.0",
  "metadata": {
    "name": "CBMZEmissionParameters",
    "description": "The literal constants WRF-Chem uses to map emissions onto the CBM-Z species of chem_opt = 170 (CBMZ_MOSAIC_KPP): the paraffin-bond (PAR) lumping coefficients of cbmz_addemiss_anthro (chem/module_cbmz_addemiss.F) and of the GUNTHER1 branch of add_biogenics (chem/module_emissions_anthropogenics.F), the `emiss_inpt_opt` codes that select the anthropogenic input variety (frame/module_state_description.F), and the run-time species pointers add_biogenics reads (WRF v4.8.0).\n\nCBM-Z carries no RADM2 alkane or ketone classes, so it represents their carbon as PAR, one per paraffinic carbon bond: an input of the RADM2 variety (`emiss_inpt_opt` 1 or 102) has its PAR built as 0.4 ALD + 2.9 HC3 + 4.8 HC5 + 7.9 HC8 + 0.9 KET + 2.8 OLI + 1.8 OLT + 1.0 ORA2, while a CBM-Z-variety input (101, PNNL_CM) carries PAR directly in the E_HC5 field. The biogenic branch uses a subset of the same coefficients.\n\nThe pointers are WRF's run-time `p_<species>` for chem_opt 170: the 1-based position of each species in the `chem` array, i.e. its position in the cbmz_mosaic_kpp package list of Registry/registry.chem plus 1 (PARAM_FIRST_SCALAR = 2). add_biogenics indexes the Gunther emission array `e_bio` with `p_<species> - 1`, which is the RADM2 class of that species only for RADM2 chemistry (FORTRAN_BUGS.md B25); `l_ket` is module_data_radm2's RADM2 ketone class, which add_biogenics also uses directly.",
    "authors": ["EqWeFiC"],
    "created": "2026-11-12T00:00:00Z",
    "tags": ["wrf-chem", "emissions", "cbmz", "parameters"]
  },
  "models": {
    "CBMZEmissionParameters": {
      "variables": {
        "emiss_inpt_default": {"type": "parameter", "units": "1", "default": 1, "description": "EMISS_INPT_DEFAULT: RADM2-variety anthropogenic input."},
        "emiss_inpt_pnnl_cm": {"type": "parameter", "units": "1", "default": 101, "description": "EMISS_INPT_PNNL_CM: CBM-Z/MOSAIC-variety input (PAR in E_HC5, plus NO2, CH3OH and C2H5OH)."},
        "emiss_inpt_pnnl_rs": {"type": "parameter", "units": "1", "default": 102, "description": "EMISS_INPT_PNNL_RS: the second RADM2-variety input code, treated like EMISS_INPT_DEFAULT."},
        "par_ald": {"type": "parameter", "units": "1", "default": 0.4, "description": "PAR per ALD, RADM2-variety anthropogenic lumping and the GUNTHER1 biogenic lumping."},
        "par_hc3": {"type": "parameter", "units": "1", "default": 2.9, "description": "PAR per HC3 (anthropogenic)."},
        "par_hc5": {"type": "parameter", "units": "1", "default": 4.8, "description": "PAR per HC5 (anthropogenic)."},
        "par_hc8": {"type": "parameter", "units": "1", "default": 7.9, "description": "PAR per HC8 (anthropogenic)."},
        "par_ket": {"type": "parameter", "units": "1", "default": 0.9, "description": "PAR per KET (anthropogenic and biogenic)."},
        "par_oli": {"type": "parameter", "units": "1", "default": 2.8, "description": "PAR per OLI (anthropogenic)."},
        "par_olt": {"type": "parameter", "units": "1", "default": 1.8, "description": "PAR per OLT (anthropogenic and biogenic)."},
        "par_ora2": {"type": "parameter", "units": "1", "default": 1.0, "description": "PAR per ORA2 (anthropogenic `1.0*`; the biogenic branch adds it with no coefficient)."},
        "p_no": {"type": "parameter", "units": "1", "default": 5, "description": "WRF p_no for chem_opt 170."},
        "p_ald": {"type": "parameter", "units": "1", "default": 9, "description": "WRF p_ald for chem_opt 170."},
        "p_hcho": {"type": "parameter", "units": "1", "default": 10, "description": "WRF p_hcho for chem_opt 170."},
        "p_ora2": {"type": "parameter", "units": "1", "default": 14, "description": "WRF p_ora2 for chem_opt 170."},
        "p_eth": {"type": "parameter", "units": "1", "default": 19, "description": "WRF p_eth for chem_opt 170."},
        "p_co": {"type": "parameter", "units": "1", "default": 20, "description": "WRF p_co for chem_opt 170."},
        "p_ol2": {"type": "parameter", "units": "1", "default": 21, "description": "WRF p_ol2 for chem_opt 170."},
        "p_olt": {"type": "parameter", "units": "1", "default": 22, "description": "WRF p_olt for chem_opt 170."},
        "p_oli": {"type": "parameter", "units": "1", "default": 23, "description": "WRF p_oli for chem_opt 170."},
        "p_xyl": {"type": "parameter", "units": "1", "default": 25, "description": "WRF p_xyl for chem_opt 170."},
        "p_ket": {"type": "parameter", "units": "1", "default": 28, "description": "WRF p_ket for chem_opt 170."},
        "p_iso": {"type": "parameter", "units": "1", "default": 32, "description": "WRF p_iso for chem_opt 170."},
        "l_ket": {"type": "parameter", "units": "1", "default": 33, "description": "module_data_radm2 `lket`, the RADM2 ketone class of e_bio."}
      },
      "equations": []
    }
  }
}
