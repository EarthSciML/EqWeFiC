{
  "esm": "1.2.0",
  "metadata": {
    "name": "MosaicCoagulationParameters",
    "description": "The fixed numbers coagsolv carries for the Brownian kernel (chem/module_mosaic_coag.F, WRF v4.8.0). They are the routine's own CGS literals -- its Boltzmann constant is 1.38054e-16 erg/K and its Avogadro number 6.02252e23, both slightly different from the modern values and from lib/wrf_constants.esm, and reproducing coagsolv means using its. The second group (piover6 to dens_water) are mosaic_coag_1clm's own literals for preparing coagsolv's entry state from the MOSAIC column state (coagulation_entry_state.esm); like every MOSAIC routine it declares its own copies, which happen to equal mosaic_drydep_parameters.esm's piover6, smallmassbb and dens_default.",
    "authors": [
      "EqWeFiC"
    ],
    "created": "2026-09-23T00:00:00Z",
    "tags": [
      "mosaic",
      "aerosol",
      "coagulation",
      "wrf-chem"
    ],
    "references": [
      {
        "citation": "Jacobson, M. Z. (2005). Fundamentals of Atmospheric Modeling, 2nd ed."
      }
    ]
  },
  "models": {
    "MosaicCoagulationParameters": {
      "variables": {
        "pi": {
          "type": "parameter",
          "units": "1",
          "default": 3.14159265358979,
          "description": "Pi as coagsolv spells it (`onepi`)."
        },
        "boltg": {
          "type": "parameter",
          "units": "erg/K",
          "default": 1.38054e-16,
          "description": "Boltzmann constant in CGS, coagsolv's own value."
        },
        "avogadro": {
          "type": "parameter",
          "units": "1/mol",
          "default": 6.02252e+23,
          "description": "Avogadro number, coagsolv's own value."
        },
        "mw_air": {
          "type": "parameter",
          "units": "g/mol",
          "default": 28.966,
          "description": "Molecular weight of dry air (`wtair`)."
        },
        "rgas_atm": {
          "type": "parameter",
          "units": "atm*L/(mol*K)",
          "default": 0.08206,
          "description": "Gas constant in atm-litre units (`rgas2`)."
        },
        "g_per_kg": {
          "type": "parameter",
          "units": "1",
          "default": 0.001,
          "description": "The 0.001 in `rho3 = patm*wtair*0.001/(rgas2*tk)`, which turns the litre-based gas constant and g/mol into g/cm^3."
        },
        "consmu": {
          "type": "parameter",
          "units": "g/(cm*s)*K",
          "default": 0.07626132000000001,
          "description": "The Sutherland numerator coagsolv precomputes, 1.8325e-4*(296.16 + 120)."
        },
        "sutherland_offset": {
          "type": "parameter",
          "units": "K",
          "default": 120.0,
          "description": "Sutherland offset."
        },
        "sutherland_tref": {
          "type": "parameter",
          "units": "K",
          "default": 296.16,
          "description": "Sutherland reference temperature."
        },
        "piover6": {
          "type": "parameter",
          "units": "1",
          "default": 0.5235987755983,
          "description": "pi/6 as mosaic_coag_1clm precomputes it (`piover6 = pi/6.0` with module_data_mosaic_other's pi = 3.14159265), the sphere volume factor of its diameters."
        },
        "dens_default": {
          "type": "parameter",
          "units": "g/cm^3",
          "default": 2.0,
          "description": "Default dry density mosaic_coag_1clm falls back to when a bin's dry mass is negligible (`densdefault`)."
        },
        "factsafe": {
          "type": "parameter",
          "units": "1",
          "default": 1.00001,
          "description": "Safety factor that keeps the conformed number strictly inside the section's volume bounds (`factsafe`)."
        },
        "smallmassbb": {
          "type": "parameter",
          "units": "g/mol",
          "default": 1e-30,
          "description": "Dry-mass threshold (g per mol of air) below which mosaic_coag_1clm treats a bin as empty (`smallmassbb`; the test is mass <= 1.01*smallmassbb)."
        },
        "dens_min": {
          "type": "parameter",
          "units": "g/cm^3",
          "default": 0.1,
          "description": "Lowest dry density mosaic_coag_1clm accepts before recomputing mass and volume from the composition."
        },
        "dens_max": {
          "type": "parameter",
          "units": "g/cm^3",
          "default": 20.0,
          "description": "Highest dry density it accepts likewise."
        },
        "mass_vol_reltol": {
          "type": "parameter",
          "units": "1",
          "default": 0.0001,
          "description": "Largest relative mismatch between the dry mass and volume times density it accepts likewise."
        },
        "dpwet_cap": {
          "type": "parameter",
          "units": "1",
          "default": 30.0,
          "description": "The wet diameter is capped at this multiple of the section's upper diameter bound."
        },
        "mw_water": {
          "type": "parameter",
          "units": "g/mol",
          "default": 18.016,
          "description": "Molecular weight of aerosol water (`mw_water_aer`, module_data_mosaic_asect)."
        },
        "dens_water": {
          "type": "parameter",
          "units": "g/cm^3",
          "default": 1.0,
          "description": "Density of aerosol water (`dens_water_aer`)."
        }
      },
      "equations": []
    }
  }
}
