{
  "esm": "1.2.0",
  "metadata": {
    "name": "MosaicThermoTemplates",
    "description": "Expression templates shared by MOSAIC's thermodynamics components (chem/module_mosaic_therm.F, WRF v4.8.0). The ZSR water of a bin is needed wherever the bin's water activity is: at the activity compute_activities is handed (aerosol_water_zsr.esm), at the fixed 0.6 of the hysteresis reference (aerosol_water_up), and inside the Kelvin iteration of aerosol_phase_state, where it is evaluated once per iterate. Writing it once is the reason these are templates. The same holds for the sulfate ratio X_T (aerosol_xt), the sulfate-poor ion pairing (ion_pair_electrolyte, used by ions_to_electrolytes.esm and by MESA's liquid-electrolyte estimate) and fn_keq. They read the consuming model's mounted parameter library by its mount name `tp` (mosaic_thermo_parameters.esm), and zsr_water reads the consumer's `elec` (electrolyte amounts, nmol/m3) and `v_kappa` (the kappa-weighted non-electrolyte dry volume) by bare name -- the keyed-factor convention of the EarthSciDiscretizations column rules.",
    "authors": [
      "EqWeFiC"
    ],
    "references": [
      {
        "citation": "Zaveri, R.A., Easter, R.C., Fast, J.D., Peters, L.K. (2008). Model for Simulating Aerosol Interactions and Chemistry (MOSAIC). J. Geophys. Res. 113, D13204."
      },
      {
        "citation": "WRF v4.8.0 chem/module_mosaic_therm.F"
      }
    ]
  },
  "expression_templates": {
    "zsr_fit_activity": {
      "params": [
        "a",
        "e"
      ],
      "description": "Water activity a held inside electrolyte e's fit range, min(max(a, a_min,e), 0.999999) (bin_molality).",
      "body": {
        "op": "min",
        "args": [
          {
            "op": "max",
            "args": [
              "a",
              {
                "op": "index",
                "args": [
                  "tp.aw_min",
                  "e"
                ]
              }
            ]
          },
          "tp.aw_cap"
        ]
      }
    },
    "zsr_binary_molality": {
      "params": [
        "a",
        "e"
      ],
      "description": "Binary molality of electrolyte e at water activity a (FUNCTION bin_molality): below the binary32 0.97 the fitted solute mole fraction x = sum_p A_{p,e} a^(p-1) turned into molality 55.509 x/(1 - x); at and above it the dilute limit -B_e ln a. Both on the clamped activity.",
      "body": {
        "op": "ifelse",
        "args": [
          {
            "op": "<",
            "args": [
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "zsr_fit_activity",
                "bindings": {
                  "a": "a",
                  "e": "e"
                }
              },
              "tp.aw_poly_max"
            ]
          },
          {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  "tp.molal_water",
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "zsr_mole_fraction",
                    "bindings": {
                      "a": {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "zsr_fit_activity",
                        "bindings": {
                          "a": "a",
                          "e": "e"
                        }
                      },
                      "e": "e"
                    }
                  }
                ]
              },
              {
                "op": "-",
                "args": [
                  1.0,
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "zsr_mole_fraction",
                    "bindings": {
                      "a": {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "zsr_fit_activity",
                        "bindings": {
                          "a": "a",
                          "e": "e"
                        }
                      },
                      "e": "e"
                    }
                  }
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "tp.b_zsr",
                      "e"
                    ]
                  }
                ]
              },
              {
                "op": "log",
                "args": [
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "zsr_fit_activity",
                    "bindings": {
                      "a": "a",
                      "e": "e"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "zsr_mole_fraction": {
      "params": [
        "a",
        "e"
      ],
      "description": "MOSAIC's fifth-order fit of electrolyte e's binary solute mole fraction against water activity, x = sum_{p=1..6} A_{p,e} a^(p-1). The caller passes the clamped activity.",
      "body": {
        "op": "faq",
        "output_idx": [],
        "reduce": "+",
        "args": [],
        "ranges": {
          "p": {
            "from": "pc"
          }
        },
        "expr": {
          "op": "*",
          "args": [
            {
              "op": "index",
              "args": [
                "tp.a_zsr",
                "p",
                "e"
              ]
            },
            {
              "op": "^",
              "args": [
                "a",
                {
                  "op": "-",
                  "args": [
                    "p",
                    1
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "zsr_water": {
      "params": [
        "a"
      ],
      "description": "ZSR liquid water of a bin at water activity a, kg per m3 of air (FUNCTION aerosol_water): W = (sum over the first NZSR electrolytes of E_e/m_e(a) + 1e-3 v_kappa a/(1 - a)) 1e-9, every literal at its binary32 value. Reads the consumer's `elec`, `v_kappa` and metaparameter NZSR.",
      "body": {
        "op": "*",
        "args": [
          {
            "op": "+",
            "args": [
              {
                "op": "faq",
                "output_idx": [],
                "reduce": "+",
                "args": [],
                "ranges": {
                  "e": [
                    1,
                    "NZSR"
                  ]
                },
                "expr": {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "elec",
                        "e"
                      ]
                    },
                    {
                      "op": "apply_expression_template",
                      "args": [],
                      "name": "zsr_binary_molality",
                      "bindings": {
                        "a": "a",
                        "e": "e"
                      }
                    }
                  ]
                }
              },
              {
                "op": "/",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "tp.kappa_water_per_volume",
                          "v_kappa"
                        ]
                      },
                      "a"
                    ]
                  },
                  {
                    "op": "-",
                    "args": [
                      1.0,
                      "a"
                    ]
                  }
                ]
              }
            ]
          },
          "tp.mol_per_nmol"
        ]
      }
    },
    "aerosol_xt": {
      "params": [
        "so4",
        "msa",
        "nh4",
        "na",
        "ca"
      ],
      "description": "MOSAIC's sulfate ratio X_T = (NH4 + Na + 2 Ca)/(SO4 + MSA/2) of a phase's species amounts, or -1 when the phase holds neither sulfate nor MSA (SUBROUTINE calculate_xt). Above 2 (or below 0) a particle is sulfate-POOR, below 2 sulfate-RICH.",
      "body": {
        "op": "ifelse",
        "args": [
          {
            "op": ">",
            "args": [
              {
                "op": "+",
                "args": [
                  "so4",
                  {
                    "op": "*",
                    "args": [
                      0.5,
                      "msa"
                    ]
                  }
                ]
              },
              0.0
            ]
          },
          {
            "op": "/",
            "args": [
              {
                "op": "+",
                "args": [
                  {
                    "op": "+",
                    "args": [
                      "nh4",
                      "na"
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      2.0,
                      "ca"
                    ]
                  }
                ]
              },
              {
                "op": "+",
                "args": [
                  "so4",
                  {
                    "op": "*",
                    "args": [
                      0.5,
                      "msa"
                    ]
                  }
                ]
              }
            ]
          },
          -1.0
        ]
      }
    },
    "ion_pair_electrolyte": {
      "params": [
        "e"
      ],
      "description": "Electrolyte e formed by EQUIVALENT-FRACTION PAIRING of the ions in the sulfate-poor domain (ions_to_electrolytes, mesa_estimate_eleliquid): with x_c = n_c z_c / sum over cations of n z and x_a likewise over the anions, E_e = (x_c n_a M_a + x_a n_c M_c)/M_e for e's cation c and anion a (tp.pair_cation, tp.pair_anion), so every cation is shared among the anions in proportion to their charge equivalents and vice versa. 0 for an electrolyte that is not a pair, and for every electrolyte when either sum is zero (the Fortran returns with all of them zero). Reads the consumer's n_ion (ion amounts in the `ion` order, nmol/m3), cation_eq and anion_eq (the two charge sums) by bare name, and the mounted parameter library `tp`.",
      "body": {
        "op": "ifelse",
        "args": [
          {
            "op": "and",
            "args": [
              {
                "op": ">",
                "args": [
                  {
                    "op": "faq",
                    "output_idx": [],
                    "reduce": "+",
                    "args": [],
                    "ranges": {
                      "i": {
                        "from": "ion"
                      }
                    },
                    "expr": {
                      "op": "index",
                      "args": [
                        "tp.pair_cation",
                        "e",
                        "i"
                      ]
                    }
                  },
                  0.0
                ]
              },
              {
                "op": "!=",
                "args": [
                  "cation_eq",
                  0.0
                ]
              },
              {
                "op": "!=",
                "args": [
                  "anion_eq",
                  0.0
                ]
              }
            ]
          },
          {
            "op": "/",
            "args": [
              {
                "op": "+",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "faq",
                        "output_idx": [],
                        "reduce": "+",
                        "args": [],
                        "ranges": {
                          "i": {
                            "from": "ion"
                          }
                        },
                        "expr": {
                          "op": "*",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "tp.pair_cation",
                                "e",
                                "i"
                              ]
                            },
                            {
                              "op": "/",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "index",
                                      "args": [
                                        "n_ion",
                                        "i"
                                      ]
                                    },
                                    {
                                      "op": "index",
                                      "args": [
                                        "tp.z_ion",
                                        "i"
                                      ]
                                    }
                                  ]
                                },
                                "cation_eq"
                              ]
                            }
                          ]
                        }
                      },
                      {
                        "op": "faq",
                        "output_idx": [],
                        "reduce": "+",
                        "args": [],
                        "ranges": {
                          "i": {
                            "from": "ion"
                          }
                        },
                        "expr": {
                          "op": "*",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "tp.pair_anion",
                                "e",
                                "i"
                              ]
                            },
                            {
                              "op": "*",
                              "args": [
                                {
                                  "op": "index",
                                  "args": [
                                    "n_ion",
                                    "i"
                                  ]
                                },
                                {
                                  "op": "index",
                                  "args": [
                                    "tp.mw_ion",
                                    "i"
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "faq",
                        "output_idx": [],
                        "reduce": "+",
                        "args": [],
                        "ranges": {
                          "i": {
                            "from": "ion"
                          }
                        },
                        "expr": {
                          "op": "*",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "tp.pair_anion",
                                "e",
                                "i"
                              ]
                            },
                            {
                              "op": "/",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "index",
                                      "args": [
                                        "n_ion",
                                        "i"
                                      ]
                                    },
                                    {
                                      "op": "index",
                                      "args": [
                                        "tp.z_ion",
                                        "i"
                                      ]
                                    }
                                  ]
                                },
                                "anion_eq"
                              ]
                            }
                          ]
                        }
                      },
                      {
                        "op": "faq",
                        "output_idx": [],
                        "reduce": "+",
                        "args": [],
                        "ranges": {
                          "i": {
                            "from": "ion"
                          }
                        },
                        "expr": {
                          "op": "*",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "tp.pair_cation",
                                "e",
                                "i"
                              ]
                            },
                            {
                              "op": "*",
                              "args": [
                                {
                                  "op": "index",
                                  "args": [
                                    "n_ion",
                                    "i"
                                  ]
                                },
                                {
                                  "op": "index",
                                  "args": [
                                    "tp.mw_ion",
                                    "i"
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "tp.mw_el",
                  "e"
                ]
              }
            ]
          },
          0.0
        ]
      }
    },
    "fn_keq": {
      "params": [
        "k298",
        "a",
        "b",
        "t",
        "t_ref"
      ],
      "description": "MOSAIC's equilibrium-constant temperature dependence, FUNCTION fn_keq: K(T) = K298 exp(a (tt - 1) + b (1 + ln tt - tt)) with tt = t_ref/T (t_ref the binary32 298.15).",
      "body": {
        "op": "*",
        "args": [
          "k298",
          {
            "op": "exp",
            "args": [
              {
                "op": "+",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "a",
                      {
                        "op": "-",
                        "args": [
                          {
                            "op": "/",
                            "args": [
                              "t_ref",
                              "t"
                            ]
                          },
                          1.0
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "b",
                      {
                        "op": "-",
                        "args": [
                          {
                            "op": "+",
                            "args": [
                              1.0,
                              {
                                "op": "log",
                                "args": [
                                  {
                                    "op": "/",
                                    "args": [
                                      "t_ref",
                                      "t"
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "op": "/",
                            "args": [
                              "t_ref",
                              "t"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
