{
  "esm": "1.2.0",
  "metadata": {
    "name": "MosaicAstemSolidSurfaceEquilibrium",
    "authors": [
      "EqWeFiC"
    ],
    "description": "",
    "references": [
      {
        "citation": "Zaveri, R.A., Easter, R.C., Fast, J.D., Peters, L.K. (2008). MOSAIC. J. Geophys. Res. 113, D13204."
      },
      {
        "citation": "WRF v4.8.0 chem/module_mosaic_therm.F, ASTEM_flux_dry and its cases 1, 2, 3a, 3b, 4, 4a, 4b, 4ab"
      }
    ]
  },
  "models": {
    "MosaicAstemSolidSurfaceEquilibrium": {
      "expression_template_imports": [
        {
          "ref": "./mosaic_thermo_templates.esm"
        }
      ],
      "subsystems": {
        "ap": {
          "ref": "./mosaic_astem_parameters.esm"
        }
      },
      "variables": {
        "gas_hno3": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Gas-phase HNO3, gas(ihno3_g)."
        },
        "gas_hcl": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Gas-phase HCl, gas(ihcl_g)."
        },
        "gas_nh3": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Gas-phase NH3, gas(inh3_g)."
        },
        "kg_hno3": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "kg(ihno3_g, ibin) (gas_particle_mass_transfer.esm)."
        },
        "kg_hcl": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "kg(ihcl_g, ibin)."
        },
        "kg_nh3": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "kg(inh3_g, ibin)."
        },
        "so4_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid-phase sulfate aer(iso4_a, jsolid, ibin); with msa, nh4, na and ca it sets the solid's sulfate ratio."
        },
        "msa_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid-phase MSA."
        },
        "nh4_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid-phase ammonium."
        },
        "na_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid-phase sodium."
        },
        "ca_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid-phase calcium."
        },
        "cl_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid-phase chloride aer(icl_a, jsolid, ibin)."
        },
        "caco3_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid CaCO3, electrolyte(jcaco3, jsolid, ibin)."
        },
        "nacl_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid NaCl, electrolyte(jnacl, jsolid, ibin)."
        },
        "cacl2_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid CaCl2, electrolyte(jcacl2, jsolid, ibin)."
        },
        "nh4no3_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid NH4NO3, electrolyte(jnh4no3, jsolid, ibin)."
        },
        "nh4cl_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid NH4Cl, electrolyte(jnh4cl, jsolid, ibin)."
        },
        "salt_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Sum of the fifteen soluble salts in the solid, sum of electrolyte(1:nsalt, jsolid, ibin): the base of the mole percents."
        },
        "keq_sg_nh4no3": {
          "type": "parameter",
          "units": "nmol^2/m^6",
          "default": 0.0,
          "description": "keq_sg(1), NH4NO3(s) = NH3(g) + HNO3(g), (nmol/m3)^2 (mosaic_gas_equilibrium_constants.esm)."
        },
        "keq_sg_nh4cl": {
          "type": "parameter",
          "units": "nmol^2/m^6",
          "default": 0.0,
          "description": "keq_sg(2), NH4Cl(s) = NH3(g) + HCl(g)."
        },
        "kp_nh4no3_0": {
          "type": "parameter",
          "units": "nmol^2/m^6",
          "default": 0.0,
          "description": "Kp_nh4no3_0 = kp_nh4no3 (m0 gamma0)^2: the vapour product over a SATURATED NH4NO3 solution at the ambient RH (update_thermodynamic_constants, ZSR molality and binary MTEM gamma at ah2o)."
        },
        "kp_nh4cl_0": {
          "type": "parameter",
          "units": "nmol^2/m^6",
          "default": 0.0,
          "description": "Kp_nh4cl_0, likewise for NH4Cl."
        },
        "x_t": {
          "type": "unknown",
          "units": "1",
          "description": "Sulfate ratio of the SOLID, template aerosol_xt (calculate_xt(ibin, jsolid))."
        },
        "case1": {
          "type": "unknown",
          "units": "1",
          "description": "1 with solid CaCO3: an acid sink."
        },
        "case2": {
          "type": "unknown",
          "units": "1",
          "description": "1 when the solid is sulfate-rich (0 <= X_T < 1.9999): an NH3 sink."
        },
        "volatile_cl": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Chloride that HNO3 can displace, NaCl + CaCl2."
        },
        "case3": {
          "type": "unknown",
          "units": "1",
          "description": "1 when the solid holds NaCl or CaCl2 and there is HNO3: HNO3 displaces HCl (case 3a), and NH4Cl may form or evaporate (3b)."
        },
        "keq0_nh4no3": {
          "type": "unknown",
          "units": "nmol^2/m^6",
          "description": "min(Kp_nh4no3_0, Keq_sg(1)): the NH4NO3 vapour product that applies (the lower of the solid's and the saturated solution's)."
        },
        "keq0_nh4cl": {
          "type": "unknown",
          "units": "nmol^2/m^6",
          "description": "min(Kp_nh4cl_0, Keq_sg(2))."
        },
        "prod_nh4no3": {
          "type": "unknown",
          "units": "1",
          "description": "1 when NH4NO3 can form (g_NH3 g_HNO3 > keq0, the gas supersaturated) or there is solid NH4NO3 to evaporate, else 0. The Fortran (ASTEM_flux_dry) writes prod_nh4no3 = max(g_NH3 g_HNO3 - Keq_nh4no3_0, 0) + electrolyte(jnh4no3, jsolid), adding a vapour product in (nmol/m3)^2 to a solid amount in nmol/m3 (FORTRAN_BUGS N122), and reads it only as prod > 0. With both terms non-negative that test is exactly the 'or' written here, so every branch is the Fortran's and the dimensions are consistent."
        },
        "prod_nh4cl": {
          "type": "unknown",
          "units": "1",
          "description": "Likewise for NH4Cl: 1 when g_NH3 g_HCl > keq0_nh4cl or there is solid NH4Cl, else 0 (the Fortran's prod_nh4cl > 0; N122)."
        },
        "case4": {
          "type": "unknown",
          "units": "1",
          "description": "1 when neither CaCO3, sulfate-rich nor displaceable chloride applies but NH4NO3 or NH4Cl can exchange."
        },
        "pc_nh4no3": {
          "type": "unknown",
          "units": "1",
          "description": "Mole percent of NH4NO3 among the solid's soluble salts."
        },
        "pc_nh4cl": {
          "type": "unknown",
          "units": "1",
          "description": "Mole percent of NH4Cl among the solid's soluble salts."
        },
        "on_nh4no3": {
          "type": "unknown",
          "units": "1",
          "description": "Case 4: solid NH4NO3 exchanges -- always when the gas is supersaturated with respect to it (g_NH3 g_HNO3 >= Keq_sg(1)); when undersaturated only if it makes up more than ptol_mol_astem (0.01 mole percent) of the solid's salts, i.e. there is solid to evaporate. The Fortran's 1% deadband around saturation, an integrator tolerance, is NOT applied."
        },
        "on_nh4cl": {
          "type": "unknown",
          "units": "1",
          "description": "Likewise for NH4Cl (case 4, and 3b against Keq_sg(2))."
        },
        "acid_hno3": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 1/3a: the irreversible uptake kg_HNO3 g_HNO3, where the gas exceeds 1e-5 nmol/m3."
        },
        "acid_hcl": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 1: the irreversible uptake kg_HCl g_HCl, where the gas exceeds 1e-5 nmol/m3."
        },
        "q3_b": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 3b: b of kg_NH3 s^2 + b s + c = 0 for the surface NH3 over NH4Cl(s), -kg_NH3 g_NH3 + kg_HCl g_HCl."
        },
        "q3_c": {
          "type": "unknown",
          "units": "nmol^2/(m^6*s)",
          "description": "Case 3b: c = -kg_HCl Keq_sg(2)."
        },
        "q4a_b": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4a: b of the NH4NO3(s) surface-NH3 quadratic."
        },
        "q4a_c": {
          "type": "unknown",
          "units": "nmol^2/(m^6*s)",
          "description": "Case 4a: c = -kg_HNO3 keq0_nh4no3."
        },
        "q4b_b": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4b: b of the NH4Cl(s) surface-NH3 quadratic."
        },
        "q4b_c": {
          "type": "unknown",
          "units": "nmol^2/(m^6*s)",
          "description": "Case 4b: c = -kg_HCl keq0_nh4cl."
        },
        "f4a": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4a: HNO3 (= NH3) condensation onto solid NH4NO3, kg_HNO3 (g_HNO3 - keq0/s_NH3)."
        },
        "f4b": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4b: HCl (= NH3) condensation onto solid NH4Cl."
        },
        "f3b": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 3b: NH3 (= HCl) condensation onto solid NH4Cl, kg_NH3 (g_NH3 - s_NH3)."
        },
        "nh3_need": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4 with both salts: the NH3 the two acid fluxes need, f4a + f4b."
        },
        "nh3_max": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4: the most NH3 the bin can take, kg_NH3 g_NH3."
        },
        "scale4": {
          "type": "unknown",
          "units": "1",
          "description": "Case 4 with both salts: min(1, nh3_max/nh3_need) -- the two acid fluxes are scaled together when NH3 cannot keep up."
        },
        "cond_hno3": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Instantaneous HNO3 condensation onto this solid bin (flux_s), negative = evaporation."
        },
        "cond_hcl": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Instantaneous HCl condensation (negative where HNO3 displaces it from NaCl/CaCl2, or NH4Cl evaporates)."
        },
        "cond_nh3": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Instantaneous NH3 condensation."
        },
        "s3_nh3_x": {
          "type": "unknown",
          "units": "1",
          "description": "4ac/b^2 of the s3_nh3 quadratic (1e6 when b = 0), FUNCTION quadratic's series variable."
        },
        "s3_nh3_series": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Series form of the s3_nh3 root."
        },
        "s3_nh3_closed": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Larger closed-form root of the s3_nh3 quadratic."
        },
        "s3_nh3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 3b surface NH3 over solid NH4Cl, from s(NH3) s(HCl) = Keq_sg(2) and the balance kg_NH3 (g_NH3 - s_NH3) = kg_HCl (g_HCl - s_HCl)."
        },
        "s4a_nh3_x": {
          "type": "unknown",
          "units": "1",
          "description": "4ac/b^2 of the s4a_nh3 quadratic (1e6 when b = 0), FUNCTION quadratic's series variable."
        },
        "s4a_nh3_series": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Series form of the s4a_nh3 root."
        },
        "s4a_nh3_closed": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Larger closed-form root of the s4a_nh3 quadratic."
        },
        "s4a_nh3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 4a surface NH3 over solid NH4NO3, from s(NH3) s(HNO3) = keq0_nh4no3 and equal NH3 and HNO3 fluxes."
        },
        "s4b_nh3_x": {
          "type": "unknown",
          "units": "1",
          "description": "4ac/b^2 of the s4b_nh3 quadratic (1e6 when b = 0), FUNCTION quadratic's series variable."
        },
        "s4b_nh3_series": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Series form of the s4b_nh3 root."
        },
        "s4b_nh3_closed": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Larger closed-form root of the s4b_nh3 quadratic."
        },
        "s4b_nh3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 4b surface NH3 over solid NH4Cl, from s(NH3) s(HCl) = keq0_nh4cl and equal fluxes."
        }
      },
      "equations": [
        {
          "lhs": "x_t",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "aerosol_xt",
            "bindings": {
              "so4": "so4_s",
              "msa": "msa_s",
              "nh4": "nh4_s",
              "na": "na_s",
              "ca": "ca_s"
            }
          }
        },
        {
          "lhs": "case1",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": ">",
                "args": [
                  "caco3_s",
                  0.0
                ]
              },
              1.0,
              0.0
            ]
          }
        },
        {
          "lhs": "case2",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "case1",
                      0.0
                    ]
                  },
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "<",
                        "args": [
                          "x_t",
                          "ap.xt_rich"
                        ]
                      },
                      {
                        "op": ">=",
                        "args": [
                          "x_t",
                          0.0
                        ]
                      }
                    ]
                  }
                ]
              },
              1.0,
              0.0
            ]
          }
        },
        {
          "lhs": "volatile_cl",
          "rhs": {
            "op": "+",
            "args": [
              "nacl_s",
              "cacl2_s"
            ]
          }
        },
        {
          "lhs": "case3",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "case1",
                      0.0
                    ]
                  },
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "==",
                        "args": [
                          "case2",
                          0.0
                        ]
                      },
                      {
                        "op": "and",
                        "args": [
                          {
                            "op": ">",
                            "args": [
                              "volatile_cl",
                              0.0
                            ]
                          },
                          {
                            "op": ">",
                            "args": [
                              "gas_hno3",
                              0.0
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1.0,
              0.0
            ]
          }
        },
        {
          "lhs": "keq0_nh4no3",
          "rhs": {
            "op": "min",
            "args": [
              "kp_nh4no3_0",
              "keq_sg_nh4no3"
            ]
          }
        },
        {
          "lhs": "keq0_nh4cl",
          "rhs": {
            "op": "min",
            "args": [
              "kp_nh4cl_0",
              "keq_sg_nh4cl"
            ]
          }
        },
        {
          "lhs": "prod_nh4no3",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "or",
                "args": [
                  {
                    "op": ">",
                    "args": [
                      {
                        "op": "-",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              "gas_nh3",
                              "gas_hno3"
                            ]
                          },
                          "keq0_nh4no3"
                        ]
                      },
                      0.0
                    ]
                  },
                  {
                    "op": ">",
                    "args": [
                      "nh4no3_s",
                      0.0
                    ]
                  }
                ]
              },
              1.0,
              0.0
            ]
          }
        },
        {
          "lhs": "prod_nh4cl",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "or",
                "args": [
                  {
                    "op": ">",
                    "args": [
                      {
                        "op": "-",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              "gas_nh3",
                              "gas_hcl"
                            ]
                          },
                          "keq0_nh4cl"
                        ]
                      },
                      0.0
                    ]
                  },
                  {
                    "op": ">",
                    "args": [
                      "nh4cl_s",
                      0.0
                    ]
                  }
                ]
              },
              1.0,
              0.0
            ]
          }
        },
        {
          "lhs": "case4",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "case1",
                      0.0
                    ]
                  },
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "==",
                        "args": [
                          "case2",
                          0.0
                        ]
                      },
                      {
                        "op": "and",
                        "args": [
                          {
                            "op": "==",
                            "args": [
                              "case3",
                              0.0
                            ]
                          },
                          {
                            "op": "or",
                            "args": [
                              {
                                "op": ">",
                                "args": [
                                  "prod_nh4no3",
                                  0.0
                                ]
                              },
                              {
                                "op": ">",
                                "args": [
                                  "prod_nh4cl",
                                  0.0
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1.0,
              0.0
            ]
          }
        },
        {
          "lhs": "pc_nh4no3",
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  100.0,
                  "nh4no3_s"
                ]
              },
              {
                "op": "ifelse",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "salt_s",
                      0.0
                    ]
                  },
                  1.0,
                  "salt_s"
                ]
              }
            ]
          }
        },
        {
          "lhs": "pc_nh4cl",
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  100.0,
                  "nh4cl_s"
                ]
              },
              {
                "op": "ifelse",
                "args": [
                  {
                    "op": "==",
                    "args": [
                      "salt_s",
                      0.0
                    ]
                  },
                  1.0,
                  "salt_s"
                ]
              }
            ]
          }
        },
        {
          "lhs": "on_nh4no3",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "<",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "gas_nh3",
                          "gas_hno3"
                        ]
                      },
                      "keq_sg_nh4no3"
                    ]
                  },
                  {
                    "op": "<=",
                    "args": [
                      "pc_nh4no3",
                      "ap.ptol_pc"
                    ]
                  }
                ]
              },
              0.0,
              1.0
            ]
          }
        },
        {
          "lhs": "on_nh4cl",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "<",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          "gas_nh3",
                          "gas_hcl"
                        ]
                      },
                      "keq_sg_nh4cl"
                    ]
                  },
                  {
                    "op": "<=",
                    "args": [
                      "pc_nh4cl",
                      "ap.ptol_pc"
                    ]
                  }
                ]
              },
              0.0,
              1.0
            ]
          }
        },
        {
          "lhs": "acid_hno3",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": ">",
                "args": [
                  "gas_hno3",
                  "ap.gas_min"
                ]
              },
              {
                "op": "*",
                "args": [
                  "kg_hno3",
                  "gas_hno3"
                ]
              },
              0.0
            ]
          }
