        },
        "route_mix": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "1 for a mixed bin holding solid NH4NO3 or NH4Cl: ASTEM_flux_mix, NOT transcribed; its semi-volatile rates here are zero."
        },
        "route_solid": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "1 for an all-solid bin: the solid surface."
        },
        "route_liquid": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin"
          ],
          "description": "1 for an all-liquid bin, or a mixed bin without solid NH4NO3 or NH4Cl: the liquid surface."
        },
        "cond_s": {
          "type": "unknown",
          "units": "nmol/(m^3*s)",
          "shape": [
            "lev",
            "bin",
            "gas"
          ],
          "description": "The solid surface's semi-volatile rates on the gas axis (zero for H2SO4 and MSA, which the surface equilibria do not treat)."
        },
        "cond_l": {
          "type": "unknown",
          "units": "nmol/(m^3*s)",
          "shape": [
            "lev",
            "bin",
            "gas"
          ],
          "description": "The liquid surface's semi-volatile rates on the gas axis (zero for H2SO4 and MSA)."
        },
        "daer": {
          "type": "unknown",
          "units": "nmol/(m^3*s)",
          "shape": [
            "lev",
            "bin",
            "gas"
          ],
          "description": "Rate into each bin of the ion each gas condenses into (H2SO4 -> SO4, HNO3 -> NO3, HCl -> Cl, NH3 -> NH4, MSA -> MSA, one nmol for one nmol), into the bin's total phase: gas kg for the non-volatile H2SO4 and MSA in every bin holding aerosol; for HNO3, HCl and NH3 the solid surface's rate in an all-solid bin, the liquid surface's in an all-liquid bin or a mixed bin without solid NH4NO3/NH4Cl, and zero otherwise (route_mix: ASTEM_flux_mix, not transcribed)."
        },
        "dgas": {
          "type": "unknown",
