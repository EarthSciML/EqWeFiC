            "el"
          ],
          "description": "Sulfate-poor activity coefficients: mixed where nu_poor > 0, else 1; all 1 with no electrolyte."
        },
        "gam_rich": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "el"
          ],
          "description": "Sulfate-rich activity coefficients: mixed where mix_rich, else 1; all 1 with no electrolyte."
        },
        "gam": {
          "type": "unknown",
          "units": "1",
          "shape": [
