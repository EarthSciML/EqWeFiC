        },
        "c_bal": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Sulfate-rich charge balance NH4 + Na + 2 Ca - NO3 - Cl - SO4_total - MSA, with Ca = 0."
        },
        "b_q": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Linear coefficient of the H+ quadratic, K + c."
        },
        "c_q": {
          "type": "unknown",
          "units": "mol^2/kg^2",
          "description": "Constant coefficient of the H+ quadratic, K (c - SO4_total)."
        },
        "x_q": {
          "type": "unknown",
          "units": "1",
          "description": "4 c_q/b_q^2, the series variable (1e6 when b_q = 0)."
        },
        "h_series_raw": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Series form of the positive root, -(b/2)(x/2 + x^2/8 + x^3/16) with x = 4c/b^2 (the Fortran's dum*0.5*... as written)."
        },
        "h_series": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Series root with the Fortran's sign fix: -b minus it where it is negative."
        },
        "h_root": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Closed-form positive root (-b + sqrt(b^2 - 4c))/2."
        },
        "h_rich": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Sulfate-rich H+, the series or closed root by |x_q| < 1e-6, floored at 1e-7."
        },
        "so4_rich": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Sulfate-rich free SO4-- molality, SO4_total K/(H + K)."
        },
        "hso4_rich": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Sulfate-rich HSO4- molality, SO4_total - SO4--."
        },
        "mc_h": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "H+ molality, mc(jc_h)."
        },
        "mc_nh4": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "NH4+ molality, mc(jc_nh4)."
        },
        "mc_na": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Na+ molality, mc(jc_na)."
        },
        "mc_ca": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Ca++ molality, mc(jc_ca) (zero in the sulfate-rich branch)."
        },
        "ma_hso4": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "HSO4- molality, ma(ja_hso4) (zero in the sulfate-poor branch)."
        },
        "ma_so4": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "SO4-- molality, ma(ja_so4)."
        },
        "ma_no3": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "NO3- molality, ma(ja_no3)."
        },
        "ma_cl": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "Cl- molality, ma(ja_cl)."
        },
        "ma_msa": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "MSA- molality, ma(ja_msa)."
        },
        "m_ion": {
          "type": "unknown",
          "units": "mol/kg",
          "shape": [
            "ion"
          ],
          "description": "The nine ion molalities in the order of tp.stoich: H+, NH4+, Na+, Ca++, HSO4-, SO4--, NO3-, Cl-, MSA-."
        },
        "act_on": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "el"
          ],
          "description": "1 where the bin's branch forms the electrolyte's activity from its ions, 0 where it sets it to zero."
        },
        "activity": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "el"
          ],
          "description": "Electrolyte activities, gamma^nu times the product of ion molalities (activity), in molality units to the power nu."
        },
        "gam_ratio": {
          "type": "unknown",
          "units": "1",
          "description": "gamma_NH4NO3^2/gamma_HNO3^2 (sulfate-poor) or gamma_NH4HSO4^2/gamma_HHSO4^2 (sulfate-rich), gam_ratio(ibin)."
        }
      },
