        }
      },
      "variables": {
        "t_k": {
          "type": "parameter",
          "units": "K",
          "default": 298.0,
          "description": "Temperature (the model's real32 t_k), for the solid-liquid constants keq_sl.",
          "shape": [
            "lev"
          ]
        },
        "aer_t": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "lev",
            "bin",
            "aer"
          ],
          "default": 0.0,
          "description": "The bin's total species aer(:, jtotal), nmol per m3 of air."
        },
        "elec_t": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "lev",
            "bin",
            "el"
          ],
          "default": 0.0,
          "description": "The bin's total electrolytes electrolyte(:, jtotal)."
        },
        "elec_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "lev",
            "bin",
            "el"
          ],
          "default": 0.0,
          "description": "THE STATE: the solid electrolytes electrolyte(:, jsolid) at which the rates are evaluated -- the unknown the equilibrium is solved for (fifteen soluble salts; CaSO4 and CaCO3 ride along). On the tape, a pass's starting solid."
        },
        "a_l": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "lev",
            "bin",
            "sp"
          ],
          "default": 0.0,
          "description": "The liquid species ions_to_electrolytes returns for this state's liquid (ions_to_electrolytes.esm `a`: clipped, CaSO4 removed), `sp` order so4, no3, cl, nh4, msa, na, ca."
        },
        "caso4": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "The CaSO4 ions_to_electrolytes moves from this state's liquid to the solid (ions_to_electrolytes.esm `caso4`): insoluble, so it is solid at any state.",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "elec_l": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "lev",
            "bin",
            "el"
          ],
          "default": 0.0,
          "description": "The liquid electrolytes ions_to_electrolytes forms for this state (ions_to_electrolytes.esm `elec`)."
        },
        "water": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 1e-09,
          "description": "The liquid water at this state (aerosol_water_zsr.esm at the bin's water activity).",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "activity": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lev",
            "bin",
            "el"
          ],
          "default": 0.0,
          "description": "The electrolyte activities at this state (mtem_activities.esm `activity`)."
        },
        "elec_t_sum": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Sum of the total electrolytes.",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "present": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin",
            "salt"
          ],
          "description": "jsalt_present: 1 for a salt above 1 mole percent of the total electrolytes."
        },
        "aer_h": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Charge-balance H+ of the totals, clipped at zero here (mesa_ptc's raz 11/13/2008 update; aerosol_phase_state does not clip it).",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "mass_dry": {
          "type": "unknown",
          "units": "g/cm^3",
          "description": "mass_dry_a as mesa_ptc recomputes it: (sum of aer_t M + aer_h) 1e-15.",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "mass_dry_salt": {
          "type": "unknown",
          "units": "g/cm^3",
          "description": "Dry mass of the fifteen soluble salts, sum of E_t M 1e-15.",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "keq_sl": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "salt"
          ],
          "description": "Solid-liquid equilibrium constants at t_k (fn_keq; keq_sl of update_thermodynamic_constants)."
        },
        "a_t": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "lev",
            "bin",
            "sp"
          ],
          "description": "Total species in the `sp` order."
        },
        "a_s": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "lev",
            "bin",
            "sp"
          ],
          "description": "Solid species of the state (electrolytes_to_ions(jsolid)): each solid electrolyte's ions (tp.stoich) mapped onto MOSAIC's species (mp.ion_species: HSO4- and SO4-- are both so4). HHSO4 is never solid; CaCO3's carbonate is not one of the `sp` species."
        },
        "a_l_state": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "lev",
            "bin",
            "sp"
          ],
          "description": "Liquid species of the state by mass balance, total minus solid: what ions_to_electrolytes is handed."
        },
        "elec_s_eq": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "lev",
            "bin",
            "el"
          ],
          "description": "The state's solid electrolytes with this state's insoluble CaSO4 added."
        },
        "wet": {
          "type": "unknown",
          "units": "1",
          "description": "1 when the liquid holds water; with none mesa_flux_salt zeroes every flux and returns.",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "sat0": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin",
            "salt"
          ],
          "description": "Saturation ratio S_s = a_s/K_s of each salt (Na3H(SO4)2's activity is set to zero first, so it never precipitates)."
        },
        "elec_l_sum": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Sum of the liquid electrolytes.",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "frac_l": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin",
            "salt"
          ],
          "description": "Mole fraction of each salt among the liquid electrolytes (epercent/100)."
        },
        "calcium": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Dissolved calcium at this state.",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "model_off": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin",
            "salt"
          ],
          "description": "MOSAIC's own switch-offs of a salt's exchange between solid and liquid (mesa_flux_salt's Heaviside conditions other than complementarity): Ca(NO3)2 and CaCl2 never precipitate, and with calcium dissolved a salt under 1% of the liquid electrolytes or absent from the totals does not exchange. Physics: they change WHICH state is the equilibrium."
        },
        "g": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin",
            "salt"
          ],
          "description": "THE EQUILIBRIUM RESIDUAL paired with the solid E_s, the function a bounded EarthSciIntegrator `solve` (D95, bounds E_s >= 0) drives to complementarity: S_s - 1 where MOSAIC lets the salt exchange and the liquid holds water, 0 where model_off holds or there is no water (that salt's solid does not change, as in mesa_ptc). The equilibrium is E_s >= 0, g_s <= 0, E_s g_s = 0. It differs from `flux` only where E_s = 0 and g_s < 0: there `flux` is switched off (the complementarity, which the solve's bound supplies, written into the rate) and g keeps S_s - 1."
        },
        "zero_flux": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin",
            "salt"
          ],
          "description": "The switch-offs of the rate `flux`: complementarity (an undersaturated salt with no solid to dissolve, E_s >= 0) or model_off."
        },
        "flux": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin",
            "salt"
          ],
          "description": "THE RATE dE_s/dtau = S_s - 1 of the pseudo-time relaxation whose steady state is the solid-liquid equilibrium (flux_sl): g with the complementarity switch-off applied (zero where zero_flux holds). tau is in amount units (nmol/m3), so the rate is dimensionless. At an equilibrium flux_s = 0 for every salt."
        },
        "phi": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin",
            "salt"
          ],
          "description": "THE SCALED RESIDUAL (S_s - 1)/max(S_s, 1) of the equilibrium (phi_salt), zero where zero_flux holds or the liquid has no water: in [-1, 1), 0 exactly at equilibrium for every active salt."
        },
        "sat": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev",
            "bin",
            "salt"
          ],
          "description": "sat_ratio as mesa_flux_salt leaves it: S_s, with Ca(NO3)2 and CaCl2 set to 1."
        },
        "mass_solid_salt": {
          "type": "unknown",
          "units": "g/cm^3",
          "description": "Mass of the state's solid salts, sum of E_s M 1e-15 over the fifteen soluble salts (g/cm3 of air).",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "all_solid": {
          "type": "unknown",
          "units": "1",
          "description": "MOSAIC's all-solid classification of the state: no salt at all (below 1e-30 g/cm3), or the solid salts hold 98% of the salt mass (mesa_convergence_criterion; a bin so classified loses its water in adjust_solid_aerosol).",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "sumflux": {
          "type": "unknown",
          "units": "1",
          "description": "Sum of |flux| over the salts.",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "crustal": {
          "type": "unknown",
          "units": "ng/m^3",
          "description": "Crustal solids of the state, CaCO3 + CaSO4 + OIN by mass (ng/m3; xhyst_up_crustal_thresh, 2017.12.03).",
          "shape": [
            "lev",
            "bin"
          ]
        },
        "all_liquid": {
          "type": "unknown",
          "units": "1",
          "description": "MOSAIC's all-liquid classification of a state that is not all solid: no salt has a nonzero rate (so none is solid or supersaturated) and the crustal solids are at most 30% of the dry mass. Otherwise, with a nonzero rate or more crust, the bin is mixed.",
          "shape": [
            "lev",
            "bin"
          ]
        }
      },
