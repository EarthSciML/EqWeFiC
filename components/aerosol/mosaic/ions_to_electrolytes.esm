  "models": {
    "MosaicIonsToElectrolytes": {
      "expression_template_imports": [
        {
          "ref": "./mosaic_thermo_templates.esm"
        }
      ],
      "subsystems": {
        "tp": {
          "ref": "./mosaic_thermo_parameters.esm"
        },
        "mp": {
          "ref": "./mosaic_mesa_parameters.esm"
        }
      },
      "variables": {
        "a_in": {
          "type": "parameter",
          "units": "nmol/m^3",
          "shape": [
            "sp"
          ],
          "default": 0.0,
          "description": "The liquid phase's species amounts aer(:, jliquid) on entry, in the `sp` order so4, no3, cl, nh4, msa, na, ca (aer indices 1, 2, 3, 4, 5, 108, 109), nmol per m3 of air. Negative values (left by a flux update) are clipped to zero first, as the Fortran does in place."
        },
        "a0": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "sp"
          ],
          "description": "a_in clipped at zero."
        },
        "caso4": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Calcium sulfate formed from the liquid, min(Ca, SO4) (form_caso4): it is insoluble, so ions_to_electrolytes moves it to the SOLID phase at once (electrolyte(jcaso4, jsolid) and aer(ica_a/iso4_a, jsolid) grow by it). A consumer carrying the solid adds it there."
        },
        "a": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "sp"
          ],
          "description": "The liquid species after the CaSO4 has left: a0 less caso4 in so4 and ca. This is aer(:, jliquid) as the routine leaves it."
        },
        "x_t": {
          "type": "unknown",
          "units": "1",
          "description": "calculate_xt of the liquid after the CaSO4 transfer."
        },
        "poor": {
          "type": "unknown",
          "units": "1",
          "description": "1 in the sulfate-POOR (near-neutral) domain, X_T >= 1.9999 or X_T < 0 (icase 1), 0 in the sulfate-rich domain."
        },
        "cat_net": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Anion equivalents less cation equivalents, (2 SO4 + NO3 + Cl + MSA) - (2 Ca + NH4 + Na): the H+ the sulfate-poor liquid needs for neutrality."
        },
        "n_ion": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "ion"
          ],
          "description": "Ion amounts for the sulfate-poor pairing, `ion` order H+ (max(cat_net, 0)), NH4+, Na+, Ca++, HSO4- (none in this domain), SO4--, NO3-, Cl-, MSA-."
        },
        "cation_eq": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Cation charge equivalents, sum over H+, NH4+, Na+, Ca++ of n z (sum_nczc)."
        },
        "anion_eq": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Anion charge equivalents, sum over HSO4-, SO4--, NO3-, Cl-, MSA- of n z (sum_naza)."
        },
        "elec_poor": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "el"
          ],
          "description": "Electrolytes of the sulfate-poor domain: every paired electrolyte by equivalent fractions (template ion_pair_electrolyte); the bisulfates and H2SO4 come out zero because no HSO4- is present, letovicite and Na3H(SO4)2 are never formed."
        },
        "camsa2": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Ca(MSA)2 formed first in the sulfate-rich domain, min(Ca, MSA/2) (form_camsa2)."
        },
        "msa_r": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "MSA left after Ca(MSA)2, max(0, MSA - 2 Ca(MSA)2)."
        },
        "na_nh4": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Na + NH4, the cations left to share the remaining MSA and the sulfate."
        },
        "f_nh4": {
          "type": "unknown",
          "units": "1",
          "description": "Ammonium's share of Na + NH4 (0 when there is neither)."
        },
        "f_na": {
          "type": "unknown",
          "units": "1",
          "description": "Sodium's share of Na + NH4."
        },
        "msa_short": {
          "type": "unknown",
          "units": "1",
          "description": "1 when Na + NH4 exceed the remaining MSA (MSA is shared in proportion f_nh4 : f_na and cations are left over for the sulfate), 0 when MSA is in excess (all Na and NH4 go to MSA salts and the rest is free MSA acid)."
        },
        "nh4msa": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "NH4MSA."
        },
        "namsa": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "NaMSA."
        },
        "msa_free": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Free MSA acid, the MSA beyond the cations."
        },
        "x_s": {
          "type": "unknown",
          "units": "1",
          "description": "Cations per sulfate left for the sulfate salts, (remaining NH4 + remaining Na)/SO4 (the Fortran reuses its xt for this); 0 without sulfate."
        },
        "s_acid": {
          "type": "unknown",
          "units": "1",
          "description": "Fraction of the sulfate held as H2SO4: 1 - x_s for x_s <= 1, else 0."
        },
        "s_bisulf": {
          "type": "unknown",
          "units": "1",
          "description": "Fraction held as bisulfate (NH4HSO4, NaHSO4): x_s for x_s <= 1, 3 - 2 x_s for 1 < x_s <= 1.5, else 0."
        },
        "s_lvc": {
          "type": "unknown",
          "units": "1",
          "description": "Fraction held as letovicite-type salts ((NH4)3H(SO4)2, Na3H(SO4)2): 0 for x_s <= 1, x_s - 1 up to 1.5, 2 - x_s above."
        },
        "s_sulf": {
          "type": "unknown",
          "units": "1",
          "description": "Fraction held as neutral sulfate ((NH4)2SO4, Na2SO4): 2 x_s - 3 above 1.5, else 0."
        },
        "elec_rich": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "el"
          ],
          "description": "Electrolytes of the sulfate-rich domain: Ca(MSA)2, the MSA salts and free MSA, the sulfate apportioned by x_s among acid, bisulfate, letovicite and sulfate with each split between ammonium and sodium in proportion f_nh4 : f_na, and all nitrate and chloride as HNO3 and HCl. With no sulfate the Fortran jumps out after the MSA salts, leaving HNO3 and HCl at zero."
        },
        "elec": {
          "type": "unknown",
          "units": "nmol/m^3",
          "shape": [
            "el"
          ],
          "description": "The liquid electrolytes electrolyte(:, jliquid) (CaSO4 and CaCO3 are zero)."
        }
      },
