        }
      },
      "variables": {
        "gas_hno3": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Gas-phase HNO3, gas(ihno3_g), as ASTEM_flux_mix sees it (after its tiny absorptions and degassings)."
        },
        "gas_hcl": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Gas-phase HCl, gas(ihcl_g), likewise."
        },
        "gas_nh3": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Gas-phase NH3, gas(inh3_g), likewise."
        },
        "kg_hno3": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "Mass-transfer coefficient of HNO3 to this bin, kg(ihno3_g, ibin) (gas_particle_mass_transfer.esm)."
        },
        "kg_hcl": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "Mass-transfer coefficient of HCl to this bin."
        },
        "kg_nh3": {
          "type": "parameter",
          "units": "1/s",
          "default": 0.0,
          "description": "Mass-transfer coefficient of NH3 to this bin."
        },
        "so4_l": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Liquid sulfate aer(iso4_a, jliquid, ibin): with msa_l, nh4_l, na_l and ca_l it sets the LIQUID's sulfate ratio X_T, which decides mixed case 2."
        },
        "msa_l": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Liquid MSA."
        },
        "nh4_l": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Liquid NH4."
        },
        "na_l": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Liquid Na."
        },
        "ca_l": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Liquid Ca."
        },
        "caco3_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid CaCO3 electrolyte(jcaco3, jsolid, ibin): any makes mixed case 1 (its percentage of the solid salts is positive exactly when the amount is)."
        },
        "nacl_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid NaCl electrolyte(jnacl, jsolid, ibin)."
        },
        "cacl2_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid CaCl2 electrolyte(jcacl2, jsolid, ibin)."
        },
        "nh4no3_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid NH4NO3 electrolyte(jnh4no3, jsolid, ibin)."
        },
        "nh4cl_s": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 0.0,
          "description": "Solid NH4Cl electrolyte(jnh4cl, jsolid, ibin)."
        },
        "keq_nh4no3": {
          "type": "parameter",
          "units": "nmol^2/m^6",
          "default": 0.0,
          "description": "Coupling target: [NH3]s [HNO3]s over the bin's solution, kel_NH3 kel_HNO3 a_NH4NO3 kp_nh4no3 (astem_liquid_surface_equilibrium.esm keq_nh4no3)."
        },
        "keq_nh4cl": {
          "type": "parameter",
          "units": "nmol^2/m^6",
          "default": 0.0,
          "description": "Coupling target: [NH3]s [HCl]s over the bin's solution (astem_liquid_surface_equilibrium.esm keq_nh4cl)."
        },
        "cond_l_hno3": {
          "type": "parameter",
          "units": "nmol/(m^3 s)",
          "default": 0.0,
          "description": "Coupling target: the liquid surface's HNO3 rate (astem_liquid_surface_equilibrium.esm), what mixed cases 1 and 2 hand the bin to."
        },
        "cond_l_hcl": {
          "type": "parameter",
          "units": "nmol/(m^3 s)",
          "default": 0.0,
          "description": "Coupling target: the liquid surface's HCl rate."
        },
        "cond_l_nh3": {
          "type": "parameter",
          "units": "nmol/(m^3 s)",
          "default": 0.0,
          "description": "Coupling target: the liquid surface's NH3 rate."
        },
        "acid_hno3": {
          "type": "parameter",
          "units": "nmol/(m^3 s)",
          "default": 0.0,
          "description": "Coupling target: the solid surface's irreversible HNO3 uptake kg g (astem_solid_surface_equilibrium.esm acid_hno3; case 3a)."
        },
        "f3b": {
          "type": "parameter",
          "units": "nmol/(m^3 s)",
          "default": 0.0,
          "description": "Coupling target: the solid surface's NH4Cl (3b) NH3 = HCl rate, evaluated with mixed = 1 (astem_solid_surface_equilibrium.esm f3b)."
        },
        "f4a": {
          "type": "parameter",
          "units": "nmol/(m^3 s)",
          "default": 0.0,
          "description": "Coupling target: the solid surface's NH4NO3 (4a) HNO3 = NH3 rate at Keq_sg(1), mixed = 1 (f4a)."
        },
        "f4b": {
          "type": "parameter",
          "units": "nmol/(m^3 s)",
          "default": 0.0,
          "description": "Coupling target: the solid surface's NH4Cl (4b) HCl = NH3 rate at Keq_sg(2), mixed = 1 (f4b)."
        },
        "scale4": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Coupling target: the solid surface's NH3-supply scaling of the two acid fluxes when both salts are active (scale4)."
        },
        "nh3_need": {
          "type": "parameter",
          "units": "nmol/(m^3 s)",
          "default": 0.0,
          "description": "Coupling target: f4a + f4b, the NH3 the two solid salts need (nh3_need)."
        },
        "x_t": {
          "type": "unknown",
          "units": "1",
          "description": "Sulfate ratio of the LIQUID, template aerosol_xt (ASTEM_flux_mix's ions_to_electrolytes(jliquid))."
        },
        "wet": {
          "type": "unknown",
          "units": "1",
          "description": "1 for mixed cases 1 and 2, which ASTEM_flux_mix hands to the liquid surface (ASTEM_flux_wet_case1 / case2): solid CaCO3, or a sulfate-rich liquid, 0 <= X_T < 1.9999."
        },
        "volatile_cl": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Solid chloride HNO3 can displace, NaCl + CaCl2."
        },
        "case3": {
          "type": "unknown",
          "units": "1",
          "description": "1 for mixed case 3: not wet, solid NaCl or CaCl2, and HNO3 in the gas -- the solid surface's case 3 (3a, and 3b where NH4Cl can form or is present)."
        },
        "case4": {
          "type": "unknown",
          "units": "1",
          "description": "1 for mixed case 4: not wet, not case 3, solid NH4NO3 AND solid NH4Cl -- the solid surface's case 4."
        },
        "case4a": {
          "type": "unknown",
          "units": "1",
          "description": "1 for mixed case 4a: not wet, not case 3, solid NH4NO3 but no solid NH4Cl -- solid NH4NO3 beside liquid NH4Cl (ASTEM_flux_mix_case4a)."
        },
        "case4b": {
          "type": "unknown",
          "units": "1",
          "description": "1 for mixed case 4b: not wet, not case 3, solid NH4Cl but no solid NH4NO3 -- solid NH4Cl beside liquid NH4NO3 (ASTEM_flux_mix_case4b)."
        },
        "on_l_nh4cl": {
          "type": "unknown",
          "units": "1",
          "description": "Case 4a: 1 unless g_NH3 g_HCl = 0 or keq_nh4cl = 0 -- the liquid NH4Cl surface exchanges."
        },
        "qcl_b": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4a liquid NH4Cl: b = -kg_NH3 g_NH3 + kg_HCl g_HCl."
        },
        "qcl_c": {
          "type": "unknown",
          "units": "nmol^2/(m^6 s)",
          "description": "Case 4a liquid NH4Cl: c = -kg_HCl keq_nh4cl."
        },
        "scl_nh3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 4a: surface NH3 over the liquid NH4Cl, the larger root of kg_NH3 s^2 + qcl_b s + qcl_c = 0 (template mosaic_quadratic), from s_NH3 s_HCl = keq_nh4cl and equal NH3 and HCl fluxes (ASTEM_flux_wet_case3b)."
        },
        "scl_hcl": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 4a: surface HCl over the liquid NH4Cl, keq_nh4cl / scl_nh3."
        },
        "lcl_hcl": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4a: liquid HCl rate kg_HCl (g_HCl - scl_hcl), 0 where the liquid NH4Cl surface is off."
        },
        "lcl_nh3": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4a: liquid NH3 rate kg_NH3 (g_NH3 - scl_nh3), 0 where off."
        },
        "on_l_nh4no3": {
          "type": "unknown",
          "units": "1",
          "description": "Case 4b: 1 unless g_NH3 g_HNO3 = 0 or keq_nh4no3 = 0 -- the liquid NH4NO3 surface exchanges."
        },
        "qno3_b": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4b liquid NH4NO3: b = -kg_NH3 g_NH3 + kg_HNO3 g_HNO3."
        },
        "qno3_c": {
          "type": "unknown",
          "units": "nmol^2/(m^6 s)",
          "description": "Case 4b liquid NH4NO3: c = -kg_HNO3 keq_nh4no3."
        },
        "sno3_nh3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 4b: surface NH3 over the liquid NH4NO3 (template mosaic_quadratic; ASTEM_flux_wet_case3a)."
        },
        "sno3_hno3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 4b: surface HNO3 over the liquid NH4NO3, keq_nh4no3 / sno3_nh3."
        },
        "lno3_hno3": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4b: liquid HNO3 rate kg_HNO3 (g_HNO3 - sno3_hno3), 0 where the liquid NH4NO3 surface is off."
        },
        "lno3_nh3": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 4b: liquid NH3 rate kg_NH3 (g_NH3 - sno3_nh3), 0 where off."
        },
        "cond_hno3": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "HNO3 condensation rate onto this mixed bin, solid plus liquid, by mixed case; negative is evaporation."
        },
        "cond_hcl": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "HCl condensation rate onto this mixed bin, solid plus liquid."
        },
        "cond_nh3": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "NH3 condensation rate onto this mixed bin, solid plus liquid."
        }
      },
