{
  "esm": "1.2.0",
  "metadata": {
    "name": "MosaicAstemParameters",
    "description": "Parameters of the PHYSICS of MOSAIC's gas-particle partitioning (ASTEM, chem/module_mosaic_therm.F, WRF v4.8.0): the gas-liquid, liquid-liquid and solid-gas equilibrium constants of update_thermodynamic_constants (:16052-16100) that set the particle-surface vapour concentrations, and the literal thresholds of the ASTEM_flux_wet / ASTEM_flux_dry case logic that decide which equilibrium holds at a particle surface. ASTEM's integrator settings (nmax_astem, alpha_astem, rtol_eqb_astem, the 100 s sub-step cap) are deliberately NOT here: EqWeFiC does not transcribe the integrator, so they belong to an EarthSciIntegrator run configuration, not to a component. As in the other MOSAIC parameter files, every default-REAL literal is given at the binary32 value the model holds and double-precision literals (the fn_keq coefficients) are exact as written. Gas order (index set `sv`) is MOSAIC's semi-volatile order hno3, hcl, nh3 (gas indices 2, 3, 4).",
    "authors": [
      "EqWeFiC"
    ],
    "references": [
      {
        "citation": "Zaveri, R.A., Easter, R.C., Fast, J.D., Peters, L.K. (2008). Model for Simulating Aerosol Interactions and Chemistry (MOSAIC). J. Geophys. Res. 113, D13204."
      },
      {
        "citation": "WRF v4.8.0 chem/module_mosaic_therm.F"
      }
    ]
  },
  "models": {
    "MosaicAstemParameters": {
      "variables": {
        "rt_c0": {
          "type": "parameter",
          "units": "1",
          "default": 82.05599975585938,
          "description": "The 82.056 of rt = 82.056 T/(1e9 1e6) (update_thermodynamic_constants), a default-REAL literal held as binary32 82.05599975585938: the gas constant in cm3 atm/(mol K)."
        },
        "rt_den": {
          "type": "parameter",
          "units": "1",
          "default": 999999986991104.0,
          "description": "The (1.e9*1.e6) of rt, a default-REAL product held as binary32 999999986991104.0: mol to nmol times cm3 to m3."
        },
        "kh_nh3_298": {
          "type": "parameter",
          "units": "1",
          "default": 57.64,
          "description": "NH3(g) = NH3(aq) Henry constant at 298.15 K, mol/(kg atm) (keq_gl(2), 57.64d0)."
        },
        "kh_nh3_a": {
          "type": "parameter",
          "units": "1",
          "default": 13.79,
          "description": "fn_keq first coefficient of keq_gl(2)."
        },
        "kh_nh3_b": {
          "type": "parameter",
          "units": "1",
          "default": -5.39,
          "description": "fn_keq second coefficient of keq_gl(2)."
        },
        "kh_hno3_298": {
          "type": "parameter",
          "units": "1",
          "default": 2630000.0,
          "description": "HNO3(g) = H+ + NO3- constant at 298.15 K, mol2/(kg2 atm) (keq_gl(3), 2.63d6)."
        },
        "kh_hno3_a": {
          "type": "parameter",
          "units": "1",
          "default": 29.17,
          "description": "fn_keq first coefficient of keq_gl(3)."
        },
        "kh_hno3_b": {
          "type": "parameter",
          "units": "1",
          "default": 16.83,
          "description": "fn_keq second coefficient of keq_gl(3)."
        },
        "kh_hcl_298": {
          "type": "parameter",
          "units": "1",
          "default": 2000000.0,
          "description": "HCl(g) = H+ + Cl- constant at 298.15 K, mol2/(kg2 atm) (keq_gl(4), 2.00d6)."
        },
        "kh_hcl_a": {
          "type": "parameter",
          "units": "1",
          "default": 30.2,
          "description": "fn_keq first coefficient of keq_gl(4)."
        },
        "kh_hcl_b": {
          "type": "parameter",
          "units": "1",
          "default": 19.91,
          "description": "fn_keq second coefficient of keq_gl(4)."
        },
        "kb_nh3_298": {
          "type": "parameter",
          "units": "1",
          "default": 1.805e-05,
          "description": "NH3(aq) + H2O = NH4+ + OH- at 298.15 K, mol/kg (keq_ll(2))."
        },
        "kb_nh3_a": {
          "type": "parameter",
          "units": "1",
          "default": -1.5,
          "description": "fn_keq first coefficient of keq_ll(2)."
        },
        "kb_nh3_b": {
          "type": "parameter",
          "units": "1",
          "default": 26.92,
          "description": "fn_keq second coefficient of keq_ll(2)."
        },
        "kw_298": {
          "type": "parameter",
          "units": "1",
          "default": 1.01e-14,
          "description": "Ion product of water at 298.15 K, mol2/kg2 (keq_ll(3))."
        },
        "kw_a": {
          "type": "parameter",
          "units": "1",
          "default": -22.52,
          "description": "fn_keq first coefficient of keq_ll(3)."
        },
        "kw_b": {
          "type": "parameter",
          "units": "1",
          "default": 26.92,
          "description": "fn_keq second coefficient of keq_ll(3)."
        },
        "ksg_nh4no3_298": {
          "type": "parameter",
          "units": "1",
          "default": 4.72e-17,
          "description": "NH4NO3(s) = NH3(g) + HNO3(g) at 298.15 K, atm2 (keq_sg(1))."
        },
        "ksg_nh4no3_a": {
          "type": "parameter",
          "units": "1",
          "default": -74.38,
          "description": "fn_keq first coefficient of keq_sg(1)."
        },
        "ksg_nh4no3_b": {
          "type": "parameter",
          "units": "1",
          "default": 6.12,
          "description": "fn_keq second coefficient of keq_sg(1)."
        },
        "ksg_nh4cl_298": {
          "type": "parameter",
          "units": "1",
          "default": 8.43e-17,
          "description": "NH4Cl(s) = NH3(g) + HCl(g) at 298.15 K, atm2 (keq_sg(2))."
        },
        "ksg_nh4cl_a": {
          "type": "parameter",
          "units": "1",
          "default": -71.0,
          "description": "fn_keq first coefficient of keq_sg(2)."
        },
        "ksg_nh4cl_b": {
          "type": "parameter",
          "units": "1",
          "default": 2.4,
          "description": "fn_keq second coefficient of keq_sg(2)."
        },
        "xt_rich": {
          "type": "parameter",
          "units": "1",
          "default": 1.999899983406067,
          "description": "The sulfate-rich test of ASTEM_flux_wet / ASTEM_flux_dry, 0 <= X_T < 1.9999 (binary32 1.999899983406067)."
        },
        "gas_min": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 9.999999747378752e-06,
          "description": "The 1.e-5 nmol/m3 below which a gas is not taken up by an acid-absorbing (CaCO3) or ammonia-absorbing (sulfate-rich solid) surface, binary32 9.999999747378752e-06."
        },
        "nh3_none": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 1.0000000195414814e-25,
          "description": "ASTEM_flux_wet's test for an ammonia-free system, gas NH3 + liquid NH4 < 1.e-25 (binary32 1.0000000195414814e-25)."
        },
        "sfc_floor": {
          "type": "parameter",
          "units": "nmol/m^3",
          "default": 1e-20,
          "description": "The 1.D-20 floor on the surface NH3 that the surface HNO3 and HCl are divided by (case 3)."
        },
        "series_x": {
          "type": "parameter",
          "units": "1",
          "default": 9.999999974752427e-07,
          "description": "FUNCTION quadratic switches to its series form of the root where |4ac/b^2| < 1.e-6 (binary32 9.999999974752427e-07)."
        },
        "ptol_pc": {
          "type": "parameter",
          "units": "1",
          "default": 0.009999999776482582,
          "description": "ptol_mol_astem, 0.01 mole percent (default REAL, binary32 0.009999999776482582): below this share of the solid's salts an undersaturated NH4NO3 or NH4Cl counts as absent, so there is nothing to evaporate (ASTEM_flux_dry_case3b/4)."
        }
      },
      "equations": []
    }
  }
}
