{
  "esm": "1.2.0",
  "metadata": {
    "name": "MosaicPhaseParameters",
    "description": "Parameters of MOSAIC's phase-state decision (aerosol_phase_state, mesa, calculate_kelvin, drh_mutual, aerosol_water_up of chem/module_mosaic_therm.F, WRF v4.8.0): MESA's crystallization point and mutual-deliquescence tables, and the literals of the Kelvin iteration. As in mosaic_thermo_parameters.esm, every value is the binary32 rounding the model holds (default-real literals assigned into or combined with real(kind=8)). The tables jsalt_index, jsulf_poor, jsulf_rich and d_mdrh are taken from the model's own arrays as kernels/mosaic_therm_driver dumps them (tools/extract_mosaic_phase_tables.py).",
    "authors": [
      "EqWeFiC"
    ],
    "references": [
      {
        "citation": "Zaveri, R.A., Easter, R.C., Fast, J.D., Peters, L.K. (2008). Model for Simulating Aerosol Interactions and Chemistry (MOSAIC). J. Geophys. Res. 113, D13204."
      },
      {
        "citation": "WRF v4.8.0 chem/module_mosaic_therm.F"
      }
    ]
  },
  "index_sets": {
    "gas": {
      "kind": "interval",
      "size": 5
    },
    "salt": {
      "kind": "interval",
      "size": 15
    },
    "poorcode": {
      "kind": "interval",
      "size": 211
    },
    "richcode": {
      "kind": "interval",
      "size": 71
    },
    "mdrhcurve": {
      "kind": "interval",
      "size": 63
    },
    "cubic": {
      "kind": "interval",
      "size": 4
    }
  },
  "models": {
    "MosaicPhaseParameters": {
      "variables": {
        "crh": {
          "type": "parameter",
          "units": "1",
          "default": 0.3499999940395355,
          "description": "Crystallization (efflorescence) water activity of SUBROUTINE mesa, crh = 0.35 (raz-30apr07) as binary32."
        },
        "ptol": {
          "type": "parameter",
          "units": "percent",
          "default": 0.009999999776482582,
          "description": "ptol_mol_astem = 0.01 (load_mosaic_parameters), the mol-percent below which MESA treats an electrolyte as absent; binary32."
        },
        "mdrh_ca": {
          "type": "parameter",
          "units": "percent",
          "default": 10.0,
          "description": "drh_mutual's fixed value for the Ca(NO3)2/CaCl2-containing mixtures (indices 7, 8, 34-51)."
        },
        "aw_up": {
          "type": "parameter",
          "units": "1",
          "default": 0.6000000238418579,
          "description": "The fixed water activity of aerosol_water_up / bin_molality_60, aw = 0.6 as binary32."
        },
        "pc_to_frac": {
          "type": "parameter",
          "units": "1/percent",
          "default": 0.009999999776482582,
          "description": "The 0.01 of ah2o = rh_pc*0.01, binary32."
        },
        "kelvin_tol_lo": {
          "type": "parameter",
          "units": "1",
          "default": 0.009999999776482582,
          "description": "Kelvin-iteration tolerance where rh_pc <= 99, written 1.e-2 (binary32)."
        },
        "kelvin_tol_hi": {
          "type": "parameter",
          "units": "1",
          "default": 9.999999974752427e-07,
          "description": "Kelvin-iteration tolerance where rh_pc > 99, written 1.e-6 (binary32)."
        },
        "ng_per_m3_to_g_per_cm3": {
          "type": "parameter",
          "units": "g*m^3/(ng*cm^3)",
          "default": 1.0000000036274937e-15,
          "description": "The 1.e-15 that turns ng/m3 into g/cm3 (and ncc/m3 into cm3/cm3) in the dry mass and volume, binary32."
        },
        "water_to_g_per_cm3": {
          "type": "parameter",
          "units": "g*m^3/(kg*cm^3)",
          "default": 0.0010000000474974513,
          "description": "The 1.e-3 of mass_wet = mass_dry + water*1.e-3 (kg/m3 to g/cm3), binary32."
        },
        "mw_h": {
          "type": "parameter",
          "units": "g/mol",
          "default": 1.0,
          "description": "The molar mass the Fortran implicitly gives the charge-balance H+ (aer_H) when it adds its nmol amount to the ng sum."
        },
        "dens_h": {
          "type": "parameter",
          "units": "g/cm^3",
          "default": 1.0,
          "description": "The density the Fortran implicitly gives aer_H when it adds its nmol amount to the ncc sum."
        },
        "pi_k": {
          "type": "parameter",
          "units": "1",
          "default": 3.141592502593994,
          "description": "calculate_kelvin's pi, written 3.1415926 (binary32)."
        },
        "third": {
          "type": "parameter",
          "units": "1",
          "default": 0.3333333432674408,
          "description": "calculate_kelvin's exponent 1./3., formed in default REAL (binary32)."
        },
        "r_cgs": {
          "type": "parameter",
          "units": "erg/(mol*K)",
          "default": 83144000.0,
          "description": "Gas constant 8.3144e7 erg/(mol K) of calculate_kelvin and the condensing-gas Kelvin terms (exact in binary32)."
        },
        "t_crit": {
          "type": "parameter",
          "units": "K",
          "default": 647.1500244140625,
          "description": "Critical temperature of water in the surface-tension fit, written 647.15 (binary32)."
        },
        "sig_a": {
          "type": "parameter",
          "units": "dyn/cm",
          "default": 0.23579999804496765,
          "description": "Coefficient of the water surface-tension fit, written 0.2358 (binary32). The fit is in N/m; MOSAIC uses its value as dyn/cm (FORTRAN_BUGS B29), and this parameter is declared in the unit MOSAIC USES so the component's arithmetic is the Fortran's."
        },
        "sig_b": {
          "type": "parameter",
          "units": "1",
          "default": 1.25600004196167,
          "description": "Exponent of the water surface-tension fit, written 1.256 (binary32)."
        },
        "sig_c": {
          "type": "parameter",
          "units": "1",
          "default": 0.625,
          "description": "Coefficient 0.625 of the water surface-tension fit."
        },
        "partial_molar_vol": {
          "type": "parameter",
          "units": "cm^3/mol",
          "default": [
            51.83000183105469,
            31.450000762939453,
