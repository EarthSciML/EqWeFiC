        "case3": {
          "type": "unknown",
          "units": "1",
          "description": "1 when sulfate-poor with ammonia: NH4NO3 and NH4Cl may both exchange (case 3)."
        },
        "case4": {
          "type": "unknown",
          "units": "1",
          "description": "1 when sulfate-poor without ammonia: only HNO3 and HCl exchange, against each other (case 4)."
        },
        "s2_nh3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case-2 surface NH3 over a sulfate-rich solution, kel gam_ratio [NH4+] K_w/([H+] K_b K_H)."
        },
        "s2_hno3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case-2 surface HNO3, kel [H+][NO3-] gamma_HNO3^2/K_HNO3."
        },
        "s2_hcl": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case-2 surface HCl, kel [H+][Cl-] gamma_HCl^2/K_HCl."
        },
        "keq_nh4no3": {
          "type": "unknown",
          "units": "1",
          "description": "Case 3: [NH3]s [HNO3]s over this solution, kel_NH3 kel_HNO3 a_NH4NO3 kp_nh4no3, (nmol/m3)^2."
        },
        "keq_nh4cl": {
          "type": "unknown",
          "units": "1",
          "description": "Case 3: [NH3]s [HCl]s, kel_NH3 kel_HCl a_NH4Cl kp_nh4cl, (nmol/m3)^2."
        },
        "qa": {
          "type": "unknown",
          "units": "1/s",
          "description": "Case 3: quadratic coefficient a = kg_NH3 of the surface-NH3 balance."
        },
        "qb": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Case 3: b = -kg_NH3 g_NH3 + kg_HNO3 g_HNO3 + kg_HCl g_HCl."
        },
        "qc": {
          "type": "unknown",
          "units": "1",
          "description": "Case 3: c = -(kg_HNO3 K_NH4NO3 + kg_HCl K_NH4Cl)."
        },
        "qx": {
          "type": "unknown",
          "units": "1",
          "description": "Case 3: 4 (a/b)(c/b), the series variable of FUNCTION quadratic (1e6 when b = 0)."
        },
        "s3_series": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 3: series form of the root, (-b/2a)(x/2 + x^2/8 + x^3/16), folded to -b/a minus itself where negative."
        },
        "s3_closed": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 3: the larger closed-form root, max of (-b +- sqrt(b^2 - 4ac))/2a."
        },
        "s3_nh3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 3 surface NH3: FUNCTION quadratic, the series form where |x| < 1e-6."
        },
        "s3_hno3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 3 surface HNO3, K_NH4NO3/max([NH3]s, 1e-20)."
        },
        "s3_hcl": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 3 surface HCl, K_NH4Cl/max([NH3]s, 1e-20)."
        },
        "eq4_num": {
          "type": "unknown",
          "units": "1",
          "description": "Case 4: kel_HNO3 K_HCl [NO3-] gamma_HNO3^2."
        },
        "eq4_den": {
          "type": "unknown",
          "units": "1",
          "description": "Case 4: kel_HCl K_HNO3 [Cl-] gamma_HCl^2."
        },
        "eq4_on": {
          "type": "unknown",
          "units": "1",
          "description": "Case 4 exchanges only with both nitrate and chloride in solution (numerator and denominator nonzero)."
        },
        "eq4_ratio": {
          "type": "unknown",
          "units": "1",
          "description": "Case 4: [HNO3]s/[HCl]s fixed by the common H+, numerator/denominator (1 when off)."
        },
        "s4_hcl": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Case 4 surface HCl from the balance kg_HNO3 (g_HNO3 - s_HNO3) + kg_HCl (g_HCl - s_HCl) = 0."
        },
        "sfc_hno3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Equilibrium HNO3 vapour concentration at the particle surface, sfc_a(ihno3_g); the gas value itself where this bin does not exchange HNO3 (no driving force)."
        },
        "sfc_hcl": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Surface HCl, sfc_a(ihcl_g)."
        },
        "sfc_nh3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "Surface NH3, sfc_a(inh3_g)."
        },
        "mc_h_from_no3": {
          "type": "unknown",
          "units": "1",
          "description": "1 where H+ is diagnosed from the surface HNO3 (cases 3 and 4)."
        },
        "mc_h_from_cl": {
          "type": "unknown",
          "units": "1",
          "description": "1 where it is diagnosed from the surface HCl instead."
        },
        "mc_h": {
          "type": "unknown",
          "units": "mol/kg",
          "description": "The bin's H+ molality after its flux routine: compute_activities' value in case 2, sqrt(K_w) in case 1, and in cases 3 and 4 the value consistent with the surface HNO3 (or HCl) through Henry's law and the activity coefficients."
        },
        "df_hno3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "HNO3 driving force gas - surface (df_gas_l, or df_gas_s for a CaCO3 bin)."
        },
        "df_hcl": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "HCl driving force."
        },
        "df_nh3": {
          "type": "unknown",
          "units": "nmol/m^3",
          "description": "NH3 driving force."
        },
        "cond_hno3": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Instantaneous HNO3 condensation rate onto this bin, kg (gas - surface); negative is evaporation. The gas tendency is minus the sum over bins, and the bin's nitrate (solid for a CaCO3 bin, else liquid) gains it."
        },
        "cond_hcl": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Instantaneous HCl condensation rate onto this bin."
        },
        "cond_nh3": {
          "type": "unknown",
          "units": "nmol/(m^3 s)",
          "description": "Instantaneous NH3 condensation rate onto this bin."
        },
        "acids_equilibrate": {
          "type": "unknown",
          "units": "1",
          "description": "1 in case 3 when the liquid holds neither nitrate nor chloride, where the Fortran calls equilibrate_acids, an instantaneous gas-liquid projection that rewrites the bin's state; that projection is not transcribed here, so the surface values and H+ this component gives there are not the Fortran's."
        }
      },
      "equations": [
        {
          "lhs": "x_t",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "aerosol_xt",
            "bindings": {
