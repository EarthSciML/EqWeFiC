                    ]
                  }
                ]
              },
              "keq_hcl_gl"
            ]
          }
        },
        {
          "lhs": "keq_nh4no3",
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "*",
                "args": [
                  "kel_nh3",
                  "kel_hno3"
                ]
              },
              "act_nh4no3",
              "kp_nh4no3"
            ]
          }
        },
        {
          "lhs": "keq_nh4cl",
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "*",
                "args": [
                  "kel_nh3",
                  "kel_hcl"
                ]
