                  "has_nh3"
                ]
              }
            ]
          }
        },
        {
          "lhs": "s2_nh3",
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  "kel_nh3",
                  "gam_ratio",
                  "mc_nh4",
                  "k_w"
                ]
              },
              {
                "op": "*",
                "args": [
                  "mc_h_act",
                  "keq_nh3_ll",
                  "keq_nh3_gl"
                ]
              }
            ]
          }
        },
        {
          "lhs": "s2_hno3",
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  "kel_hno3",
                  "mc_h_act",
                  "ma_no3",
                  {
                    "op": "^",
                    "args": [
