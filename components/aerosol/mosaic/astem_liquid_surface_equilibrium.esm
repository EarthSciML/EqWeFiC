                      2.0
                    ]
                  }
                ]
              },
              "keq_hno3_gl"
            ]
          }
        },
        {
          "lhs": "s2_hcl",
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "*",
                "args": [
                  "kel_hcl",
