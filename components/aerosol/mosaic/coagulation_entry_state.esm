      "description": "Number of MOSAIC aerosol components carried by each bin (ncomp_aer = 10 for chem_opt = 170: so4, no3, cl, co3, nh4, na, ca, oin, oc, bc)."
    }
  },
  "index_sets": {
    "comp": {
      "kind": "interval",
      "size": "NCOMP"
    }
  },
