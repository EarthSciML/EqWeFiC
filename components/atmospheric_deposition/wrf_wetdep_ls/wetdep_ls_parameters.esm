{
  "esm": "1.2.0",
  "metadata": {
    "name": "WetDepLSParameters",
    "description": "The literal constants of WRF-Chem's large-scale wet deposition, `wetdep_ls` in chem/module_wetdep_ls.F (WRF v4.8.0), the scheme `wetscav_onoff < 0` selects. None is a physical constant: they are the scheme's scavenging efficiencies, the clamp on its conversion factor, and the floors and gates it compares raw numbers against. Every gate is a bare number in WRF's own units for the quantity it tests (rain in mm per step, i.e. kg m-2; a species in ITS chem unit -- ppmv for a gas, ug/kg or 1/kg for an aerosol), so each is declared here in the unit the comparison is actually made in.\n\nThe one entry that is not a literal of the source is `F_unit`. The scheme is dimensionally inconsistent (FORTRAN_BUGS.md B22): its conversion factor `frc` is a rain rate over a column-integrated cloud-water flux, units 1/m, and the per-layer removal argument `frc*rho*dz8w*vvel` is therefore a mass flux in kg m-2 s-1, which the Fortran then adds to 1. The numbers WRF produces are those of that sum taken in SI, so the component divides the argument by a unit flux of 1 kg m-2 s-1 to make the dimensionless number the Fortran uses. It reproduces WRF; it does not repair the scheme, and a change of units in the inputs would change the answer, which is the defect.",
    "authors": ["EqWeFiC"],
    "created": "2026-11-11T00:00:00Z",
    "tags": ["wrf-chem", "wet-deposition", "wetdep_ls", "parameters"]
  },
  "models": {
    "WetDepLSParameters": {
      "variables": {
        "alpha_aerosol": {"type": "parameter", "units": "1", "default": 0.5, "description": "Scavenging efficiency of every aerosol species (nv > numgas) for chem_opt < 300, `alpha = .5`."},
        "alpha_sulf": {"type": "parameter", "units": "1", "default": 1.0, "description": "Scavenging efficiency of gas-phase sulfuric acid `sulf`, the one gas the scheme scavenges (`alpha = 1.` for p_sulf, and for the four sea-salt bins of the GOCART mechanisms, which chem_opt 170 does not carry)."},
        "frc_min": {"type": "parameter", "units": "1/m", "default": 1.0e-6, "description": "Lower clamp on the conversion factor, `max(1.e-6, ...)`."},
        "frc_max": {"type": "parameter", "units": "1/m", "default": 0.005, "description": "Upper clamp on the conversion factor, `min(frc, .005)`."},
        "rain_gate": {"type": "parameter", "units": "kg/m^2", "default": 1.0e-10, "description": "The column scavenges only when the step's grid-scale rain exceeds this, `rain(i,j) .gt. 1.e-10` (rainncv, mm per step)."},
        "burden_gate": {"type": "parameter", "units": "kg/m^3", "default": 1.0e-10, "description": "The species is scavenged only when its density-weighted level SUM exceeds this, `var_sum .gt. 1.e-10`; in the species' own chem unit times kg/m3, so the gate means something different for a gas in ppmv, an aerosol mass in ug/kg and a number in 1/kg."},
        "cw_gate": {"type": "parameter", "units": "kg/(m*s)", "default": 1.0e-10, "description": "The column scavenges only when its integrated upward cloud-water flux exceeds this, `var_sum_clw .gt. 1.e-10`."},
        "c_threshold": {"type": "parameter", "units": "1", "default": 1.0e-16, "description": "A layer is scavenged only when the species exceeds this, `var .gt. 1.e-16`, and the scavenged value is floored at it, `max(1.e-16, var - dvar)`; in the species' own chem unit."},
        "F_unit": {"type": "parameter", "units": "kg/(m^2*s)", "default": 1.0, "description": "A unit mass flux, NOT in the source: the removal argument frc*rho*dz*w is a mass flux that the Fortran adds to 1 as though it were dimensionless, so the component divides by 1 kg m-2 s-1 to reproduce that number (see the model description and FORTRAN_BUGS.md B22)."}
      },
      "equations": []
    }
  }
}
