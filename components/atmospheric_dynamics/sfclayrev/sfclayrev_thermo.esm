{
 "esm": "1.0.0",
 "metadata": {
  "name": "sfclayrev_thermo",
  "description": "Thermodynamic helpers of WRF's surface-layer schemes not yet in lib/wrf_thermo.esm: the Bolton (1980) saturation vapour pressure e_s = svp1 exp(svp2 (T - svpt0)/(T - svp3)) in the units of svp1 (kPa in WRF), the Exner function (p/p0)^(R_d/c_p), and the Beljaars (1994) convective velocity scale over land w_c = (g/T h F)^0.33 with F the surface buoyancy flux (module_sf_sfclayrev/sf_sfclayrev.F90 lines 239, 267, 290-299, 346-348). To be folded into lib/wrf_thermo.esm when that library is next revised.",
  "license": "MIT",
  "tags": ["wrf", "thermodynamics", "surface-layer", "expression-templates"],
  "references": [
   {"citation": "Bolton, D. (1980). The computation of equivalent potential temperature. Mon. Wea. Rev. 108, 1046-1053."},
   {"citation": "Beljaars, A. C. M. (1994). The parametrization of surface fluxes in large-scale models under free convection. Q. J. R. Meteorol. Soc. 121, 255-270."}
  ]
 },
 "expression_templates": {
  "bolton_saturation_vapor_pressure": {
   "params": ["T", "svp1", "svp2", "svp3", "svpt0"],
   "description": "Bolton (1980) saturation vapour pressure over water, svp1 exp(svp2 (T - svpt0)/(T - svp3)), in the units of svp1 (WRF: kPa).",
   "body": {"op": "*", "args": ["svp1", {"op": "exp", "args": [{"op": "/", "args": [{"op": "*", "args": ["svp2", {"op": "-", "args": ["T", "svpt0"]}]}, {"op": "-", "args": ["T", "svp3"]}]}]}]}
  },
  "exner_function": {
   "params": ["p", "p0", "kappa"],
   "description": "Exner function (p/p0)^kappa, kappa = R_d/c_p; theta = T/exner.",
   "body": {"op": "^", "args": [{"op": "/", "args": ["p", "p0"]}, "kappa"]}
  },
  "beljaars_convective_velocity": {
   "params": ["g", "T_sfc", "h", "buoyancy_flux", "coef", "expo", "unit_velocity"],
   "description": "Beljaars (1994) convective velocity scale over land, coef (g/T_sfc h F)^expo with F = max(H/(rho cp) + ep_1 theta_v E/rho, 0) the kinematic buoyancy flux and h the boundary-layer depth (WRF vconv = vconvc (g/tgdsa pblh fluxc)^.33). The kernel's exponent 0.33 (not 1/3) makes the expression dimensionally inconsistent, so the base is divided by unit_velocity^3 (1 m^3/s^3) and the result multiplied by unit_velocity: numerically identical in SI.",
   "body": {"op": "*", "args": ["coef", "unit_velocity", {"op": "^", "args": [{"op": "/", "args": [{"op": "*", "args": [{"op": "/", "args": ["g", "T_sfc"]}, "h", "buoyancy_flux"]}, {"op": "^", "args": ["unit_velocity", 3]}]}, "expo"]}]}
  }
 }
}
