          "description": "Departure d's parcel condensate (dp_plu), marker included."
        },
        "ke_out": {
          "type": "unknown",
          "units": "m^2/s^2",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Departure d's parcel kinetic energy (dp_kup)."
        },
        "Tv_out": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Departure d's parcel virtual temperature (dp_vptu)."
        },
        "Tv_env_out": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "The environmental virtual temperature departure d's ascent recorded (dp_vten)."
        },
        "buoy_out": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Departure d's parcel buoyancy (dp_zbuo)."
        },
        "buoy_acc_out": {
          "type": "unknown",
          "units": "m/s^2",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Departure d's buoyant acceleration (dp_abuoy): none at the departure itself."
        },
        "marked": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "1 at the half levels departure d's base placement labels 2 directly: the base, and under base_low the level above it."
        },
        "lab_out": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Departure d's level labels (dp_klab): 1 at the departure (2 if the base is placed there), 2/1 by condensate at the levels reached, 0 at the stall level unless the base is there, 0 elsewhere."
        },
        "deep": {
          "type": "unknown",
          "units": "1",
          "description": "1 when the scan accepts a departure: penetrative (deep) convection."
        },
        "ktype": {
          "type": "unknown",
          "units": "1",
          "description": "cutypen's convection type: 1 if the deep scan accepts a departure, else the shallow phase's 2 or 0. NOT the scheme's final type: cumastrn later sets mid-level convection (3), and on this reference reclassifies some deep columns as shallow (see the description)."
        },
        "cubot": {
          "type": "unknown",
          "units": "1",
          "description": "cutypen's cloud base: the accepted departure's, else the shallow cloud's, else -1."
        },
        "cutop": {
          "type": "unknown",
          "units": "1",
          "description": "cutypen's cloud top, chosen the same way."
        },
        "kdpl": {
          "type": "unknown",
          "units": "1",
          "description": "cutypen's departure level: L+1 of the accepted departure; NLEV for a shallow cloud (launched from the lowest layer); NLEV-1 otherwise."
        },
        "wbase": {
          "type": "unknown",
          "units": "m/s",
          "description": "cutypen's cloud-base velocity, sqrt(2 K) at the accepted departure's base, else the shallow cloud's."
        }
