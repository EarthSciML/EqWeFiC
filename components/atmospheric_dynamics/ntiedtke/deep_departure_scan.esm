        "dl_frz": {
          "type": "unknown",
          "units": "kg/kg",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Condensate that changes phase between k+1 and k (`freezing_amount`)."
        },
        "dh_up": {
          "type": "unknown",
          "units": "J/kg",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Parcel dry static energy carried out of level k (`parcel_dse`)."
        },
        "l_climb": {
          "type": "unknown",
          "units": "kg/kg",
          "shape": [
            "dep",
            "climb"
          ],
          "description": "Parcel condensate along departure d's ascent, CLIMB-ordered (j = 1 the departure half level L+1, kernel level L+2-j): l[j] = (l[j-1] + dq_cond)/2 from l[1] = 0. The deep scan HALVES the running condensate at every level where the shallow ascent caps it -- a crude precipitation sink. A single-variable recurrence along climb, with departure as a non-recurrence axis."
        },
        "l_up": {
          "type": "unknown",
          "units": "kg/kg",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "The condensate sweep in kernel ordering (0 below the departure)."
        },
        "Tv_up": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Parcel virtual temperature with condensate loading (`parcel_virtual_temperature`)."
        },
        "buoy": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Parcel buoyancy at half level k; at L+1 the departure parcel's, which carries no condensate."
        },
        "buoy_acc": {
          "type": "unknown",
          "units": "m/s^2",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Buoyant acceleration over the step from k+1 to k, g times the mean of the two half levels' buoyancy."
        },
        "ke_climb": {
          "type": "unknown",
          "units": "m^2/s^2",
          "shape": [
            "dep",
            "climb"
          ],
          "description": "Parcel kinetic energy along departure d's ascent, CLIMB-ordered, from 0.5 m^2/s^2 at departure (`ke_step`)."
        },
        "ke_up": {
          "type": "unknown",
          "units": "m^2/s^2",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "The kinetic-energy sweep in kernel ordering (0 below the departure)."
        },
        "n_stalled_below": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "dep",
            "lev"
          ],
          "description": "Number of levels strictly between k and the departure (k < i <= L) at which departure d's parcel has negative kinetic energy."
        },
        "reached": {
