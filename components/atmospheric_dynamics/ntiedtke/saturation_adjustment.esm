            "bindings": {
              "tt": "T_in"
            }
          }
        },
        {
          "lhs": "c_env1",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "newton_increment_folded",
            "bindings": {
              "tt": "T_in",
              "qq": "q_in",
              "pp": "p"
            }
          }
        },
        {
          "lhs": "T_env_mid",
          "rhs": {
            "op": "+",
            "args": [
              "T_in",
              {
                "op": "*",
                "args": [
                  "ldcpm_in",
                  "c_env1"
                ]
              }
            ]
          }
        },
        {
          "lhs": "q_env_mid",
          "rhs": {
            "op": "-",
            "args": [
              "q_in",
              "c_env1"
            ]
          }
        },
        {
          "lhs": "c_env2",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "newton_increment_folded",
            "bindings": {
              "tt": "T_env_mid",
              "qq": "q_env_mid",
              "pp": "p"
            }
          }
        },
        {
          "lhs": "T_env",
          "rhs": {
            "op": "+",
            "args": [
              "T_env_mid",
              {
                "op": "*",
                "args": [
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "foeldcpm",
                    "bindings": {
                      "tt": "T_env_mid"
                    }
                  },
                  "c_env2"
                ]
              }
            ]
          }
        },
        {
          "lhs": "q_env",
          "rhs": {
            "op": "-",
            "args": [
              "q_env_mid",
              "c_env2"
            ]
          }
        },
        {
          "lhs": "c_up1_raw",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "newton_increment_scaled",
            "bindings": {
              "tt": "T_in",
              "qq": "q_in",
              "pp": "p"
            }
          }
        },
        {
          "lhs": "up_active",
          "rhs": {
            "op": "ifelse",
            "args": [
              {
                "op": ">",
                "args": [
                  "c_up1_raw",
                  0.0
                ]
              },
              1.0,
              0.0
            ]
          }
        },
        {
          "lhs": "c_up1",
          "rhs": {
            "op": "*",
            "args": [
              "up_active",
              "c_up1_raw"
            ]
          }
        },
        {
          "lhs": "T_up_mid",
          "rhs": {
            "op": "+",
            "args": [
              "T_in",
              {
                "op": "*",
                "args": [
                  "ldcpm_in",
                  "c_up1"
                ]
              }
            ]
          }
        },
        {
          "lhs": "q_up_mid",
          "rhs": {
            "op": "-",
            "args": [
              "q_in",
              "c_up1"
            ]
          }
        },
        {
          "lhs": "c_up2",
          "rhs": {
            "op": "*",
            "args": [
              "up_active",
              {
                "op": "ifelse",
                "args": [
                  {
                    "op": "<",
                    "args": [
                      {
                        "op": "abs",
                        "args": [
                          "c_up1"
                        ]
                      },
                      "par.zcond_eps"
                    ]
                  },
                  0.0,
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "newton_increment_scaled",
                    "bindings": {
                      "tt": "T_up_mid",
                      "qq": "q_up_mid",
                      "pp": "p"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": "T_up",
          "rhs": {
            "op": "+",
            "args": [
              "T_up_mid",
              {
                "op": "*",
                "args": [
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "foeldcpm",
                    "bindings": {
                      "tt": "T_up_mid"
                    }
                  },
                  "c_up2"
                ]
              }
            ]
          }
        },
        {
          "lhs": "q_up",
          "rhs": {
            "op": "-",
            "args": [
              "q_up_mid",
              "c_up2"
            ]
          }
        },
        {
          "lhs": "c_dd1",
          "rhs": {
            "op": "min",
            "args": [
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "newton_increment_folded",
                "bindings": {
                  "tt": "T_in",
                  "qq": "q_in",
                  "pp": "p"
                }
              },
              0.0
            ]
          }
        },
        {
          "lhs": "T_dd_mid",
          "rhs": {
            "op": "+",
            "args": [
              "T_in",
              {
                "op": "*",
                "args": [
                  "ldcpm_in",
                  "c_dd1"
                ]
              }
            ]
          }
        },
        {
          "lhs": "q_dd_mid",
          "rhs": {
            "op": "-",
            "args": [
              "q_in",
              "c_dd1"
            ]
          }
        },
        {
          "lhs": "c_dd2_raw",
