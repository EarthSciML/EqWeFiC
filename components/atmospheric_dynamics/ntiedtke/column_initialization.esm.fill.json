{
  "dump_dir": "/projects/illinois/eng/cee/ctessum/ctessum/data/eqwefic/chem170_scm",
  "model": "NTiedtkeColumnInitialization",
  "_note": "Inputs and reference are the same file: the real64 replay's stage dump taken right after the cuinin call. `ci_pqsen` comes out FLAT because cumastrn declares `pqsen` rank-1 while every routine it hands it to declares it rank-2 (FORTRAN_BUGS N110); it is reshaped here in the column-major order the sequence association implies. Both TILE COLUMNS are used, and each test names its own, because the two columns reach different convective outcomes at the same step.",
  "tests": [
    {
      "id": "step1_col1_half_level_initialization",
      "description": "cuinin on the chem170 single-column reference, step 1, TILE COLUMN 1 of 2 -- the strongest convective step of the run (deep, ktype 1 in BOTH columns), 06 LST. Reference run: data/eqwefic/notes/chem170_scm_reference_run.md (em_scm_xy, Weisman-Klemp sounding over Kansas, 1997-06-20 12 UTC + 48 h, dx = 20 km, 59 levels, dt = 60 s, cu_physics = 16). Reference build: the real64 (kind_phys = real64) replay through kernels/ntiedtke_driver of WRF fork branch earthsciml-instrumented-chem170, with the seven constants cu_ntiedtke_init takes supplied at binary64 precision (they are ARGUMENTS); the scheme's own parameter block stays at its binary32 roundings, FORTRAN_BUGS N109. The values come from a stage dump taken immediately after the cuinin call, because every one of its outputs is a cumastrn local that the updraught and the rest overwrite before the routine returns. `qs_h` is asserted through `qs_h_defined`, which zeroes the top entry on both sides: cuinin never assigns `pqsenh(:,1)` even though the array is intent(out), so there is nothing there to match. Vertical ordering is the scheme's own TOP-DOWN kernel ordering, index 1 at the model top. Algebraic observeds at t = 0 with no ODE state, so the empty time_span is one static evaluation.",
      "inputs": "nt64/1.json",
      "reference": "nt64/1.json",
      "column": 0,
      "time_span": {
        "start": 0,
        "end": 0
      },
      "tolerance": {
        "rel": 1e-09
      },
      "fields_library": "tests/ci_step1_col1_inputs.esm",
      "fields": {
        "input_ci_T": {
          "expr": "ci_pten",
          "axis": "lev"
        },
        "input_ci_q": {
          "expr": "ci_pqen",
          "axis": "lev"
        },
        "input_ci_qs": {
          "expr": "ci_pqsen.reshape(59,2)[:,0]",
          "axis": "lev"
        },
        "input_ci_u": {
          "expr": "ci_puen",
          "axis": "lev"
        },
        "input_ci_v": {
          "expr": "ci_pven",
          "axis": "lev"
        },
        "input_ci_omega": {
          "expr": "ci_pverv",
          "axis": "lev"
        },
        "input_ci_geo": {
          "expr": "ci_pgeo",
          "axis": "lev"
        },
        "input_ci_paph": {
          "expr": "ci_paph",
          "axis": "lev_nodes"
        },
        "input_ci_geoh": {
          "expr": "ci_pgeoh",
          "axis": "lev_nodes"
        }
      },
      "assertions": [
        {
          "variable": "T_h",
          "expr": "ci_ztenh",
          "axis": "lev",
          "reduce": "Linf_error",
          "tol_rel_max": 1e-09
        },
        {
          "variable": "q_h",
          "expr": "ci_zqenh",
          "axis": "lev",
          "reduce": "Linf_error",
          "tol_rel_max": 1e-09
        },
        {
          "variable": "qs_h_defined",
          "expr": "concat(zeros(1), ci_zqsenh[1:])",
          "axis": "lev",
          "reduce": "Linf_error",
          "tol_rel_max": 1e-09
        },
        {
          "variable": "Tu",
          "expr": "ci_ptu",
          "axis": "lev",
          "reduce": "Linf_error",
          "tol_rel_max": 1e-09
        },
        {
          "variable": "Td",
          "expr": "ci_ztd",
          "axis": "lev",
          "reduce": "Linf_error",
          "tol_rel_max": 1e-09
        },
        {
          "variable": "qu",
          "expr": "ci_pqu",
          "axis": "lev",
          "reduce": "Linf_error",
          "tol_rel_max": 1e-09
        },
        {
          "variable": "qd",
          "expr": "ci_zqd",
          "axis": "lev",
          "reduce": "Linf_error",
          "tol_rel_max": 1e-09
        },
        {
          "variable": "lu",
          "expr": "ci_plu",
          "axis": "lev",
          "reduce": "Linf_error",
          "tolerance": {
            "abs": 0.0
          }
        },
        {
          "variable": "uu",
          "expr": "ci_zuu",
          "axis": "lev",
          "reduce": "Linf_error",
          "tol_rel_max": 1e-09
        },
        {
          "variable": "vu",
          "expr": "ci_zvu",
          "axis": "lev",
          "reduce": "Linf_error",
          "tol_rel_max": 1e-09
        },
        {
          "variable": "lab",
          "expr": "ci_ilab",
          "axis": "lev",
          "reduce": "Linf_error",
          "tolerance": {
            "abs": 0.0
          }
        },
        {
          "variable": "klwmin",
          "expr": "ci_ilwmin",
          "tolerance": {
            "abs": 0.0
          }
        }
      ]
    },
