        "evap_floor_at": {
          "params": [
            "kz"
          ],
          "description": "Least flux the humidity limiter lets survive layer kz: what would remain if evaporation brought it to rhevap times saturation within one step. A TEMPLATE rather than an array because the evaporation sweep needs it at the cell it has just published; as an observed it closes a cycle with the total flux that esm-spec 4.9.6 rejects, even though every read is of a published cell. Re-applied afterwards to the finished profile so it can be asserted.",
          "body": {
            "op": "-",
            "args": [
              {
                "op": "index",
