{
  "esm": "1.1.0",
  "metadata": {
    "name": "MadronichParameters",
    "description": "Scheme constants of WRF-Chem's Madronich photolysis (phot_opt = 1, PHOTMAD), transcribed from chem/module_phot_mad.F of WRF v4.8.0. Only constants that the scheme itself defines or redefines live here; everything physical comes from lib/wrf_constants.esm. Three separate values of pi are in play on this code path and they are NOT interchangeable at the tolerance these tests use, so each is named for where it is spelled: pi_zenith is the literal 3.1415926535590 that SUBROUTINE calc_zenith assigns to its own local `pi` (module_phot_mad.F:2676) and uses for every degree-to-radian conversion inside the ephemeris; pi_driver is the 3.141592654 of chem/module_data_radm2.F:123, which is the `pi` in scope in madronich1_driver and therefore the one used for zenita = cos(zenith*pi/180.) (module_phot_mad.F:1497); WRF's own piconst (3.141592653589793, share/module_model_constants.F:72) is used by neither. The difference between pi_zenith and piconst is 4e-11 relative and between pi_driver and piconst 2e-10 relative, both below the 1e-5 single-precision tolerance of the tests here, but they are transcribed faithfully so that a future double-precision kernel reference still matches."
  },
  "models": {
    "MadronichParameters": {
      "variables": {
        "pi_zenith": {"type": "parameter", "units": "1", "default": 3.1415926535590, "description": "Pi as SUBROUTINE calc_zenith spells it (module_phot_mad.F:2676, `pi = 3.1415926535590`)."},
        "degrad_zenith": {"type": "unknown", "units": "rad/deg", "description": "Radians per degree inside calc_zenith, its local `dr = pi/180.` (module_phot_mad.F:2677)."},
        "pi_driver": {"type": "parameter", "units": "1", "default": 3.141592654, "description": "Pi as seen by madronich1_driver, from chem/module_data_radm2.F:123. This is the one in `zenita = cos(zenith*pi/180.)`."},
        "degrad_driver": {"type": "unknown", "units": "rad/deg", "description": "Radians per degree in madronich1_driver, pi_driver/180."},

        "ml_c0": {"type": "parameter", "units": "deg", "default": 279.2801988, "description": "Geometric mean longitude of the sun, constant term (calc_zenith: ml = 279.2801988 + .9856473354*d + 2.267E-13*d*d)."},
        "ml_c1": {"type": "parameter", "units": "deg/day", "default": 0.9856473354, "description": "Geometric mean longitude, linear term."},
        "ml_c2": {"type": "parameter", "units": "deg/day^2", "default": 2.267e-13, "description": "Geometric mean longitude, quadratic term."},

        "w_c0": {"type": "parameter", "units": "deg", "default": 282.4932328, "description": "Mean longitude of perigee, constant term (w = 282.4932328 + 4.70684E-5*d + 3.39E-13*d*d)."},
        "w_c1": {"type": "parameter", "units": "deg/day", "default": 4.70684e-5, "description": "Mean longitude of perigee, linear term."},
        "w_c2": {"type": "parameter", "units": "deg/day^2", "default": 3.39e-13, "description": "Mean longitude of perigee, quadratic term."},

        "ec_c0": {"type": "parameter", "units": "1", "default": 1.6720041e-2, "description": "Orbital eccentricity, constant term (ec = 1.6720041E-2 - 1.1444E-9*d - 9.4E-17*d*d)."},
        "ec_c1": {"type": "parameter", "units": "1/day", "default": -1.1444e-9, "description": "Orbital eccentricity, linear term."},
        "ec_c2": {"type": "parameter", "units": "1/day^2", "default": -9.4e-17, "description": "Orbital eccentricity, quadratic term."},

        "epsi_c0": {"type": "parameter", "units": "deg", "default": 23.44266511, "description": "Mean obliquity of the ecliptic, constant term (epsi = 23.44266511 - 3.5626E-7*d - 1.23E-15*d*d)."},
        "epsi_c1": {"type": "parameter", "units": "deg/day", "default": -3.5626e-7, "description": "Mean obliquity, linear term."},
        "epsi_c2": {"type": "parameter", "units": "deg/day^2", "default": -1.23e-15, "description": "Mean obliquity, quadratic term."},

        "eqt_scale": {"type": "parameter", "units": "s", "default": 13751.0, "description": "Scale converting the dimensionless Fourier sum feqt to the equation of time in seconds (eqt = feqt*13751.0)."},
        "eot_sec_per_deg": {"type": "parameter", "units": "s/deg", "default": 240.0, "description": "Seconds of the equation of time per degree of right ascension (reqt = eqt/240.); 86400 s / 360 deg."},
        "decl_tan_coeff": {"type": "parameter", "units": "1", "default": 0.43360, "description": "Coefficient of the declination, tab = 0.43360*sin(rra) with rdecl = atan(tab). 0.4336 = tan(23.44 deg)."},

        "solar_noon": {"type": "parameter", "units": "h", "default": 12.0, "description": "Local solar noon in hours, the leading term of lbgmt = 12.0 - eqt/3600. + long*24./360."},
        "sec_per_hour": {"type": "parameter", "units": "s/h", "default": 3600.0, "description": "Seconds per hour, converting the equation of time to an hour offset."},
        "hours_per_day": {"type": "parameter", "units": "h/day", "default": 24.0, "description": "Hours per day; used both for d = jd + gmt/24. and, with degrees_per_turn, for the longitude-to-hour conversion."},
        "degrees_per_turn": {"type": "parameter", "units": "deg", "default": 360.0, "description": "Degrees in a full rotation, the 360. of long*24./360."},
        "deg_per_hour": {"type": "parameter", "units": "deg/h", "default": 15.0, "description": "Degrees of hour angle per hour (lzgmt = 15.0*(gmt-lbgmt))."},
        "half_turn": {"type": "parameter", "units": "deg", "default": 180.0, "description": "Half a rotation; the 180. of the azimuth reflection azimuth = azimuth + 2*(180.-azimuth) and of the caz < -0.999999 branch."},

        "caz_lo": {"type": "parameter", "units": "1", "default": -0.999999, "description": "Lower guard on the cosine of the azimuth: below it calc_zenith returns azimuth = 180 rather than calling acos."},
        "caz_hi": {"type": "parameter", "units": "1", "default": 0.999999, "description": "Upper guard on the cosine of the azimuth: above it calc_zenith returns azimuth = 0."},

        "night_zenith": {"type": "parameter", "units": "deg", "default": 90.0, "description": "Zenith angle at which madronich1_driver declares night: `if(zenith.ge.90.) go to 199` skips the radiative transfer and leaves every j-value at zero (module_phot_mad.F:1495)."},
        "zenith_nudge": {"type": "parameter", "units": "deg", "default": 89.9, "description": "The value madronich1_driver substitutes for an exactly-90-degree zenith, `if(zenith.eq.90.) zenith = 89.9` (module_phot_mad.F:1494), so that the Chapman branch stays finite."},
        "chap_threshold": {"type": "parameter", "units": "deg", "default": 75.0, "description": "Zenith angle above which the effective cosine is replaced by the reciprocal Chapman function, `if(zenith.gt.75.) zenita=1./chap(zenith)` (module_phot_mad.F:1498)."}
      },
      "equations": [
        {"lhs": "degrad_zenith", "rhs": {"op": "/", "args": ["pi_zenith", 180]}},
        {"lhs": "degrad_driver", "rhs": {"op": "/", "args": ["pi_driver", 180]}}
      ]
    }
  }
}
